<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Base body */
        body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Background Image Layer (Blurred) */
        body::before {
            content: '';
            position: fixed;
            top: -10px;
            left: -10px;
            right: -10px;
            bottom: -10px;
            background-image: url('/images/rp-main.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            filter: blur(5px);
            z-index: -2;
        }

        /* Dark Overlay Layer */
        body::after {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.55);
            z-index: -1;
        }

        .navbar {
            position: relative;
            z-index: 10;
            background: transparent !important;
            border: 0 !important;
            padding: 8px 12px;
        }

        .navbar .container-fluid {
            justify-content: flex-end;
        }

        .navbar .btn {
            color: rgba(255,255,255,0.94) !important;
            background: rgba(96,165,250,0.16) !important;
            border: 1px solid rgba(147,197,253,0.34) !important;
            border-radius: 999px !important;
            padding: 8px 16px;
            box-shadow: 0 10px 24px rgba(15,23,42,0.20);
            backdrop-filter: blur(10px);
            transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
        }

        .navbar .btn:hover,
        .navbar .btn:focus-visible {
            color: #ffffff !important;
            background: rgba(96,165,250,0.26) !important;
            border-color: rgba(191,219,254,0.52) !important;
            transform: translateY(-1px);
        }

        .main-container {
            position: relative;
            z-index: 10;
        }

        .password-toggle {
            cursor: pointer;
        }

        .back-link {
            cursor: pointer;
            color: #0d6efd;
            text-decoration: underline;
        }

        .back-link:hover {
            color: #0a58ca;
        }

        .disabled-input {
            background-color: #e9ecef !important;
            cursor: not-allowed;
        }

        /* Card styling */
        .card {
            background-color: rgba(255, 255, 255, 0.97);
            border: none;
            border-radius: 12px;
        }

        /* Footer text styling */
        .footer-text {
            color: rgba(255, 255, 255, 0.9) !important;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.7);
        }
    </style>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar">
        <div class="container-fluid">
            <a class="btn btn-outline-light" href="/">Back</a>
        </div>
    </nav>

    <!-- Login/Reset Card -->
    <div class="container main-container mt-5" style="max-width: 420px;">
        <div class="card shadow-lg">
            <div class="card-body">

                <!-- No Account Found Warning -->
                <% if (!adminAccount) { %>
                    <div class="alert alert-warning">
                        <strong>Warning:</strong> No admin account found in database. Please contact your system administrator.
                    </div>
                <% } %>

                <!-- LOGIN PANEL -->
                <div id="login-panel">
                    <h4 class="card-title text-center mb-4">Admin Login</h4>

                    <!-- Login Error Message -->
                    <% if (typeof loginError !== 'undefined' && loginError) { %>
                        <div class="alert alert-danger">
                            <%= loginError %>
                        </div>
                    <% } %>

                    <!-- Login Form -->
                    <form action="/login" method="POST">
                        <div class="mb-3">
                            <label for="login-account" class="form-label">Username</label>
                            <input 
                                type="text" 
                                id="login-account" 
                                name="account" 
                                class="form-control disabled-input" 
                                value="<%= adminAccount || 'No account found' %>"
                                readonly
                                disabled>
                            <div class="form-text text-muted">Username is pre-configured</div>
                        </div>

                        <div class="mb-3">
                            <label for="login-password" class="form-label">Password</label>
                            <div class="input-group">
                                <input
                                    type="password"
                                    id="login-password"
                                    name="password"
                                    class="form-control"
                                    placeholder="Enter your password"
                                    required
                                    autocomplete="current-password"
                                    <%= !adminAccount ? 'disabled' : '' %>>
                                <button class="btn btn-outline-secondary password-toggle" type="button" data-target="login-password" <%= !adminAccount ? 'disabled' : '' %>>
                                    Show
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100" <%= !adminAccount ? 'disabled' : '' %>>
                            Login
                        </button>
                    </form>

                    <div class="text-center mt-3">
                        <small class="text-muted">
                            Forgot your password? 
                            <span class="back-link" id="showResetPanel">Reset here</span>
                        </small>
                    </div>
                </div>

                <!-- RESET PASSWORD PANEL -->
                <div id="reset-panel" style="display: none;">
                    <h4 class="card-title text-center mb-4">Reset Password</h4>

                    <!-- Reset Error/Success Message -->
                    <% if (typeof resetError !== 'undefined' && resetError) { %>
                        <div class="alert alert-danger">
                            <%= resetError %>
                        </div>
                    <% } %>

                    <% if (typeof resetSuccess !== 'undefined' && resetSuccess) { %>
                        <div class="alert alert-success">
                            <%= resetSuccess %>
                        </div>
                    <% } %>

                    <div class="alert alert-info mb-3">
                        <small>
                            <strong>Note:</strong> You need the admin reset passcode to reset your password. Contact your system administrator if you don't have it.
                        </small>
                    </div>

                    <!-- Reset Form -->
                    <form action="/reset-password" method="POST">
                        <div class="mb-3">
                            <label for="reset-account" class="form-label">Username</label>
                            <input 
                                type="text" 
                                id="reset-account" 
                                name="account" 
                                class="form-control disabled-input" 
                                value="<%= adminAccount || 'No account found' %>"
                                readonly
                                disabled>
                            <div class="form-text text-muted">Password will be reset for this account</div>
                        </div>

                        <div class="mb-3">
                            <label for="reset-passcode" class="form-label">Reset Passcode</label>
                            <div class="input-group">
                                <input
                                    type="password"
                                    id="reset-passcode"
                                    name="passcode"
                                    class="form-control"
                                    placeholder="Enter admin reset passcode"
                                    required
                                    <%= !adminAccount ? 'disabled' : '' %>>
                                <button class="btn btn-outline-secondary password-toggle" type="button" data-target="reset-passcode" <%= !adminAccount ? 'disabled' : '' %>>
                                    Show
                                </button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="reset-new-password" class="form-label">New Password</label>
                            <div class="input-group">
                                <input
                                    type="password"
                                    id="reset-new-password"
                                    name="newPassword"
                                    class="form-control"
                                    placeholder="Enter new password"
                                    minlength="6"
                                    required
                                    autocomplete="new-password"
                                    <%= !adminAccount ? 'disabled' : '' %>>
                                <button class="btn btn-outline-secondary password-toggle" type="button" data-target="reset-new-password" <%= !adminAccount ? 'disabled' : '' %>>
                                    Show
                                </button>
                            </div>
                            <div class="form-text">Minimum 6 characters</div>
                        </div>

                        <div class="mb-3">
                            <label for="reset-confirm-password" class="form-label">Confirm New Password</label>
                            <div class="input-group">
                                <input
                                    type="password"
                                    id="reset-confirm-password"
                                    name="confirmPassword"
                                    class="form-control"
                                    placeholder="Confirm new password"
                                    minlength="6"
                                    required
                                    autocomplete="new-password"
                                    <%= !adminAccount ? 'disabled' : '' %>>
                                <button class="btn btn-outline-secondary password-toggle" type="button" data-target="reset-confirm-password" <%= !adminAccount ? 'disabled' : '' %>>
                                    Show
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-warning w-100" <%= !adminAccount ? 'disabled' : '' %>>
                            Reset Password
                        </button>
                    </form>

                    <div class="text-center mt-3">
                        <small class="text-muted">
                            Remember your password? 
                            <span class="back-link" id="showLoginPanel">Back to Login</span>
                        </small>
                    </div>
                </div>

            </div>
        </div>

        <div class="text-center mt-3">
            <small class="footer-text">ESG Dashboard - Republic Polytechnic</small>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Scripts -->
    <script>
        (function(){
            // Password toggle functionality
            document.querySelectorAll('.password-toggle').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var targetId = this.getAttribute('data-target');
                    var pwdInput = document.getElementById(targetId);
                    if (!pwdInput) return;

                    var isShowing = pwdInput.type === 'text';
                    pwdInput.type = isShowing ? 'password' : 'text';
                    this.textContent = isShowing ? 'Show' : 'Hide';
                });
            });

            // Panel switching
            var loginPanel = document.getElementById('login-panel');
            var resetPanel = document.getElementById('reset-panel');
            var showResetBtn = document.getElementById('showResetPanel');
            var showLoginBtn = document.getElementById('showLoginPanel');

            if (showResetBtn) {
                showResetBtn.addEventListener('click', function() {
                    loginPanel.style.display = 'none';
                    resetPanel.style.display = 'block';
                });
            }

            if (showLoginBtn) {
                showLoginBtn.addEventListener('click', function() {
                    resetPanel.style.display = 'none';
                    loginPanel.style.display = 'block';
                });
            }

            // Auto-show reset panel if there's a reset error or success
            <% if ((typeof resetError !== 'undefined' && resetError) || (typeof resetSuccess !== 'undefined' && resetSuccess)) { %>
                if (loginPanel && resetPanel) {
                    loginPanel.style.display = 'none';
                    resetPanel.style.display = 'block';
                }
            <% } %>

            // Auto-focus password field on load
            var pwdField = document.getElementById('login-password');
            if (pwdField && !pwdField.disabled) {
                pwdField.focus();
            }
        })();

    </script>

</body>
</html>
