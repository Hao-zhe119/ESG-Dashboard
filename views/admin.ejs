    function rowHtmlForItem(item) {
      const id = item.id;
      const type = String(item.media_type || "").toLowerCase();
      const filename = item.filename;

      const enabledYesNo = item.is_enabled ? "Yes" : "No";
      const onSel  = item.is_enabled ? "selected" : "";
      const offSel = !item.is_enabled ? "selected" : "";

      let thumb = "";
      let previewHref = "";
      let extraBodyHtml = "";
      let editBtn = "";

      if (type === "image") {
        thumb = '<div class="media-thumb" aria-hidden="true"><img src="/uploads/images/carousel/' + filename + '" alt="" class="media-thumb" /></div>';
        previewHref = '/uploads/images/carousel/' + filename;
        const captionText = item.caption_text || "";
        if (captionText) {
          extraBodyHtml += '<div class="text-muted small mt-1 caption-info">Caption: <em>' + captionText + '</em></div>';
        }
        const captionX  = item.caption_x || 50;
        const captionY  = item.caption_y || 85;
        const captionFs = item.caption_font_size || 24;
        editBtn = '<button class="btn btn-sm btn-outline-warning edit-overlay-btn"' +
          ' data-id="' + id + '"' +
          ' data-filename="' + filename + '"' +
          ' data-caption="' + captionText.replace(/"/g, '&quot;') + '"' +
          ' data-cx="' + captionX + '"' +
          ' data-cy="' + captionY + '"' +
          ' data-fs="' + captionFs + '">Edit</button>';
      } else {
        thumb = '<div class="media-thumb" aria-hidden="true"><video preload="metadata" muted playsinline><source src="/uploads/videos/' + filename + '#t=0.1" type="video/mp4"></video></div>';
        previewHref = '/uploads/videos/' + filename;
        const vidCaptionText = item.caption_text || "";
        const vidCaptionX    = item.caption_x    || 50;
        const vidCaptionY    = item.caption_y    || 85;
        const vidCaptionFs   = item.caption_font_size || 24;
        if (vidCaptionText) {
          extraBodyHtml += '<div class="text-muted small mt-1 caption-info">Caption: <em>' + vidCaptionText + '</em></div>';
        }
        editBtn = '<button class="btn btn-sm btn-outline-warning edit-overlay-btn"' +
          ' data-id="' + id + '"' +
          ' data-type="video"' +
          ' data-filename="' + filename + '"' +
          ' data-caption="' + vidCaptionText.replace(/"/g, '&quot;') + '"' +
          ' data-cx="' + vidCaptionX + '"' +
          ' data-cy="' + vidCaptionY + '"' +
          ' data-fs="' + vidCaptionFs + '">Edit</button>';
      }

      const fileSettings = loadVideoSettingsByFile()[filename] || {};
      const startValue = (typeof fileSettings.startTime !== "undefined" && fileSettings.startTime !== null) ? fileSettings.startTime : "";
      const durationValue = (typeof fileSettings.duration !== "undefined" && fileSettings.duration !== null) ? fileSettings.duration : "";

      let videoSegmentHtml = "";
      if (type === "video") {
        videoSegmentHtml =
          '<div class="d-flex flex-wrap gap-2 align-items-center mt-2">' +
            '<div class="input-group input-group-sm" style="width: 128px;">' +
              '<span class="input-group-text">Start</span>' +
              '<input type="number" class="form-control video-segment-start" data-filename="' + filename + '" min="0" step="1" placeholder="0" value="' + startValue + '" />' +
              '<div class="invalid-feedback">Start time must be a whole number 0 or greater.</div>' +
            '</div>' +
            '<div class="input-group input-group-sm" style="width: 160px;">' +
              '<span class="input-group-text">Len</span>' +
              '<input type="number" class="form-control video-segment-duration" data-filename="' + filename + '" min="0" step="1" placeholder="Full" value="' + durationValue + '" />' +
              '<div class="invalid-feedback">Length must be a whole number 0 or greater, or left blank.</div>' +
            '</div>' +
          '</div>';
      }

      return '<div class="media-row" data-id="' + id + '">' +
        '<div class="drag-handle" title="Drag to reorder">||</div>' +
        thumb +
        '<div class="media-body"><strong title="' + filename + '">' + filename + '</strong>' +
        '<div class="text-muted small">Enabled: <span class="enabled-label">' + enabledYesNo + '</span></div>' +
        extraBodyHtml +
        videoSegmentHtml +
        '</div>' +
        '<div class="media-controls">' +
        editBtn +
        '<a class="btn btn-sm btn-outline-info" href="' + previewHref + '" target="_blank" rel="noopener noreferrer">Preview</a>' +
        '<input type="hidden" class="sort-input" value="">' +
        '<select class="form-select form-select-sm enabled-select" style="width:auto;"><option value="1" ' + onSel + '>On</option><option value="0" ' + offSel + '>Off</option></select>' +
        '<form action="/admin/media/' + id + '/delete" method="POST" onsubmit="return confirm(\'Are you sure you want to delete this item? Continue?\');"><input type="hidden" name="media_type" value="' + type + '"><button class="btn btn-sm btn-danger" type="submit">X</button></form>' +
        '</div></div>';
    }

    async function refreshMediaList(type) {
      const listEl = (type === "image")
        ? document.getElementById("imageSortable")
        : document.getElementById("videoSortable");

      if (!listEl) return;

      const json = await fetchMediaJson(type);
      const items = Array.isArray(json.items) ? json.items : [];

      listEl.innerHTML = items.map(rowHtmlForItem).join("");

      initSortable(listEl);
      updateHiddenSortInputs(listEl);
      syncAllEnabledLabels(listEl);
    }

