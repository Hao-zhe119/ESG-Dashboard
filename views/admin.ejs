      const lbl = document.getElementById("overlayDragLabel");
      if (lbl) {
        lbl.textContent = caption || "Caption Preview";
        lbl.style.fontSize = fs + "px";
      }
      updateDragLabel(cx, cy);

      showOverlayPanel();
    });

    $("#saveOverlayBtn").on("click", async function() {
      const id = $("#overlayModalMediaId").val();
      if (!id) return;

      const captionText = $("#overlayCaptionText").val().trim();

      $(this).prop("disabled", true).text("Saving...");
      try {
        const res  = await fetch("/admin/media/" + id + "/save-overlay", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ caption_text: captionText, caption_x: _captionX, caption_y: _captionY, caption_font_size: _captionFontSize })
        });
        const json = await res.json();
        if (json.success) {
          const btn = $(".edit-overlay-btn[data-id='" + id + "']");
          btn.attr("data-caption", captionText);
