    async function fetchMediaJson(type) {
      const res = await fetch("/admin/media/json?type=" + encodeURIComponent(type), {
        headers: { "Accept": "application/json" }
      });
      if (!res.ok) throw new Error("Failed to fetch media json for " + type);
