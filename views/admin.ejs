    // ============================================================
    // Video Settings (Volume, Mute, Start Time, Duration)
    // ============================================================
    const LS_KEY = "esg_video_settings";
    const BY_FILE_KEY = "esg_video_settings_by_file";
    const ADMIN_VIDEO_SETTINGS_CHANNEL = "esg_video_settings_channel";
    let videoSettings = { volume: 0.5, muted: false, startTime: null, duration: null };

    function loadVideoSettingsByFile() {
      try {
        const raw = localStorage.getItem(BY_FILE_KEY);
        if (!raw) return {};
        const payload = JSON.parse(raw);
        return (payload && typeof payload === "object") ? payload : {};
      } catch (_e) {
        return {};
      }
    }

    function saveVideoSettingsByFile(data) {
      try { localStorage.setItem(BY_FILE_KEY, JSON.stringify(data || {})); } catch (_e) {}
      try {
        const channel = new BroadcastChannel(ADMIN_VIDEO_SETTINGS_CHANNEL);
        channel.postMessage({ type: "ADMIN_VIDEO_SETTINGS_PER_FILE", payload: data || {} });
        channel.close();
      } catch (_e) {}
    }

    function updateVideoSettingsForFile(filename, next) {
      if (!filename) return;
      const settings = loadVideoSettingsByFile();
      const current = (settings && typeof settings === "object") ? settings : {};
      const updated = { ...(current[filename] || {}), ...(next || {}) };
      if (updated.startTime == null && updated.duration == null) {
        delete current[filename];
      } else {
        current[filename] = updated;
      }
      saveVideoSettingsByFile(current);
    }

    function clamp01(n) {
      n = Number(n);
      if (!isFinite(n)) return 0;
      return Math.max(0, Math.min(1, n));
    }

    function validateVideoTimeInput(value, allowEmpty = true) {
      const raw = String(value === null || value === undefined ? "" : value).trim();
      if (raw === "") return { valid: allowEmpty, parsed: null, error: null };
      if (!/^[0-9]+$/.test(raw)) {
        return { valid: false, parsed: null, error: "Enter a whole number 0 or greater." };
      }
      const parsed = Number(raw);
      if (!isFinite(parsed) || parsed < 0) {
        return { valid: false, parsed: null, error: "Enter a valid non-negative number." };
      }
      return { valid: true, parsed: Math.floor(parsed), error: null };
    }

    function setVideoInputValidity($input, isValid, message) {
      if (isValid) {
        $input.removeClass("is-invalid");
        $input.next(".invalid-feedback").text("");
      } else {
        $input.addClass("is-invalid");
        $input.next(".invalid-feedback").text(message || "Invalid value.");
      }
    }

    function loadSettings() {
      try {
        const raw = localStorage.getItem(LS_KEY);
        if (!raw) return;
        const s = JSON.parse(raw);
        if (s && typeof s === "object") {
          if (typeof s.volume !== "undefined") videoSettings.volume = clamp01(s.volume);
          if (typeof s.muted  !== "undefined") videoSettings.muted  = !!s.muted;
        }
      } catch(_e) {}
    }

    function saveSettings() {
      try { localStorage.setItem(LS_KEY, JSON.stringify(videoSettings)); } catch(_e) {}
      try {
        const channel = new BroadcastChannel(ADMIN_VIDEO_SETTINGS_CHANNEL);
        channel.postMessage({ type: "ADMIN_VIDEO_SETTINGS", ...videoSettings });
        channel.close();
      } catch(_e) {}
    }

    function setAdminUIFromSettings() {
      const pct = Math.round(videoSettings.volume * 100);
      $("#adminVideoVolume").val(String(pct));
      $("#adminVideoVolumeChip").text(pct + "%");
      $("#videoMuteStateChip").text(videoSettings.muted ? "Muted" : "Unmuted");
    }

    function getDashboardWindowIfLinked() {
      try { if (window.opener && !window.opener.closed) return window.opener; } catch(_e) {}
      return null;
    }

    function pushToDashboardIfPossible() {
      const w = getDashboardWindowIfLinked();
      if (!w) return false;
      try {
        w.postMessage({ type: "ADMIN_VIDEO_SETTINGS", ...videoSettings }, window.location.origin);
        return true;
      } catch(_e) {
        return false;
      }
    }

    function applySettings() {
      saveSettings();
      setAdminUIFromSettings();
      pushToDashboardIfPossible();
    }

    function updateVideoSetting(name, value) {
      if (name === "volume") {
        videoSettings.volume = clamp01(value);
      } else if (name === "muted") {
        videoSettings.muted = !!value;
      }
      applySettings();
    }

    function setVideoRowSegmentInputs() {
      const settingsByFile = loadVideoSettingsByFile();
      $(".video-segment-start").each(function() {
        const filename = $(this).data("filename");
        const fileSettings = settingsByFile[filename] || {};
        $(this).val(fileSettings.startTime != null ? fileSettings.startTime : "");
        setVideoInputValidity($(this), true);
      });
      $(".video-segment-duration").each(function() {
        const filename = $(this).data("filename");
        const fileSettings = settingsByFile[filename] || {};
        $(this).val(fileSettings.duration != null ? fileSettings.duration : "");
        setVideoInputValidity($(this), true);
      });
    }

    function saveVideoSegmentInput(filename, name, value) {
      const validation = validateVideoTimeInput(value, name === "duration");
      const $input = $(".video-segment-" + name + "[data-filename='" + filename + "']");
      setVideoInputValidity($input, validation.valid, validation.error);
      if (!validation.valid) return;
      const next = {};
      next[name] = validation.parsed;
      if (validation.parsed == null) next[name] = null;
      updateVideoSettingsForFile(filename, next);
    }

    $(document).on("input change", ".video-segment-start", function() {
      const filename = $(this).data("filename");
      saveVideoSegmentInput(filename, "startTime", $(this).val());
    });

    $(document).on("input change", ".video-segment-duration", function() {
      const filename = $(this).data("filename");
      saveVideoSegmentInput(filename, "duration", $(this).val());
    });

    loadSettings();
    setAdminUIFromSettings();
    setVideoRowSegmentInputs();
    pushToDashboardIfPossible();

    $("#videoMuteBtn").on("click", function() { videoSettings.muted = true; applySettings(); });
    $("#videoUnmuteBtn").on("click", function() { videoSettings.muted = false; applySettings(); });

    $("#adminVideoVolume").on("input change", function() {
      const pct = Math.max(0, Math.min(100, Number($(this).val() || 0)));
      const v = clamp01(pct / 100);
      videoSettings.volume = v;
      if (v > 0) videoSettings.muted = false;
      applySettings();
    });

    window.addEventListener("message", (ev) => {
      if (ev.origin !== window.location.origin) return;
      const data = ev.data || {};
      if (data.type === "DASHBOARD_READY") pushToDashboardIfPossible();
    });

    // ============================================================
    // Upload XLSX + Auto-reload to display year ranges
    // ============================================================
    $("#xlsxFile").on("change", function() {
      let name = this.files.length ? this.files[0].name : "";
      $("#xlsxFileName").text(name ? "Selected: " + name : "");
    });

    $("#xlsxForm").on("submit", function(e) {
      e.preventDefault();
      let fileInput = $("#xlsxFile")[0].files[0];
      
      if (!fileInput) { 
        showStatus("Please select an Excel file before uploading.", "danger"); 
        return; 
      }

      const $submitBtn = $(this).find('button[type="submit"]');
      const originalBtnText = $submitBtn.text();
      $submitBtn.prop("disabled", true).text("Uploading & Processing...");
      
      showStatus("Uploading and processing XLSX file. This may take a moment...", "info");

      let formData = new FormData();
      formData.append("xlsxFile", fileInput);

      $.ajax({
        url: "/upload/xlsx",
        method: "POST",
        data: formData,
        processData: false,
        contentType: false,
        timeout: 120000,
        success: function(response) { 
          showStatus(response + " | Refreshing page to display year ranges...", "success");
          
          $("#xlsxFile").val("");
          $("#xlsxFileName").text("");
          
          setTimeout(function() {
            window.location.href = window.location.pathname + "#sec-upload-graph";
            window.location.reload();
          }, 1500);
        },
        error: function(err) { 
          let msg = "Upload failed. Please try again.";
          if (err && err.responseText) {
            msg = err.responseText;
          } else if (err.statusText) {
            msg = "Upload failed: " + err.statusText;
          }
          
          showStatus(msg, "danger");
          $submitBtn.prop("disabled", false).text(originalBtnText);
          $("#xlsxFile").val("");
          $("#xlsxFileName").text("");
        }
      });
    });

    $("#clearDataBtn").on("click", function() {
      const confirmed = confirm(
        "WARNING: This will permanently delete ALL data:\n\n" +
        "- All electricity records\n" +
        "- All water usage records\n" +
        "- All solar generation data\n" +
        "- All waste management data\n" +
        "- Year range configurations\n\n" +
        "This action CANNOT be undone!\n\n" +
        "Are you absolutely sure you want to continue?"
      );
      
      if (!confirmed) return;
      
      const $btn = $(this);
      const originalText = $btn.text();
      $btn.prop("disabled", true).text("Clearing...");
      showStatus("Clearing all data...", "info");
      
      $.ajax({
        url: "/clear/all",
        method: "POST",
        success: function(response) { 
          showStatus("All data cleared successfully. Refreshing page...", "success");
          
          setTimeout(function() {
            window.location.href = window.location.pathname + "#sec-upload-graph";
            window.location.reload();
          }, 1500);
        },
        error: function(err) { 
          let msg = "Failed to clear data.";
          if (err && err.responseText) msg = err.responseText;
          
          showStatus(msg, "danger");
          $btn.prop("disabled", false).text(originalText);
        }
      });
    });

    function showStatus(message, type) {
      const $status = $("#xlsxStatus");
      
      $status
        .removeClass("d-none alert-success alert-danger alert-warning alert-info")
        .addClass("alert-" + type)
        .html(message);
      
      if (type === "success" && !message.includes("Refreshing")) {
        setTimeout(function() {
          $status.addClass("d-none");
        }, 10000);
      }
    }

    // ============================================================
    // YEAR RANGES: AUTO-SAVE + DYNAMIC DROPDOWN VALIDATION
    // ============================================================
    const $yearRangeSaveChip = $("#yearRangeSaveChip");
    let yearRangeAutosaveTimer = null;

    const ELEC_YEARS = <%- JSON.stringify(typeof elecYearsAsInts !== "undefined" ? elecYearsAsInts : []) %>;
    const WATER_YEARS = <%- JSON.stringify(typeof waterYearsAsInts !== "undefined" ? waterYearsAsInts : []) %>;
    const ELEC_MIN = ELEC_YEARS.length > 0 ? ELEC_YEARS[0] : null;
    const ELEC_MAX = ELEC_YEARS.length > 0 ? ELEC_YEARS[ELEC_YEARS.length - 1] : null;
    const WATER_MIN = WATER_YEARS.length > 0 ? WATER_YEARS[0] : null;
    const WATER_MAX = WATER_YEARS.length > 0 ? WATER_YEARS[WATER_YEARS.length - 1] : null;

    function setYearRangeChip(state) {
      $yearRangeSaveChip.removeClass("saving saved error");
      if (state === "saving") {
        $yearRangeSaveChip.addClass("saving").text("Saving...");
      } else if (state === "saved") {
        $yearRangeSaveChip.addClass("saved").text("Saved");
      } else if (state === "error") {
        $yearRangeSaveChip.addClass("error").text("Error saving");
      } else {
        $yearRangeSaveChip.text("Auto-save enabled");
      }
    }

    function updateDropdownConstraints(buildingId, dataType) {
      const $startSelect = $("#" + dataType + "-start-" + buildingId);
      const $endSelect = $("#" + dataType + "-end-" + buildingId);
      
      if (!$startSelect.length || !$endSelect.length) return;
      
      const startVal = $startSelect.val();
      const endVal = $endSelect.val();
      
      const startYear = startVal ? parseInt(startVal, 10) : null;
      const endYear = endVal ? parseInt(endVal, 10) : null;
      
      $endSelect.find("option").each(function() {
        const optVal = $(this).val();
        const optYear = parseInt(optVal, 10);
        if (startYear !== null && optYear < startYear) {
          $(this).prop("disabled", true);
        } else {
          $(this).prop("disabled", false);
        }
      });
      
      $startSelect.find("option").each(function() {
        const optVal = $(this).val();
        const optYear = parseInt(optVal, 10);
        if (endYear !== null && optYear > endYear) {
          $(this).prop("disabled", true);
        } else {
          $(this).prop("disabled", false);
        }
      });
    }

    function updateRangeStatusText(buildingId, dataType) {
      const $startSelect = $("#" + dataType + "-start-" + buildingId);
      const $endSelect = $("#" + dataType + "-end-" + buildingId);
      const $status = $(".range-status[data-building-id='" + buildingId + "'][data-type='" + dataType + "']");
      
      if (!$startSelect.length || !$endSelect.length || !$status.length) return;
      
      const startVal = $startSelect.val();
      const endVal = $endSelect.val();
      
      const text = "Current: " + startVal + " - " + endVal;
      
      $status.text(text);
      
      $status.addClass("updated");
      setTimeout(function() {
        $status.removeClass("updated");
      }, 1500);
    }

    function updateConfigBadge(buildingId) {
      const $row = $(".building-year-row[data-building-id='" + buildingId + "']");
      const $badge = $row.find(".config-badge");
      
      const elecStart = parseInt($("#elec-start-" + buildingId).val(), 10);
      const elecEnd = parseInt($("#elec-end-" + buildingId).val(), 10);
      const waterStart = parseInt($("#water-start-" + buildingId).val(), 10);
      const waterEnd = parseInt($("#water-end-" + buildingId).val(), 10);
      
      const elecIsFullRange = (isNaN(elecStart) && isNaN(elecEnd)) || (elecStart === ELEC_MIN && elecEnd === ELEC_MAX);
      const waterIsFullRange = (isNaN(waterStart) && isNaN(waterEnd)) || (waterStart === WATER_MIN && waterEnd === WATER_MAX);
      const isCustomRange = !elecIsFullRange || !waterIsFullRange;
      
      $badge
        .removeClass("bg-success bg-secondary")
        .addClass(isCustomRange ? "bg-success" : "bg-secondary")
        .text(isCustomRange ? "Custom Range" : "Full Range");
    }

    function collectYearRangeData() {
      const data = {
        elec_startyears: {},
        elec_endyears: {},
        water_startyears: {},
        water_endyears: {}
      };
      
      $(".building-year-row").each(function() {
        const buildingId = $(this).data("building-id");
        
        data.elec_startyears[buildingId] = $("#elec-start-" + buildingId).val() || "";
        data.elec_endyears[buildingId] = $("#elec-end-" + buildingId).val() || "";
        data.water_startyears[buildingId] = $("#water-start-" + buildingId).val() || "";
        data.water_endyears[buildingId] = $("#water-end-" + buildingId).val() || "";
      });
      
      return data;
    }

    function buildFormData(data) {
      const params = new URLSearchParams();
      
      for (const key in data) {
        if (data.hasOwnProperty(key)) {
          const obj = data[key];
          for (const id in obj) {
            if (obj.hasOwnProperty(id)) {
              params.append(key + "[" + id + "]", obj[id]);
            }
          }
        }
      }
      
      return params.toString();
    }

    async function autosaveYearRanges(buildingId) {
      const $row = $(".building-year-row[data-building-id='" + buildingId + "']");
      
      $row.removeClass("saved error").addClass("saving");
      setYearRangeChip("saving");
      
      const data = collectYearRangeData();
      
      try {
        const response = await fetch("/admin/building-year-ranges", {
          method: "POST",
          headers: {
            "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8"
          },
          body: buildFormData(data)
        });
        
        if (!response.ok) {
          throw new Error("Save failed: " + response.statusText);
        }
        
        $row.removeClass("saving").addClass("saved");
        setYearRangeChip("saved");
        
        setTimeout(function() {
          $row.removeClass("saved");
          setYearRangeChip("idle");
        }, 1500);
        
      } catch (error) {
        console.error("Year range save error:", error);
        $row.removeClass("saving").addClass("error");
        setYearRangeChip("error");
        
        setTimeout(function() {
          $row.removeClass("error");
          setYearRangeChip("idle");
        }, 3000);
      }
    }

    function scheduleYearRangeAutosave(buildingId) {
      if (yearRangeAutosaveTimer) {
        clearTimeout(yearRangeAutosaveTimer);
      }
      
      yearRangeAutosaveTimer = setTimeout(function() {
        autosaveYearRanges(buildingId);
      }, 600);
    }

    function initializeAllDropdownConstraints() {
      $(".building-year-row").each(function() {
        const buildingId = $(this).data("building-id");
        updateDropdownConstraints(buildingId, "elec");
        updateDropdownConstraints(buildingId, "water");
      });
    }

    $(document).on("change", ".year-select", function() {
      const $select = $(this);
      const buildingId = $select.data("building-id");
      const dataType = $select.data("type");
      
      updateDropdownConstraints(buildingId, dataType);
      updateRangeStatusText(buildingId, dataType);
      updateConfigBadge(buildingId);
      scheduleYearRangeAutosave(buildingId);
    });

    initializeAllDropdownConstraints();

    // ========================
    // Building Image Preview 
    // ========================
    $("#imgfile").on("change", function() {
      const file = this.files && this.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        $("#buildingImagePreview").attr("src", e.target.result).show();
      };
      reader.readAsDataURL(file);
    });

  });
  </script>

</body>
</html>
