    async function postUpdateRow(rowEl, mediaType) {
      const id = rowEl.getAttribute("data-id");
      const sortOrder = $(rowEl).find(".sort-input").val() || "1";
      const isEnabled = $(rowEl).find(".enabled-select").val() || "1";

      const url = "/admin/media/" + encodeURIComponent(id) + "/update";

      const body = new URLSearchParams();
      body.set("media_type", mediaType);
      body.set("sort_order", sortOrder);
      body.set("is_enabled", isEnabled);

      const res = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8" },
        body: body.toString()
      });

      if (!res.ok) {
        const t = await res.text().catch(() => "");
        throw new Error("Update failed for id=" + id + " " + t);
      }
    }

    async function autosaveList(el) {
      if (!el) return;

      const mediaType = el.getAttribute("data-media-type") || "";
      const rows = Array.from(el.querySelectorAll(".media-row"));

      updateHiddenSortInputs(el);
      syncAllEnabledLabels(el);

      setMediaChip("saving");

      try {
        for (const row of rows) {
          await postUpdateRow(row, mediaType);
        }
        setMediaChip("saved");
        setTimeout(() => setMediaChip("idle"), 1200);
      } catch(e) {
        console.error(e);
        setMediaChip("error");
        setTimeout(() => setMediaChip("idle"), 2000);
      }
    }

