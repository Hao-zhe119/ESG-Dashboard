    function renderHealth(snapshot) {
      const health = snapshot && snapshot.status ? snapshot : {};
      $("#healthStatusBadge").text(health.status || "unknown");
      const checks = health.checks || {};
      const hardware = checks.hardware || {};
      const dashboard = checks.dashboard || {};
      const database = checks.database || {};
      const backend = checks.backend || {};
      const process = checks.process || {};
      const pcOk = hardware.ok !== false;
      const appOk = dashboard.ok !== false && database.ok !== false && backend.ok !== false && process.ok !== false;
      const pcLines = [
        "Status: " + (pcOk ? "OK" : "Needs attention"),
        "Memory: " + (hardware.memoryUsedPercent != null ? hardware.memoryUsedPercent + "% used" : "Unknown"),
        "Disk: " + (hardware.diskFreePercent != null ? hardware.diskFreePercent + "% free" : "Unknown"),
        "Battery: " + (hardware.battery && hardware.battery.EstimatedChargeRemaining != null ? hardware.battery.EstimatedChargeRemaining + "%" : "Not available"),
        "Uptime: " + (hardware.uptimeHours != null ? hardware.uptimeHours + " hours" : "Unknown")
      ];
      const appLines = [
        "Status: " + (appOk ? "OK" : "Needs attention"),
        "Dashboard: " + (dashboard.message || "Unknown"),
        "Database: " + (database.message || "Unknown"),
        "Server: " + (backend.message || process.message || "Unknown")
      ];
      $("#healthDetails").html(
        '<div class="p-2 border border-secondary rounded mb-2"><strong>PC Health</strong><br>' +
        pcLines.map(function(line) { return $("<div>").text(line).prop("outerHTML"); }).join("") +
        '</div><div class="p-2 border border-secondary rounded"><strong>Application Health</strong><br>' +
        appLines.map(function(line) { return $("<div>").text(line).prop("outerHTML"); }).join("") +
        '</div>'
      );
    }

