    // ==============
    // Manage Media
    // ==============
    const $mediaSaveChip = $("#mediaSaveChip");
    let autosaveTimer = null;

    function setMediaChip(state) {
      $mediaSaveChip.removeClass("saving saved error");
      if (state === "saving") {
        $mediaSaveChip.addClass("saving").text("Saving...");
      } else if (state === "saved") {
        $mediaSaveChip.addClass("saved").text("Saved");
      } else if (state === "error") {
        $mediaSaveChip.addClass("error").text("Error");
      } else {
        $mediaSaveChip.text("Idle");
      }
    }

    function updateHiddenSortInputs(el) {
      $(el).children(".media-row").each(function(i) {
        $(this).find(".sort-input").val(i + 1);
      });
    }

    function setEnabledLabel(rowEl, val) {
      const label = rowEl.querySelector(".enabled-label");
      if (!label) return;
      label.textContent = (String(val) === "1") ? "Yes" : "No";
    }

    function syncAllEnabledLabels(listEl) {
      if (!listEl) return;
      listEl.querySelectorAll(".media-row").forEach(row => {
        const sel = row.querySelector(".enabled-select");
        if (sel) setEnabledLabel(row, sel.value);
      });
    }

    async function postUpdateRow(rowEl, mediaType) {
      const id = rowEl.getAttribute("data-id");
      const sortOrder = $(rowEl).find(".sort-input").val() || "1";
      const isEnabled = $(rowEl).find(".enabled-select").val() || "1";

      const url = "/admin/media/" + encodeURIComponent(id) + "/update";

      const body = new URLSearchParams();
      body.set("media_type", mediaType);
      body.set("sort_order", sortOrder);
      body.set("is_enabled", isEnabled);

      const res = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8" },
        body: body.toString()
      });

      if (!res.ok) {
        const t = await res.text().catch(() => "");
        throw new Error("Update failed for id=" + id + " " + t);
      }
    }

    async function autosaveList(el) {
      if (!el) return;

      const mediaType = el.getAttribute("data-media-type") || "";
      const rows = Array.from(el.querySelectorAll(".media-row"));

      updateHiddenSortInputs(el);
      syncAllEnabledLabels(el);

      setMediaChip("saving");

      try {
        for (const row of rows) {
          await postUpdateRow(row, mediaType);
        }
        setMediaChip("saved");
        setTimeout(() => setMediaChip("idle"), 1200);
      } catch(e) {
        console.error(e);
        setMediaChip("error");
        setTimeout(() => setMediaChip("idle"), 2000);
      }
    }

    function refreshIfListWasEmpty(mediaType) {
      const wasEmpty =
        (mediaType === "image" && $("#imageSortable").length === 0) ||
        (mediaType === "video" && $("#videoSortable").length === 0);

      if (wasEmpty) {
        location.reload();
        return true;
      }
      return false;
    }

    function scheduleAutosave(el) {
      if (autosaveTimer) clearTimeout(autosaveTimer);
      autosaveTimer = setTimeout(() => autosaveList(el), 350);
    }

    function initSortable(el) {
      if (!el) return;

      updateHiddenSortInputs(el);
      syncAllEnabledLabels(el);

      new Sortable(el, {
        animation: 150,
        handle: ".drag-handle",
        onEnd: function() {
          updateHiddenSortInputs(el);
          syncAllEnabledLabels(el);
          scheduleAutosave(el);
        }
      });
    }

    initSortable(document.getElementById("imageSortable"));
    initSortable(document.getElementById("videoSortable"));

    $(document).on("change", ".enabled-select", function() {
      const rowEl = this.closest(".media-row");
      const listEl = this.closest(".media-sortable");
      if (!rowEl || !listEl) return;

      setEnabledLabel(rowEl, this.value);
      updateHiddenSortInputs(listEl);
      scheduleAutosave(listEl);
    });

