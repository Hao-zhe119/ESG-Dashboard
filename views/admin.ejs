    // Caption state
    let _captionX = 50, _captionY = 85, _captionFontSize = 24;

    function updateDragLabel(x, y) {
      _captionX = Math.round(Math.max(5, Math.min(95, x)));
      _captionY = Math.round(Math.max(5, Math.min(95, y)));
      const lbl = document.getElementById("overlayDragLabel");
      if (lbl) {
        lbl.style.left = _captionX + "%";
        lbl.style.top  = _captionY + "%";
      }
      const disp = document.getElementById("overlayPosDisplay");
      if (disp) disp.textContent = _captionX + "%, " + _captionY + "%";
    }

    // Sync label text with caption input
    $(document).on("input", "#overlayCaptionText", function() {
      const lbl = document.getElementById("overlayDragLabel");
      if (lbl) lbl.textContent = this.value.trim() || "Caption Preview";
    });

    // Sync font size slider — update label and preview
    $(document).on("input", "#overlayCaptionFontSize", function() {
      _captionFontSize = parseInt(this.value, 10);
      $("#fontSizeDisplay").text(_captionFontSize);
      const lbl = document.getElementById("overlayDragLabel");
      if (lbl) lbl.style.fontSize = _captionFontSize + "px";
    });

    // Click on image container to reposition
    $(document).on("click", "#overlayDragContainer", function(e) {
      if ($(e.target).is("#overlayDragLabel")) return; // handled by drag
      const rect = this.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width)  * 100;
      const y = ((e.clientY - rect.top)  / rect.height) * 100;
      updateDragLabel(x, y);
    });

    // Drag the label to reposition
    (function() {
      let dragging = false, startX, startY, startLeft, startTop;

      $(document).on("mousedown", "#overlayDragLabel", function(e) {
        e.preventDefault();
        dragging = true;
        startX = e.clientX; startY = e.clientY;
        startLeft = _captionX; startTop = _captionY;
      });

      $(document).on("mousemove", function(e) {
        if (!dragging) return;
        const container = document.getElementById("overlayDragContainer");
        if (!container) return;
        const rect = container.getBoundingClientRect();
        const dx = ((e.clientX - startX) / rect.width)  * 100;
        const dy = ((e.clientY - startY) / rect.height) * 100;
        updateDragLabel(startLeft + dx, startTop + dy);
      });

      $(document).on("mouseup", function() { dragging = false; });
    })();

    $(document).on("click", ".edit-overlay-btn", function() {
      const id       = this.dataset.id;
      const type     = this.dataset.type || "image";
      const filename = this.dataset.filename;
      const caption  = this.dataset.caption || "";
      const cx       = parseFloat(this.dataset.cx) || 50;
      const cy       = parseFloat(this.dataset.cy) || 85;
      const fs       = parseInt(this.dataset.fs, 10) || 24;

      $("#overlayModalMediaId").val(id);
      $("#overlayCaptionText").val(caption);
      $("#overlayCaptionFontSize").val(fs);
      $("#fontSizeDisplay").text(fs);
      _captionFontSize = fs;
      $("#overlayModalStatus").addClass("d-none").text("").removeClass("alert-success alert-danger");

      // Show correct preview type
      const imgEl   = document.getElementById("overlayModalPreview");
      const videoEl = document.getElementById("overlayVideoPreview");

      if (type === "video") {
        imgEl.style.display = "none";
        imgEl.src = "";
        videoEl.style.display = "block";
        videoEl.src = "/uploads/videos/" + encodeURIComponent(filename) + "#t=2";
        videoEl.load();
      } else {
        videoEl.style.display = "none";
        videoEl.src = "";
        imgEl.style.display = "block";
        imgEl.src = "/uploads/images/carousel/" + encodeURIComponent(filename);
