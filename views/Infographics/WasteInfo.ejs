}

.waste-info-panel .info-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.75rem;
}

.waste-info-panel .info-table th,
.waste-info-panel .info-table td {
  padding: 4px 6px;
  text-align: right;
  border-bottom: 1px solid #e5e7eb;
}

.waste-info-panel .info-table th {
  background: rgba(243,244,246,0.78);
  font-weight: 600;
  color: #374151;
}

.waste-info-panel .info-table th:first-child,
.waste-info-panel .info-table td:first-child {
