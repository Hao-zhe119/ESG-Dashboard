}

.waste-info-panel .yoy-comparison {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 5px;
}

.waste-info-panel .yoy-item {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 5px;
}

.waste-info-panel .yoy-label {
  font-size: 0.8rem;
  font-weight: 500;
  color: #374151;
}

.waste-info-panel .yoy-badge {
  padding: 2px 6px;
  border-radius: 10px;
  font-weight: 600;
  font-size: 0.75rem;
}

.waste-info-panel .yoy-badge.positive {
  background: rgba(220,252,231,0.82);
  color: #166534;
}

.waste-info-panel .yoy-badge.negative {
  background: rgba(254,226,226,0.82);
  color: #991b1b;
}

.waste-info-panel .yoy-note {
  font-size: 0.7rem;
  color: #6b7280;
}

.waste-info-panel .progress-container {
  margin: 6px 0;
}

.waste-info-panel .progress-bar {
  position: relative;
  height: 16px;
  background: rgba(229,231,235,0.72);
  border-radius: 8px;
  overflow: visible;
}

.waste-info-panel .progress-fill {
  height: 100%;
  border-radius: 8px;
  transition: width 0.5s ease;
}

.waste-info-panel .progress-fill.excellent {
  background: linear-gradient(90deg, #10b981, #34d399);
}

.waste-info-panel .progress-fill.good {
  background: linear-gradient(90deg, #22c55e, #4ade80);
}

.waste-info-panel .progress-fill.average {
  background: linear-gradient(90deg, #f59e0b, #fbbf24);
}

.waste-info-panel .progress-fill.low {
