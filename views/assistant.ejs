<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RP ESG Assistant</title>
  <style>
    :root{
      /* ── Aligned with dashboard design tokens ── */
      --bg:#0b0e12;
      --text:#e8edf3;
      --muted:#9ca3af;

      /* Brand palette (matches dashboard greens) */
      --accent:#34d399;
      --accent2:#8fd14f;
      --accentDeep:#7eae33;
      --brandGrad:linear-gradient(100deg,#8fd14f 0%, #34d399 55%, #10b981 100%);

      /* Glassmorphism (mirrors index.ejs glass tokens) */
      --glassPanel:linear-gradient(to bottom, rgba(8,12,16,0.72), rgba(20,28,38,0.55));
      --glassBot:linear-gradient(to bottom, rgba(255,255,255,0.10), rgba(255,255,255,0.04));
      --glassBorder:1px solid rgba(255,255,255,0.14);
      --glassBlur:blur(22px) saturate(160%);
      --glassShadow:0 18px 45px rgba(0,0,0,0.40), inset 0 0 18px rgba(0,0,0,0.16);
      --radius:18px;
    }
    *{ box-sizing:border-box; }
    html,body{
      margin:0; height:100%;
      color:var(--text);
      font-family:Arial, sans-serif;
      background:
        radial-gradient(circle at 12% -10%, rgba(52,211,153,0.16), transparent 55%),
        radial-gradient(circle at 100% 110%, rgba(143,209,79,0.10), transparent 50%),
        linear-gradient(160deg,#0d1117 0%, #0b0e12 100%);
    }
    body{ display:flex; flex-direction:column; height:100vh; }

    /* ── Header ── */
    header{
      flex:0 0 auto;
      display:flex; align-items:center; gap:12px;
      padding:16px 20px;
      border-bottom:var(--glassBorder);
      background:var(--glassPanel);
      -webkit-backdrop-filter:var(--glassBlur);
      backdrop-filter:var(--glassBlur);
    }
    header .dot{
      width:10px; height:10px; border-radius:50%;
      background:var(--accent);
      box-shadow:0 0 0 0 rgba(52,211,153,0.6);
      animation:pulse 2.4s ease-out infinite;
    }
    @keyframes pulse{
      0%   { box-shadow:0 0 0 0 rgba(52,211,153,0.55); }
      70%  { box-shadow:0 0 0 10px rgba(52,211,153,0); }
      100% { box-shadow:0 0 0 0 rgba(52,211,153,0); }
    }
    header h1{
      font-size:18px; margin:0; font-weight:800; letter-spacing:0.01em;
      background:var(--brandGrad);
      -webkit-background-clip:text; background-clip:text;
      -webkit-text-fill-color:transparent; color:transparent;
    }
    header .sub{ font-size:12px; color:var(--muted); margin-left:auto; }

    /* ── Messages ── */
    #messages{
      flex:1 1 auto; overflow-y:auto;
      padding:22px 20px; display:flex; flex-direction:column; gap:14px;
      max-width:900px; width:100%; margin:0 auto;
    }
    #messages::-webkit-scrollbar{ width:8px; }
    #messages::-webkit-scrollbar-thumb{
      background:rgba(255,255,255,0.12); border-radius:999px;
    }
    #messages::-webkit-scrollbar-thumb:hover{ background:rgba(52,211,153,0.4); }

    .msg{ display:flex; animation:bubbleIn 0.35s cubic-bezier(0.22,1,0.36,1) both; }
    .msg.user{ justify-content:flex-end; }
    @keyframes bubbleIn{
      from{ opacity:0; transform:translateY(10px); }
      to  { opacity:1; transform:translateY(0); }
    }
    .bubble{
      max-width:78%;
      padding:12px 16px; border-radius:16px;
      line-height:1.55; font-size:15px; white-space:pre-wrap; word-wrap:break-word;
      box-shadow:0 6px 18px rgba(0,0,0,0.25);
    }
    .msg.user .bubble{
      background:var(--brandGrad); color:#06210f; font-weight:600;
      border-bottom-right-radius:5px;
    }
    .msg.bot .bubble{
      background:var(--glassBot);
      -webkit-backdrop-filter:var(--glassBlur);
      backdrop-filter:var(--glassBlur);
      border:var(--glassBorder);
      color:var(--text); border-bottom-left-radius:5px;
    }
    .bubble.thinking{ color:var(--muted); font-style:italic; }

    /* ── Welcome hint + suggestion chips ── */
    .hint{ text-align:center; color:var(--muted); font-size:14px; margin:auto; max-width:540px; }
    .hint b{
      background:var(--brandGrad);
      -webkit-background-clip:text; background-clip:text;
      -webkit-text-fill-color:transparent; color:transparent;
      font-weight:800;
    }
    .chips{ display:flex; flex-wrap:wrap; gap:10px; justify-content:center; margin-top:18px; }
    .chip{
      background:var(--glassBot);
      -webkit-backdrop-filter:var(--glassBlur);
      backdrop-filter:var(--glassBlur);
      border:var(--glassBorder);
      color:var(--text); padding:9px 14px; border-radius:999px; font-size:13px; cursor:pointer;
      transition:transform 0.15s ease, border-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
    }
    .chip:hover{
      border-color:var(--accent); color:var(--accent);
      transform:translateY(-2px);
      box-shadow:0 6px 16px rgba(52,211,153,0.18);
    }

    /* ── Footer / input ── */
    footer{
      flex:0 0 auto;
      border-top:var(--glassBorder);
      background:var(--glassPanel);
      -webkit-backdrop-filter:var(--glassBlur);
      backdrop-filter:var(--glassBlur);
      padding:14px 20px;
    }
    .inputRow{
      display:flex; gap:10px; max-width:900px; margin:0 auto; align-items:flex-end;
    }
    #input{
      flex:1 1 auto; resize:none;
      background:rgba(8,12,16,0.6); color:var(--text);
      border:var(--glassBorder); border-radius:14px;
      padding:13px 16px; font-size:15px; font-family:inherit; line-height:1.4;
      max-height:140px; min-height:50px;
      transition:border-color 0.15s ease, box-shadow 0.15s ease;
    }
    #input::placeholder{ color:rgba(156,163,175,0.8); }
    #input:focus{
      outline:none; border-color:var(--accent);
      box-shadow:0 0 0 3px rgba(52,211,153,0.18);
    }
    #send{
      flex:0 0 auto;
      background:var(--brandGrad); color:#06210f; font-weight:800;
      border:none; border-radius:14px; padding:0 24px; height:50px;
      font-size:15px; cursor:pointer; letter-spacing:0.02em;
      box-shadow:0 8px 20px rgba(52,211,153,0.25);
      transition:transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
    }
    #send:hover:not(:disabled){
      transform:translateY(-2px);
      box-shadow:0 12px 26px rgba(52,211,153,0.35);
    }
    #send:disabled{ opacity:0.45; cursor:not-allowed; box-shadow:none; }
    .modelTag{ text-align:center; color:var(--muted); font-size:11px; margin-top:10px; }
  </style>
</head>
<body>
  <header>
    <span class="dot"></span>
    <h1>RP ESG Assistant</h1>
    <span class="sub">Runs locally &middot; <%= model %></span>
  </header>

  <div id="messages">
    <div class="hint" id="welcome">
      Ask me anything about <b>RP's sustainability</b> &mdash; ESG, electricity, water, solar, or waste.
      <div class="chips">
        <span class="chip">What is ESG?</span>
        <span class="chip">Why does saving electricity matter?</span>
        <span class="chip">What is solar energy?</span>
        <span class="chip">Give me 3 simple ways to reduce waste</span>
      </div>
    </div>
  </div>

  <footer>
    <div class="inputRow">
      <textarea id="input" placeholder="Type your question and press Enter..." rows="1"></textarea>
      <button id="send">Send</button>
    </div>
    <div class="modelTag">Your conversation stays on this machine. Nothing is sent to the internet.</div>
  </footer>

  <script>
    const messagesEl = document.getElementById("messages");
    const welcomeEl  = document.getElementById("welcome");
    const inputEl    = document.getElementById("input");
    const sendBtn    = document.getElementById("send");

    // Full conversation we send to the server each turn
    const history = [];
    let busy = false;

    function addBubble(role, text){
      const wrap = document.createElement("div");
      wrap.className = "msg " + (role === "user" ? "user" : "bot");
      const bubble = document.createElement("div");
      bubble.className = "bubble";
      bubble.textContent = text;
      wrap.appendChild(bubble);
      messagesEl.appendChild(wrap);
      messagesEl.scrollTop = messagesEl.scrollHeight;
      return bubble;
    }

    function autoGrow(){
      inputEl.style.height = "auto";
      inputEl.style.height = Math.min(inputEl.scrollHeight, 140) + "px";
    }
    inputEl.addEventListener("input", autoGrow);

    async function send(){
      const text = inputEl.value.trim();
      if (!text || busy) return;

      if (welcomeEl) welcomeEl.remove();
      busy = true;
      sendBtn.disabled = true;
      inputEl.value = "";
      autoGrow();

      addBubble("user", text);
      history.push({ role: "user", content: text });

      const botBubble = addBubble("bot", "Thinking...");
      botBubble.classList.add("thinking");
      let answer = "";

      try {
        const resp = await fetch("/api/chat", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ messages: history })
        });

        if (!resp.ok || !resp.body){
          const err = await resp.json().catch(() => ({}));
          botBubble.classList.remove("thinking");
          botBubble.textContent = err.error || "Sorry, the assistant is unavailable right now.";
          throw new Error("bad response");
        }

        const reader = resp.body.getReader();
        const decoder = new TextDecoder();
        while (true){
          const { value, done } = await reader.read();
          if (done) break;
          answer += decoder.decode(value, { stream: true });
          botBubble.classList.remove("thinking");
          botBubble.textContent = answer;
          messagesEl.scrollTop = messagesEl.scrollHeight;
        }

        if (answer.trim()){
          history.push({ role: "assistant", content: answer });
        } else {
          botBubble.textContent = "(no response)";
        }
      } catch (e){
        if (botBubble.classList.contains("thinking")){
          botBubble.classList.remove("thinking");
          botBubble.textContent = "Sorry, I couldn't reach the assistant. Make sure Ollama is running.";
        }
      } finally {
        busy = false;
        sendBtn.disabled = false;
        inputEl.focus();
      }
    }

    sendBtn.addEventListener("click", send);
    inputEl.addEventListener("keydown", e => {
      if (e.key === "Enter" && !e.shiftKey){ e.preventDefault(); send(); }
    });

    // Suggestion chips fill the box and send
    messagesEl.addEventListener("click", e => {
      if (e.target.classList.contains("chip")){
        inputEl.value = e.target.textContent;
        send();
      }
    });

    inputEl.focus();
  </script>
</body>
</html>
