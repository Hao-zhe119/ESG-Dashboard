<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RP ESG Assistant</title>
  <style>
    :root{
      --bg:#0f1318;
      --panel:#161b22;
      --panelBorder:rgba(255,255,255,0.10);
      --text:#e5e7eb;
      --muted:#9ca3af;
      --accent:#60a5fa;
      --userBubble:#2563eb;
      --botBubble:#1f2937;
    }
    *{ box-sizing:border-box; }
    html,body{
      margin:0; height:100%;
      background:var(--bg); color:var(--text);
      font-family:Arial, sans-serif;
    }
    body{ display:flex; flex-direction:column; height:100vh; }

    header{
      flex:0 0 auto;
      display:flex; align-items:center; gap:12px;
      padding:16px 20px;
      border-bottom:1px solid var(--panelBorder);
      background:var(--panel);
    }
    header .dot{
      width:10px; height:10px; border-radius:50%;
      background:#34d399; box-shadow:0 0 8px #34d399;
    }
    header h1{ font-size:18px; margin:0; font-weight:700; }
    header .sub{ font-size:12px; color:var(--muted); margin-left:auto; }

    #messages{
      flex:1 1 auto; overflow-y:auto;
      padding:20px; display:flex; flex-direction:column; gap:14px;
      max-width:900px; width:100%; margin:0 auto;
    }
    .msg{ display:flex; }
    .msg.user{ justify-content:flex-end; }
    .bubble{
      max-width:78%;
      padding:12px 16px; border-radius:14px;
      line-height:1.5; font-size:15px; white-space:pre-wrap; word-wrap:break-word;
    }
    .msg.user .bubble{ background:var(--userBubble); color:#fff; border-bottom-right-radius:4px; }
    .msg.bot  .bubble{ background:var(--botBubble); color:var(--text); border-bottom-left-radius:4px; }
    .bubble.thinking{ color:var(--muted); font-style:italic; }

    .hint{ text-align:center; color:var(--muted); font-size:14px; margin:auto; max-width:520px; }
    .hint b{ color:var(--text); }
    .chips{ display:flex; flex-wrap:wrap; gap:8px; justify-content:center; margin-top:14px; }
    .chip{
      background:rgba(255,255,255,0.06); border:1px solid var(--panelBorder);
      color:var(--text); padding:8px 12px; border-radius:999px; font-size:13px; cursor:pointer;
    }
    .chip:hover{ border-color:var(--accent); color:var(--accent); }

    footer{
      flex:0 0 auto;
      border-top:1px solid var(--panelBorder); background:var(--panel);
      padding:14px 20px;
    }
    .inputRow{
      display:flex; gap:10px; max-width:900px; margin:0 auto; align-items:flex-end;
    }
    #input{
      flex:1 1 auto; resize:none;
      background:#0b0e12; color:var(--text);
      border:1px solid var(--panelBorder); border-radius:12px;
      padding:12px 14px; font-size:15px; font-family:inherit; line-height:1.4;
      max-height:140px; min-height:48px;
    }
    #input:focus{ outline:none; border-color:var(--accent); }
    #send{
      flex:0 0 auto;
      background:var(--accent); color:#06121f; font-weight:700;
      border:none; border-radius:12px; padding:0 22px; height:48px;
      font-size:15px; cursor:pointer;
    }
    #send:disabled{ opacity:0.5; cursor:not-allowed; }
    .modelTag{ text-align:center; color:var(--muted); font-size:11px; margin-top:8px; }
  </style>
</head>
<body>
  <header>
    <span class="dot"></span>
    <h1>RP ESG Assistant</h1>
    <span class="sub">Runs locally &middot; <%= model %></span>
  </header>

  <div id="messages">
    <div class="hint" id="welcome">
      Ask me anything about <b>RP's sustainability</b> &mdash; ESG, electricity, water, solar, or waste.
      <div class="chips">
        <span class="chip">What is ESG?</span>
        <span class="chip">Why does saving electricity matter?</span>
        <span class="chip">What is solar energy?</span>
        <span class="chip">Give me 3 simple ways to reduce waste</span>
      </div>
    </div>
  </div>

  <footer>
    <div class="inputRow">
      <textarea id="input" placeholder="Type your question and press Enter..." rows="1"></textarea>
      <button id="send">Send</button>
    </div>
    <div class="modelTag">Your conversation stays on this machine. Nothing is sent to the internet.</div>
  </footer>

  <script>
    const messagesEl = document.getElementById("messages");
    const welcomeEl  = document.getElementById("welcome");
    const inputEl    = document.getElementById("input");
    const sendBtn    = document.getElementById("send");

    // Full conversation we send to the server each turn
    const history = [];
    let busy = false;

    function addBubble(role, text){
      const wrap = document.createElement("div");
      wrap.className = "msg " + (role === "user" ? "user" : "bot");
      const bubble = document.createElement("div");
      bubble.className = "bubble";
      bubble.textContent = text;
      wrap.appendChild(bubble);
      messagesEl.appendChild(wrap);
      messagesEl.scrollTop = messagesEl.scrollHeight;
      return bubble;
    }

    function autoGrow(){
      inputEl.style.height = "auto";
      inputEl.style.height = Math.min(inputEl.scrollHeight, 140) + "px";
    }
    inputEl.addEventListener("input", autoGrow);

    async function send(){
      const text = inputEl.value.trim();
      if (!text || busy) return;

      if (welcomeEl) welcomeEl.remove();
      busy = true;
      sendBtn.disabled = true;
      inputEl.value = "";
      autoGrow();

      addBubble("user", text);
      history.push({ role: "user", content: text });

      const botBubble = addBubble("bot", "Thinking...");
      botBubble.classList.add("thinking");
      let answer = "";

      try {
        const resp = await fetch("/api/chat", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ messages: history })
        });

        if (!resp.ok || !resp.body){
          const err = await resp.json().catch(() => ({}));
          botBubble.classList.remove("thinking");
          botBubble.textContent = err.error || "Sorry, the assistant is unavailable right now.";
          throw new Error("bad response");
        }

        const reader = resp.body.getReader();
        const decoder = new TextDecoder();
        while (true){
          const { value, done } = await reader.read();
          if (done) break;
          answer += decoder.decode(value, { stream: true });
          botBubble.classList.remove("thinking");
          botBubble.textContent = answer;
          messagesEl.scrollTop = messagesEl.scrollHeight;
        }

        if (answer.trim()){
          history.push({ role: "assistant", content: answer });
        } else {
          botBubble.textContent = "(no response)";
        }
      } catch (e){
        if (botBubble.classList.contains("thinking")){
          botBubble.classList.remove("thinking");
          botBubble.textContent = "Sorry, I couldn't reach the assistant. Make sure Ollama is running.";
        }
      } finally {
        busy = false;
        sendBtn.disabled = false;
        inputEl.focus();
      }
    }

    sendBtn.addEventListener("click", send);
    inputEl.addEventListener("keydown", e => {
      if (e.key === "Enter" && !e.shiftKey){ e.preventDefault(); send(); }
    });

    // Suggestion chips fill the box and send
    messagesEl.addEventListener("click", e => {
      if (e.target.classList.contains("chip")){
        inputEl.value = e.target.textContent;
        send();
      }
    });

    inputEl.focus();
  </script>
</body>
</html>
