<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RP Campus Interactive Map</title>
  <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.4.0/model-viewer.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Inter:wght@300;400;500&display=swap');
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* :root {
      --green:        #00c896;
      --green-dim:    #00c89640;
      --dark:         #050d0a;
      --panel:        #0a1a14cc;
      --panel-solid:  #0a1a14;
      --panel-border: #1a3a2a;
      --text:         #c8ffe8;
      --text-dim:     #6a9980;
      --accent:       #00ffb3;
      --e-color:      #22c55e;
      --w-color:      #a855f7;
      --other-color:  #ffb347;
    } */

    :root {
      --green:        #00c896;
      --green-dim:    #00c89640;
      --dark:         #050d0a;
      --panel:        #0a1a14cc;
      --panel-solid:  #0a1a14;
      --panel-border: #1a3a2a;
      --text:         #c8ffe8;
      --text-dim:     #6a9980;
      --accent:       #00ffb3;
      --e-color:      #22c55e;
      --w-color:      #a855f7;
      --other-color:  #ffb347;

      /* ── Map backdrop (driven by the Background picker) ── */
      --bgBase:  #050d0a;                                   /* solid fill colour   */
      --bgGlow:  rgba(0, 200, 150, 0.16);                   /* centre glow colour  */
      --bgImage: none;                                      /* optional PNG/JPG    */
      --bgFit:   cover;                                     /* cover | contain     */
      --bgOpacity: 1;                                       /* image opacity       */
    }


    html, body { height: 100%; background: var(--dark); color: var(--text); font-family: 'Inter', sans-serif; overflow: hidden; position: relative; }

    /* Z-index layering — model is background, all UI floats above */
    .loading-overlay { z-index: 9999; }
    .map-header, .legend, .controls-hint, .zoom-controls, .cycle-bar { z-index: 100; }
    .info-panel, .cycle-panel { z-index: 200; }

    /* ── LOADING ── */
    .loading-overlay {
      position: fixed; inset: 0; background: var(--dark);
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px;
      z-index: 9999; transition: opacity 0.8s ease;
    }
    .loading-overlay.hidden { opacity: 0; pointer-events: none; }
    .loading-logo { font-family: 'Rajdhani', sans-serif; font-size: 2rem; font-weight: 700; letter-spacing: 0.2em; color: var(--accent); }
    .loading-sub { font-size: 0.78rem; color: var(--text-dim); letter-spacing: 0.1em; text-transform: uppercase; }
    .loading-bar { width: 220px; height: 2px; background: var(--panel-border); border-radius: 2px; overflow: hidden; }
    .loading-bar-fill { height: 100%; background: linear-gradient(90deg, var(--green), var(--accent)); width: 0%; transition: width 0.3s; }

    /* ── HEADER ── */
    .map-header {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 24px;
      background: linear-gradient(180deg, rgba(5,13,10,0.97) 0%, transparent 100%);
    }
    .header-left h1 {
      font-family: 'Rajdhani', sans-serif; font-size: 1.35rem; font-weight: 700;
      letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent);
    }
    .header-left p { font-size: 0.72rem; color: var(--text-dim); letter-spacing: 0.05em; margin-top: 1px; }

    /* ── AUTO-CYCLE PROGRESS BAR ── */
    .cycle-bar {
      position: fixed; bottom: 0; left: 0; right: 0; height: 3px;
      background: rgba(255,255,255,0.06); z-index: 300;
    }
    .cycle-bar-fill {
      height: 100%; width: 0%;
      background: linear-gradient(90deg, var(--green), var(--accent));
      transition: width 0.2s linear;
    }

    /* ── BACK BUTTON ── */
    .back-btn {
      display: flex; align-items: center; gap: 8px; padding: 8px 16px;
      border: 1px solid var(--panel-border); border-radius: 6px;
      background: var(--panel); color: var(--text-dim);
      font-family: 'Rajdhani', sans-serif; font-size: 0.85rem; font-weight: 600;
      letter-spacing: 0.08em; text-decoration: none; transition: all 0.2s;
    }
    .back-btn:hover { border-color: var(--green); color: var(--accent); }

    /* ── MODEL VIEWER ── */
    model-viewer {
      position: fixed;
      top: 0; left: 0;
      width: 100vw; height: 100vh;
      background: transparent;
      --progress-bar-color: transparent;
      --progress-mask: transparent;
      z-index: 0;
    }

    /* Force model to always render centred inside the viewer */
    model-viewer::part(default-ar-button) { display: none; }


    /* ── HOTSPOT BASE ── */
    .hotspot { display: block; position: relative; cursor: pointer; text-decoration: none; }

    /* Pulse rings — 3 rings for drama */
    .hotspot::before, .hotspot::after {
      content: ''; position: absolute; top: 50%; left: 50%;
      border-radius: 50%; pointer-events: none;
    }
    .hotspot::before {
      width: 32px; height: 32px;
      border: 1.5px solid currentColor;
      animation: pulse-ring 2s ease-out infinite;
    }
    .hotspot::after {
      width: 20px; height: 20px;
      border: 1px solid currentColor;
      animation: pulse-ring 2s ease-out infinite 0.6s;
      opacity: 0.6;
    }

    /* Inner dot */
    .hotspot-dot {
      width: 18px; height: 18px; border-radius: 50%;
      background: currentColor;
      border: 2px solid #ffffff;
      box-shadow: 0 0 12px currentColor, 0 0 28px currentColor, 0 0 4px #000;
      transition: transform 0.25s, box-shadow 0.25s;
      position: relative; z-index: 2;
    }
    
    .hotspot:hover .hotspot-dot, .hotspot.active .hotspot-dot {
      transform: scale(1.6);
      box-shadow: 0 0 20px currentColor, 0 0 40px currentColor;
    }

    /* Active hotspot ring */
    .hotspot.active::before {
      animation: pulse-ring-active 1.2s ease-out infinite;
      border-width: 2px;
    }

    /* Color categories */
    .hotspot.e-block  { color: var(--e-color); }
    .hotspot.w-block  { color: var(--w-color); }
    .hotspot.other    { color: var(--other-color); }

    /* Label */
    .hotspot-label {
      position: absolute; left: 50%; bottom: calc(100% + 12px);
      transform: translateX(-50%) translateY(6px);
      white-space: nowrap; background: var(--panel-solid);
      border: 1px solid var(--panel-border); border-radius: 4px;
      padding: 4px 10px;
      font-family: 'Rajdhani', sans-serif; font-size: 0.78rem; font-weight: 600;
      letter-spacing: 0.08em; color: currentColor;
      opacity: 0; pointer-events: none;
      transition: opacity 0.2s, transform 0.2s;
    }
    .hotspot-label::after {
      content: ''; position: absolute; top: 100%; left: 50%;
      transform: translateX(-50%);
      border: 5px solid transparent; border-top-color: var(--panel-border);
    }
    .hotspot:hover .hotspot-label, .hotspot.active .hotspot-label {
      opacity: 1; transform: translateX(-50%) translateY(0);
    }

    @keyframes pulse-ring {
      0%   { transform: translate(-50%,-50%) scale(0.7); opacity: 0.9; }
      100% { transform: translate(-50%,-50%) scale(2.6); opacity: 0; }
    }
    @keyframes pulse-ring-active {
      0%   { transform: translate(-50%,-50%) scale(0.8); opacity: 1; }
      100% { transform: translate(-50%,-50%) scale(2.8); opacity: 0; }
    }

    /* ── INFO PANEL ── */
    .info-panel {
      position: fixed; bottom: 24px; right: 24px; width: 280px;
      background: var(--panel-solid); border: 1px solid var(--panel-border);
      border-radius: 12px; padding: 0; z-index: 200;
      opacity: 0; transform: translateY(16px) scale(0.97);
      transition: opacity 0.3s, transform 0.3s;
      pointer-events: none; overflow: hidden;
    }
    .info-panel.visible { opacity: 1; transform: translateY(0) scale(1); pointer-events: all; }

    .info-panel-header {
      padding: 14px 16px 10px;
      border-bottom: 1px solid var(--panel-border);
      display: flex; align-items: center; justify-content: space-between;
    }
    .info-panel-category {
      font-size: 0.65rem; font-weight: 600; letter-spacing: 0.1em;
      text-transform: uppercase; margin-bottom: 3px;
    }
    .info-panel-title {
      font-family: 'Rajdhani', sans-serif; font-size: 1.2rem; font-weight: 700;
      letter-spacing: 0.06em; color: var(--accent);
    }
    .info-panel-close {
      width: 28px; height: 28px; border-radius: 50%;
      background: rgba(255,255,255,0.05); border: 1px solid var(--panel-border);
      color: var(--text-dim); cursor: pointer; font-size: 0.9rem;
      display: flex; align-items: center; justify-content: center;
      transition: all 0.2s; flex-shrink: 0;
    }
    .info-panel-close:hover { background: rgba(255,100,100,0.15); color: #ff6b6b; border-color: #ff6b6b; }

    .info-panel-body { padding: 12px 16px; }
    .info-panel-loading { text-align: center; color: var(--text-dim); font-size: 0.78rem; padding: 16px 0; }

    .info-metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px; }
    .metric-card {
      background: rgba(255,255,255,0.04); border: 1px solid var(--panel-border);
      border-radius: 8px; padding: 8px 10px;
    }
    .metric-card-label { font-size: 0.65rem; color: var(--text-dim); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 3px; }
    .metric-card-value { font-family: 'Rajdhani', sans-serif; font-size: 1rem; font-weight: 700; color: var(--text); }

    .info-panel-actions { display: flex; gap: 8px; }
    .info-btn {
      flex: 1; padding: 9px 8px; border-radius: 7px;
      font-family: 'Rajdhani', sans-serif; font-size: 0.85rem; font-weight: 600;
      letter-spacing: 0.06em; text-align: center; text-decoration: none;
      transition: all 0.2s; cursor: pointer; border: none;
    }
    .info-btn-primary { background: var(--green); color: var(--dark); }
    .info-btn-primary:hover { background: var(--accent); }
    .info-btn-secondary { background: transparent; border: 1px solid var(--panel-border); color: var(--text-dim); }
    .info-btn-secondary:hover { border-color: var(--green); color: var(--text); }

    /* ── AUTO-CYCLE PANEL ── */
    .cycle-panel {
      position: fixed; bottom: 24px; left: 24px; z-index: 200;
      background: var(--panel-solid); border: 1px solid var(--panel-border);
      border-radius: 10px; padding: 10px 14px;
      display: flex; flex-direction: column; gap: 6px; min-width: 180px;
    }
    .cycle-label {
      font-size: 0.65rem; color: var(--text-dim); letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .cycle-building {
      font-family: 'Rajdhani', sans-serif; font-size: 1rem; font-weight: 700; color: var(--accent);
    }
    .cycle-controls { display: flex; gap: 6px; align-items: center; }
    .cycle-btn {
      width: 28px; height: 28px; border-radius: 6px;
      background: rgba(255,255,255,0.06); border: 1px solid var(--panel-border);
      color: var(--text-dim); cursor: pointer; font-size: 0.8rem;
      display: flex; align-items: center; justify-content: center; transition: all 0.2s;
    }
    .cycle-btn:hover { background: rgba(0,200,150,0.15); border-color: var(--green); color: var(--accent); }
    .cycle-btn.active-play { background: rgba(0,200,150,0.2); border-color: var(--green); color: var(--accent); }
    .cycle-counter { font-size: 0.7rem; color: var(--text-dim); margin-left: auto; }

    /* ── ZOOM CONTROLS ── */
    .zoom-controls {
      position: fixed; right: 24px; top: 50%; transform: translateY(-50%);
      z-index: 200; display: flex; flex-direction: column; gap: 6px;
    }
    .zoom-btn {
      width: 36px; height: 36px; border-radius: 8px;
      background: var(--panel); border: 1px solid var(--panel-border);
      color: var(--text-dim); cursor: pointer; font-size: 1.1rem;
      display: flex; align-items: center; justify-content: center; transition: all 0.2s;
    }
    .zoom-btn:hover { background: rgba(0,200,150,0.15); border-color: var(--green); color: var(--accent); }
    .zoom-divider { height: 1px; background: var(--panel-border); margin: 2px 0; }
    

    /* ── LEGEND ── */
    .legend {
      position: fixed; top: 70px; left: 24px; z-index: 100;
      display: flex; flex-direction: column; gap: 5px;
    }
    .legend-item { display: flex; align-items: center; gap: 7px; font-size: 0.68rem; color: var(--text-dim); }
    .legend-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }

    /* ── CONTROLS HINT ── */
    .controls-hint {
      position: fixed; top: 72px; left: 50%; transform: translateX(-50%);
      display: flex; gap: 16px; z-index: 100; animation: fadeout 0.8s ease 5s forwards;
    }
    .hint-item {
      font-size: 0.7rem; color: var(--text-dim);
      background: rgba(10,26,20,0.85); border: 1px solid var(--panel-border);
      border-radius: 20px; padding: 5px 12px; white-space: nowrap;
    }
    @keyframes fadeout { to { opacity: 0; pointer-events: none; } }

    /* ── FLY-IN ANIMATION ── */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .map-header, .legend, .zoom-controls {
      animation: fadeInUp 0.8s ease both;
    }
    .legend { animation-delay: 0.3s; }
    .zoom-controls { animation-delay: 0.4s; }

    /* ── EMBEDDED MODES (inside control panel / big-screen iframe) ── */
    /* embed: hide the "back to dashboard" link (navigation handled by host) */
    body.embed .back-btn { display: none !important; }
    /* mirror: audience view on the big screen — no operator chrome, not clickable */
    body.mirror .map-header,
    body.mirror .zoom-controls,
    body.mirror .cycle-panel,
    body.mirror .cycle-bar,
    body.mirror .controls-hint,
    body.mirror .info-panel { display: none !important; }
    body.mirror .hotspot { pointer-events: none; }

    /* ============================================================
       MAP BACKDROP  (colour + optional image)  — sits behind everything
    ============================================================ */
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background:
        radial-gradient(ellipse 70% 60% at 50% 48%,
          var(--bgGlow) 0%,
          color-mix(in srgb, var(--bgGlow) 40%, transparent) 35%,
          transparent 70%),
        var(--bgBase);
    }

    /* Image layer — separate so opacity can be tuned without killing the glow */
    #bgImageLayer {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background-image: var(--bgImage);
      background-size: var(--bgFit);
      background-position: center;
      background-repeat: no-repeat;
      opacity: var(--bgOpacity);
      transition: opacity .25s ease;
    }

    /* ============================================================
       BACKGROUND PICKER
    ============================================================ */
/* ── BACKGROUND PICKER BUTTON ── */
    .bg-btn {
      position: fixed; top: 84px; right: 20px; z-index: 400;
      display: flex; align-items: center; gap: 8px;
      height: 40px; padding: 0 16px 0 12px;
      border-radius: 999px;
      background: linear-gradient(135deg, rgba(0,200,150,.18), rgba(0,255,179,.06));
      border: 1px solid var(--green);
      color: var(--accent);
      font-family: 'Rajdhani', sans-serif;
      font-size: .82rem; font-weight: 700;
      letter-spacing: .08em; text-transform: uppercase;
      cursor: pointer; white-space: nowrap;
      box-shadow: 0 0 0 0 rgba(0,200,150,.45);
      animation: bgBtnPulse 2.6s ease-out infinite;
      transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
    }

    .bg-btn:hover {
      transform: translateY(-2px);
      background: linear-gradient(135deg, rgba(0,200,150,.32), rgba(0,255,179,.14));
      box-shadow: 0 6px 20px rgba(0,200,150,.4);
      animation: none;
    }
    .bg-btn:active { transform: translateY(0); }

    /* Colour-wheel swatch — reads instantly as "colour" */
    .bg-btn::before {
      content: "";
      width: 18px; height: 18px; border-radius: 50%;
      flex-shrink: 0;
      background: conic-gradient(
        #ff4d4d, #ffb347, #ffe74d, #4dff88,
        #4dd2ff, #4d6bff, #b84dff, #ff4dbf, #ff4d4d
      );
      border: 2px solid rgba(255,255,255,.9);
      box-shadow: 0 0 8px rgba(255,255,255,.35);
    }

    @keyframes bgBtnPulse {
      0%   { box-shadow: 0 0 0 0 rgba(0,200,150,.45); }
      70%  { box-shadow: 0 0 0 10px rgba(0,200,150,0); }
      100% { box-shadow: 0 0 0 0 rgba(0,200,150,0); }
    }

    .bg-panel {
      position: fixed; top: 132px; right: 20px; z-index: 401;
      width: 260px; padding: 14px;
      background: var(--panel-solid); border: 1px solid var(--panel-border);
      border-radius: 12px; box-shadow: 0 12px 32px rgba(0,0,0,.5);
      display: none; font-family: 'Inter', sans-serif;
    }
    .bg-panel.open { display: block; }

    .bg-panel h4 {
      font-family: 'Rajdhani', sans-serif; font-size: .95rem; font-weight: 700;
      color: var(--accent); margin-bottom: 10px; letter-spacing: .04em;
    }
    .bg-section-label {
      font-size: .68rem; text-transform: uppercase; letter-spacing: .08em;
      color: var(--text-dim); margin: 12px 0 6px;
    }
    .bg-section-label:first-of-type { margin-top: 0; }

    .bg-swatches { display: grid; grid-template-columns: repeat(6, 1fr); gap: 7px; }
    .bg-swatch {
      aspect-ratio: 1; border-radius: 7px; cursor: pointer;
      border: 2px solid transparent; transition: transform .12s ease, border-color .12s ease;
    }
    .bg-swatch:hover  { transform: scale(1.12); }
    .bg-swatch.active { border-color: #fff; box-shadow: 0 0 0 2px rgba(255,255,255,.25); }

    .bg-row { display: flex; align-items: center; gap: 8px; }
    .bg-row input[type="color"] {
      width: 38px; height: 30px; padding: 0; border: 1px solid var(--panel-border);
      border-radius: 6px; background: transparent; cursor: pointer;
    }
    .bg-row input[type="range"] { flex: 1; accent-color: var(--green); }
    .bg-row .bg-val { font-size: .7rem; color: var(--text-dim); min-width: 32px; text-align: right; }

    .bg-file-btn {
      display: block; width: 100%; text-align: center;
      padding: 8px; border-radius: 7px; cursor: pointer;
      background: rgba(255,255,255,.05); border: 1px dashed var(--panel-border);
      color: var(--text-dim); font-size: .75rem; transition: all .15s ease;
    }
    .bg-file-btn:hover { border-color: var(--green); color: var(--accent); }

    .bg-actions { display: flex; gap: 7px; margin-top: 12px; }
    .bg-actions button {
      flex: 1; padding: 7px; border-radius: 7px; cursor: pointer;
      font-size: .72rem; font-family: 'Inter', sans-serif;
      background: rgba(255,255,255,.05); border: 1px solid var(--panel-border);
      color: var(--text-dim); transition: all .15s ease;
    }
    .bg-actions button:hover { border-color: var(--green); color: var(--accent); }
  </style>
</head>

<body>
  <!-- Backdrop image layer (colour glow is on body::before) -->
  <div id="bgImageLayer"></div>

  <!-- Background picker -->
  <button class="bg-btn" id="bgToggle" title="Change background">Theme</button>

  <div class="bg-panel" id="bgPanel">
    <h4>Map Background</h4>

    <div class="bg-section-label">Presets</div>
    <div class="bg-swatches" id="bgSwatches"></div>

    <div class="bg-section-label">Custom colour</div>
    <div class="bg-row">
      <input type="color" id="bgColorPick" value="#050d0a" title="Base colour" />
      <input type="color" id="bgGlowPick"  value="#00c896" title="Glow colour" />
      <span class="bg-val">base / glow</span>
    </div>

    <div class="bg-section-label">Image</div>
    <label class="bg-file-btn" for="bgFile">Upload PNG / JPG</label>
    <input type="file" id="bgFile" accept="image/*" hidden />

    <div class="bg-row" style="margin-top:8px;">
      <span class="bg-val" style="text-align:left;">Fit</span>
      <select id="bgFit" style="flex:1;background:rgba(255,255,255,.05);border:1px solid var(--panel-border);color:var(--text-dim);border-radius:6px;padding:4px;font-size:.72rem;">
        <option value="cover">Cover</option>
        <option value="contain">Contain</option>
      </select>
    </div>

    <div class="bg-row" style="margin-top:8px;">
      <span class="bg-val" style="text-align:left;">Fade</span>
      <input type="range" id="bgOpacity" min="0" max="100" value="100" />
      <span class="bg-val" id="bgOpacityVal">100%</span>
    </div>

    <div class="bg-actions">
      <button id="bgClearImg" type="button">Remove image</button>
      <button id="bgReset"    type="button">Reset</button>
    </div>
  </div>

  <!-- Loading -->
  <div class="loading-overlay" id="loadingOverlay">
    <div class="loading-logo">RP CAMPUS MAP</div>
    <div class="loading-sub">Loading 3D Model...</div>
    <div class="loading-bar"><div class="loading-bar-fill" id="loadingFill"></div></div>
  </div>

  <!-- Header -->
  <header class="map-header">
    <div class="header-left">
      <h1>RP Campus Interactive Map</h1>
      <p>Click a building to view sustainability data</p>
    </div>
    <a href="/" class="back-btn">← Dashboard</a>
  </header>

  <!-- Legend -->
  <div class="legend">
    <div class="legend-item"><div class="legend-dot" style="background:var(--e-color);box-shadow:0 0 6px var(--e-color)"></div> E Block</div>
    <div class="legend-item"><div class="legend-dot" style="background:var(--w-color);box-shadow:0 0 6px var(--w-color)"></div> W Block</div>
    <div class="legend-item"><div class="legend-dot" style="background:var(--other-color);box-shadow:0 0 6px var(--other-color)"></div> Other Buildings</div>
  </div>

  <!-- Controls hint -->
  <div class="controls-hint">
    <div class="hint-item">🖱 Drag to rotate</div>
    <div class="hint-item">🔍 Scroll to zoom</div>
    <div class="hint-item">📍 Click dot to select</div>
  </div>

  <!-- Zoom Controls -->
  <div class="zoom-controls">
    <button class="zoom-btn" id="zoomIn" title="Zoom In">+</button>
