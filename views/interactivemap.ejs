    <div class="cycle-building" id="cycleBuildingName">—</div>
    <div class="cycle-controls">
      <button class="cycle-btn" id="cyclePrev" title="Previous">‹</button>
      <button class="cycle-btn active-play" id="cyclePlayPause" title="Pause">⏸</button>
      <button class="cycle-btn" id="cycleNext" title="Next">›</button>
      <span class="cycle-counter" id="cycleCounter">1 / 22</span>
    </div>
  </div>

  <!-- Progress Bar -->
  <div class="cycle-bar"><div class="cycle-bar-fill" id="cycleBarFill"></div></div>

  <script>
    // ── EMBED / MIRROR MODE ─────────────────────────────────────────────
    // /interactivemap?embed=1                → interactive copy (control panel)
    // /interactivemap?embed=1&mode=mirror    → audience copy (big screen)
    const MAP_PARAMS = new URLSearchParams(location.search);
    const MAP_EMBED  = MAP_PARAMS.get('embed') === '1';
    const MAP_MIRROR = (MAP_PARAMS.get('mode') || 'interactive') === 'mirror';
    if (MAP_EMBED)  document.body.classList.add('embed');
    if (MAP_MIRROR) document.body.classList.add('mirror');

    // Tell the hosting window (control panel) which building the guest picked.
    function mapPostToParent(payload){
      try {
        if (MAP_EMBED && window.parent && window.parent !== window){
          window.parent.postMessage(payload, window.location.origin);
        }
      } catch (_e) {}
    }

    const viewer   = document.getElementById('campusViewer');
    const overlay  = document.getElementById('loadingOverlay');
    const loadFill = document.getElementById('loadingFill');
    const infoPanel    = document.getElementById('infoPanel');
    const panelTitle   = document.getElementById('panelTitle');
    const panelCategory= document.getElementById('panelCategory');
    const panelMetrics = document.getElementById('panelMetrics');
    const panelViewBtn = document.getElementById('panelViewBtn');
    const cycleBarFill = document.getElementById('cycleBarFill');
    const cycleNameEl  = document.getElementById('cycleBuildingName');
    const cycleCounter = document.getElementById('cycleCounter');
    const playPauseBtn = document.getElementById('cyclePlayPause');

    // ── HOME VIEW ──
    // 180deg = rotated to face the front entrance of the campus
    // 55deg  = comfortable top-down tilt
    // 90%    = fills the screen nicely
    // If the front is still wrong, try 0deg, 90deg, or 270deg for the first value
    const HOME_ORBIT  = '0deg 55deg 90%';
    const HOME_TARGET = '0m 0m 0m';

    // ── BUILDING DATA ──
    const buildings = [
      { slug:'e1',  name:'Block E1',       cat:'E Block',    catClass:'e-block' },
      { slug:'e2',  name:'Block E2',       cat:'E Block',    catClass:'e-block' },
      { slug:'e3',  name:'Block E3',       cat:'E Block',    catClass:'e-block' },
      { slug:'e4',  name:'Block E4',       cat:'E Block',    catClass:'e-block' },
      { slug:'e5',  name:'Block E5',       cat:'E Block',    catClass:'e-block' },
      { slug:'e6',  name:'Block E6',       cat:'E Block',    catClass:'e-block' },
      { slug:'w1',  name:'Block W1',       cat:'W Block',    catClass:'w-block' },
      { slug:'w2',  name:'Block W2',       cat:'W Block',    catClass:'w-block' },
      { slug:'w3',  name:'Block W3',       cat:'W Block',    catClass:'w-block' },
      { slug:'w4',  name:'Block W4',       cat:'W Block',    catClass:'w-block' },
      { slug:'w5',  name:'Block W5',       cat:'W Block',    catClass:'w-block' },
      { slug:'w6',  name:'Block W6',       cat:'W Block',    catClass:'w-block' },
      { slug:'ecmc',          name:'ECMC',          cat:'Facility', catClass:'other' },
      { slug:'rpc',           name:'RPC',           cat:'Facility', catClass:'other' },
      { slug:'trcc',          name:'TRCC',          cat:'Facility', catClass:'other' },
      { slug:'sports-complex',name:'Sports Complex',cat:'Facility', catClass:'other' },
      { slug:'the-arch',      name:'The Arch',      cat:'Facility', catClass:'other' },
      { slug:'green-house',   name:'Green House',   cat:'Facility', catClass:'other' },
      { slug:'blk-43',        name:'Block 43',      cat:'Facility', catClass:'other' },
      { slug:'rpic',          name:'RPIC',          cat:'Facility', catClass:'other' },
      { slug:'xlc',           name:'XLC',           cat:'Facility', catClass:'other' },
      { slug:'alc',           name:'ALC',           cat:'Facility', catClass:'other' },
    ];

    // Slot name map: slug → hotspot slot id suffix
    const slotMap = {
      'e1':'e1','e2':'e2','e3':'e3','e4':'e4','e5':'e5','e6':'e6',
      'w1':'w1','w2':'w2','w3':'w3','w4':'w4','w5':'w5','w6':'w6',
      'ecmc':'ecmc','rpc':'rpc','trcc':'trcc','sports-complex':'sports',
      'the-arch':'arch','green-house':'greenhouse','blk-43':'blk43',
      'rpic':'rpic','xlc':'xlc','alc':'alc'
    };

    // ── LOADING ──
    // Store the original orbit after model finishes loading — reset always returns here
    let originalOrbit  = HOME_ORBIT;
    let originalTarget = HOME_TARGET;
    let maxZoomRadius  = null; 

    viewer.addEventListener('progress', e => {
      loadFill.style.width = (e.detail.totalProgress * 100).toFixed(0) + '%';
    });

    viewer.addEventListener('load', () => {
      setTimeout(() => overlay.classList.add('hidden'), 600);
      // Fly-in animation
      viewer.cameraOrbit  = '20deg 70deg 120%';
      viewer.cameraTarget = HOME_TARGET;
      setTimeout(() => {
        viewer.cameraOrbit  = HOME_ORBIT;
        viewer.cameraTarget = HOME_TARGET;
        // Save this as the original position after fly-in settles
        setTimeout(() => {
          originalOrbit  = HOME_ORBIT;
          originalTarget = HOME_TARGET;
          maxZoomRadius = viewer.getCameraOrbit().radius;
        }, 600);
      }, 120);
    });

    // ── ACTIVE HOTSPOT ──
    let activeSlug = null;
    function setActiveHotspot(slug) {
      document.querySelectorAll('.hotspot').forEach(h => h.classList.remove('active'));
      if (slug) {
        const slot = slotMap[slug];
        const el = slot ? document.querySelector(`[slot="hotspot-${slot}"]`) : null;
        if (el) el.classList.add('active');
      }
      activeSlug = slug;
    }

    // ── FETCH BUILDING METRICS ──
    const dataCache = {};
    function loadBuildingData(slug, name) {
      panelTitle.textContent = name;
      panelViewBtn.setAttribute('href', `/?building=${slug}`);
      panelMetrics.innerHTML = '<div class="info-panel-loading">Loading data...</div>';

      if (dataCache[slug]) { renderMetrics(dataCache[slug]); return; }

      fetch(`/building-left/${encodeURIComponent(slug)}`)
        .then(r => r.text())
        .then(html => {
          // Parse electricity and water from returned HTML
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');

          // Try to extract numbers from the page
          const text = doc.body ? doc.body.innerText : '';
          let elec = null, water = null;

          const elecMatch = text.match(/electricity[^\d]*([\d,]+)\s*kwh/i);
          const waterMatch = text.match(/water[^\d]*([\d,]+)\s*m/i);
          if (elecMatch) elec = elecMatch[1];
          if (waterMatch) water = waterMatch[1];

          const result = { elec, water };
          dataCache[slug] = result;
          renderMetrics(result);
        })
        .catch(() => {
          panelMetrics.innerHTML = '<div class="info-panel-loading">No data available yet.</div>';
        });
    }

    function renderMetrics(data) {
      if (data.elec || data.water) {
        panelMetrics.innerHTML = `
          <div class="info-metrics">
            <div class="metric-card">
              <div class="metric-card-label">⚡ Electricity</div>
              <div class="metric-card-value">${data.elec ? data.elec + ' kWh' : 'N/A'}</div>
            </div>
            <div class="metric-card">
              <div class="metric-card-label">💧 Water</div>
              <div class="metric-card-value">${data.water ? data.water + ' m³' : 'N/A'}</div>
            </div>
          </div>`;
      } else {
        panelMetrics.innerHTML = `
          <div class="info-metrics">
            <div class="metric-card">
              <div class="metric-card-label">⚡ Electricity</div>
              <div class="metric-card-value" style="color:var(--text-dim);font-size:0.8rem">See full data</div>
            </div>
            <div class="metric-card">
              <div class="metric-card-label">💧 Water</div>
              <div class="metric-card-value" style="color:var(--text-dim);font-size:0.8rem">See full data</div>
            </div>
          </div>`;
      }
    }

    // ── OPEN PANEL ──
    function openPanel(b) {
      const catColors = { 'E Block':'var(--e-color)', 'W Block':'var(--w-color)', 'Facility':'var(--other-color)' };
      panelCategory.textContent = b.cat;
      panelCategory.style.color = catColors[b.cat] || 'var(--accent)';
      panelTitle.textContent = b.name;
      panelTitle.style.color = catColors[b.cat] || 'var(--accent)';
      infoPanel.classList.add('visible');
      setActiveHotspot(b.slug);
      loadBuildingData(b.slug, b.name);
    }

    function closePanel() {
      infoPanel.classList.remove('visible');
      setActiveHotspot(null);
      if (!cycleRunning) viewer.autoRotate = true;
    }

    // ── HOTSPOT CLICKS ──
    document.querySelectorAll('.hotspot').forEach(hotspot => {
      hotspot.addEventListener('click', e => {
        e.preventDefault();
        if (MAP_MIRROR) return; // audience copy is not interactive
        const href = hotspot.getAttribute('href');
        const slug = href.split('/building-left/')[1];
        const b = buildings.find(b => b.slug === slug);
        if (!b) return;
        pauseCycle();
        viewer.autoRotate = false;
        openPanel(b);
        // Drive the big screen to this building's full data (Page 5).
        mapPostToParent({ type: 'MAP_SELECT_BUILDING', building: slug });
      });
    });

    // "View Full Data": when embedded, push to the big screen instead of
    // navigating this iframe to /?building=...
    panelViewBtn.addEventListener('click', e => {
      if (MAP_EMBED) {
        e.preventDefault();
        if (activeSlug) mapPostToParent({ type: 'MAP_SELECT_BUILDING', building: activeSlug });
      }
    });

    // Click on empty model area closes panel
    viewer.addEventListener('click', e => {
      if (!e.target.closest('.hotspot')) closePanel();
    });

    // ── AUTO-CYCLE ──
    let cycleIdx = 0;
    let cycleRunning = true;
    let cycleTimer = null;
    let cycleStartTime = null;
    const CYCLE_DURATION = 5000; // 5s per building

    function startCycleTimer() {
      clearCycleTimer();
      cycleStartTime = Date.now();
      cycleBarFill.style.transition = 'none';
      cycleBarFill.style.width = '0%';

      setTimeout(() => {
        cycleBarFill.style.transition = `width ${CYCLE_DURATION}ms linear`;
        cycleBarFill.style.width = '100%';
      }, 30);

      cycleTimer = setTimeout(() => {
        cycleIdx = (cycleIdx + 1) % buildings.length;
        showCycleBuilding();
      }, CYCLE_DURATION);
    }

    function clearCycleTimer() {
      if (cycleTimer) clearTimeout(cycleTimer);
      cycleTimer = null;
      cycleBarFill.style.transition = 'none';
      cycleBarFill.style.width = '0%';
    }

    function showCycleBuilding() {
      const b = buildings[cycleIdx];
      cycleNameEl.textContent = b.name;
      cycleCounter.textContent = `${cycleIdx + 1} / ${buildings.length}`;
      setActiveHotspot(b.slug);
      if (cycleRunning) startCycleTimer();
    }

    function pauseCycle() {
      cycleRunning = false;
      clearCycleTimer();
      playPauseBtn.textContent = '▶';
      playPauseBtn.classList.remove('active-play');
    }

    function resumeCycle() {
      cycleRunning = true;
      playPauseBtn.textContent = '⏸';
      playPauseBtn.classList.add('active-play');
      closePanel();
      viewer.autoRotate = true;
      showCycleBuilding();
    }

    playPauseBtn.addEventListener('click', () => {
      if (cycleRunning) pauseCycle(); else resumeCycle();
    });

    document.getElementById('cyclePrev').addEventListener('click', () => {
      pauseCycle();
      cycleIdx = (cycleIdx - 1 + buildings.length) % buildings.length;
      showCycleBuilding();
      openPanel(buildings[cycleIdx]);
    });

    document.getElementById('cycleNext').addEventListener('click', () => {
      pauseCycle();
      cycleIdx = (cycleIdx + 1) % buildings.length;
      showCycleBuilding();
      openPanel(buildings[cycleIdx]);
    });

    // ── ZOOM CONTROLS ──
    function getOrbit() {
      const parts = viewer.getCameraOrbit();
      return { theta: parts.theta, phi: parts.phi, radius: parts.radius };
    }

    document.getElementById('zoomIn').addEventListener('click', () => {
      const o = getOrbit();
      const newR = Math.max(o.radius * 0.75, viewer.getDimensions ? 5 : 0.5);
      viewer.cameraOrbit = `${o.theta}rad ${o.phi}rad ${newR}m`;
    });

    document.getElementById('zoomOut').addEventListener('click', () => {
      const o = getOrbit();
      let newR = o.radius * 1.35;
      if (maxZoomRadius !== null) newR = Math.min(newR, maxZoomRadius);
      viewer.cameraOrbit = `${o.theta}rad ${o.phi}rad ${newR}m`;
    });

    let isResetting = false;

    function resetToHome() {
      isResetting = true;
      clearTimeout(viewer._resumeTimer);
      viewer.autoRotate = false;

      const applyHome = () => {
        viewer.cameraTarget = originalTarget;
        viewer.cameraOrbit  = originalOrbit;
      };

      applyHome();                  // 0ms
      setTimeout(applyHome, 50);    // 50ms
      setTimeout(applyHome, 600);   // 600ms

    
      setTimeout(() => {
        isResetting = false;
        viewer.autoRotate = false;
      }, 800);


      viewer._resumeTimer = setTimeout(() => {
        if (cycleRunning) viewer.autoRotate = true;
      }, 3000);
    }

    document.getElementById('resetView').addEventListener('click', resetToHome);

    // Pause auto-rotate on manual drag — ignore during reset
    viewer.addEventListener('camera-change', e => {
      if (isResetting) return;
      if (e.detail.source === 'user-interaction') {
        viewer.autoRotate = false;
        clearTimeout(viewer._resumeTimer);
        viewer._resumeTimer = setTimeout(() => {
          if (cycleRunning) viewer.autoRotate = true;
        }, 6000);
      }
    });


    // ── START ──
    viewer.addEventListener('load', () => {
      if (MAP_MIRROR) { pauseCycle(); return; } // audience copy: just auto-rotate
      setTimeout(() => { showCycleBuilding(); }, 800);
    });
  </script>

 <script>
  (function setupMapBackground(){
    const KEY = "rpMapBg";

    const PRESETS = [
      { name:"Green",  base:"#050d0a", glow:"rgba(0,200,150,0.16)",  sw:"#0f3a2c" },
      { name:"Night",  base:"#05070d", glow:"rgba(96,165,250,0.16)", sw:"#1e3a8a" },
      { name:"Red",    base:"#140505", glow:"rgba(239,68,68,0.16)",  sw:"#7f1d1d" },
      { name:"Pink",   base:"#14050f", glow:"rgba(236,72,153,0.16)", sw:"#9d174d" },
      { name:"Sunset", base:"#140b05", glow:"rgba(251,146,60,0.18)", sw:"#9a3412" },
      { name:"Slate",  base:"#0b0e12", glow:"rgba(203,213,225,0.10)", sw:"#475569" }
    ];

    const DEFAULTS = { base:"#050d0a", glow:"rgba(0,200,150,0.16)", image:null, fit:"cover", opacity:1 };

    const root       = document.documentElement;
    const mvEl       = document.getElementById("campusViewer");
    const toggle     = document.getElementById("bgToggle");
    const panel      = document.getElementById("bgPanel");
    const swatches   = document.getElementById("bgSwatches");
    const colorPick  = document.getElementById("bgColorPick");
    const glowPick   = document.getElementById("bgGlowPick");
    const fileInput  = document.getElementById("bgFile");
    const fitSel     = document.getElementById("bgFit");
    const opSlider   = document.getElementById("bgOpacity");
    const opVal      = document.getElementById("bgOpacityVal");
    const clearImg   = document.getElementById("bgClearImg");
    const resetBtn   = document.getElementById("bgReset");

    // The model-viewer carries a hardcoded inline gradient that would cover
    // our backdrop. Make it transparent so body::before + #bgImageLayer show through.
    if (mvEl) mvEl.style.background = "transparent";

    let state = { ...DEFAULTS };

    function hexToRgba(hex, a){
      const h = hex.replace("#","");
      const n = parseInt(h.length === 3 ? h.split("").map(c=>c+c).join("") : h, 16);
      return "rgba(" + ((n>>16)&255) + "," + ((n>>8)&255) + "," + (n&255) + "," + a + ")";
    }

    function apply(){
      root.style.setProperty("--bgBase", state.base);
      root.style.setProperty("--bgGlow", state.glow);
      root.style.setProperty("--bgImage", state.image ? 'url("' + state.image + '")' : "none");
      root.style.setProperty("--bgFit", state.fit);
      root.style.setProperty("--bgOpacity", String(state.opacity));

      colorPick.value = state.base;
      fitSel.value    = state.fit;
      opSlider.value  = String(Math.round(state.opacity * 100));
      opVal.textContent = Math.round(state.opacity * 100) + "%";

      // mark matching preset
      Array.from(swatches.children).forEach(el => {
        el.classList.toggle("active",
          el.dataset.base === state.base && el.dataset.glow === state.glow);
      });
    }

    function save(){
      try { localStorage.setItem(KEY, JSON.stringify(state)); } catch(e){}
    }

    function load(){
      try {
        const raw = localStorage.getItem(KEY);
        if (raw) state = Object.assign({}, DEFAULTS, JSON.parse(raw));
      } catch(e){ state = { ...DEFAULTS }; }
    }

    // Build preset swatches
    PRESETS.forEach(p => {
      const el = document.createElement("div");
      el.className = "bg-swatch";
      el.title = p.name;
      el.style.background = p.sw;
      el.dataset.base = p.base;
      el.dataset.glow = p.glow;
      el.addEventListener("click", () => {
        state.base = p.base;
        state.glow = p.glow;
        apply(); save();
      });
      swatches.appendChild(el);
    });

    // Custom colours
    colorPick.addEventListener("input", () => {
      state.base = colorPick.value;
      apply(); save();
    });
    glowPick.addEventListener("input", () => {
      state.glow = hexToRgba(glowPick.value, 0.16);
      apply(); save();
    });

    // Image upload → base64 so it persists without a server round-trip
    fileInput.addEventListener("change", () => {
      const f = fileInput.files && fileInput.files[0];
      if (!f) return;
      const reader = new FileReader();
      reader.onload = () => {
        state.image = reader.result;
        apply(); save();
      };
      reader.readAsDataURL(f);
      fileInput.value = "";
    });

    fitSel.addEventListener("change", () => { state.fit = fitSel.value; apply(); save(); });

    opSlider.addEventListener("input", () => {
      state.opacity = Number(opSlider.value) / 100;
      apply(); save();
    });

    clearImg.addEventListener("click", () => { state.image = null; apply(); save(); });

    resetBtn.addEventListener("click", () => {
      state = { ...DEFAULTS };
      apply(); save();
    });

    // Panel open/close
    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      panel.classList.toggle("open");
    });
    document.addEventListener("click", (e) => {
      if (!panel.contains(e.target) && e.target !== toggle) panel.classList.remove("open");
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") panel.classList.remove("open");
    });

    load();
    apply();
  })();
  </script>

</body>
</html>


