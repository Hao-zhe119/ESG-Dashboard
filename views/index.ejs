    // Pick a basic colour for each year; that one colour is used for BOTH the
    // year's bars and its trend line. Different years stay different colours.
    // Saved per-browser in localStorage; UI lives in the floating "🎨" panel.
    // ============================================================
    const CHART_COLOR_STORAGE_KEY = "esgChartColorPrefs";
    // Colour choices shown in the pop-up grid picker (4 per row).
    const COLOR_GRID = [
      "#ef4444", "#f97316", "#f59e0b", "#eab308",
