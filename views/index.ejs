    function buildEnabledPages() {
      const pages = [1, 2, 3, 4, 5, 6, 7];
      if (hasVideos) pages.push(8);
      if (hasImages) pages.push(9);
      pages.push(10);
      return pages;
    }

    const enabled_pages_auto = buildEnabledPages();
    const enabled_pages_interactive = buildEnabledPages();

    function enabledPages() {
      return is_auto_mode ? enabled_pages_auto : enabled_pages_interactive;
    }

    function nextEnabledPage(from, direction) {
      const pages = enabledPages();
      const index = pages.indexOf(from);
      if (index === -1) return pages[0];
      const nextIndex = (index + (direction || 1) + pages.length) % pages.length;
      return pages[nextIndex];
    }

    // Use timer-based default duration
    const defaultPageDurationMs = getPageDuration(1);
    
    const backArrowButton = document.getElementById("backArrowButton");
    const nextArrowButton = document.getElementById("nextArrowButton");
    const progressBarContainerElement = document.getElementById("progressBarContainer");
    const progressBarFillElement = document.getElementById("progressBarFill");

    let progressIntervalId = null;
    let progressStartTimestampMs = 0;
    let progressTotalDurationMs = defaultPageDurationMs;
    let progressElapsedMs = 0;
    let isAutoAdvanceEnabled = true;
    let progressActivePage = 1;
    let pageTransitionSeq = 0;
    let pageTransitionBusy = false;

    function hardResetProgressBar() {
      if (progressIntervalId) clearInterval(progressIntervalId);
      progressIntervalId = null;
      progressTotalDurationMs = getPageDuration(currentPageNumber);
      progressElapsedMs = 0;
      progressStartTimestampMs = 0;
      isAutoAdvanceEnabled = true;
      progressActivePage = currentPageNumber;
      if (progressBarFillElement) progressBarFillElement.style.width = "0%";
      if (progressBarContainerElement && is_auto_mode) progressBarContainerElement.style.display = "";
    }

    function stopProgressBarAnimation() {
      if (progressIntervalId) clearInterval(progressIntervalId);
      progressIntervalId = null;
      progressElapsedMs = 0;
      if (progressBarFillElement) progressBarFillElement.style.width = "0%";
    }

    function setProgressBarToComputedElapsed(totalMs, elapsedMs, autoAdvance) {
      if (!is_auto_mode) return;
      progressTotalDurationMs = Math.max(1, Number(totalMs || 1));
      progressElapsedMs = Math.max(0, Number(elapsedMs || 0));
      progressStartTimestampMs = Date.now() - progressElapsedMs;
      isAutoAdvanceEnabled = !!autoAdvance;
      progressActivePage = currentPageNumber;
      if (!progressBarFillElement) return;
      const percentage = Math.max(0, Math.min(100, (progressElapsedMs / progressTotalDurationMs) * 100));
      progressBarFillElement.style.width = percentage + "%";
      if (progressIntervalId) clearInterval(progressIntervalId);
      progressIntervalId = setInterval(() => {
        if (progressActivePage !== currentPageNumber) return;
        const now = Date.now();
        const elapsed = now - progressStartTimestampMs;
        progressElapsedMs = elapsed;
        const percent = Math.max(0, Math.min(100, (elapsed / progressTotalDurationMs) * 100));
        progressBarFillElement.style.width = percent + "%";
        if (elapsed >= progressTotalDurationMs) {
          clearInterval(progressIntervalId);
          progressIntervalId = null;
          progressBarFillElement.style.width = "100%";
          if (isAutoAdvanceEnabled && progressActivePage === currentPageNumber) {
            navigateToNextPage();
          }
        }
      }, 100);
    }

    function updateProgressBarWidthFromState() {
      if (!progressBarFillElement) return;
      const percentage = Math.max(0, Math.min(100, (progressElapsedMs / progressTotalDurationMs) * 100));
      progressBarFillElement.style.width = percentage + "%";
    }

    function startManualProgress(totalMs, elapsedMs) {
      if (!is_auto_mode) return;
      if (progressIntervalId) clearInterval(progressIntervalId);
      progressIntervalId = null;
      progressTotalDurationMs = Math.max(1, Number(totalMs || 1));
      progressElapsedMs = Math.max(0, Number(elapsedMs || 0));
      progressStartTimestampMs = Date.now() - progressElapsedMs;
      isAutoAdvanceEnabled = false;
      progressActivePage = currentPageNumber;
      updateProgressBarWidthFromState();
    }

    function runProgressForPage(pageNum, totalMs, autoAdvance) {
      if (!is_auto_mode) return;
      setProgressBarToComputedElapsed(totalMs, 0, autoAdvance);
    }

    // ============================================================
    // ADMIN VIDEO SETTINGS
    // ============================================================
    const ADMIN_VIDEO_SETTINGS_KEY = "esg_video_settings";
    const ADMIN_VIDEO_SETTINGS_CHANNEL = "esg_video_settings_channel";

    function clamp01(inputValue) {
      const number = Number(inputValue);
      if (!isFinite(number)) return null;
      return Math.max(0, Math.min(1, number));
    }

    function readAdminVideoSettings() {
      try {
        const raw = localStorage.getItem(ADMIN_VIDEO_SETTINGS_KEY);
        if (!raw) return null;
        const settings = JSON.parse(raw);
        if (!settings || typeof settings !== "object") return null;
        const volume = (settings.volume != null) ? clamp01(settings.volume) : null;
        const muted = (typeof settings.muted === "boolean") ? settings.muted : null;
        return { volume: volume, muted };
      } catch (error) { return null; }
    }

    function saveAdminVideoSettings(next) {
      try {
        const current = readAdminVideoSettings() || {};
        const merged = {
          volume: (next && next.volume != null) ? clamp01(next.volume) : current.volume,
          muted: (next && typeof next.muted === "boolean") ? !!next.muted : current.muted
        };
        localStorage.setItem(ADMIN_VIDEO_SETTINGS_KEY, JSON.stringify(merged));
        return merged;
      } catch (error) { return null; }
    }

    function applyAdminVideoSettingsToPlayer(videoElement) {
      const video = videoElement || document.getElementById("esgVideoElement");
      if (!video) return;
      try { video.removeAttribute("muted"); } catch (error) {}
      const settings = readAdminVideoSettings();
      const targetVolume = (settings && typeof settings.volume === "number") ? settings.volume : 0.5;
      const targetMuted = (settings && typeof settings.muted === "boolean") ? settings.muted : true;
      try {
        const clampedVolume = clamp01(targetVolume);
        if (clampedVolume != null) video.volume = clampedVolume;
      } catch (error) {}
      try { video.muted = !!targetMuted; } catch (error) {}
    }

    (function initAdminVideoSettingsListeners() {
      window.addEventListener("load", () => { applyAdminVideoSettingsToPlayer(); });
      window.addEventListener("storage", (event) => {
        if (event.key === ADMIN_VIDEO_SETTINGS_KEY) {
          applyAdminVideoSettingsToPlayer();
          if (!is_auto_mode && currentPageNumber === 8) sendVideoStateToControls();
        }
      });
      try {
        const broadcastChannel = new BroadcastChannel(ADMIN_VIDEO_SETTINGS_CHANNEL);
        broadcastChannel.onmessage = (event) => {
          const message = event && event.data;
          if (!message || message.type !== "ADMIN_VIDEO_SETTINGS") return;
          saveAdminVideoSettings({ volume: message.volume, muted: message.muted });
          applyAdminVideoSettingsToPlayer();
          if (!is_auto_mode && currentPageNumber === 8) sendVideoStateToControls();
        };
      } catch (error) {}
    })();

