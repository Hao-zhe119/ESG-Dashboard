/* ========================================
   SLUG SANDBOX (INJECTED CONTENT)
   ======================================== */
.slug-sandbox {
  height: 100%;
  min-height: 0;
  overflow: hidden;
  color: inherit;
  background: transparent;
  box-sizing: border-box;
  max-width: 100%;
}

.slug-sandbox * {
  box-sizing: border-box;
  max-width: 100%;
}

.slug-sandbox html,
.slug-sandbox body {
  background: transparent !important;
  overflow: hidden !important;
  margin: 0 !important;
  padding: 0 !important;
}

.slug-sandbox h1,
.slug-sandbox h2,
.slug-sandbox h3,
.slug-sandbox h4,
.slug-sandbox h5 {
  color: #111827;
  margin: 0 0 8px 0;
}

.slug-sandbox .muted,
