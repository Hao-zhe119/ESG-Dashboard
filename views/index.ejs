<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RP ESG Dashboard</title>

  <!-- Bootstrap + Animate.css -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
:root {
  --navH: 56px;
  --pad: clamp(12px, 1.1vw, 20px);
  --gap: clamp(10px, 1.2vw, 18px);
  --progH: clamp(6px, 0.7vh, 10px);
  --bFs: clamp(12px, 0.9vw, 16px);
  --vh: 1vh;
  --arrowGutter: clamp(72px, 5.5vw, 130px);
  --stageAvailH: calc((var(--vh) * 100) - var(--navH) - var(--progH) - (var(--pad) * 2) - 24px);
  --stageMaxW: 92vw;
  --stageW: min(var(--stageMaxW), calc(var(--stageAvailH) * (16 / 9)));
  --bg: #0f1318;
  --text: #e5e7eb;
  --muted: #9ca3af;
  --panel: #161b22;
  --panelBorder: rgba(255,255,255,0.10);
  --shadow: 0 10px 24px rgba(0,0,0,0.45);
  --accent: #60a5fa;
  --listRow: rgba(255,255,255,0.04);
  --listRowAlt: rgba(255,255,255,0.02);
  --listRowHover: rgba(96,165,250,0.16);
  --listRowActive: rgba(52,211,153,0.18);
  --progressBg: rgba(255,255,255,0.10);
  --progressFill: #34d399;
/* ── Glassmorphism tokens ── */
  --glassBg: linear-gradient(to bottom, rgba(255,255,255,0.18), rgba(255,255,255,0.06));
  --glassBgStrong: linear-gradient(to bottom, rgba(8,12,16,0.62), rgba(20,28,38,0.45));
  --glassBorder: 1px solid rgba(255,255,255,0.45);
  --glassBlur: blur(22px) saturate(170%) brightness(0.9);
  --glassShadow: 0 18px 45px rgba(0,0,0,0.40), inset 0 0 18px rgba(0,0,0,0.16);
  --glassRadius: 22px;
  --cardBg: rgba(255,255,255,0.10);
  --cardText: #ffffff;
  --pageBreathTB: 4px;
  --threeBreathTB: 4px;

  /* ========================================
     SHARED PANEL RATIOS (Pages 5, 6, 7)
     Change these 4 values to adjust all 3 pages
     ======================================== */
  --panel-ratio-left: 0.75;
  --panel-ratio-mid: 1.5;
  --panel-ratio-right: 0.75;
  --panel-ratio-total: 3; 
  --graphSurface: #f7f9fc;
  --graphSurfaceDark: #101827;
  --graphCardSurface: linear-gradient(180deg, rgba(255,255,255,0.94) 0%, rgba(246,249,253,0.90) 100%);
  --graphCardBorder: rgba(148,163,184,0.24);
  --graphCardShadow: 0 22px 54px rgba(2,6,23,0.24), 0 2px 10px rgba(15,23,42,0.10), inset 0 1px 0 rgba(255,255,255,0.88);
  --graphPlotSurface: rgba(248,250,252,0.50);
  --graphBorder: rgba(30,41,59,0.08);
  --graphShadow: none;
  --graphRadius: 16px;
  --chartFont: Inter, "IBM Plex Sans", Geist, "Segoe UI", Arial, sans-serif;
  --chartEase: cubic-bezier(0.22, 1, 0.36, 1);
  --chartControlBg: rgba(255,255,255,0.72);
  --chartControlBorder: rgba(148,163,184,0.28);
  --chartControlText: #334155;
  --chartControlActive: #111827;
  --chartFocus: rgba(37,99,235,0.32);
  --chartPanelSubtle: rgba(255,255,255,0.52);
  --chartGlassBlur: blur(20px) saturate(160%);
  --metricElectricity: #2563eb;
  --metricWater: #0891b2;
  --metricSolar: #d97706;
  --metricWaste: #64748b;
  --metricRecyclable: #16a34a;
  --metricCarbon: #ea580c;
}


.three-building-title,
.three-info-body,
.metric-label,
.metric-value { color: #fff !important; text-shadow: 0 2px 8px rgba(0,0,0,0.5); }


@media (min-aspect-ratio: 48/10) {
  :root { --stageMaxW: calc(100vw / 3); }
}

html, body {
  margin: 0;
  padding: 0;
  height: 100%;
  font-family: Arial, sans-serif;
  color: var(--text);
  background: var(--bg);
  overflow: hidden;
}

/* ========================================
   PAGE 1: WELCOME
   ======================================== */
/* Welcome KPI summary cards */
#page1 .welcome-kpis{
  position:static;
  transform:none;
  display:grid;
  grid-template-columns:repeat(4, 1fr);
  gap:18px;
  width:min(1100px, 88vw);
  z-index:2;
  margin-top: clamp(8px, 2vh, 20px);
}
#page1 .kpi-card{
  background: var(--glassBgStrong);
  -webkit-backdrop-filter: var(--glassBlur);
  backdrop-filter: var(--glassBlur);
  border: var(--glassBorder);
  border-radius: var(--glassRadius);
  box-shadow: var(--glassShadow);
  padding:18px 16px;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:6px;
  color:#fff;
}

/* ---- KPI card animations ---- */

/* Entrance: fade + rise, staggered */
#page1 .kpi-card{
  opacity: 0;
  animation: kpiRise 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}
#page1 .kpi-card:nth-child(1){ animation-delay: 0.25s; }
#page1 .kpi-card:nth-child(2){ animation-delay: 0.40s; }
#page1 .kpi-card:nth-child(3){ animation-delay: 0.55s; }
#page1 .kpi-card:nth-child(4){ animation-delay: 0.70s; }

@keyframes kpiRise{
  from{ opacity:0; transform: translateY(30px) scale(0.96); }
  to  { opacity:1; transform: translateY(0)    scale(1); }
}

/* Idle float: inner wrapper floats so it doesn't fight the entrance */
#page1 .kpi-card .kpi-icon,
#page1 .kpi-card .kpi-value,
#page1 .kpi-card .kpi-label{
  animation: kpiWave 2.8s ease-in-out infinite;
}
/* Stagger the wave so cards float ONE BY ONE */
#page1 .kpi-card:nth-child(1) .kpi-icon,
#page1 .kpi-card:nth-child(1) .kpi-value,
#page1 .kpi-card:nth-child(1) .kpi-label{ animation-delay: 0s; }

#page1 .kpi-card:nth-child(2) .kpi-icon,
#page1 .kpi-card:nth-child(2) .kpi-value,
#page1 .kpi-card:nth-child(2) .kpi-label{ animation-delay: 0.35s; }

#page1 .kpi-card:nth-child(3) .kpi-icon,
#page1 .kpi-card:nth-child(3) .kpi-value,
#page1 .kpi-card:nth-child(3) .kpi-label{ animation-delay: 0.7s; }

#page1 .kpi-card:nth-child(4) .kpi-icon,
#page1 .kpi-card:nth-child(4) .kpi-value,
#page1 .kpi-card:nth-child(4) .kpi-label{ animation-delay: 1.05s; }

@keyframes kpiWave{
  0%, 100%{ transform: translateY(0); }
  50%     { transform: translateY(-14px); }
}

/* Hover: glow (no transform, so it won't fight the wave) */
#page1 .kpi-card{
  transition: box-shadow .25s ease, border-color .25s ease;
}
#page1 .kpi-card:hover{
  box-shadow: 0 18px 40px rgba(0,0,0,0.5), 0 0 0 1px rgba(126,174,51,0.55), 0 0 26px rgba(126,174,51,0.30);
  border-color: rgba(126,174,51,0.55);
}

#page1 .kpi-icon{
  width:48px; height:48px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  font-size:24px; margin-bottom:2px;
}

#page1 .kpi-value{
  font-size:clamp(22px, 2vw, 34px);
  font-weight:800;
  text-shadow:0 2px 8px rgba(0,0,0,0.5);
  line-height:1.1;
}
#page1 .kpi-label{
  font-size:clamp(11px, 0.9vw, 13px);
  color:rgba(255,255,255,0.8);
  text-align:center;
}
@media (max-width:900px){
  #page1 .welcome-kpis{ grid-template-columns:repeat(2,1fr); }
}

#page1 {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: clamp(16px, 3vh, 36px);
}

#page1 .welcome-logo {
  height: clamp(95px, 12vh, 150px);
  width: auto;
  position: absolute;
  top: clamp(70px, 10vh, 110px);
  left: clamp(24px, 3vw, 52px);
  box-sizing: border-box;
  padding: clamp(10px, 1.4vh, 18px);
  border-radius: 26px;
  background: rgba(255, 255, 255, 0.96);
  border: 1px solid rgba(255, 255, 255, 0.7);
  box-shadow:
    0 12px 32px rgba(0, 0, 0, 0.40),
    0 2px 6px rgba(0, 0, 0, 0.20),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
  filter: none;
  z-index: 3;
  animation: logoFloat 4s ease-in-out infinite;
}
@keyframes logoFloat {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-10px); }
}

#page1 .welcome-title {
  position: static;
  transform: none;
  font-size: clamp(2rem, 4vw, 4.4rem);
  font-weight: 800;
  letter-spacing: 0.04em;
  text-align: center;
  color: #ffffff;
  text-shadow: 0 4px 24px rgba(0,0,0,0.6);
  padding: 0 clamp(10px, 2vw, 24px);
  max-width: 92vw;
  margin: 0;
  line-height: 1.12;
  animation: titleRise 1s cubic-bezier(0.22, 1, 0.36, 1) both;
}
@keyframes titleRise {
  from { opacity: 0; transform: translateY(28px); filter: blur(6px); }
  to   { opacity: 1; transform: translateY(0);    filter: blur(0); }
}

#page1 .welcome-rp-text {
  display: inline-block;
  font-weight: 900;
  letter-spacing: 0.05em;
  background: linear-gradient(100deg, #8fd14f 0%, #ffffff 45%, #7eae33 70%, #ffffff 100%);
  background-size: 250% auto;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
  text-shadow: none;
  filter: drop-shadow(0 2px 14px rgba(126,174,51,0.45));
  animation: rpShimmer 5s linear infinite;
}
@keyframes rpShimmer {
  to { background-position: 250% center; }
}

#welcome-page .welcome-rp-text,
#page1 .welcome-rp-text {
  display: inline-block;
  animation-duration: 2.2s;
  animation-timing-function: ease-in-out;
}

/* ========================================
   PAGE BASE STYLES
   ======================================== */
.page {
  height: calc(var(--vh) * 100);
  box-sizing: border-box;
  padding: var(--pad);
  padding-top: calc(var(--navH) + var(--pad) + var(--pageBreathTB));
  padding-bottom: calc(var(--pad) + var(--progH) + var(--pageBreathTB));
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  overflow: hidden;
  min-height: 0;
  min-width: 0;
  background: var(--bg);
  color: var(--text);
  transform: translateX(100%);
  opacity: 0;
  pointer-events: none;
  transition: transform 0.45s cubic-bezier(.4, 0, .2, 1), opacity 0.35s ease;
}

.page.active-page {
  transform: translateX(0);
  opacity: 1;
  pointer-events: auto;
  z-index: 2;
}

.page.enter-left { transform: translateX(-100%); opacity: 0; z-index: 2; }
.page.enter-right { transform: translateX(100%); opacity: 0; z-index: 2; }
.page.exit-left { transform: translateX(-100%); opacity: 0; pointer-events: none; z-index: 1; }
.page.exit-right { transform: translateX(100%); opacity: 0; pointer-events: none; z-index: 1; }

@media (prefers-reduced-motion: reduce) {
  .page { transition: none !important; }
}

/* Right-panel lists (Navigation / Solar / Waste) — solid white rows on glass */
#page5 #threeRightBody .building-list-item,
#page6 #solar-year-list .building-list-item,
#page7 #waste-year-list .building-list-item {
  background: #ffffff !important;
  color: #111827;
}
#page5 #threeRightBody .building-list-item:nth-child(even),
#page6 #solar-year-list .building-list-item:nth-child(even),
#page7 #waste-year-list .building-list-item:nth-child(even) {
  background: #f3f4f6 !important;
}
#page5 #threeRightBody .building-list-item .fw-bold,
#page6 #solar-year-list .building-list-item .fw-bold,
#page7 #waste-year-list .building-list-item .fw-bold {
  color: #111827 !important;
}
#page5 #threeRightBody .building-list-item small,
#page6 #solar-year-list .building-list-item small,
#page7 #waste-year-list .building-list-item small {
  color: rgba(17,24,39,0.70) !important;
}
/* keep the active row clearly highlighted */
#page5 #threeRightBody .building-list-item.active,
#page6 #solar-year-list .building-list-item.active,
#page7 #waste-year-list .building-list-item.active {
  background: rgba(22,163,74,0.16) !important;
}

#page5 #threeRightBody .building-list-item.active,
#page6 #solar-year-list .building-list-item.active,
#page7 #waste-year-list .building-list-item.active {
  background: rgba(22,163,74,0.55) !important;
}
#page5 #threeRightBody .building-list-item.active .fw-bold,
#page6 #solar-year-list .building-list-item.active .fw-bold,
#page7 #waste-year-list .building-list-item.active .fw-bold,
#page5 #threeRightBody .building-list-item.active small,
#page6 #solar-year-list .building-list-item.active small,
#page7 #waste-year-list .building-list-item.active small {
  color: #ffffff !important;
}

/* ========================================
   PAGE BACKGROUNDS
   ======================================== */
#page1, #page2, #page3, #page4, #page5, #page6, #page7, #page8, #page9, #page10, #page11 {
  background: url("/images/rp-main.jpg") no-repeat center center / cover;
}

#page1::before, #page2::before, #page3::before, #page4::before, #page5::before,
#page6::before, #page7::before, #page8::before, #page9::before, #page10::before, #page11::before {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(20, 28, 38, 0.45);;
  z-index: 0;
}

/* Floating "pollen / energy" specks over the photo, behind all content.
   z-index:0 sits above the ::before overlay (painted later in tree order)
   yet below page content (z-index:1 / auto). pointer-events:none keeps it
   purely decorative. Hidden for users who prefer reduced motion. */
.bg-particles {
  /* !important needed because `#pageN > *` (ID specificity) otherwise
     forces position:relative / z-index:1 onto every direct child. */
  position: absolute !important;
  inset: 0 !important;
  width: 100% !important;
  height: 100% !important;
  z-index: 0 !important;
  pointer-events: none !important;
}

/* Campus-map mirror overlay — audience view, driven by the control panel.
   Covers everything (incl. navbar) while a guest browses the map. */
#mapOverlay {
  position: fixed;
  inset: 0;
  z-index: 2000;
  background: #050d0a;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.35s ease;
}
#mapOverlay.open { opacity: 1; pointer-events: auto; }
#mapOverlay iframe {
  width: 100%;
  height: 100%;
  border: 0;
  display: block;
}

#page1 > *, #page2 > *, #page3 > *, #page4 > *, #page8 > *, #page9 > *, #page10 > *, #page11 > * {
  position: relative;
  z-index: 1;
  color: var(--text);
}

/* ========================================
   NAVBAR
   ======================================== */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
}

.navbar.bg-light {
  background: linear-gradient(to bottom, rgba(0,0,0,0.55), rgba(0,0,0,0.32)) !important;
  -webkit-backdrop-filter: blur(18px) saturate(160%);
  backdrop-filter: blur(18px) saturate(160%);
  border-bottom: 1px solid rgba(255,255,255,0.18) !important;
}

.navbar .navbar-brand { color: var(--text) !important; }
.navbar .navbar-toggler { border-color: rgba(255,255,255,0.18) !important; }
.navbar .navbar-toggler-icon { filter: invert(1) grayscale(1); opacity: 0.9; }

:fullscreen .navbar { display: none !important; }
:-webkit-full-screen .navbar { display: none !important; }
body.is-fullscreen .navbar { display: none !important; }

/* ========================================
   ARROW BUTTONS
   ======================================== */
.arrow-btn {
  position: fixed;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.18);
  color: var(--text);
  padding: clamp(8px, 1vh, 12px) clamp(12px, 1.2vw, 18px);
  border-radius: 50%;
  cursor: pointer;
  z-index: 1500;
  font-size: clamp(18px, 1.8vw, 26px);
  transition: 0.2s;
  box-shadow: 0 10px 22px rgba(0,0,0,0.35);
  user-select: none;
}

.arrow-btn:hover { background: rgba(96,165,250,0.18); }
#backArrowButton { left: clamp(10px, 1.2vw, 20px); }
#nextArrowButton { right: clamp(10px, 1.2vw, 20px); }

/* ========================================
   PROGRESS BAR
   ======================================== */
#progressBarContainer {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: var(--progH);
  z-index: 2000;
  background: var(--progressBg);
  border-top: 1px solid rgba(255,255,255,0.10);
}

#progressBarFill {
  width: 0%;
  height: 100%;
  background: var(--progressFill);
  transition: width 0.1s linear;
}

body.mode-interactive #progressBarContainer { display: none; }

/* ========================================
   BUTTONS
   ======================================== */
.btn-outline-secondary {
  color: var(--text) !important;
  border-color: rgba(255,255,255,0.22) !important;
  background: rgba(255,255,255,0.04) !important;
}

.btn-outline-secondary:hover {
  background: rgba(96,165,250,0.18) !important;
  border-color: rgba(96,165,250,0.35) !important;
}

.btn-outline-light {
  color: var(--text) !important;
  border-color: rgba(255,255,255,0.22) !important;
}

.btn-outline-light:hover {
  background: rgba(96,165,250,0.18) !important;
  border-color: rgba(96,165,250,0.35) !important;
}

#page5 .panel .btn,
#page6 .panel .btn,
#page7 .panel .btn {
  color: #111827 !important;
  border-color: rgba(17,24,39,0.25) !important;
  background: rgba(17,24,39,0.06) !important;
}

#page5 .panel .btn:hover,
#page6 .panel .btn:hover,
#page7 .panel .btn:hover {
  background: rgba(37,99,235,0.10) !important;
  border-color: rgba(37,99,235,0.35) !important;
  color: #111827 !important;
}

/* ========================================
   PAGE 2: BUILDING OVERVIEW
   ======================================== */
#page2 {
  justify-content: flex-start;
  align-items: stretch;
  text-align: center;
  padding-left: calc(var(--pad) + var(--arrowGutter));
  padding-right: calc(var(--pad) + var(--arrowGutter));
}

.multi-building-title {
  font-size: clamp(26px, 2.6vw, 46px);
  margin: 0 0 8px 0;
  color: var(--text);
  text-align: center;
  font-weight: 850;
  line-height: 1.06;
}

.multi-building-subtitle {
  font-size: clamp(15px, 1.25vw, 22px);
  margin: 0 0 10px 0;
  color: var(--muted);
  text-align: center;
  font-weight: 650;
}

#page2 .page2-body {
  flex: 1;
  min-height: 0;
  width: 100%;
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: clamp(10px, 1.1vw, 16px);
  align-items: stretch;
  overflow: hidden;
}

#page2 .page2-cards {
  min-height: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

#page2 .multi-building-grid {
  flex: 1;
  min-height: 0;
  width: 100%;
  display: grid;
  gap: clamp(8px, 0.9vw, 12px);
  grid-template-columns: repeat(auto-fit, minmax(185px, 1fr));
  align-content: start;
  overflow: hidden;
}

@media (min-width: 2560px) {
  #page2 .multi-building-grid {
    grid-template-columns: repeat(auto-fit, minmax(clamp(260px, 16vw, 360px), 1fr));
    max-width: none;
  }
}

#page2 .building-card { scroll-snap-align: start; }

#page2 .page2-map {
  min-height: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

#page2 .map-stage {
  width: 100%;
  height: 100%;
  min-height: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

#page2 .map-stage img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
  border-radius: 0;
}

/* ========================================
   BUILDING CARDS
   ======================================== */
.building-card {
  border-radius: var(--glassRadius);
  background: var(--glassBg);
  -webkit-backdrop-filter: var(--glassBlur);
  backdrop-filter: var(--glassBlur);
  color: var(--cardText);
  text-shadow: 0 2px 8px rgba(0,0,0,0.5);
  padding: 10px 12px;
  min-width: 0;
  box-shadow: var(--glassShadow);
  border: var(--glassBorder);
  pointer-events: none;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  gap: 2px;
}

.building-name {
  font-size: clamp(14px, 1.2vw, 18px);
  font-weight: 400;
  margin: 0 0 2px 0;
  white-space: nowrap;
  overflow: visible;
  text-overflow: unset;
}

.building-metric {
  font-size: clamp(12px, 0.95vw, 14px);
  margin: 0;
  line-height: 1.15;
  white-space: nowrap;
  overflow: visible;
  text-overflow: unset;
  color: rgba(255,255,255,0.92);
}

/* ========================================
   PAGE 8: VIDEO
   ======================================== */
#page8 {
  justify-content: center;
  align-items: center;
}

#page8 h2 {
  color: var(--text);
  margin-bottom: clamp(10px, 1.2vh, 16px);
}

#page8 video {
  width: var(--stageW);
  height: auto;
  aspect-ratio: 16 / 9;
  max-height: var(--stageAvailH);
  object-fit: contain;
  border-radius: 12px;
  box-shadow: var(--shadow);
  background: #000;
  border: 1px solid rgba(255,255,255,0.10);
}

/* ========================================
   PAGE 9: CAROUSEL
   ======================================== */
#page9 {
  justify-content: center;
  align-items: center;
}

#page9 h2 {
  color: var(--text);
  margin-bottom: clamp(10px, 1.2vh, 16px);
}

#page9 .carousel {
  width: var(--stageW);
  margin: 0 auto;
}

#page9 .carousel img {
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 9;
  max-height: var(--stageAvailH);
  object-fit: contain;
  border-radius: 16px;
  box-shadow: var(--shadow);
  border: 1px solid rgba(255,255,255,0.10);
  background: #000;
}

#page9 .carousel-item {
  position: relative;
}

#page9 .carousel-caption-overlay {
  position: absolute;
  transform: translate(-50%, -50%);
  padding: clamp(5px, 0.8vh, 10px) clamp(10px, 1.5vw, 20px);
  background: rgba(0, 0, 0, 0.62);
  color: #fff;
  font-weight: 500;
  text-align: center;
  z-index: 5;
  border-radius: 6px;
  max-width: 90%;
  pointer-events: none;
}

/* ========================================
   PAGES 5, 6, 7: THREE-PANEL LAYOUT
   ======================================== */
#page5, #page6, #page7 {
  padding: 0 !important;
  justify-content: flex-start;
  align-items: stretch;
  background: url("/images/rp-main.jpg") no-repeat center center / cover;
}

.three-panel {
  position: absolute;
  top: calc(var(--navH) + var(--threeBreathTB));
  left: var(--pad);
  right: var(--pad);
  bottom: calc(var(--progH) + var(--threeBreathTB));
  display: flex;
  gap: var(--gap);
  align-items: stretch;
  justify-content: center;
  text-align: left;
  overflow: hidden;
  margin: 0;
  min-height: 0;
  min-width: 0;
}

body.mode-interactive #page5 .three-panel,
body.mode-interactive #page6 .three-panel,
body.mode-interactive #page7 .three-panel {
  left: calc(var(--pad) + var(--arrowGutter));
  right: calc(var(--pad) + var(--arrowGutter));
}

/* Default: Equal thirds */
.three-panel .panel {
  flex: 0 0 calc((100% - (2 * var(--gap))) / 3);
  background: var(--glassBgStrong);
  -webkit-backdrop-filter: var(--glassBlur);
  backdrop-filter: var(--glassBlur);
  border: var(--glassBorder);
  border-radius: var(--glassRadius);
  padding: 12px;
  overflow: hidden;
  min-width: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  box-shadow: var(--glassShadow);
  color: #ffffff;
}

/* Default: Responsive stacking */
@media (max-aspect-ratio: 4/3), (max-width: 1200px) {
  .three-panel { flex-direction: column; }
  .three-panel .panel { flex: 1 1 auto; }
}

/* ========================================
   PAGES 5, 6, 7: SHARED PANEL RATIOS
   ======================================== */
#page5 .three-panel .panel-left,
#page6 .three-panel .panel-left,
#page7 .three-panel .panel-left {
  flex: 0 0 calc((100% - (2 * var(--gap))) * var(--panel-ratio-left) / var(--panel-ratio-total));
}

#page5 .three-panel .panel-mid,
#page6 .three-panel .panel-mid,
#page7 .three-panel .panel-mid {
  flex: 0 0 calc((100% - (2 * var(--gap))) * var(--panel-ratio-mid) / var(--panel-ratio-total));
}

#page5 .three-panel .panel-right,
#page6 .three-panel .panel-right,
#page7 .three-panel .panel-right {
  flex: 0 0 calc((100% - (2 * var(--gap))) * var(--panel-ratio-right) / var(--panel-ratio-total));
}

/* Responsive: Stack vertically */
@media (max-aspect-ratio: 4/3), (max-width: 1200px) {
  #page5 .three-panel .panel-left,
  #page5 .three-panel .panel-mid,
  #page5 .three-panel .panel-right,
  #page6 .three-panel .panel-left,
  #page6 .three-panel .panel-mid,
  #page6 .three-panel .panel-right,
  #page7 .three-panel .panel-left,
  #page7 .three-panel .panel-mid,
  #page7 .three-panel .panel-right {
    flex: 1 1 auto;
  }
}

/* ========================================
   THREE-PANEL CONTENT STYLES
   ======================================== */
.three-building-title {
  font-size: clamp(18px, 1.65vw, 30px);
  margin: 0 0 8px 0;
  color: #111827;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-weight: 850;
  line-height: 1.08;
}

#page5 .three-building-title,
#page6 .three-building-title,
#page7 .three-building-title {
  text-align: center;
}

.three-info-body {
  color: rgba(17,24,39,0.72);
  font-size: clamp(12px, 1.0vw, 14px);
  line-height: 1.35;
  overflow: hidden;
  min-height: 0;
  flex: 1;
}

#page5 #threeInfoBody {
  grid-column: 1 / -1;
  width: 100%;
  min-width: 0;
  overflow: auto;
  min-height: 0;
}

/* Solar / Waste left info panels can be taller than the column — let them
   scroll instead of clipping the last cards (they inherit overflow:hidden
   from .three-info-body). */
#page6 #solarLeftBody,
#page7 #wasteLeftBody {
  overflow-y: auto;
  min-height: 0;
  padding: 0 4px 0 0;   /* right gap for the scrollbar only — no vertical padding */
}
/* Scrollable content gets a little bottom room so the last card's rounded
   corners show; this lives on the CONTENT (adds scroll height) rather than the
   fixed-height container, so it never shrinks the visible area. */
#page6 #solarLeftBody > .slug-sandbox,
#page7 #wasteLeftBody > .slug-sandbox {
  padding-bottom: 6px;
}
#page6 #solarLeftBody::-webkit-scrollbar,
#page7 #wasteLeftBody::-webkit-scrollbar { width: 7px; }
#page6 #solarLeftBody::-webkit-scrollbar-thumb,
#page7 #wasteLeftBody::-webkit-scrollbar-thumb {
  background: rgba(17,24,39,0.22);
  border-radius: 999px;
}

.three-metrics {
  margin-top: 10px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  flex: 0 0 auto;
}

.metric-box {
  background: rgba(37,99,235,0.06);
  border: 1px solid rgba(37,99,235,0.12);
  border-radius: 12px;
  padding: 8px;
  overflow: hidden;
  min-width: 0;
}

.metric-label {
  font-size: 12px;
  color: rgba(17,24,39,0.72);
}

.metric-value {
  font-size: 18px;
  font-weight: 700;
  color: #111827;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.analytics-card {
  width: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: clamp(18px, 1.5vw, 24px);
  border-radius: var(--graphRadius);
  border: 1px solid var(--graphCardBorder);
  background: var(--graphCardSurface);
  box-shadow: var(--graphCardShadow);
  -webkit-backdrop-filter: blur(20px) saturate(160%);
  backdrop-filter: blur(20px) saturate(160%);
  overflow: hidden;
  color: #111827;
  font-family: var(--chartFont);
}

.analytics-card-full {
  flex: 1;
  max-width: min(88vw, 2240px);
  max-height: min(84vh, 980px);
}

.panel-mid .analytics-card {
  height: 100%;
}

.analytics-card-header {
  flex: 0 0 auto;
  display: grid;
  grid-template-columns: minmax(260px, 1fr) minmax(320px, auto);
  align-items: start;
  gap: 16px;
  padding-bottom: 16px;
  border-bottom: 1px solid rgba(148,163,184,0.20);
}

.chart-title-stack {
  min-width: 0;
  text-align: left;
}

.analytics-card .multi-building-title {
  margin: 0;
  color: #111827 !important;
  text-align: left;
  font-size: clamp(22px, 1.55vw, 28px);
  font-weight: 650;
  line-height: 1.12;
  letter-spacing: 0;
  text-shadow: none !important;
  animation: none !important;
}

.analytics-card .three-building-title {
  margin: 0;
  color: #111827 !important;
  text-align: left;
  font-size: clamp(18px, 1.25vw, 24px);
  font-weight: 650;
  line-height: 1.14;
  letter-spacing: 0;
  white-space: normal;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  text-overflow: ellipsis;
  text-shadow: none !important;
  animation: none !important;
}

.analytics-card .multi-building-subtitle {
  margin: 8px 0 0;
  color: #64748b;
  text-align: left;
  font-size: 14px;
  font-weight: 500;
  line-height: 1.25;
}

.chart-kicker {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
  color: #64748b;
  font-size: 12px;
  font-weight: 650;
  letter-spacing: 0;
  text-transform: uppercase;
}

.chart-kicker::before {
  content: "";
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--chartAccent, #2563eb);
  box-shadow: 0 0 0 5px color-mix(in srgb, var(--chartAccent, #2563eb) 16%, transparent);
}

.analytics-card-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.three-chart-wrap {
  position: relative;
  flex: 1;
  min-height: 248px;
  margin-top: 0;
  padding: 16px 18px 18px;
  border-radius: calc(var(--graphRadius) - 6px);
  background: var(--graphPlotSurface);
  border: 1px solid rgba(148,163,184,0.16);
  font-family: var(--chartFont);
  overflow: hidden;
  transition: background .24s var(--chartEase), border-color .24s var(--chartEase), box-shadow .24s var(--chartEase);
}

.three-chart-wrap canvas {
  width: 100% !important;
  height: 100% !important;
  background: transparent;
  border-radius: calc(var(--graphRadius) - 8px);
  border: 0;
  box-shadow: none;
  cursor: crosshair;
}

.analytics-toolbar {
  justify-self: end;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  align-items: center;
  gap: 8px;
  max-width: min(58vw, 920px);
}

.analytics-control-group {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  min-height: 32px;
  padding: 3px;
  border: 1px solid var(--chartControlBorder);
  border-radius: 8px;
  background: var(--chartControlBg);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.70);
  -webkit-backdrop-filter: var(--chartGlassBlur);
  backdrop-filter: var(--chartGlassBlur);
}

.analytics-tool-btn,
.analytics-segment {
  appearance: none;
  border: 0;
  min-height: 26px;
  border-radius: 6px;
  padding: 5px 8px;
  background: transparent;
  color: var(--chartControlText);
  font: 650 12px/1 var(--chartFont);
  letter-spacing: 0;
  cursor: pointer;
  transition: background .16s var(--chartEase), color .16s var(--chartEase), box-shadow .16s var(--chartEase), transform .16s var(--chartEase), opacity .16s var(--chartEase);
}

.analytics-tool-btn:hover,
.analytics-segment:hover {
  background: rgba(37,99,235,0.08);
  color: #0f172a;
}

.analytics-tool-btn:focus-visible,
.analytics-segment:focus-visible,
.analytics-range-input:focus-visible {
  outline: 2px solid var(--chartFocus);
  outline-offset: 2px;
}

.analytics-tool-btn.active,
.analytics-segment.active {
  background: var(--chartControlActive);
  color: #ffffff;
  box-shadow: 0 8px 18px rgba(15,23,42,0.18);
}

.analytics-tool-btn.is-playing {
  background: #166534;
  color: #ffffff;
}

.analytics-toolbar-label {
  padding: 0 5px;
  color: #64748b;
  font: 750 10px/1 var(--chartFont);
  text-transform: uppercase;
}

.analytics-view-mode-bar .compare-bars,
.analytics-view-mode-line .compare-line {
  flex: 1 1 100%;
}

.analytics-view-mode-bar .compare-line,
.analytics-view-mode-line .compare-bars {
  flex: 0 0 0;
  min-height: 0;
  opacity: 0;
  pointer-events: none;
  transform: translateY(8px);
}

.analytics-view-mode-combined {
  position: relative;
}

.analytics-view-mode-combined .compare-bars,
.analytics-view-mode-combined .compare-line {
  position: absolute;
  inset: 16px 18px 18px;
  flex: none;
  min-height: 0;
}

.analytics-view-mode-combined .compare-bars { z-index: 1; }
.analytics-view-mode-combined .compare-line {
  z-index: 2;
  pointer-events: none;
}

.analytics-view-mode-bar .compare-bars,
.analytics-view-mode-line .compare-line,
.analytics-view-mode-combined .compare-bars,
.analytics-view-mode-combined .compare-line {
  opacity: 1;
  transform: translateY(0);
}

.analytics-navigator {
  flex: 0 0 auto;
  display: grid;
  grid-template-columns: minmax(100px, auto) minmax(180px, 1fr) minmax(100px, auto);
  align-items: center;
  gap: 10px;
  padding: 8px 10px;
  border: 1px solid rgba(148,163,184,0.18);
  border-radius: 8px;
  background: var(--chartPanelSubtle);
  -webkit-backdrop-filter: blur(16px) saturate(150%);
  backdrop-filter: blur(16px) saturate(150%);
}

.analytics-range-label,
.analytics-range-value {
  color: #475569;
  font: 650 12px/1.2 var(--chartFont);
  white-space: nowrap;
}

.analytics-range-track {
  position: relative;
  height: 24px;
}

.analytics-range-input {
  position: absolute;
  inset: 0;
  width: 100%;
  margin: 0;
  accent-color: var(--chartAccent, #2563eb);
  background: transparent;
  cursor: pointer;
}

.analytics-range-input + .analytics-range-input {
  pointer-events: none;
}

.analytics-range-input + .analytics-range-input::-webkit-slider-thumb {
  pointer-events: auto;
}

.analytics-range-input + .analytics-range-input::-moz-range-thumb {
  pointer-events: auto;
}

.analytics-intelligence {
  flex: 0 0 auto;
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(220px, .75fr);
  gap: 12px;
}

.analytics-insights,
.analytics-stats {
  min-height: 58px;
  padding: 10px 12px;
  border: 1px solid rgba(148,163,184,0.18);
  border-radius: 8px;
  background: var(--chartPanelSubtle);
  color: #334155;
  -webkit-backdrop-filter: blur(16px) saturate(150%);
  backdrop-filter: blur(16px) saturate(150%);
}

.analytics-insights-title,
.analytics-stats-title {
  margin-bottom: 6px;
  color: #64748b;
  font: 750 10px/1 var(--chartFont);
  letter-spacing: 0;
  text-transform: uppercase;
}

.analytics-insights-body {
  color: #1e293b;
  font: 500 12px/1.45 var(--chartFont);
}

.analytics-stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
}

.analytics-stat {
  min-width: 0;
}

.analytics-stat-label {
  display: block;
  color: #64748b;
  font: 650 10px/1 var(--chartFont);
}

.analytics-stat-value {
  display: block;
  margin-top: 3px;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #0f172a;
  font: 750 12px/1 var(--chartFont);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

/* ========================================
   PAGE 11: CAMPUS ANALYTICS
   ======================================== */
#page11 {
  padding-top: calc(var(--navH) + var(--pad));
  padding-inline: clamp(16px, 2vw, 34px);
  padding-bottom: calc(var(--progH) + var(--pad) + 8px);
}

.campus-analytics-shell {
  width: min(1680px, 96vw);
  height: min(860px, calc((var(--vh) * 100) - var(--navH) - var(--progH) - 32px));
  display: grid;
  grid-template-columns: minmax(280px, 340px) minmax(0, 1fr);
  gap: 14px;
  margin: 0 auto;
}

.campus-selector-panel,
.campus-forecast-panel {
  min-height: 0;
  border: 1px solid var(--graphCardBorder);
  border-radius: 10px;
  background: var(--chartPanelSubtle);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.54);
  -webkit-backdrop-filter: blur(18px) saturate(155%);
  backdrop-filter: blur(18px) saturate(155%);
}

.campus-selector-panel {
  display: flex;
  flex-direction: column;
  padding: 12px;
  color: #1e293b;
}

.campus-selector-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 10px;
}

.campus-selector-title {
  margin: 0;
  color: #0f172a;
  font: 750 14px/1.1 var(--chartFont);
}

.campus-selector-count {
  color: #64748b;
  font: 650 11px/1.2 var(--chartFont);
  white-space: nowrap;
}

.campus-search {
  width: 100%;
  height: 34px;
  border: 1px solid var(--chartControlBorder);
  border-radius: 8px;
  padding: 0 10px;
  background: rgba(255,255,255,0.74);
  color: #0f172a;
  font: 500 13px/1 var(--chartFont);
  outline: none;
}

.campus-search:focus {
  border-color: rgba(37,99,235,0.42);
  box-shadow: 0 0 0 3px rgba(37,99,235,0.12);
}

.campus-action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 7px;
  margin: 10px 0;
}

.campus-action-btn,
.campus-mode-btn {
  min-height: 30px;
  border: 1px solid var(--chartControlBorder);
  border-radius: 7px;
  background: rgba(255,255,255,0.70);
  color: #334155;
  font: 700 11px/1.1 var(--chartFont);
  letter-spacing: 0;
  cursor: pointer;
  transition: background .16s var(--chartEase), color .16s var(--chartEase), border-color .16s var(--chartEase), box-shadow .16s var(--chartEase);
}

.campus-action-btn:hover,
.campus-mode-btn:hover {
  background: rgba(37,99,235,0.08);
  border-color: rgba(37,99,235,0.28);
  color: #0f172a;
}

.campus-mode-btn.active {
  background: #111827;
  border-color: #111827;
  color: #ffffff;
  box-shadow: 0 8px 18px rgba(15,23,42,0.18);
}

.campus-building-list {
  flex: 1 1 auto;
  min-height: 0;
  overflow: auto;
  display: grid;
  gap: 6px;
  padding-right: 2px;
}

.campus-building-row {
  display: grid;
  grid-template-columns: 18px minmax(0, 1fr) auto;
  align-items: center;
  gap: 8px;
  min-height: 38px;
  padding: 7px 8px;
  border: 1px solid rgba(148,163,184,0.16);
  border-radius: 8px;
  background: rgba(255,255,255,0.48);
  cursor: pointer;
  user-select: none;
  transition: background .16s var(--chartEase), border-color .16s var(--chartEase), opacity .16s var(--chartEase);
}

.campus-building-row:hover {
  background: rgba(37,99,235,0.08);
  border-color: rgba(37,99,235,0.22);
}

.campus-building-row.is-selected {
  background: rgba(16,185,129,0.12);
  border-color: rgba(16,185,129,0.32);
}

.campus-building-row.is-muted {
  opacity: .44;
}

.campus-building-check {
  width: 14px;
  height: 14px;
  border: 1px solid rgba(100,116,139,0.42);
  border-radius: 4px;
  background: rgba(255,255,255,0.80);
}

.campus-building-row.is-selected .campus-building-check {
  background: #10b981;
  border-color: #059669;
  box-shadow: inset 0 0 0 3px #ffffff;
}

.campus-building-name {
  min-width: 0;
  color: #0f172a;
  font: 700 12px/1.18 var(--chartFont);
}

/* Name on the first line, usage total on its own line below — the two spans
   used to render inline and collide on long building names. */
.campus-building-name > span {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.campus-building-meta {
  margin-top: 2px;
  color: #64748b;
  font: 600 10px/1.15 var(--chartFont);
  font-variant-numeric: tabular-nums;
}

.campus-building-swatch {
  width: 12px;
  height: 28px;
  border-radius: 999px;
  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.50);
}

.campus-main-grid {
  min-width: 0;
  min-height: 0;
  display: grid;
  grid-template-rows: minmax(0, 1fr) auto;
  gap: 12px;
}

.campus-analytics-card {
  min-height: 0;
}

.campus-chart-controls {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  align-items: center;
  gap: 8px;
}

.campus-chart-control-group {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  min-height: 32px;
  padding: 3px;
  border: 1px solid var(--chartControlBorder);
  border-radius: 8px;
  background: var(--chartControlBg);
}

.campus-forecast-toggle {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  min-height: 32px;
  padding: 0 9px;
  border: 1px solid var(--chartControlBorder);
  border-radius: 8px;
  background: var(--chartControlBg);
  color: var(--chartControlText);
  font: 700 12px/1 var(--chartFont);
  cursor: pointer;
}

.campus-forecast-toggle input {
  accent-color: #2563eb;
}

.campus-chart-wrap {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 0;
}

.campus-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  max-height: 42px;
  overflow: hidden;
  padding-top: 8px;
}

.campus-legend-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  max-width: 168px;
  min-height: 24px;
  padding: 4px 7px;
  border: 1px solid rgba(148,163,184,0.22);
  border-radius: 999px;
  background: rgba(255,255,255,0.62);
  color: #334155;
  font: 650 11px/1 var(--chartFont);
}

.campus-legend-dot {
  flex: 0 0 auto;
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

.campus-legend-label {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.campus-legend-more {
  color: #64748b;
  font: 700 11px/24px var(--chartFont);
}

.campus-forecast-panel {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(280px, .85fr);
  gap: 12px;
  padding: 12px;
}

.campus-forecast-summary,
.campus-forecast-stats {
  min-width: 0;
}

.campus-panel-title {
  margin: 0 0 7px;
  color: #64748b;
  font: 750 10px/1 var(--chartFont);
  letter-spacing: 0;
  text-transform: uppercase;
}

.campus-forecast-copy {
  color: #1e293b;
  font: 500 12px/1.45 var(--chartFont);
}

.campus-forecast-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
}

.campus-forecast-stat {
  min-width: 0;
  padding: 8px;
  border: 1px solid rgba(148,163,184,0.18);
  border-radius: 8px;
  background: rgba(255,255,255,0.46);
}

.campus-forecast-stat span {
  display: block;
  color: #64748b;
  font: 650 10px/1.1 var(--chartFont);
}

.campus-forecast-stat strong {
  display: block;
  margin-top: 4px;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #0f172a;
  font: 760 12px/1.1 var(--chartFont);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

body.graph-bg-dark .campus-selector-panel,
body.graph-bg-dark .campus-forecast-panel,
body.graph-bg-dark .campus-selector-title,
body.graph-bg-dark .campus-building-name,
body.graph-bg-dark .campus-forecast-copy,
body.graph-bg-dark .campus-forecast-stat strong {
