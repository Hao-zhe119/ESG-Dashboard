    function hideZeroMonths(labels, ...series) {
      const keep = labels.map((_, index) => series.some(arr => Number(arr[index] || 0) !== 0));
      const outLabels = [];
      const outSeries = series.map(() => []);
      for (let index = 0; index < labels.length; index++) {
        if (!keep[index]) continue;
        outLabels.push(labels[index]);
        series.forEach((arr, seriesIndex) => outSeries[seriesIndex].push(Number(arr[index] || 0)));
      }
      if (!outLabels.length) return { labels: labels.slice(), series: series.map(array => array.map(value => Number(value || 0))) };
      return { labels: outLabels, series: outSeries };
    }

