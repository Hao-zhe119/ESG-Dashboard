        const recyclableWaste = labels.map((_, index) => Number((months[index] && months[index].recyclableKg) || 0));
        const filtered = hideZeroMonths(labels, generalWaste, recyclableWaste);
        const wasteCharts = function () { return [wasteBarChart, wasteLineChart]; };
        if (wasteBarChart)  { wasteBarChart.destroy();  wasteBarChart = null; }
        if (wasteLineChart) { wasteLineChart.destroy(); wasteLineChart = null; }
        const wasteDs = buildCategoryDatasets("waste", WASTE_CATS, {
          general: filtered.series[0], recyclable: filtered.series[1]
        });
        const builtWaste = makeCategoryPanels({
          barCanvasId: "wasteBarChart", lineCanvasId: "wasteLineChart",
          labels: filtered.labels, barDatasets: wasteDs.barDatasets, lineDatasets: wasteDs.lineDatasets,
          yTitle: "kg"
        });
        wasteBarChart  = builtWaste.barChart;
        wasteLineChart = builtWaste.lineChart;
        buildCategoryControls("wasteColorControls", "waste", WASTE_CATS, wasteCharts);
        reapplyCategoryVisibility(wasteCharts, "waste");
        refreshEnterpriseAnalytics();
        
        // Update chart title with year
        const chartTitle = document.getElementById("wasteChartTitle");
        if (chartTitle) {
          chartTitle.textContent = `Waste Analytics - FY ${selected.year}`;
        }
        
        // Update active state in list
        document.querySelectorAll("#waste-year-list .building-list-item").forEach(li => {
          if (li && li.dataset && li.dataset.year === String(selected.year)) li.classList.add("active");
          else li.classList.remove("active");
        });
        
        // Incremental scroll to active year
        scrollActiveItemIntoView("#waste-year-list", ".building-list-item.active");
        
        if (is_auto_mode && userClick) {
          clearWasteCycleTimer();
          runProgressForPage(7, wasteCycleMs, false);
        }
      }

      window.__applyWasteYearFromControls = applyWasteYear;
      renderList();

      // Initial year selection: auto mode cycles oldest → newest, so start at
      // the oldest; interactive visitors should land on the latest fiscal year.
      const defaultWasteOption = is_auto_mode ? options[0] : options[options.length - 1];
      const initialYear = (wastePendingYear != null) ? wastePendingYear : (defaultWasteOption ? defaultWasteOption.year : null);
      if (initialYear) applyWasteYear(initialYear, false);
      
      if (!is_auto_mode) { 
        stopProgressBarAnimation(); 
        return; 
      }

      // Auto mode: cycle through years
      wasteCycleList = options.map(option => option.year);
      wasteCycleIdx = 0;
      
      const runWasteCycle = () => {
        if (currentPageNumber !== 7) return;
        const year = wasteCycleList[wasteCycleIdx] || null;
        if (year) applyWasteYear(year, false);
        runProgressForPage(7, wasteCycleMs, false);
        wasteCycleTimeoutId = setTimeout(() => {
          wasteCycleIdx++;
          if (wasteCycleIdx >= wasteCycleList.length) { 
            clearWasteCycleTimer(); 
            navigateToNextPage(); 
            return; 
          }
          runWasteCycle();
        }, wasteCycleMs);
      };
      
      clearWasteCycleTimer();
      if (wasteCycleList.length > 0) {
        runWasteCycle();
      } else {
        runProgressForPage(7, wasteCycleMs, true);
      }
    }

    // ============================================================
    // VIDEO PAGE
    // ============================================================
    let videoIndex = 0;
    let __videoBridge = { ready: false, playlistLen: 0, playAtIndex: null };

    function videoBridgeReset() { __videoBridge.ready = false; __videoBridge.playlistLen = 0; __videoBridge.playAtIndex = null; }
    function videoBridgeSet(playlistLen, playAtIndexFn) { __videoBridge.ready = true; __videoBridge.playlistLen = Number(playlistLen || 0); __videoBridge.playAtIndex = (typeof playAtIndexFn === "function") ? playAtIndexFn : null; }

    function setupVideoPageProgressBehavior() {
      clearVideoEndCountdown();
      const video = document.getElementById("esgVideoElement");
      if (!video) return;
      applyAdminVideoSettingsToPlayer(video);

      const tryPlayWithAutoplayFallback = () => {
        try {
          const promise = video.play();
          if (promise && typeof promise.catch === "function") {
            promise.catch(() => {
              try { video.muted = true; video.volume = 0; } catch (error) {}
              try { video.play().catch(() => {}); } catch (error) {}
              setTimeout(sendVideoStateToControls, 120);
            });
          }
        } catch (error) {}
      };

      const playlist = Array.isArray(mediaVideos) ? mediaVideos.slice() : [];
      videoBridgeReset();

      if (!playlist.length) {
        console.log("No videos available, skipping page 8");
        if (is_auto_mode) {
          setTimeout(() => navigateToNextPage(), 100);
          return;
        }
        stopProgressBarAnimation();
        sendVideoStateToControls();
        return;
      }

      if (is_auto_mode) {
        hardResetProgressBar();
        if (progressBarContainerElement) progressBarContainerElement.style.display = "none";
      } else { 
        stopProgressBarAnimation(); 
      }

      const updateVideoCaption = (item) => {
        const overlay = document.getElementById("videoCaptionOverlay");
        if (!overlay) return;
        if (item && item.caption_text) {
          overlay.textContent  = item.caption_text;
          overlay.style.left   = (item.caption_x != null ? item.caption_x : 50) + "%";
          overlay.style.top    = (item.caption_y != null ? item.caption_y : 85) + "%";
          overlay.style.fontSize = (item.caption_font_size || 24) + "px";
          overlay.style.display  = "block";
        } else {
          overlay.style.display = "none";
        }
      };

      let _segmentEndTriggered = false;

      const playAtIndex = (index) => {
        _segmentEndTriggered = false;
        videoIndex = (index + playlist.length) % playlist.length;
        const item = playlist[videoIndex];
        video.src = "/uploads/videos/" + item.filename;
        video._adminFilename = item.filename;
        applyAdminVideoSettingsToPlayerAndSegment(video, item.filename);
        updateVideoCaption(item);
        tryPlayWithAutoplayFallback();
        setTimeout(sendVideoStateToControls, 120);
      };

      videoBridgeSet(playlist.length, playAtIndex);

      const startEndCountdownThenNextPage = () => {
        if (progressBarContainerElement) progressBarContainerElement.style.display = "";
        hardResetProgressBar();
        runProgressForPage(8, getPageDuration(8), true);
      };

      video.onended = () => {
        if (videoIndex >= playlist.length - 1) {
          if (is_auto_mode) startEndCountdownThenNextPage();
        } else {
          playAtIndex(videoIndex + 1);
        }
        setTimeout(sendVideoStateToControls, 80);
      };

      video.onplay = () => setTimeout(sendVideoStateToControls, 50);
      video.onpause = () => setTimeout(sendVideoStateToControls, 50);
      video.onvolumechange = () => { 
        saveAdminVideoSettings({ volume: video.volume, muted: video.muted }); 
        setTimeout(sendVideoStateToControls, 50); 
      };
      video.ontimeupdate = () => {
        const segmentStart = (typeof video._adminSegmentStart === "number" && isFinite(video._adminSegmentStart)) ? video._adminSegmentStart : 0;
        const segmentEnd = (typeof video._adminSegmentEnd === "number" && isFinite(video._adminSegmentEnd) && video._adminSegmentEnd > 0) ? video._adminSegmentEnd : null;
        if (segmentEnd !== null && !_segmentEndTriggered && video.currentTime >= segmentStart) {
          if (video.currentTime + 0.05 >= segmentEnd) {
            _segmentEndTriggered = true;
            if (videoIndex >= playlist.length - 1) {
              if (is_auto_mode) {
                try { video.pause(); } catch (_error) {}
                startEndCountdownThenNextPage();
              } else {
                try { video.pause(); } catch (_error) {}
              }
            } else {
              playAtIndex(videoIndex + 1);
            }
          }
        }
        if (!is_auto_mode && currentPageNumber === 8) sendVideoStateToControls();
      };

      playAtIndex(0);
    }

    // ============================================================
    // ============================================================
    // CAROUSEL PAGE
    // ============================================================
    let imageCarouselTimerId = null;

    function clearImageCarouselTimer() { if (imageCarouselTimerId) clearInterval(imageCarouselTimerId); imageCarouselTimerId = null; }

    function setupImageCarouselPageProgressBehavior() {
      const carouselElement = document.getElementById("esgImageCarousel");
      if (!carouselElement) return;
      
      carouselElement.querySelectorAll(".carousel-control-prev, .carousel-control-next, .carousel-indicators button")
        .forEach(button => button.addEventListener("click", (event) => event.stopPropagation()));

      const items = Array.isArray(mediaImages) ? mediaImages : [];
      
      if (!items.length) {
        console.log("No images available, skipping page 9");
        if (is_auto_mode) {
          setTimeout(() => navigateToNextPage(), 100);
          return;
        }
        stopProgressBarAnimation();
        sendCarouselStateToControls();
        return;
      }

      const carouselInstance = new bootstrap.Carousel(carouselElement, { 
        interval: false, 
        ride: false, 
        pause: false, 
        wrap: true 
      });
      
      carouselElement.addEventListener("slid.bs.carousel", () => {
        sendCarouselStateToControls();
      });

      if (!is_auto_mode) { 
        stopProgressBarAnimation(); 
        sendCarouselStateToControls(); 
        return; 
      }

      // Use timer for per-image duration
      const durationPerItemMs = getPageDuration(9);
      const totalMs = durationPerItemMs * items.length;
      let start = Date.now();
      startManualProgress(totalMs, 0);
      clearImageCarouselTimer();

      imageCarouselTimerId = setInterval(() => {
        if (currentPageNumber !== 9) return;
        const elapsed = Date.now() - start;
        progressTotalDurationMs = totalMs;
        progressElapsedMs = elapsed;
        updateProgressBarWidthFromState();
        const slideIndex = Math.min(items.length - 1, Math.floor(elapsed / durationPerItemMs));
        try { carouselInstance.to(slideIndex); } catch (error) {}
        if (elapsed >= totalMs) { 
          clearImageCarouselTimer(); 
          progressElapsedMs = totalMs; 
          updateProgressBarWidthFromState(); 
          navigateToNextPage(); 
        }
      }, 250);
    }

    function setupThankYouPage() {
      const page = document.getElementById("page10");
      if (page) page.onclick = () => showPageByNumber(1, "right");
      if (!is_auto_mode) { stopProgressBarAnimation(); return; }
      runProgressForPage(10, getPageDuration(10), true);
    }

    // ============================================================
    // PAGE ENTER HOOK
    // ============================================================
    function onEnterPage(pageNum) {
      clearThreeCycleTimer();
      clearSolarCycleTimer();
      clearWasteCycleTimer();
      clearImageCarouselTimer();
      clearVideoEndCountdown();
      if (pageNum === 1) { if (!is_auto_mode) stopProgressBarAnimation(); else runProgressForPage(1, getPageDuration(1), true); }
      else if (pageNum === 2) setupAllBuildingsListPage();
      else if (pageNum === 3) setupElectricityComparePage();
      else if (pageNum === 4) setupWaterComparePage();
      else if (pageNum === 11) setupCampusAnalyticsPage();
      else if (pageNum === 5) setupBuildingThreePanelPage();
      else if (pageNum === 6) setupSolarThreePanelPage();
      else if (pageNum === 7) setupWasteThreePanelPage();
      else if (pageNum === 8) setupVideoPageProgressBehavior();
      else if (pageNum === 9) setupImageCarouselPageProgressBehavior();
      else if (pageNum === 10) setupThankYouPage();
      sendControlPageUpdate();
    }

    // ============================================================
    // CAMPUS MAP MIRROR OVERLAY (audience view, driven by control panel)
    // ============================================================
    let mapReturnPage = null;             // page to restore when the map closes
    // Looked up lazily — these elements sit near </body>, after this script.
    function mapOverlayElement() { return document.getElementById("mapOverlay"); }

    function isMapOverlayOpen() {
      const el = mapOverlayElement();
      return !!(el && el.classList.contains("open"));
    }

    function showMapOverlay() {
      const el = mapOverlayElement();
      if (!el) return;
      if (!isMapOverlayOpen()) mapReturnPage = currentPageNumber; // remember where we were
      // Load the model once, then keep it for instant re-opens.
      const frame = document.getElementById("mapOverlayFrame");
      if (frame && !frame.getAttribute("src")) {
        frame.setAttribute("src", "/interactivemap?embed=1&mode=mirror");
      }
      stopProgressBarAnimation();          // freeze auto-advance while the map is up
      el.classList.add("open");
      el.setAttribute("aria-hidden", "false");
    }

    function hideMapOverlay() {
      const el = mapOverlayElement();
      if (!el) return;
      el.classList.remove("open");
      el.setAttribute("aria-hidden", "true");
    }

    // Close the map and return to the page the guest left before opening it.
    function closeMapAndRestore() {
      hideMapOverlay();
      const target = (mapReturnPage != null) ? mapReturnPage : currentPageNumber;
      mapReturnPage = null;
      if (target === currentPageNumber) onEnterPage(currentPageNumber); // resume timers in place
      else showPageByNumber(target, "right");
    }

    // ============================================================
    // CONTROLS WINDOW MESSAGE HANDLER
    // ============================================================
    window.addEventListener("message", (event) => {
      if (event.origin !== window.location.origin) return;
      if (!event.data) return;
      markInteractiveActivityClient();

      if (event.data.type === "SHOW_MAP") { showMapOverlay(); return; }
      if (event.data.type === "CLOSE_MAP") { closeMapAndRestore(); return; }

      if (event.data.type === "SET_BUILDING") {
        const buildingCode = normalizeBuildingKey(event.data.building);
        if (!buildingCode) return;
        hideMapOverlay(); // reveal the full data on the big screen
        if (currentPageNumber !== 5) showPageByNumber(5, "left");
        clearThreeCycleTimer();
        setThreePanelBuilding(buildingCode);
        return;
      }

      if (event.data.type === "NAV_PREV") { navigateToPreviousPage(); return; }
      if (event.data.type === "NAV_NEXT") { navigateToNextPage(); return; }
      if (event.data.type === "NAV_PAGE") {
        const pageNumber = Number(event.data.page);
        if (enabledPages().includes(pageNumber)) showPageByNumber(pageNumber, pageNumber > currentPageNumber ? "left" : "right");
        return;
      }

      if (event.data.type === "VIDEO_PLAY") {
        const videoElement = document.getElementById("esgVideoElement");
        if (videoElement) { try { videoElement.play(); } catch (error) {} }
        setTimeout(sendVideoStateToControls, 80);
        return;
      }
      if (event.data.type === "VIDEO_PAUSE") {
        const videoElement = document.getElementById("esgVideoElement");
        if (videoElement) { try { videoElement.pause(); } catch (error) {} }
        setTimeout(sendVideoStateToControls, 80);
        return;
      }
      if (event.data.type === "VIDEO_PLAY_PAUSE") {
        const videoElement = document.getElementById("esgVideoElement");
        if (videoElement) {
          try {
            if (videoElement.paused) videoElement.play();
            else videoElement.pause();
          } catch (error) {}
        }
        setTimeout(sendVideoStateToControls, 80);
        return;
      }

      if (event.data.type === "VIDEO_MUTE") {
        const videoElement = document.getElementById("esgVideoElement");
        if (videoElement) {
          videoElement.muted = true;
          saveAdminVideoSettings({ muted: true });
        }
        setTimeout(sendVideoStateToControls, 80);
        return;
      }
      if (event.data.type === "VIDEO_UNMUTE") {
        const videoElement = document.getElementById("esgVideoElement");
        if (videoElement) {
          videoElement.muted = false;
          saveAdminVideoSettings({ muted: false });
        }
        setTimeout(sendVideoStateToControls, 80);
        return;
      }
      if (event.data.type === "VIDEO_SET_VOLUME") {
        const videoElement = document.getElementById("esgVideoElement");
        if (videoElement && typeof event.data.volume === "number") {
          const clampedVolume = clamp01(event.data.volume);
          if (clampedVolume !== null) {
            videoElement.volume = clampedVolume;
            saveAdminVideoSettings({ volume: clampedVolume });
          }
        }
        setTimeout(sendVideoStateToControls, 80);
        return;
      }
      if (event.data.type === "VIDEO_SEEK") {
        const videoElement = document.getElementById("esgVideoElement");
        if (videoElement) {
          if (typeof event.data.ratio === "number" && isFinite(event.data.ratio)) {
            const duration = videoElement.duration;
            if (isFinite(duration) && duration > 0) {
              const targetTime = Math.max(0, Math.min(duration, event.data.ratio * duration));
              videoElement.currentTime = targetTime;
            }
          }
          else if (typeof event.data.time === "number" && isFinite(event.data.time)) {
            videoElement.currentTime = Math.max(0, event.data.time);
          }
        }
        setTimeout(sendVideoStateToControls, 80);
        return;
      }
      if (event.data.type === "VIDEO_PREV") {
        if (__videoBridge.ready && typeof __videoBridge.playAtIndex === "function") {
          __videoBridge.playAtIndex(videoIndex - 1);
        }
        setTimeout(sendVideoStateToControls, 80);
        return;
      }
      if (event.data.type === "VIDEO_NEXT") {
        if (__videoBridge.ready && typeof __videoBridge.playAtIndex === "function") {
          __videoBridge.playAtIndex(videoIndex + 1);
        }
        setTimeout(sendVideoStateToControls, 80);
        return;
      }

      if (event.data.type === "CAROUSEL_PREV") {
        const carouselElement = document.getElementById("esgImageCarousel");
        if (!carouselElement) return;
        try {
          const carouselInstance = bootstrap.Carousel.getOrCreateInstance(carouselElement);
          carouselInstance.prev();
        } catch (error) {}
        setTimeout(sendCarouselStateToControls, 80);
        return;
      }
      if (event.data.type === "CAROUSEL_NEXT") {
        const carouselElement = document.getElementById("esgImageCarousel");
        if (!carouselElement) return;
        try {
          const carouselInstance = bootstrap.Carousel.getOrCreateInstance(carouselElement);
          carouselInstance.next();
        } catch (error) {}
        setTimeout(sendCarouselStateToControls, 80);
        return;
      }
      if (event.data.type === "CAROUSEL_TO") {
        const carouselElement = document.getElementById("esgImageCarousel");
        if (!carouselElement) return;
        const slideIndex = Number(event.data.index);
        if (!isFinite(slideIndex) || slideIndex < 0) return;
        try {
          const carouselInstance = bootstrap.Carousel.getOrCreateInstance(carouselElement);
          carouselInstance.to(slideIndex);
        } catch (error) {}
        setTimeout(sendCarouselStateToControls, 80);
        return;
      }

      if (event.data.type === "SET_SOLAR_YEAR") {
        const year = event.data.year;
        if (currentPageNumber !== 6) {
          solarPendingYear = year;
          showPageByNumber(6, "left");
        } else if (typeof window.__applySolarYearFromControls === "function") {
          clearSolarCycleTimer();
          window.__applySolarYearFromControls(year, false);
        }
        return;
      }

      if (event.data.type === "SET_WASTE_YEAR") {
        const year = event.data.year;
        if (currentPageNumber !== 7) {
          wastePendingYear = year;
          showPageByNumber(7, "left");
        } else if (typeof window.__applyWasteYearFromControls === "function") {
          clearWasteCycleTimer();
          window.__applyWasteYearFromControls(year, false);
        }
        return;
      }

      if (event.data.type === "REQUEST_STATE") {
        sendControlPageUpdate();
        sendDashboardMetaToControls();
        if (currentPageNumber === 5) sendCurrentBuildingToControls();
        if (currentPageNumber === 8) sendVideoStateToControls();
        if (currentPageNumber === 9) sendCarouselStateToControls();
        return;
      }

      if (event.data.type === "REQUEST_BUILDING_LIST") {
        ensureAllBuildingsPrepared();
        safePostToControls({
          type: "BUILDING_LIST",
          buildings: allBuildingCodes.map(buildingCode => ({
            code: buildingCode,
            label: labelForBuilding(buildingCode),
            ...buildingTotals(buildingCode)
          }))
        });
        return;
      }

      if (event.data.type === "REQUEST_YEAR_LIST") {
        safePostToControls({
          type: "YEAR_LIST",
          allYears: allYears,
          oldestYear: oldestYear,
          newestYear: newestYear,
          latestYear: latestDataYear
        });
        return;
      }
    });

    // ============================================================
    // ARROW BUTTONS VISIBILITY
    // ============================================================
    function updateArrowButtonVisibility() {
      if (is_auto_mode) {
        if (backArrowButton) backArrowButton.style.display = "none";
        if (nextArrowButton) nextArrowButton.style.display = "none";
      } else {
        if (backArrowButton) backArrowButton.style.display = "";
        if (nextArrowButton) nextArrowButton.style.display = "";
      }
    }

    // ============================================================
    // VIEWPORT HEIGHT FIX
    // ============================================================
    function setVHUnit() {
      const viewportHeight = window.innerHeight * 0.01;
      document.documentElement.style.setProperty("--vh", viewportHeight + "px");
    }
    window.addEventListener("resize", setVHUnit);
    window.addEventListener("orientationchange", setVHUnit);
    setVHUnit();

    // ============================================================
    // FULLSCREEN CLASS TOGGLE
    // ============================================================
    function updateFullscreenClass() {
      const apiFullscreen = !!(document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement || document.msFullscreenElement);
      const f11Fullscreen = (window.innerHeight === screen.height && window.innerWidth === screen.width);
      const isFullscreen = apiFullscreen || f11Fullscreen;
      document.body.classList.toggle("is-fullscreen", isFullscreen);
    }
    document.addEventListener("fullscreenchange", updateFullscreenClass);
    document.addEventListener("webkitfullscreenchange", updateFullscreenClass);
    document.addEventListener("mozfullscreenchange", updateFullscreenClass);
    document.addEventListener("MSFullscreenChange", updateFullscreenClass);
    window.addEventListener("resize", updateFullscreenClass);
    updateFullscreenClass();

    // ============================================================
    // KEYBOARD NAVIGATION
    // ============================================================
    document.addEventListener("keydown", (event) => {
      if (is_auto_mode) return;
      if (event.key === "ArrowRight" || event.key === "PageDown") {
        event.preventDefault();
        navigateToNextPage();
      } else if (event.key === "ArrowLeft" || event.key === "PageUp") {
        event.preventDefault();
        navigateToPreviousPage();
      } else if (event.key === "Home") {
        event.preventDefault();
        showPageByNumber(1, "right");
      } else if (event.key === "End") {
        event.preventDefault();
        const pages = enabledPages();
        showPageByNumber(pages[pages.length - 1] || 10, "left");
      }
    });

    // ============================================================
    // TOUCH/SWIPE NAVIGATION
    // ============================================================
    let touchStartX = 0;
    let touchEndX = 0;

    document.addEventListener("touchstart", (event) => {
      touchStartX = event.changedTouches[0].screenX;
    }, { passive: true });

    document.addEventListener("touchend", (event) => {
      if (is_auto_mode) return;
      touchEndX = event.changedTouches[0].screenX;
      const swipeDifference = touchStartX - touchEndX;
      if (Math.abs(swipeDifference) > 80) {
        if (swipeDifference > 0) navigateToNextPage();
        else navigateToPreviousPage();
      }
    }, { passive: true });

    // ============================================================
    // WINDOW LOAD: INITIALIZATION
    // ============================================================
    window.addEventListener("load", () => {
      updateArrowButtonVisibility();
      ensureAllBuildingsPrepared();

      // ── Deep-link from 3D map: /?building=e1 ──
      const startupParams = new URLSearchParams(window.location.search);
      const requestedBuilding = startupParams.get("building");
      const requestedPage = String(startupParams.get("page") || "").toLowerCase();
      const targetBuildingCode = requestedBuilding ? normalizeBuildingKey(requestedBuilding) : null;

      if (targetBuildingCode) {
        currentPageNumber = 5;
        document.querySelectorAll(".page").forEach(p => {
          p.classList.remove("active-page");
          p.style.transform = "";
          p.style.opacity = "";
        });
        const page5 = document.getElementById("page5");
        if (page5) page5.classList.add("active-page");
        onEnterPage(5);
        setTimeout(() => {
          clearThreeCycleTimer();
          setThreePanelBuilding(targetBuildingCode);
        }, 150);
      } else if (requestedPage === "campus-analytics" || requestedPage === "campus") {
        currentPageNumber = 11;
        document.querySelectorAll(".page").forEach(p => {
          p.classList.remove("active-page");
          p.style.transform = "";
          p.style.opacity = "";
        });
        const page11 = document.getElementById("page11");
        if (page11) page11.classList.add("active-page");
        onEnterPage(11);
      } else {
        onEnterPage(currentPageNumber);
      }

      setTimeout(() => {
        sendControlPageUpdate();
        sendDashboardMetaToControls();
      }, 200);
    });

    // ============================================================
    // BROADCAST CHANNEL: CROSS-TAB SYNC
    // ============================================================
    (function initBroadcastSync() {
      try {
        const broadcastChannel = new BroadcastChannel("esg_dashboard_sync");

        broadcastChannel.onmessage = (event) => {
          const message = event && event.data;
          if (!message) return;

          if (message.type === "PAGE_CHANGE" && !is_auto_mode) {
            const pageNumber = Number(message.page);
            if (enabledPages().includes(pageNumber) && pageNumber !== currentPageNumber) {
              showPageByNumber(pageNumber, pageNumber > currentPageNumber ? "left" : "right");
            }
          }

          if (message.type === "BUILDING_CHANGE" && !is_auto_mode && currentPageNumber === 5) {
            const buildingCode = normalizeBuildingKey(message.building);
            if (buildingCode) {
              clearThreeCycleTimer();
              setThreePanelBuilding(buildingCode);
            }
          }
        };

        const originalShowPage = showPageByNumber;
        window.showPageByNumber = function(pageNumber, direction) {
