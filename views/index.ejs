    // PAGE 6: SOLAR - WITH YEAR CYCLING IN AUTO MODE
    // ============================================================
    let solarThreeChart = null;
    let solarCycleTimeoutId = null;
    let solarCycleList = [];
    let solarCycleIdx = 0;
    let solarCycleMs = getPageDuration(6);

    function clearSolarCycleTimer() {
      if (solarCycleTimeoutId) clearTimeout(solarCycleTimeoutId);
      solarCycleTimeoutId = null;
    }

    function setupSolarThreePanelPage() {
      clearSolarCycleTimer();
      solarCycleMs = getPageDuration(6);
      
      const leftBody = document.getElementById("solarLeftBody");
      if (leftBody) leftBody.innerHTML = "<div class='slug-sandbox'><p class='text-muted'>Loading solar info...</p></div>";

      function loadSolarLeftPanel(year) {
      const element = document.getElementById("solarLeftBody");
      if (!element) return;
      
      fetch(`/infographics/SolarInfo?year=${encodeURIComponent(String(year || ""))}`)
        .then(response => response.text())
        .then(html => { 
          element.innerHTML = html; 
          
          // Use MutationObserver to detect when content is added
          const observer = new MutationObserver((mutations) => {
            mutations.forEach((mutation) => {
              if (mutation.addedNodes.length) {
                // Check if our target element exists
                if (document.getElementById('solarTotalValue')) {
                  initSolarCountAnimation();
                  observer.disconnect(); // Stop observing
                }
              }
            });
          });
          
          // Start observing the container
          observer.observe(element, { childList: true, subtree: true });
          
          // Also try immediately in case it's already there
          setTimeout(() => {
            if (document.getElementById('solarTotalValue')) {
              initSolarCountAnimation();
              observer.disconnect();
            }
          }, 50);
        })
        .catch(() => { 
          element.innerHTML = "<div class='slug-sandbox'><p class='text-muted'>No solar info available.</p></div>"; 
        });
    }

      const yearLabel = document.getElementById("solarYearLabel");
