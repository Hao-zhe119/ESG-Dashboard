    const barValueLabelPlugin = {
      id: "barValueLabel",
      afterDatasetsDraw(chart, args, pluginOptions) {
        try {
          const options = pluginOptions || {};
          if (!options.enabled) return;
          const mode = String(options.mode || "all");
          const context = chart.ctx;
          const datasets = chart.data?.datasets || [];

          const isPositiveFiniteNumber = (value) => {
            const number = Number(value);
            return Number.isFinite(number) && number > 0;
          };

          const formatValue = (value) => {
            const number = Number(value);
            if (!Number.isFinite(number)) return "";
            return number.toLocaleString(undefined, { maximumFractionDigits: 0 });
          };

          const maxValuePerDataset = new Map();
          let globalMaxValue = -Infinity;

          datasets.forEach((dataset, datasetIndex) => {
            if (!dataset) return;
            if (String(dataset.label || "").startsWith("_")) return;
            const datasetType = String(dataset.type || chart.config.type || "");
            if (datasetType && datasetType !== "bar" && datasetType !== "line") return;
            const meta = chart.getDatasetMeta(datasetIndex);
            if (!meta || meta.hidden) return;
            const dataArray = Array.isArray(dataset.data) ? dataset.data : [];
            let datasetMaxValue = -Infinity;
            dataArray.forEach((dataPoint) => {
              if (!isPositiveFiniteNumber(dataPoint)) return;
              if (dataPoint > datasetMaxValue) datasetMaxValue = dataPoint;
              if (dataPoint > globalMaxValue) globalMaxValue = dataPoint;
            });
            maxValuePerDataset.set(datasetIndex, datasetMaxValue);
          });

          context.save();
          context.textAlign = "center";
          context.textBaseline = "bottom";
          context.font = "700 12px Arial";
          context.fillStyle = "#111827";

          datasets.forEach((dataset, datasetIndex) => {
            if (!dataset) return;
            if (String(dataset.label || "").startsWith("_")) return;
            const datasetType = String(dataset.type || chart.config.type || "");
            if (datasetType && datasetType !== "bar" && datasetType !== "line") return;
            const meta = chart.getDatasetMeta(datasetIndex);
            if (!meta || meta.hidden) return;
            const datasetMaxValue = maxValuePerDataset.get(datasetIndex);
            const dataArray = Array.isArray(dataset.data) ? dataset.data : [];
            const chartElements = meta.data || [];
            if (mode === "max-per-dataset" && !isPositiveFiniteNumber(datasetMaxValue)) return;

            chartElements.forEach((element, dataIndex) => {
              const value = Number(dataArray[dataIndex]);
              if (!element || !isPositiveFiniteNumber(value)) return;
              let shouldDrawLabel = false;
              if (mode === "all") shouldDrawLabel = true;
              else if (mode === "max-global") shouldDrawLabel = value === globalMaxValue;
              else if (mode === "max-per-dataset") shouldDrawLabel = value === datasetMaxValue;
              if (!shouldDrawLabel) return;
              const position = (typeof element.getProps === "function")
                ? element.getProps(["x", "y", "base"], true)
                : { x: element.x, y: element.y, base: element.base };
              const xPosition = position.x;
              const yTop = Number.isFinite(position.base) ? Math.min(position.y, position.base) : position.y;
              context.fillText(formatValue(value), xPosition, yTop - 4);
            });
          });
          context.restore();
        } catch (error) {}
      }
    };

    try { Chart.register(barValueLabelPlugin); } catch (error) {}

    const snapLinePointsToBars = {
      id: "snapLinePointsToBars",
      beforeDatasetDraw(chart, args) {
        try {
          const lineDatasetIndex = args.index;
          const datasetsList = chart?.data?.datasets || [];
          const lineDataset = datasetsList[lineDatasetIndex];
          if (!lineDataset || lineDataset.type !== "line") return;
          const barDatasetIndex = Number(lineDataset.snapToBarIndex);
          if (!isFinite(barDatasetIndex)) return;
          const barMeta = chart.getDatasetMeta(barDatasetIndex);
          const lineMeta = chart.getDatasetMeta(lineDatasetIndex);
          if (!barMeta || !lineMeta) return;
          const barElements = barMeta.data || [];
          const linePoints = lineMeta.data || [];
          const count = Math.min(barElements.length, linePoints.length);
          for (let index = 0; index < count; index++) {
            const barElement = barElements[index];
            const linePoint = linePoints[index];
            if (!barElement || !linePoint) continue;
            const barXPosition = (typeof barElement.getProps === "function") ? barElement.getProps(["x"], true).x : barElement.x;
            if (typeof barXPosition === "number") {
              linePoint.x = barXPosition;
              if (typeof linePoint.controlPointPreviousX === "number") linePoint.controlPointPreviousX = barXPosition;
              if (typeof linePoint.controlPointNextX === "number") linePoint.controlPointNextX = barXPosition;
            }
          }
        } catch (error) {}
      }
    };

