      if (progressIntervalId) clearInterval(progressIntervalId);
      progressIntervalId = null;
      progressElapsedMs = 0;
      if (progressBarFillElement) progressBarFillElement.style.width = "0%";
    }

    function setProgressBarToComputedElapsed(totalMs, elapsedMs, autoAdvance) {
      if (!is_auto_mode) return;
      progressTotalDurationMs = Math.max(1, Number(totalMs || 1));
      progressElapsedMs = Math.max(0, Number(elapsedMs || 0));
      progressStartTimestampMs = Date.now() - progressElapsedMs;
      isAutoAdvanceEnabled = !!autoAdvance;
      progressActivePage = currentPageNumber;
      if (!progressBarFillElement) return;
      const percentage = Math.max(0, Math.min(100, (progressElapsedMs / progressTotalDurationMs) * 100));
      progressBarFillElement.style.width = percentage + "%";
      if (progressIntervalId) clearInterval(progressIntervalId);
      progressIntervalId = setInterval(() => {
        if (progressActivePage !== currentPageNumber) return;
        const now = Date.now();
        const elapsed = now - progressStartTimestampMs;
        progressElapsedMs = elapsed;
        const percent = Math.max(0, Math.min(100, (elapsed / progressTotalDurationMs) * 100));
        progressBarFillElement.style.width = percent + "%";
        if (elapsed >= progressTotalDurationMs) {
          clearInterval(progressIntervalId);
          progressIntervalId = null;
          progressBarFillElement.style.width = "100%";
          if (isAutoAdvanceEnabled && progressActivePage === currentPageNumber) {
            navigateToNextPage();
          }
        }
      }, 100);
    }

    function updateProgressBarWidthFromState() {
      if (!progressBarFillElement) return;
      const percentage = Math.max(0, Math.min(100, (progressElapsedMs / progressTotalDurationMs) * 100));
      progressBarFillElement.style.width = percentage + "%";
    }

    function startManualProgress(totalMs, elapsedMs) {
      if (!is_auto_mode) return;
      if (progressIntervalId) clearInterval(progressIntervalId);
      progressIntervalId = null;
      progressTotalDurationMs = Math.max(1, Number(totalMs || 1));
      progressElapsedMs = Math.max(0, Number(elapsedMs || 0));
      progressStartTimestampMs = Date.now() - progressElapsedMs;
      isAutoAdvanceEnabled = false;
      progressActivePage = currentPageNumber;
      updateProgressBarWidthFromState();
    }

    function runProgressForPage(pageNum, totalMs, autoAdvance) {
      if (!is_auto_mode) return;
      setProgressBarToComputedElapsed(totalMs, 0, autoAdvance);
    }

    // ============================================================
    // INTERACTIVE MODE AUTO-REVERT
    // ============================================================
    const interactive_config = (runtime_config && runtime_config.interactiveMode) ? runtime_config.interactiveMode : {};
    const interactive_auto_switch_enabled = interactive_config.autoSwitchOnActivity !== false;
    const interactive_auto_revert_enabled = !!interactive_config.autoRevertEnabled;
    const interactive_idle_timeout_ms = Math.max(1, Number(interactive_config.idleTimeoutMinutes || 15)) * 60 * 1000;
    let interactiveLastActivityAt = Date.now();
    let interactiveActivityPingTimer = null;
    let interactiveRevertTimer = null;
    let interactiveSwitchPending = false;

    async function pingInteractiveActivity() {
      if ((!is_auto_mode && !interactive_auto_revert_enabled) || interactiveSwitchPending) return;
      try {
        if (is_auto_mode) interactiveSwitchPending = true;
        const response = await fetch("/dashboard/interactive-activity", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ activityAt: new Date().toISOString() })
        });
        const json = await response.json().catch(() => ({}));
        if (json.switched) {
          window.location.href = "/";
          return;
        }
      } catch (error) {
      } finally {
        interactiveSwitchPending = false;
      }
    }

    function markInteractiveActivityClient() {
      if (is_auto_mode && !interactive_auto_switch_enabled) return;
      if (!is_auto_mode && !interactive_auto_revert_enabled) return;
      interactiveLastActivityAt = Date.now();
      if (interactiveActivityPingTimer) return;
      interactiveActivityPingTimer = setTimeout(() => {
        interactiveActivityPingTimer = null;
        pingInteractiveActivity();
      }, 1000);
    }

    function startInteractiveAutoRevertWatcher() {
      if (is_auto_mode || !interactive_auto_revert_enabled) return;
      pingInteractiveActivity();
      if (interactiveRevertTimer) clearInterval(interactiveRevertTimer);
      interactiveRevertTimer = setInterval(async () => {
        if (Date.now() - interactiveLastActivityAt < interactive_idle_timeout_ms) return;
        try {
          await fetch("/dashboard/interactive-revert", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({})
          });
        } catch (error) {}
        window.location.href = "/?mode=auto";
      }, 5000);
    }

    ["mousemove", "mousedown", "keydown", "touchstart", "scroll"].forEach((eventName) => {
      window.addEventListener(eventName, markInteractiveActivityClient, { passive: true });
    });

    // ============================================================
    // ADMIN VIDEO SETTINGS
    // ============================================================
    const ADMIN_VIDEO_SETTINGS_KEY = "esg_video_settings";
    const ADMIN_VIDEO_SETTINGS_BY_FILE_KEY = "esg_video_settings_by_file";
    const ADMIN_VIDEO_SETTINGS_CHANNEL = "esg_video_settings_channel";

    function clamp01(inputValue) {
      const number = Number(inputValue);
      if (!isFinite(number)) return null;
      return Math.max(0, Math.min(1, number));
    }

    function parseAdminVideoTime(inputValue) {
      if (inputValue === null || inputValue === undefined || String(inputValue).trim() === "") return null;
      const number = Number(inputValue);
      if (!isFinite(number) || number < 0) return null;
      return Math.max(0, Math.floor(number));
    }

    function readAdminVideoSettings() {
      try {
        const raw = localStorage.getItem(ADMIN_VIDEO_SETTINGS_KEY);
        if (!raw) return null;
        const settings = JSON.parse(raw);
        if (!settings || typeof settings !== "object") return null;
        const volume = (settings.volume != null) ? clamp01(settings.volume) : null;
        const muted = (typeof settings.muted === "boolean") ? settings.muted : null;
        const startTime = (settings.startTime != null) ? parseAdminVideoTime(settings.startTime) : null;
        const duration = (settings.duration != null) ? parseAdminVideoTime(settings.duration) : null;
        return { volume: volume, muted, startTime, duration };
      } catch (error) { return null; }
    }

    function saveAdminVideoSettings(next) {
      try {
        const current = readAdminVideoSettings() || {};
        const merged = {
          volume: (next && next.volume != null) ? clamp01(next.volume) : current.volume,
          muted: (next && typeof next.muted === "boolean") ? !!next.muted : current.muted,
          startTime: (next && next.startTime != null) ? parseAdminVideoTime(next.startTime) : current.startTime,
          duration: (next && next.duration != null) ? parseAdminVideoTime(next.duration) : current.duration
        };
        localStorage.setItem(ADMIN_VIDEO_SETTINGS_KEY, JSON.stringify(merged));
        return merged;
      } catch (error) { return null; }
    }

    function readAdminVideoSettingsByFile() {
      try {
        const raw = localStorage.getItem(ADMIN_VIDEO_SETTINGS_BY_FILE_KEY);
        if (!raw) return {};
        const payload = JSON.parse(raw);
        return (payload && typeof payload === "object") ? payload : {};
      } catch (error) {
        return {};
      }
    }

    function readAdminVideoSettingsForFile(filename) {
      if (!filename) return null;
      const fileSettings = readAdminVideoSettingsByFile();
      const entry = (fileSettings && typeof fileSettings === "object") ? fileSettings[filename] : null;
      if (!entry || typeof entry !== "object") return null;
      const startTime = (entry.startTime != null) ? parseAdminVideoTime(entry.startTime) : null;
      const duration = (entry.duration != null) ? parseAdminVideoTime(entry.duration) : null;
      return { startTime, duration };
    }

    function applyAdminVideoSettingsToPlayer(videoElement) {
      const video = videoElement || document.getElementById("esgVideoElement");
      if (!video) return;
      try { video.removeAttribute("muted"); } catch (error) {}
      const settings = readAdminVideoSettings();
      const targetVolume = (settings && typeof settings.volume === "number") ? settings.volume : 0.5;
      const targetMuted = (settings && typeof settings.muted === "boolean") ? settings.muted : true;
      try {
        const clampedVolume = clamp01(targetVolume);
        if (clampedVolume != null) video.volume = clampedVolume;
      } catch (error) {}
      try { video.muted = !!targetMuted; } catch (error) {}
    }

    function applyAdminVideoSegmentToPlayer(videoElement, filename) {
      const video = videoElement || document.getElementById("esgVideoElement");
      if (!video) return;
      const settings = readAdminVideoSettings();
      const fileSettings = readAdminVideoSettingsForFile(filename || video._adminFilename);
      const startTime = (fileSettings && fileSettings.startTime != null)
        ? fileSettings.startTime
        : ((settings && settings.startTime != null) ? settings.startTime : 0);
      const duration = (fileSettings && fileSettings.duration != null)
        ? fileSettings.duration
        : ((settings && settings.duration != null && settings.duration > 0) ? settings.duration : null);
      const clampedStart = Math.max(0, startTime);
      const segmentEnd = (duration != null && duration > 0) ? clampedStart + duration : null;
      video._adminSegmentStart = clampedStart;
      video._adminSegmentDuration = (duration != null && duration > 0) ? duration : null;
      video._adminSegmentEnd = segmentEnd;

      const seekToStart = () => {
        if (!video.duration || !isFinite(video.duration)) return;
        const safeStart = Math.min(clampedStart, video.duration);
        if (Math.abs(video.currentTime - safeStart) > 0.5) {
          try { video.currentTime = safeStart; } catch (_error) {}
        }
      };

      if (video.readyState >= 1) {
        seekToStart();
      } else {
        video.addEventListener("loadedmetadata", function onVideoLoaded() {
          seekToStart();
        }, { once: true });
      }
    }

    function applyAdminVideoSettingsToPlayerAndSegment(videoElement, filename) {
      applyAdminVideoSettingsToPlayer(videoElement);
      applyAdminVideoSegmentToPlayer(videoElement, filename);
    }

    (function initAdminVideoSettingsListeners() {
      window.addEventListener("load", () => { applyAdminVideoSettingsToPlayerAndSegment(); });
      window.addEventListener("storage", (event) => {
        if (event.key === ADMIN_VIDEO_SETTINGS_KEY || event.key === ADMIN_VIDEO_SETTINGS_BY_FILE_KEY) {
          applyAdminVideoSettingsToPlayerAndSegment();
          if (!is_auto_mode && currentPageNumber === 8) sendVideoStateToControls();
        }
      });
      try {
        const broadcastChannel = new BroadcastChannel(ADMIN_VIDEO_SETTINGS_CHANNEL);
        broadcastChannel.onmessage = (event) => {
          const message = event && event.data;
        if (!message) return;
        if (message.type === "ADMIN_VIDEO_SETTINGS") {
          saveAdminVideoSettings({
            volume: message.volume,
            muted: message.muted,
            startTime: message.startTime,
            duration: message.duration
          });
          applyAdminVideoSettingsToPlayerAndSegment();
        } else if (message.type === "ADMIN_VIDEO_SETTINGS_PER_FILE") {
          applyAdminVideoSettingsToPlayerAndSegment();
        } else {
          return;
        }
        if (!is_auto_mode && currentPageNumber === 8) sendVideoStateToControls();
        };
      } catch (error) {}
    })();

    // ============================================================
    // BUILDING CONTROLS WINDOW
    // ============================================================
    window.buildingControlWin = null;

    function safePostToControls(payload) {
      try {
        if (window.buildingControlWin && !window.buildingControlWin.closed) {
          window.buildingControlWin.postMessage(payload, window.location.origin);
        }
      } catch (error) {}
    }

    function controlModeForPage(pageNum) {
      if (pageNum >= 5 && pageNum <= 7) return "building";
      if (pageNum === 8 && hasVideos) return "video";
      if (pageNum === 9 && hasImages) return "carousel";
      return "nav";
    }

    function sendDashboardMetaToControls() {
      if (is_auto_mode) return;
      safePostToControls({
        type: "DASHBOARD_META",
        allYears: allYears,
        oldestYear: oldestYear,
        newestYear: newestYear,
        latestYear: latestDataYear,
        currentPage: currentPageNumber
      });
    }

    function sendControlPageUpdate() {
      if (is_auto_mode) return;
      safePostToControls({
        type: "DASHBOARD_PAGE_UPDATE",
        page: currentPageNumber,
        mode: controlModeForPage(currentPageNumber),
        buildingPages: [5, 6, 7],
        videoPage: hasVideos ? 8 : null,
        carouselPage: hasImages ? 9 : null,
        hasVideos: hasVideos,
        hasImages: hasImages,
        enabledPages: enabledPages()
      });
      sendDashboardMetaToControls();
      if (currentPageNumber === 8 && hasVideos) sendVideoStateToControls();
      if (currentPageNumber === 9 && hasImages) sendCarouselStateToControls();
      if (currentPageNumber === 5) sendCurrentBuildingToControls();
    }

    function sendVideoStateToControls() {
      if (is_auto_mode) return;
      const video = document.getElementById("esgVideoElement");
      if (!video) return;
      safePostToControls({
        type: "VIDEO_STATE",
        paused: !!video.paused,
        muted: !!video.muted,
        volume: (typeof video.volume === "number") ? video.volume : 1,
        currentTime: (typeof video.currentTime === "number") ? video.currentTime : 0,
        duration: (typeof video.duration === "number" && isFinite(video.duration)) ? video.duration : 0
      });
    }

    function sendCarouselStateToControls() {
      if (is_auto_mode) return;
      const carouselElement = document.getElementById("esgImageCarousel");
      if (!carouselElement) return;
      const items = carouselElement.querySelectorAll(".carousel-item");
      const activeIndex = Array.from(items).findIndex(item => item.classList.contains("active"));
      safePostToControls({
        type: "CAROUSEL_STATE",
        index: Math.max(0, activeIndex),
        total: items.length || 0
      });
    }

    function sendCurrentBuildingToControls() {
      if (is_auto_mode) return;
      const titleElement = document.getElementById("threeInfoTitle");
      if (!titleElement) return;
      const buildingCode = normalizeBuildingKey(titleElement.textContent);
      const totals = buildingTotals(buildingCode);
      safePostToControls({
        type: "BUILDING_UPDATE",
        building: buildingCode,
        label: labelForBuilding(buildingCode),
        electricity: totals.electricity,
        water: totals.water
      });
    }

    window.addEventListener("load", () => {
      if (is_auto_mode) return;
      if (!window.buildingControlWin || window.buildingControlWin.closed) {
        window.buildingControlWin = window.open(
          "/buildingControls?mode=interactive&startPage=1",
          "buildingControls",
          "width=520,height=780,resizable=yes"
        );
      }
      setTimeout(() => { sendControlPageUpdate(); }, 150);
      setTimeout(() => { sendDashboardMetaToControls(); }, 180);
    });

    function openBuildingControlsWindow() {
      if (window.buildingControlWin && !window.buildingControlWin.closed) {
        window.buildingControlWin.focus();
        return;
      }
      window.buildingControlWin = window.open(
        "/buildingControls?mode=interactive&startPage=" + String(currentPageNumber || 1),
        "buildingControls",
        "width=520,height=780,resizable=yes"
      );
      setTimeout(() => {
        sendControlPageUpdate();
        sendDashboardMetaToControls();
      }, 200);
    }

    // ============================================================
    // CLEANUP HELPERS
    // ============================================================
    let videoEndCountdownId = null;

    function clearVideoEndCountdown() {
      if (videoEndCountdownId) clearTimeout(videoEndCountdownId);
      videoEndCountdownId = null;
    }

    function stopAndResetVideoElement() {
      clearVideoEndCountdown();
      if (progressBarContainerElement && is_auto_mode) progressBarContainerElement.style.display = "";
      const video = document.getElementById("esgVideoElement");
      if (!video) return;
      try { video.onended = null; } catch (error) {}
      try { video.pause(); } catch (error) {}
      try { video.removeAttribute("src"); } catch (error) {}
      try { video.load(); } catch (error) {}
      videoBridgeReset();
    }

    function disposeImageCarouselInstance() {
      const carouselElement = document.getElementById("esgImageCarousel");
      if (!carouselElement) return;
      try {
        const instance = bootstrap.Carousel.getInstance(carouselElement);
        if (instance) instance.dispose();
      } catch (error) {}
    }

    // ============================================================
    // PAGE TRANSITIONS
    // ============================================================
    function showPageByNumber(pageNumber, forcedDirection) {
      const next = Number(pageNumber || 1);
      if (!enabledPages().includes(next)) return;
      if (currentPageNumber === next) return;
      if (!is_auto_mode && pageTransitionBusy) return;
      const mySeq = ++pageTransitionSeq;
      if (!is_auto_mode) pageTransitionBusy = true;

      const currentElement = document.getElementById("page" + currentPageNumber);
      const nextElement = document.getElementById("page" + next);
      if (!nextElement) {
        if (!is_auto_mode) pageTransitionBusy = false;
        return;
      }

      if (currentPageNumber === 8) stopAndResetVideoElement();
      if (currentPageNumber === 9) disposeImageCarouselInstance();

      const direction = forcedDirection || (next > currentPageNumber ? "left" : "right");

      nextElement.classList.remove("exit-left", "exit-right", "active-page");
      nextElement.style.transition = "none";
      nextElement.style.transform = direction === "left" ? "translateX(100%)" : "translateX(-100%)";
      nextElement.offsetHeight;

      if (currentElement) {
        currentElement.style.transition = "transform 0.5s ease, opacity 0.5s ease";
        currentElement.style.transform = direction === "left" ? "translateX(-100%)" : "translateX(100%)";
        currentElement.style.opacity = "0";
      }

      nextElement.classList.add("active-page");
      nextElement.style.transition = "transform 0.5s ease, opacity 0.5s ease";
      nextElement.style.transform = "translateX(0)";
      nextElement.style.opacity = "1";

      currentPageNumber = next;
      hardResetProgressBar();
      onEnterPage(next);
      sendControlPageUpdate();

      setTimeout(() => {
        if (mySeq !== pageTransitionSeq) return;
        document.querySelectorAll(".page").forEach((page) => {
          if (page !== nextElement) {
            page.classList.remove("active-page", "exit-left", "exit-right");
            page.style.transition = "";
            page.style.transform = "";
            page.style.opacity = "";
          }
        });
        nextElement.style.transition = "";
        nextElement.style.transform = "";
        nextElement.style.opacity = "";
        if (!is_auto_mode) pageTransitionBusy = false;
      }, 500);
    }

    function navigateToNextPage() {
      const next = nextEnabledPage(currentPageNumber, 1);
      showPageByNumber(next, "left");
    }

    function navigateToPreviousPage() {
      const previous = nextEnabledPage(currentPageNumber, -1);
      showPageByNumber(previous, "right");
    }

    // ============================================================
    // BUILDING DATA PREP
    // ============================================================
    let allBuildingCodes = [];
    let latestOverviewByKey = {};
    let threePanelChart = null;
    // Building monthly view (Page 5): split into a top BAR panel and a bottom
    // LINE panel, with their own per-year colour + filter controls.
    let threeBuildingBarChart = null;
    let threeBuildingLineChart = null;
    let _buildingElecYears = [];
    let _buildingWaterYears = [];
    const buildingHiddenSeries = { electricity: {}, water: {} };
    let threeCycleTimeoutId = null;
    let threeCycleList = [];
    let threeCycleIdx = 0;
    let threeCycleMs = getPageDuration(5);
    let electricityCompareChart = null;
    let waterCompareChart = null;
    let electricityCompareLineChart = null;   // bottom "trend line" panel for the electricity page
    let waterCompareLineChart = null;          // bottom "trend line" panel for the water page

    function clearThreeCycleTimer() {
      if (threeCycleTimeoutId) clearTimeout(threeCycleTimeoutId);
      threeCycleTimeoutId = null;
    }

    function ensureAllBuildingsPrepared() {
      if (allBuildingCodes.length) return;
      
      const monthlyByYearKeys = Object.keys(buildingMonthlyByYear || {}).filter(Boolean);
      if (monthlyByYearKeys.length) {
        allBuildingCodes = monthlyByYearKeys.map(keyItem => normalizeBuildingKey(keyItem));
      } else {
        const monthlyKeys = Object.keys(buildingMonthlyByCode || {}).filter(Boolean);
        if (monthlyKeys.length) {
          allBuildingCodes = monthlyKeys.map(keyItem => normalizeBuildingKey(keyItem));
        } else {
          const rows = overviewNewestRows.length ? overviewNewestRows : overviewOldestRows;
          allBuildingCodes = rows.map(rowItem => rowItem && rowItem.building).filter(Boolean).map(building => normalizeBuildingKey(building));
        }
      }
      allBuildingCodes = [...new Set(allBuildingCodes)].filter(Boolean);

      const latestRows = overviewNewestRows.length ? overviewNewestRows : overviewOldestRows;
      latestOverviewByKey = {};
      latestRows.forEach(rowItem => {
        if (!rowItem || !rowItem.building) return;
        const keyValue = normalizeBuildingKey(rowItem.building);
        if (!keyValue) return;
        latestOverviewByKey[keyValue] = {
          electricity: Number(rowItem.electricity || 0),
          water: Number(rowItem.water || 0),
          label: rowItem.building
        };
      });

      const BUILDING_CONTROLS_ORDER = [
        "E1","E2","E3","E4","E5","E6","W1","W2","W3","W4","W5","W6",
        "ALC","BLK 43","ECMC","GREEN HOUSE","RPC","RPIC","SPORTS COMPLEX","THE ARCH","TRCC","XLC"
      ];
      const BUILDING_CONTROLS_ORDER_INDEX = new Map(BUILDING_CONTROLS_ORDER.map((building, index) => [normalizeBuildingKey(building), index]));

      function sortBuildingsByControlsOrder(buildingA, buildingB) {
        const keyA = normalizeBuildingKey(buildingA);
        const keyB = normalizeBuildingKey(buildingB);
        const indexA = BUILDING_CONTROLS_ORDER_INDEX.has(keyA) ? BUILDING_CONTROLS_ORDER_INDEX.get(keyA) : 9999;
        const indexB = BUILDING_CONTROLS_ORDER_INDEX.has(keyB) ? BUILDING_CONTROLS_ORDER_INDEX.get(keyB) : 9999;
        if (indexA !== indexB) return indexA - indexB;
        return labelForBuilding(keyA).localeCompare(labelForBuilding(keyB));
      }
      allBuildingCodes.sort(sortBuildingsByControlsOrder);
    }

    function buildingTotals(buildingCode) {
      const key = normalizeBuildingKey(buildingCode);
      const row = latestOverviewByKey[key];
      return { electricity: row ? row.electricity : 0, water: row ? row.water : 0 };
    }

    function renderBuildingCards(containerElement) {
      if (!containerElement) return;
      containerElement.innerHTML = "";
      allBuildingCodes.forEach(code => {
        const totals = buildingTotals(code);
        const card = document.createElement("div");
        card.className = "building-card";
        card.dataset.building = code;
        if (!is_auto_mode) {
          card.style.pointerEvents = "auto";
          card.style.cursor = "pointer";
          card.addEventListener("click", () => {
            const building = normalizeBuildingKey(code);
            showPageByNumber(5, "left");
            setThreePanelBuilding(building);
            if (!window.buildingControlWin || window.buildingControlWin.closed) {
              window.buildingControlWin = window.open(
                "/buildingControls?mode=interactive&startPage=" + String(currentPageNumber || 1),
                "buildingControls", "width=520,height=780,resizable=yes"
              );
            }
            setTimeout(() => {
              try {
                if (window.buildingControlWin && !window.buildingControlWin.closed) {
                  window.buildingControlWin.postMessage({ type: "SET_BUILDING", building }, window.location.origin);
                  sendControlPageUpdate();
                }
              } catch (error) {}
            }, 150);
          });
        }
        const name = document.createElement("div");
        name.className = "building-name";
        name.textContent = cardLabelForBuilding(code);
        const elecMetricElement = document.createElement("p");
        elecMetricElement.className = "building-metric";
        elecMetricElement.textContent = "Electricity: " + formatNumber(totals.electricity) + " kWh";
        const waterMetricElement = document.createElement("p");
        waterMetricElement.className = "building-metric";
        waterMetricElement.textContent = "Water: " + formatNumber(totals.water) + " m³";
        card.appendChild(name);
        card.appendChild(elecMetricElement);
        card.appendChild(waterMetricElement);
        containerElement.appendChild(card);
      });
    }
    
    function renderBuildingList(containerElement, onClick) {
      if (!containerElement) return;
      containerElement.innerHTML = "";
      const ul = document.createElement("ul");
      allBuildingCodes.forEach((code) => {
        const li = document.createElement("li");
        li.className = "building-list-item";
        li.dataset.building = code;
        const name = document.createElement("div");
        name.className = "fw-bold";
        name.textContent = labelForBuilding(code);
        const meta = document.createElement("small");
        const totals = buildingTotals(code);
        meta.textContent = "Electricity: " + formatNumber(totals.electricity) + " kWh  •  Water: " + formatNumber(totals.water) + " m³";
        li.appendChild(name);
        li.appendChild(meta);
        li.addEventListener("click", () => onClick(code, li));
        ul.appendChild(li);
      });
      containerElement.appendChild(ul);
    }

    function sanitizeInjectedHtml(html) {
      const temp = document.createElement("div");
      temp.innerHTML = String(html || "");
      temp.querySelectorAll("script, link, meta, title, head").forEach(node => node.remove());
      temp.querySelectorAll("style").forEach(styleElement => {
        const css = String(styleElement.textContent || "");
        if (/(^|\W)(:root|html|body|\*)(\W|$)|@import/i.test(css)) styleElement.remove();
      });
      const body = temp.querySelector("body");
      const content = body ? body.innerHTML : temp.innerHTML;
      return `<div class="slug-sandbox">${content}</div>`;
    }

    // ============================================================
    // SCROLL HELPER - Incremental scroll
    // ============================================================
    function scrollActiveItemIntoView(containerSelector, activeSelector) {
      requestAnimationFrame(() => {
        const container = document.querySelector(containerSelector);
        const activeItem = container ? container.querySelector(activeSelector) : null;
        if (!activeItem || !container) return;
        
        const ul = container.querySelector('ul') || container;
        if (!ul) return;
        
        const containerRect = ul.getBoundingClientRect();
        const itemRect = activeItem.getBoundingClientRect();
        
        const buffer = 4;
        const padding = 8;
        
        // Check if item is visible within container
        const isAboveView = itemRect.top < (containerRect.top + buffer);
        const isBelowView = itemRect.bottom > (containerRect.bottom - buffer);
        const isFullyVisible = !isAboveView && !isBelowView;
        
        // Only scroll if item is not fully visible
        if (isFullyVisible) return;
        
        if (isAboveView) {
          // Item is above visible area - scroll up minimally to show it at top
          const scrollAmount = itemRect.top - containerRect.top - padding;
          ul.scrollTop = Math.max(0, ul.scrollTop + scrollAmount);
        } else if (isBelowView) {
          // Item is below visible area - scroll down minimally to show it at bottom
          const scrollAmount = itemRect.bottom - containerRect.bottom + padding;
          ul.scrollTop = ul.scrollTop + scrollAmount;
        }
      });
    }

    // ============================================================
    // PAGE 5: SET THREE PANEL BUILDING
    // ============================================================
    function setThreePanelBuilding(buildingCode) {
      ensureAllBuildingsPrepared();

      const title = document.getElementById("threeInfoTitle");
      const elecTotal = document.getElementById("threeElecTotal");
      const waterTotal = document.getElementById("threeWaterTotal");
      const elecMetricLabel = document.getElementById("elecMetricLabel");
      const waterMetricLabel = document.getElementById("waterMetricLabel");
      const chartTitle = document.querySelector("#page5 .panel-mid #threeChartTitle");

      const buildingName = labelForBuilding(buildingCode);
      const buildingSlug = buildingSlugFromCode(buildingCode);

      const ranges = buildingYearRanges[buildingCode] || {};
      const elecStartYear = ranges.elecStartYear;
      const elecEndYear = ranges.elecEndYear;
      const waterStartYear = ranges.waterStartYear;
      const waterEndYear = ranges.waterEndYear;

      function buildYearArray(startYear, endYear, validYears) {
        if (!startYear && !endYear) {
          if (validYears && validYears.length > 0) {
            const sorted = [...validYears].sort((yearA, yearB) => yearB - yearA);
            return [sorted[0]];
          }
          return latestDataYear ? [latestDataYear] : [];
        }

        const start = startYear || (validYears && validYears.length > 0 ? Math.min(...validYears) : null);
        const end = endYear || (validYears && validYears.length > 0 ? Math.max(...validYears) : null);

        if (!start || !end) return [];

        const years = [];
        for (let year = start; year <= end; year++) {
          if (!validYears || validYears.length === 0 || validYears.includes(year)) {
            years.push(year);
          }
        }
        return years.sort((yearA, yearB) => yearA - yearB);
      }

      const buildingData = buildingMonthlyByYear[buildingCode] || buildingMonthlyByYear[buildingCode] || {};
      const validElecYears = buildingData.validElecYears || buildingData.validYears || allYears;
      const validWaterYears = buildingData.validWaterYears || buildingData.validYears || allYears;

      const elecYearsForChart = buildYearArray(elecStartYear, elecEndYear, validElecYears);
      const waterYearsForChart = buildYearArray(waterStartYear, waterEndYear, validWaterYears);

      if (title) title.textContent = buildingName;

      const allChartYears = [...new Set([...elecYearsForChart, ...waterYearsForChart])].sort((yearA, yearB) => yearA - yearB);
      let yearRangeText;
      if (allChartYears.length === 0) {
        yearRangeText = latestDataYear || "Latest";
      } else if (allChartYears.length === 1) {
        yearRangeText = String(allChartYears[0]);
      } else {
        yearRangeText = `${allChartYears[0]} to ${allChartYears[allChartYears.length - 1]}`;
      }

      if (chartTitle) {
        chartTitle.textContent = `(${buildingName}) Monthly Trend - ${yearRangeText}`;
      }

      let totalElectricity = 0;
      let totalWater = 0;

      elecYearsForChart.forEach(year => {
        const yearData = getBuildingMonthlyForYear(buildingCode, year);
        totalElectricity += (yearData.elec || []).reduce((sum, value) => sum + Number(value || 0), 0);
      });

      waterYearsForChart.forEach(year => {
        const yearData = getBuildingMonthlyForYear(buildingCode, year);
        totalWater += (yearData.water || []).reduce((sum, value) => sum + Number(value || 0), 0);
      });

      if (elecMetricLabel) {
        if (elecYearsForChart.length === 0) {
          elecMetricLabel.textContent = "Electricity (N/A)";
        } else if (elecYearsForChart.length === 1) {
          elecMetricLabel.textContent = `Electricity (${elecYearsForChart[0]})`;
        } else {
          elecMetricLabel.textContent = `Electricity (${elecYearsForChart[0]}-${elecYearsForChart[elecYearsForChart.length - 1]})`;
        }
      }

      if (waterMetricLabel) {
        if (waterYearsForChart.length === 0) {
          waterMetricLabel.textContent = "Water (N/A)";
        } else if (waterYearsForChart.length === 1) {
          waterMetricLabel.textContent = `Water (${waterYearsForChart[0]})`;
        } else {
          waterMetricLabel.textContent = `Water (${waterYearsForChart[0]}-${waterYearsForChart[waterYearsForChart.length - 1]})`;
        }
      }

      if (elecTotal) elecTotal.textContent = formatNumber(totalElectricity) + " kWh";
      if (waterTotal) waterTotal.textContent = formatNumber(totalWater) + " m³";

      fetch(`/building-left/${encodeURIComponent(buildingSlug)}`)
        .then(response => response.text())
        .then(html => {
          const body = document.getElementById("threeInfoBody");
          if (!body) return;
          body.innerHTML = sanitizeInjectedHtml(html);
          const elecElement = body.querySelector(".js-elec-total");
          const waterElement = body.querySelector(".js-water-total");
          if (elecElement) elecElement.textContent = formatNumber(totalElectricity);
          if (waterElement) waterElement.textContent = formatNumber(totalWater);
        })
        .catch(() => {
          const body = document.getElementById("threeInfoBody");
          if (body) body.innerHTML = "<div class='slug-sandbox'><p class='text-muted'>No building info available.</p></div>";
        });

      // Render building list in right panel
      (function renderRightPanelBuildingList() {
        const rightBody = document.getElementById("threeRightBody");
        if (!rightBody) return;

        const existingUl = rightBody.querySelector(".building-list ul");
        if (existingUl) {
          rightPanelScrollTop = existingUl.scrollTop;
        }

        rightBody.innerHTML = "";

        const listContainer = document.createElement("div");
        listContainer.className = "building-list";

        const ul = document.createElement("ul");
        
        allBuildingCodes.forEach(code => {
          const isCurrentBuilding = normalizeBuildingKey(code) === buildingCode;
          const codeKey = normalizeBuildingKey(code);
          
          const codeBuildingData = buildingMonthlyByYear[codeKey] || buildingMonthlyByYear[code] || {};
          const codeRanges = buildingYearRanges[codeKey] || {};
          
          const elecStart = codeRanges.elecStartYear;
          const elecEnd = codeRanges.elecEndYear;
          const waterStart = codeRanges.waterStartYear;
          const waterEnd = codeRanges.waterEndYear;
          
          const codeValidElecYears = (codeBuildingData.validElecYears || codeBuildingData.validYears || allYears)
            .map(yearValue => parseInt(yearValue, 10)).filter(yearValue => !isNaN(yearValue));
          const codeValidWaterYears = (codeBuildingData.validWaterYears || codeBuildingData.validYears || allYears)
            .map(yearValue => parseInt(yearValue, 10)).filter(yearValue => !isNaN(yearValue));
          
          function getYearsInRange(startYear, endYear, validYears) {
            if (!startYear && !endYear) {
              if (validYears && validYears.length > 0) {
                const sorted = [...validYears].sort((yearA, yearB) => yearB - yearA);
                return [sorted[0]];
              }
              return latestDataYear ? [latestDataYear] : [];
            }

            const start = startYear || (validYears.length > 0 ? Math.min(...validYears) : null);
            const end = endYear || (validYears.length > 0 ? Math.max(...validYears) : null);
            
            if (!start || !end) return [];
            
            const years = [];
            for (let year = start; year <= end; year++) {
              if (validYears.length === 0 || validYears.includes(year)) {
                years.push(year);
              }
            }
            return years.sort((yearA, yearB) => yearA - yearB);
          }
          
          const elecYearsToShow = getYearsInRange(elecStart, elecEnd, codeValidElecYears);
          const waterYearsToShow = getYearsInRange(waterStart, waterEnd, codeValidWaterYears);
          
          const allYearsToShow = [...new Set([...elecYearsToShow, ...waterYearsToShow])]
            .sort((yearA, yearB) => yearA - yearB);
          
          if (!allYearsToShow.length && latestDataYear) {
            allYearsToShow.push(latestDataYear);
          }

          const yearlyData = allYearsToShow.map(year => {
            const yearData = getBuildingMonthlyForYear(codeKey, year);
            
            const includeElec = elecYearsToShow.includes(year);
            const includeWater = waterYearsToShow.includes(year);
            
            const elecTotal = includeElec 
              ? (yearData.elec || []).reduce((sum, value) => sum + Number(value || 0), 0)
              : null;
            const waterTotal = includeWater
              ? (yearData.water || []).reduce((sum, value) => sum + Number(value || 0), 0)
              : null;

            return { year, elec: elecTotal, water: waterTotal };
          });

          const li = document.createElement("li");
          li.className = "building-list-item";
          li.dataset.building = code;

          if (isCurrentBuilding) {
            li.classList.add("active");
          }

          const name = document.createElement("div");
          name.className = "fw-bold";
          if (isCurrentBuilding) {
            name.textContent = "Active ▸ " + cardLabelForBuilding(code);
          } else {
            name.textContent = cardLabelForBuilding(code);
          }
          li.appendChild(name);

          yearlyData.forEach(({ year, elec, water }) => {
            const yearLine = document.createElement("small");
            yearLine.style.display = "block";

            const parts = [];
            if (elec !== null) {
              parts.push("Elec: " + formatNumber(elec) + " kWh");
            }
            if (water !== null) {
              parts.push("Water: " + formatNumber(water) + " m³");
            }

            if (parts.length > 0) {
              yearLine.textContent = parts.join(" • ") + " (" + year + ")";
            } else {
              yearLine.textContent = "No data (" + year + ")";
            }

            li.appendChild(yearLine);
          });

          li.addEventListener("click", () => {
            clearThreeCycleTimer();
            setThreePanelBuilding(normalizeBuildingKey(code));
          });

          ul.appendChild(li);
        });

        listContainer.appendChild(ul);
        rightBody.appendChild(listContainer);

        // Auto-scroll to active element using incremental scroll
        scrollActiveItemIntoView("#page5 #threeRightBody .building-list", ".building-list-item.active");
      })();

      // Build chart datasets
      const elecDataByYear = {};
      const waterDataByYear = {};

      elecYearsForChart.forEach(year => {
        const yearData = getBuildingMonthlyForYear(buildingCode, year);
        elecDataByYear[year] = yearData.elec || Array(12).fill(0);
      });

      waterYearsForChart.forEach(year => {
        const yearData = getBuildingMonthlyForYear(buildingCode, year);
        waterDataByYear[year] = yearData.water || Array(12).fill(0);
      });

      const allSeries = [];
      elecYearsForChart.forEach(year => allSeries.push(elecDataByYear[year]));
      waterYearsForChart.forEach(year => allSeries.push(waterDataByYear[year]));

      const labels = month_labels.slice();
      const filtered = hideZeroMonths(labels, ...allSeries);

      let seriesIndex = 0;
      const filteredElecData = {};
      elecYearsForChart.forEach(year => {
        filteredElecData[year] = filtered.series[seriesIndex];
        seriesIndex++;
      });

      const filteredWaterData = {};
      waterYearsForChart.forEach(year => {
        filteredWaterData[year] = filtered.series[seriesIndex];
        seriesIndex++;
      });

      // Colours come from the shared per-year colour prefs (same store the
      // Electricity/Water "by building" pages use) so a year keeps one colour
      // everywhere. Electricity -> left axis (y, kWh); Water -> right axis (y1, m³).
      _buildingElecYears  = elecYearsForChart.slice();
      _buildingWaterYears = waterYearsForChart.slice();

      const barDatasets  = [];
      const lineDatasets = [];

      function pushSeries(metric, year, yearIndex, total, data, axisId, unit) {
        const color = buildingYearColor(metric, year, yearIndex, total);
        const meta  = { _metric: metric, _year: year, _yearIndex: yearIndex, _yearTotal: total };
        const label = (metric === "electricity" ? "Electricity " : "Water ") + year + " (" + unit + ")";
        barDatasets.push(Object.assign({
          label: label,
          data: data,
          backgroundColor: color,
          borderColor: color,
          borderWidth: 1,
          yAxisID: axisId
        }, meta));
        lineDatasets.push(Object.assign({
          label: label,
          data: data,
          borderColor: color,
          backgroundColor: "transparent",
          pointBackgroundColor: color,
          pointBorderColor: "#ffffff",
          pointBorderWidth: 1.5,
          pointRadius: 3,
          pointHoverRadius: 5,
          borderWidth: 3,
          tension: 0,
          fill: false,
          yAxisID: axisId
        }, meta));
      }

      elecYearsForChart.forEach((year, index) =>
        pushSeries("electricity", year, index, elecYearsForChart.length, filteredElecData[year] || [], "y", "kWh"));
      waterYearsForChart.forEach((year, index) =>
        pushSeries("water", year, index, waterYearsForChart.length, filteredWaterData[year] || [], "y1", "m³"));

      if (threeBuildingBarChart)  { threeBuildingBarChart.destroy();  threeBuildingBarChart = null; }
      if (threeBuildingLineChart) { threeBuildingLineChart.destroy(); threeBuildingLineChart = null; }

      const built = makeBuildingPanels({
        barCanvasId: "threeBuildingBarChart",
        lineCanvasId: "threeBuildingLineChart",
        labels: filtered.labels,
        barDatasets: barDatasets,
        lineDatasets: lineDatasets
      });
      threeBuildingBarChart  = built.barChart;
      threeBuildingLineChart = built.lineChart;

      buildBuildingColorControls();
      reapplyBuildingVisibility();

      document.querySelectorAll("#three-buildings-grid .building-list-item").forEach((card) => {
        if (card && card.dataset && card.dataset.building === buildingCode) card.classList.add("active");
        else card.classList.remove("active");
      });

      if (!is_auto_mode) sendCurrentBuildingToControls();
    }

    function buildTotalsMapFromOverview(rows) {
      const map = {};
      (rows || []).forEach(rowItem => {
        const key = normalizeBuildingKey(rowItem && rowItem.building);
        if (!key) return;
        map[key] = { label: key, electricity: Number(rowItem.electricity || 0), water: Number(rowItem.water || 0) };
      });
      return map;
    }

    function getUnionBuildingKeys(mapA, mapB) {
      const keys = new Set();
      Object.keys(mapA || {}).forEach(keyItem => keys.add(keyItem));
      Object.keys(mapB || {}).forEach(keyItem => keys.add(keyItem));
      return Array.from(keys).sort((keyA, keyB) => labelForBuilding(keyA).localeCompare(labelForBuilding(keyB)));
    }

    // ============================================================
    // PAGE SETUP FUNCTIONS
    // ============================================================
    function setupAllBuildingsListPage() {
      ensureAllBuildingsPrepared();
      const grid = document.getElementById("all-buildings-grid");
      renderBuildingCards(grid);
      const cards = grid.querySelectorAll('.building-card');
      cards.forEach((card, index) => {
        card.style.opacity = 0;
        setTimeout(() => {
          card.classList.add('animate__animated', 'animate__fadeInUp');
          card.style.opacity = 1;
