  <button id="backArrowButton" class="arrow-btn" onclick="navigateToPreviousPage()">&#8592;</button>
  <button id="nextArrowButton" class="arrow-btn" onclick="navigateToNextPage()">&#8594;</button>
  <div id="progressBarContainer"><div id="progressBarFill"></div></div>
  
  <script>
    // ============================================================
    // SERVER DATA
    // ============================================================
    const dashboard_data = <%- JSON.stringify(dashboardData || {}) %>;
    const dashboard_mode = <%- JSON.stringify(dashboardMode || 'auto') %>;
    const mediaVideos = <%- JSON.stringify(mediaVideos || []) %>;
    const mediaImages = <%- JSON.stringify(mediaImages || []) %>;
    const building_label_map = <%- JSON.stringify(buildingLabelMap || {}) %>;
    const building_card_label_map = <%- JSON.stringify(buildingCardLabelMap || {}) %>;
    const runtime_config = <%- JSON.stringify(runtimeConfig || {}) %>;
    const access_profile = <%- JSON.stringify(accessProfile || 'public') %>;

    // ============================================================
    // AUTO-REFRESH ON NEW UPLOAD
    // The dashboard renders its charts once, from the data baked in at page
    // load. It does not re-query on its own. So we poll a tiny version probe;
    // when an admin uploads (or clears) data the server bumps that number, and
    // any open screen reloads itself to pick up the new figures.
    // ============================================================
    (function watchForDataUpdates() {
      const loadedDataVersion = Number((runtime_config && runtime_config.dataVersion) || 0);
      const POLL_INTERVAL_MS = 30000; // check every 30s

      async function checkVersion() {
        try {
          const res = await fetch("/dashboard/data-version", { cache: "no-store" });
          if (!res.ok) return;
          const data = await res.json();
          const current = Number(data && data.version);
          if (Number.isFinite(current) && current !== loadedDataVersion) {
            console.log("New dashboard data detected (v" + loadedDataVersion + " -> v" + current + "). Reloading...");
            window.location.reload();
          }
        } catch (e) {
          // Network blip or server restarting; ignore and try again next tick.
        }
      }

      setInterval(checkVersion, POLL_INTERVAL_MS);
    })();

    // ============================================================
    // TIMERS DATA
    // ============================================================
    const timers_array = <%- typeof timers !== 'undefined' ? JSON.stringify(timers || []) : '[]' %>;
    const timers_by_page = <%- typeof timersByTimerId !== 'undefined' ? JSON.stringify(timersByTimerId || {}) : '{}' %>;
    const is_auto_mode = String(dashboard_mode || '').toLowerCase() === 'auto';

    // ============================================================
    // TIMER CONFIGURATION
    // Default durations in milliseconds
    // ============================================================
    const configured_default_timers_seconds = (runtime_config && runtime_config.defaultTimersSeconds) ? runtime_config.defaultTimersSeconds : {};
    const DEFAULT_PAGE_DURATIONS = {
      1: Number(configured_default_timers_seconds[1] || configured_default_timers_seconds["1"] || 15) * 1000,
      2: Number(configured_default_timers_seconds[2] || configured_default_timers_seconds["2"] || 60) * 1000,
      3: Number(configured_default_timers_seconds[3] || configured_default_timers_seconds["3"] || 60) * 1000,
      4: Number(configured_default_timers_seconds[4] || configured_default_timers_seconds["4"] || 60) * 1000,
      5: Number(configured_default_timers_seconds[5] || configured_default_timers_seconds["5"] || 60) * 1000,
      6: Number(configured_default_timers_seconds[6] || configured_default_timers_seconds["6"] || 60) * 1000,
      7: Number(configured_default_timers_seconds[7] || configured_default_timers_seconds["7"] || 60) * 1000,
      8: Number(configured_default_timers_seconds[8] || configured_default_timers_seconds["8"] || 4) * 1000,
      9: Number(configured_default_timers_seconds[9] || configured_default_timers_seconds["9"] || 30) * 1000,
      10: Number(configured_default_timers_seconds[10] || configured_default_timers_seconds["10"] || 15) * 1000
    };

    /**
     * Get timer duration for a specific page
     * pageNum - Page number (1-10)
     * Duration in milliseconds
     */
    function getPageDuration(pageNum) {
      // Check if timers_by_page exists and has configuration for this page
      if (timers_by_page && typeof timers_by_page === 'object') {
        const timerConfig = timers_by_page[pageNum];
        if (timerConfig && timerConfig.duration_ms > 0) {
          return timerConfig.duration_ms;
        }
      }
      // Fall back to default
      return DEFAULT_PAGE_DURATIONS[pageNum] || 30000;
    }

    /**
     * Get timer duration in seconds for display
     * pageNum - Page number (1-10)
     * returns Duration in seconds
     */
    function getPageDurationSeconds(pageNum) {
      return Math.round(getPageDuration(pageNum) / 1000);
    }

    // ============================================================
    // EXTRACT SERVER DATA INTO LOCAL STATE
    // ============================================================
    let allYears = [];
    let oldestYear = null;
    let newestYear = null;
    let latestDataYear = null;
    let overviewOldestRows = [];
    let overviewNewestRows = [];
    let solarPendingYear = null;
    let wastePendingYear = null;
    let solarOldestMonths = [];
    let solarNewestMonths = [];
    let wasteOldestMonths = [];
    let wasteNewestMonths = [];
    let buildingMonthlyByCode = {};

    // Scroll position persistence for right panel
    let rightPanelScrollTop = 0;

    // Multi-year data structures
    let overviewByYear = {};
    let solarByYear = {};
    let wasteByYear = {};
    
    // Building monthly data by year with separate elec/water year ranges
    let buildingMonthlyByYear = {};
    let buildingYearRanges = {};

    if (dashboard_data && typeof dashboard_data === "object") {
      const data = dashboard_data;
      allYears = Array.isArray(data.allYears) ? data.allYears : [];
      oldestYear = data.oldestYear || (allYears.length > 0 ? allYears[allYears.length - 1] : null);
      newestYear = data.newestYear || (allYears.length > 0 ? allYears[0] : null);
      latestDataYear = data.latestYear || newestYear || oldestYear || null;
      
      // Legacy data
      overviewOldestRows = Array.isArray(data.overviewYear1Rows) ? data.overviewYear1Rows : [];
      overviewNewestRows = Array.isArray(data.overviewYear2Rows) ? data.overviewYear2Rows : [];
      solarOldestMonths = Array.isArray(data.solarYear1Months) ? data.solarYear1Months : [];
      solarNewestMonths = Array.isArray(data.solarYear2Months) ? data.solarYear2Months : [];
      wasteOldestMonths = Array.isArray(data.wasteYear1Months) ? data.wasteYear1Months : [];
      wasteNewestMonths = Array.isArray(data.wasteYear2Months) ? data.wasteYear2Months : [];
      buildingMonthlyByCode = (data.buildingMonthly && typeof data.buildingMonthly === "object") ? data.buildingMonthly : {};
      
      // Multi-year data
      overviewByYear = (data.overviewByYear && typeof data.overviewByYear === "object") ? data.overviewByYear : {};
      solarByYear = (data.solarByYear && typeof data.solarByYear === "object") ? data.solarByYear : {};
      wasteByYear = (data.wasteByYear && typeof data.wasteByYear === "object") ? data.wasteByYear : {};
      
      // Building monthly by year with year ranges
      buildingMonthlyByYear = (data.buildingMonthlyByYear && typeof data.buildingMonthlyByYear === "object") ? data.buildingMonthlyByYear : {};
      buildingYearRanges = (data.buildingYearRanges && typeof data.buildingYearRanges === "object") ? data.buildingYearRanges : {};
    }

    // ============================================================
    // BUILDING YEAR RANGE HELPERS
    // ============================================================
    
    function getBuildingYearRange(buildingKey, dataType) {
      const key = normalizeBuildingKey(buildingKey);
      const ranges = buildingYearRanges[key] || {};
      const buildingData = buildingMonthlyByYear[key] || buildingMonthlyByYear[buildingKey] || {};
      
      let validYears;
      if (dataType === 'elec' || dataType === 'electricity') {
        validYears = buildingData.validElecYears || buildingData.validYears || allYears;
      } else {
        validYears = buildingData.validWaterYears || buildingData.validYears || allYears;
      }
      
      if (!Array.isArray(validYears)) validYears = allYears;
      
      const sortedYears = [...validYears].map(yearValue => parseInt(yearValue, 10)).filter(yearValue => !isNaN(yearValue)).sort((yearA, yearB) => yearA - yearB);
      
      if (!sortedYears.length) return { start: null, end: null, years: [], isCustom: false };
      
      const minYear = sortedYears[0];
      const maxYear = sortedYears[sortedYears.length - 1];
      
      const allYearsSorted = [...allYears].map(yearValue => parseInt(yearValue, 10)).filter(yearValue => !isNaN(yearValue)).sort((yearA, yearB) => yearA - yearB);
      const globalMin = allYearsSorted.length > 0 ? allYearsSorted[0] : minYear;
      const globalMax = allYearsSorted.length > 0 ? allYearsSorted[allYearsSorted.length - 1] : maxYear;
      
      const isCustom = (minYear !== globalMin || maxYear !== globalMax);
      
      return { start: minYear, end: maxYear, years: sortedYears, isCustom: isCustom };
    }

    function getLatestYearForBuilding(buildingKey, dataType) {
      const range = getBuildingYearRange(buildingKey, dataType);
      if (!range.years.length) return latestDataYear || newestYear;
      return range.years[range.years.length - 1];
    }

    function getBuildingMonthlyForYear(buildingKey, year) {
      const key = normalizeBuildingKey(buildingKey);
      const buildingData = buildingMonthlyByYear[key] || buildingMonthlyByYear[buildingKey];
      
      if (buildingData && buildingData.dataByYear && buildingData.dataByYear[year]) {
        const data = buildingData.dataByYear[year];
        return {
          elec: Array.isArray(data.elec) ? data.elec.slice() : Array(12).fill(0),
          water: Array.isArray(data.water) ? data.water.slice() : Array(12).fill(0),
          year: year
        };
      }
      
      const monthly = (function() {
        if (!buildingMonthlyByCode) return null;
        if (buildingMonthlyByCode[key]) return buildingMonthlyByCode[key];
        if (buildingMonthlyByCode[buildingKey]) return buildingMonthlyByCode[buildingKey];
        const lowerKey = key.toLowerCase();
        for (const [objectKey, objectValue] of Object.entries(buildingMonthlyByCode)) {
          if (objectKey.toLowerCase() === lowerKey) return objectValue;
          if (normalizeBuildingKey(objectKey) === key) return objectValue;
        }
        return null;
      })();
      
      return {
        elec: monthly && Array.isArray(monthly.elec) ? monthly.elec.slice() : Array(12).fill(0),
        water: monthly && Array.isArray(monthly.water) ? monthly.water.slice() : Array(12).fill(0),
        year: year
      };
    }

    function getBuildingTotalsForYear(buildingKey, year) {
      const key = normalizeBuildingKey(buildingKey);
      if (overviewByYear && overviewByYear[year]) {
        const yearData = overviewByYear[year];
        const row = yearData.find(rowItem => normalizeBuildingKey(rowItem.building) === key);
        if (row) {
          return { electricity: Number(row.electricity || 0), water: Number(row.water || 0) };
        }
      }
      const monthly = getBuildingMonthlyForYear(buildingKey, year);
      return {
        electricity: (monthly.elec || []).reduce((sum, value) => sum + Number(value || 0), 0),
        water: (monthly.water || []).reduce((sum, value) => sum + Number(value || 0), 0)
      };
    }

    function formatYearRangeDisplay(elecRange, waterRange) {
      const elecText = elecRange.years.length === 0 ? 'N/A' :
                       elecRange.years.length === 1 ? String(elecRange.years[0]) :
                       `${elecRange.start}-${elecRange.end}`;
      const waterText = waterRange.years.length === 0 ? 'N/A' :
                        waterRange.years.length === 1 ? String(waterRange.years[0]) :
                        `${waterRange.start}-${waterRange.end}`;
      if (elecText === waterText) return elecText;
      return `Elec: ${elecText}, Water: ${waterText}`;
    }

