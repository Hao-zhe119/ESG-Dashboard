  line-height: 1.2;
}

.pct-body {
  display: grid;
  gap: 7px;
}

.pct-row {
  display: grid;
  grid-template-columns: 9px minmax(0, 1fr) auto;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  line-height: 1.2;
}

.pct-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
