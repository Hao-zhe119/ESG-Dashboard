  <div id="page7" class="page">
    <div class="three-panel">
      <div class="panel panel-left">
        <div class="three-info-body" id="wasteLeftBody">Loading waste info...</div>
      </div>
      <div class="panel panel-mid">
        <div class="analytics-card" style="--chartAccent: var(--metricWaste);">
          <div class="analytics-card-header">
            <div class="chart-title-stack">
              <div class="chart-kicker">Waste Analytics</div>
              <div class="three-building-title" id="wasteChartTitle">
                Waste (General &amp; Recyclable)
              </div>
            </div>
            <div id="wasteColorControls" class="compare-color-controls"></div>
          </div>
          <div class="analytics-card-body">
            <div class="three-chart-wrap compare-split">
              <div class="compare-bars"><canvas id="wasteBarChart"></canvas></div>
              <div class="compare-line"><canvas id="wasteLineChart"></canvas></div>
            </div>
          </div>
        </div>
      </div>
      <div class="panel panel-right">
        <div class="three-building-title animate__animated animate__headShake animate__infinite" style="--animate-duration: 3s;" id="wasteRightTitle">Waste Data</div>
        <div id="waste-year-list" class="building-list"></div>
      </div>
    </div>
  </div>


  <!-- PAGE 8: VIDEO -->
  <div id="page8" class="page<%= (!mediaVideos || !mediaVideos.length) ? ' page-skipped' : '' %>">
    <h2>RP Sustainability Video</h2>
    <div id="videoWrapper" style="position:relative; display:inline-block; width:100%; max-width:100%;">
      <video id="esgVideoElement" controls autoplay playsinline style="width:100%; display:block;"></video>
      <div id="videoCaptionOverlay"
           style="display:none; position:absolute; transform:translate(-50%,-50%);
                  background:rgba(0,0,0,0.62); color:#fff; font-weight:500;
                  text-align:center; border-radius:6px; max-width:90%;
                  padding:6px 16px; pointer-events:none; z-index:5;"></div>
    </div>
    <% if (!mediaVideos || !mediaVideos.length) { %>
      <p class="text-muted mt-3">No videos uploaded</p>
    <% } %>
  </div>

  <!-- PAGE 9: IMAGES CAROUSEL -->
  <div id="page9" class="page<%= (!mediaImages || !mediaImages.length) ? ' page-skipped' : '' %>">
    <h2 class="animate__animated animate__flash animate__infinite" style="--animate-duration: 3s;">
      Campus Sustainability Highlights
    </h2>
    <div id="esgImageCarousel" class="carousel slide">
      <div class="carousel-inner">
        <% if (mediaImages && mediaImages.length) { %>
          <% mediaImages.forEach(function(img, index){ %>
            <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
              <img src="/uploads/images/carousel/<%= img.filename %>" class="d-block w-100" />
              <% if (img.caption_text) { %>
                <div class="carousel-caption-overlay"
                     style="left:<%= img.caption_x != null ? img.caption_x : 50 %>%;
                            top:<%= img.caption_y != null ? img.caption_y : 85 %>%;
                            font-size:<%= img.caption_font_size || 24 %>px;">
                  <%= img.caption_text %>
                </div>
              <% } %>
            </div>
          <% }) %>
        <% } else { %>
          <div class="carousel-item active">
            <div class="text-muted text-center p-5">No images uploaded</div>
          </div>
        <% } %>
      </div>
      <button class="carousel-control-prev" type="button" data-bs-target="#esgImageCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true" style="filter: invert(1);"></span>
        <span class="visually-hidden">Previous</span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#esgImageCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true" style="filter: invert(1);"></span>
        <span class="visually-hidden">Next</span>
      </button>
      <div class="carousel-indicators">
        <% if (mediaImages && mediaImages.length) { %>
          <% mediaImages.forEach(function(_, index){ %>
            <button type="button" data-bs-target="#esgImageCarousel" data-bs-slide-to="<%= index %>"
              class="<%= index === 0 ? 'active' : '' %>" aria-current="<%= index === 0 ? 'true' : 'false' %>"
              aria-label="Slide <%= index+1 %>"></button>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>

  <!-- PAGE 10: THANK YOU -->
  <div id="page10" class="page">
    <h1 style="color:var(--text)">THANK YOU FOR VISITING</h1>
    <p class="animate__animated animate__pulse animate__infinite" style="color:var(--muted)">
      Tap to return to Welcome Page
    </p>
  </div>

  <button id="backArrowButton" class="arrow-btn" onclick="navigateToPreviousPage()">&#8592;</button>
  <button id="nextArrowButton" class="arrow-btn" onclick="navigateToNextPage()">&#8594;</button>
  <div id="progressBarContainer"><div id="progressBarFill"></div></div>
  
  <script>
    // ============================================================
    // SERVER DATA
    // ============================================================
    const dashboard_data = <%- JSON.stringify(dashboardData || {}) %>;
    const dashboard_mode = <%- JSON.stringify(dashboardMode || 'auto') %>;
    const mediaVideos = <%- JSON.stringify(mediaVideos || []) %>;
    const mediaImages = <%- JSON.stringify(mediaImages || []) %>;
    const building_label_map = <%- JSON.stringify(buildingLabelMap || {}) %>;
    const building_card_label_map = <%- JSON.stringify(buildingCardLabelMap || {}) %>;
    const runtime_config = <%- JSON.stringify(runtimeConfig || {}) %>;
    const access_profile = <%- JSON.stringify(accessProfile || 'public') %>;

    // ============================================================
    // AUTO-REFRESH ON NEW UPLOAD
    // The dashboard renders its charts once, from the data baked in at page
    // load. It does not re-query on its own. So we poll a tiny version probe;
    // when an admin uploads (or clears) data the server bumps that number, and
    // any open screen reloads itself to pick up the new figures.
    // ============================================================
    (function watchForDataUpdates() {
      const loadedDataVersion = Number((runtime_config && runtime_config.dataVersion) || 0);
      const POLL_INTERVAL_MS = 30000; // check every 30s

      async function checkVersion() {
        try {
          const res = await fetch("/dashboard/data-version", { cache: "no-store" });
          if (!res.ok) return;
          const data = await res.json();
          const current = Number(data && data.version);
          if (Number.isFinite(current) && current !== loadedDataVersion) {
            console.log("New dashboard data detected (v" + loadedDataVersion + " -> v" + current + "). Reloading...");
            window.location.reload();
          }
        } catch (e) {
          // Network blip or server restarting; ignore and try again next tick.
        }
      }

      setInterval(checkVersion, POLL_INTERVAL_MS);
    })();

    // ============================================================
    // TIMERS DATA
    // ============================================================
    const timers_array = <%- typeof timers !== 'undefined' ? JSON.stringify(timers || []) : '[]' %>;
    const timers_by_page = <%- typeof timersByTimerId !== 'undefined' ? JSON.stringify(timersByTimerId || {}) : '{}' %>;
    const is_auto_mode = String(dashboard_mode || '').toLowerCase() === 'auto';

    // ============================================================
    // TIMER CONFIGURATION
    // Default durations in milliseconds
    // ============================================================
    const configured_default_timers_seconds = (runtime_config && runtime_config.defaultTimersSeconds) ? runtime_config.defaultTimersSeconds : {};
    const DEFAULT_PAGE_DURATIONS = {
      1: Number(configured_default_timers_seconds[1] || configured_default_timers_seconds["1"] || 15) * 1000,
      2: Number(configured_default_timers_seconds[2] || configured_default_timers_seconds["2"] || 60) * 1000,
      3: Number(configured_default_timers_seconds[3] || configured_default_timers_seconds["3"] || 60) * 1000,
      4: Number(configured_default_timers_seconds[4] || configured_default_timers_seconds["4"] || 60) * 1000,
      5: Number(configured_default_timers_seconds[5] || configured_default_timers_seconds["5"] || 60) * 1000,
      6: Number(configured_default_timers_seconds[6] || configured_default_timers_seconds["6"] || 60) * 1000,
      7: Number(configured_default_timers_seconds[7] || configured_default_timers_seconds["7"] || 60) * 1000,
      8: Number(configured_default_timers_seconds[8] || configured_default_timers_seconds["8"] || 4) * 1000,
      9: Number(configured_default_timers_seconds[9] || configured_default_timers_seconds["9"] || 30) * 1000,
      10: Number(configured_default_timers_seconds[10] || configured_default_timers_seconds["10"] || 15) * 1000,
      11: Number(configured_default_timers_seconds[11] || configured_default_timers_seconds["11"] || 75) * 1000
    };

    /**
     * Get timer duration for a specific page
     * pageNum - Page number (1-10)
     * Duration in milliseconds
     */
    function getPageDuration(pageNum) {
      // Check if timers_by_page exists and has configuration for this page
      if (timers_by_page && typeof timers_by_page === 'object') {
        const timerConfig = timers_by_page[pageNum];
        if (timerConfig && timerConfig.duration_ms > 0) {
          return timerConfig.duration_ms;
        }
      }
      // Fall back to default
      return DEFAULT_PAGE_DURATIONS[pageNum] || 30000;
    }

    /**
     * Get timer duration in seconds for display
     * pageNum - Page number (1-10)
     * returns Duration in seconds
     */
    function getPageDurationSeconds(pageNum) {
      return Math.round(getPageDuration(pageNum) / 1000);
    }

    // ============================================================
    // EXTRACT SERVER DATA INTO LOCAL STATE
    // ============================================================
    let allYears = [];
    let oldestYear = null;
    let newestYear = null;
    let latestDataYear = null;
    let latestOverviewYear = null;
    let oldestOverviewYear = null;
    let latestSolarYear = null;
    let oldestSolarYear = null;
    let latestWasteYear = null;
    let oldestWasteYear = null;
    let overviewOldestRows = [];
    let overviewNewestRows = [];
    let solarPendingYear = null;
    let wastePendingYear = null;
    let solarOldestMonths = [];
    let solarNewestMonths = [];
    let wasteOldestMonths = [];
    let wasteNewestMonths = [];
    let buildingMonthlyByCode = {};

    // Scroll position persistence for right panel
    let rightPanelScrollTop = 0;

    // Multi-year data structures
    let overviewByYear = {};
    let solarByYear = {};
    let wasteByYear = {};
    
    // Building monthly data by year with separate elec/water year ranges
    let buildingMonthlyByYear = {};
    let buildingYearRanges = {};

    if (dashboard_data && typeof dashboard_data === "object") {
      const data = dashboard_data;
      allYears = Array.isArray(data.allYears) ? data.allYears : [];
      oldestYear = data.oldestYear || (allYears.length > 0 ? allYears[allYears.length - 1] : null);
      newestYear = data.newestYear || (allYears.length > 0 ? allYears[0] : null);
      latestDataYear = data.latestYear || newestYear || oldestYear || null;
      latestOverviewYear = data.latestOverviewYear || null;
      oldestOverviewYear = data.oldestOverviewYear || null;
      latestSolarYear = data.latestSolarYear || null;
      oldestSolarYear = data.oldestSolarYear || null;
      latestWasteYear = data.latestWasteYear || null;
      oldestWasteYear = data.oldestWasteYear || null;
      
      // Legacy data
      overviewOldestRows = Array.isArray(data.overviewYear1Rows) ? data.overviewYear1Rows : [];
      overviewNewestRows = Array.isArray(data.overviewYear2Rows) ? data.overviewYear2Rows : [];
      solarOldestMonths = Array.isArray(data.solarYear1Months) ? data.solarYear1Months : [];
      solarNewestMonths = Array.isArray(data.solarYear2Months) ? data.solarYear2Months : [];
      wasteOldestMonths = Array.isArray(data.wasteYear1Months) ? data.wasteYear1Months : [];
      wasteNewestMonths = Array.isArray(data.wasteYear2Months) ? data.wasteYear2Months : [];
      buildingMonthlyByCode = (data.buildingMonthly && typeof data.buildingMonthly === "object") ? data.buildingMonthly : {};
      
      // Multi-year data
      overviewByYear = (data.overviewByYear && typeof data.overviewByYear === "object") ? data.overviewByYear : {};
      solarByYear = (data.solarByYear && typeof data.solarByYear === "object") ? data.solarByYear : {};
      wasteByYear = (data.wasteByYear && typeof data.wasteByYear === "object") ? data.wasteByYear : {};
      
      // Building monthly by year with year ranges
      buildingMonthlyByYear = (data.buildingMonthlyByYear && typeof data.buildingMonthlyByYear === "object") ? data.buildingMonthlyByYear : {};
      buildingYearRanges = (data.buildingYearRanges && typeof data.buildingYearRanges === "object") ? data.buildingYearRanges : {};
    }

    function orderedDashboardYears(descending) {
      const years = [...allYears]
        .map(yearValue => parseInt(yearValue, 10))
        .filter(yearValue => !isNaN(yearValue));
      years.sort((yearA, yearB) => descending ? yearB - yearA : yearA - yearB);
      return years;
    }

    function yearWithData(byYear, hasData, descending) {
      const years = orderedDashboardYears(descending);
      for (const year of years) {
        if (hasData(byYear && byYear[year])) return year;
      }
      return null;
    }

    function overviewHasData(rows) {
      return Array.isArray(rows) && rows.some(rowItem =>
        Number(rowItem.electricity || 0) > 0 || Number(rowItem.water || 0) > 0
      );
    }

    function solarHasData(months) {
      return Array.isArray(months) && months.some(monthData =>
        Number(monthData.urban || 0) > 0 || Number(monthData.greenhouse || 0) > 0
      );
    }

    function wasteHasData(months) {
      return Array.isArray(months) && months.some(monthData =>
        Number(monthData.generalKg || 0) > 0 || Number(monthData.recyclableKg || 0) > 0
      );
    }

    latestOverviewYear = latestOverviewYear || yearWithData(overviewByYear, overviewHasData, true) || latestDataYear;
    oldestOverviewYear = oldestOverviewYear || yearWithData(overviewByYear, overviewHasData, false) || oldestYear;
    latestSolarYear = latestSolarYear || yearWithData(solarByYear, solarHasData, true) || latestDataYear;
    oldestSolarYear = oldestSolarYear || yearWithData(solarByYear, solarHasData, false) || oldestYear;
    latestWasteYear = latestWasteYear || yearWithData(wasteByYear, wasteHasData, true) || latestDataYear;
    oldestWasteYear = oldestWasteYear || yearWithData(wasteByYear, wasteHasData, false) || oldestYear;

    // ============================================================
    // BUILDING YEAR RANGE HELPERS
    // ============================================================
    
    function getBuildingYearRange(buildingKey, dataType) {
      const key = normalizeBuildingKey(buildingKey);
      const ranges = buildingYearRanges[key] || {};
      const buildingData = buildingMonthlyByYear[key] || buildingMonthlyByYear[buildingKey] || {};
      
      let validYears;
      if (dataType === 'elec' || dataType === 'electricity') {
        validYears = buildingData.validElecYears || buildingData.validYears || allYears;
      } else {
        validYears = buildingData.validWaterYears || buildingData.validYears || allYears;
      }
      
      if (!Array.isArray(validYears)) validYears = allYears;
      
      const sortedYears = [...validYears].map(yearValue => parseInt(yearValue, 10)).filter(yearValue => !isNaN(yearValue)).sort((yearA, yearB) => yearA - yearB);
      
      if (!sortedYears.length) return { start: null, end: null, years: [], isCustom: false };
      
      const minYear = sortedYears[0];
      const maxYear = sortedYears[sortedYears.length - 1];
      
      const allYearsSorted = [...allYears].map(yearValue => parseInt(yearValue, 10)).filter(yearValue => !isNaN(yearValue)).sort((yearA, yearB) => yearA - yearB);
      const globalMin = allYearsSorted.length > 0 ? allYearsSorted[0] : minYear;
      const globalMax = allYearsSorted.length > 0 ? allYearsSorted[allYearsSorted.length - 1] : maxYear;
      
      const isCustom = (minYear !== globalMin || maxYear !== globalMax);
      
      return { start: minYear, end: maxYear, years: sortedYears, isCustom: isCustom };
    }

    function getLatestYearForBuilding(buildingKey, dataType) {
      const range = getBuildingYearRange(buildingKey, dataType);
      if (!range.years.length) return null;
      return range.years[range.years.length - 1];
    }

    function getBuildingMonthlyForYear(buildingKey, year) {
      const key = normalizeBuildingKey(buildingKey);
      const buildingData = buildingMonthlyByYear[key] || buildingMonthlyByYear[buildingKey];
      
      if (buildingData && buildingData.dataByYear && buildingData.dataByYear[year]) {
        const data = buildingData.dataByYear[year];
        return {
          elec: Array.isArray(data.elec) ? data.elec.slice() : Array(12).fill(0),
          water: Array.isArray(data.water) ? data.water.slice() : Array(12).fill(0),
          year: year
        };
      }
      
      const monthly = (function() {
        if (!buildingMonthlyByCode) return null;
        if (buildingMonthlyByCode[key]) return buildingMonthlyByCode[key];
        if (buildingMonthlyByCode[buildingKey]) return buildingMonthlyByCode[buildingKey];
        const lowerKey = key.toLowerCase();
        for (const [objectKey, objectValue] of Object.entries(buildingMonthlyByCode)) {
          if (objectKey.toLowerCase() === lowerKey) return objectValue;
          if (normalizeBuildingKey(objectKey) === key) return objectValue;
        }
        return null;
      })();
      
      return {
        elec: monthly && Array.isArray(monthly.elec) ? monthly.elec.slice() : Array(12).fill(0),
        water: monthly && Array.isArray(monthly.water) ? monthly.water.slice() : Array(12).fill(0),
        year: year
      };
    }

    function getBuildingTotalsForYear(buildingKey, year) {
      const key = normalizeBuildingKey(buildingKey);
      if (overviewByYear && overviewByYear[year]) {
        const yearData = overviewByYear[year];
        const row = yearData.find(rowItem => normalizeBuildingKey(rowItem.building) === key);
        if (row) {
          return { electricity: Number(row.electricity || 0), water: Number(row.water || 0) };
        }
      }
      const monthly = getBuildingMonthlyForYear(buildingKey, year);
      return {
        electricity: (monthly.elec || []).reduce((sum, value) => sum + Number(value || 0), 0),
        water: (monthly.water || []).reduce((sum, value) => sum + Number(value || 0), 0)
      };
    }

    function formatYearRangeDisplay(elecRange, waterRange) {
      const elecText = elecRange.years.length === 0 ? 'N/A' :
                       elecRange.years.length === 1 ? String(elecRange.years[0]) :
                       `${elecRange.start}-${elecRange.end}`;
      const waterText = waterRange.years.length === 0 ? 'N/A' :
                        waterRange.years.length === 1 ? String(waterRange.years[0]) :
                        `${waterRange.start}-${waterRange.end}`;
      if (elecText === waterText) return elecText;
      return `Elec: ${elecText}, Water: ${waterText}`;
    }

    // ============================================================
    // CHART.JS PLUGINS
    // ============================================================
    const GRAPH_BACKGROUND_STORAGE_KEY = "esgGraphBackgroundMode";
    const ESG_CHART_COLORS = {
      electricity: "#2f6fdd",
      water: "#0e8ba6",
      solar: "#d8901f",
      waste: "#66758a",
      recyclable: "#2fa65a",
      carbon: "#dc6b2a",
      text: "#1f2937",
      muted: "#64748b",
      grid: "rgba(71,85,105,0.12)",
      axis: "rgba(71,85,105,0.32)",
      surface: "transparent",
      surfaceDark: "#101827"
    };
    const GRAPH_BACKGROUND_MODES = {
      light: {
        canvas: ESG_CHART_COLORS.surface,
        text: ESG_CHART_COLORS.text,
        grid: ESG_CHART_COLORS.grid,
        axis: ESG_CHART_COLORS.axis,
        label: ESG_CHART_COLORS.text,
        axisTitle: ESG_CHART_COLORS.muted,
        electricityTitle: ESG_CHART_COLORS.electricity,
        waterTitle: ESG_CHART_COLORS.water
      },
      dark: {
        canvas: "transparent",
        text: "#e5e7eb",
        grid: "rgba(226,232,240,0.13)",
        axis: "rgba(226,232,240,0.32)",
        label: "#f8fafc",
        axisTitle: "#e5e7eb",
        electricityTitle: "#93c5fd",
        waterTitle: "#67e8f9"
      },
      transparent: {
        canvas: "transparent",
        text: ESG_CHART_COLORS.text,
        grid: "rgba(71,85,105,0.13)",
        axis: ESG_CHART_COLORS.axis,
        label: ESG_CHART_COLORS.text,
        axisTitle: ESG_CHART_COLORS.muted,
        electricityTitle: ESG_CHART_COLORS.electricity,
        waterTitle: ESG_CHART_COLORS.water
      }
    };

    function normalizeGraphBackgroundMode(mode) {
      const normalized = String(mode || "light").toLowerCase();
      return GRAPH_BACKGROUND_MODES[normalized] ? normalized : "light";
    }

    let graphBackgroundMode = normalizeGraphBackgroundMode((function loadGraphBackgroundMode() {
      try { return localStorage.getItem(GRAPH_BACKGROUND_STORAGE_KEY); } catch (error) { return "light"; }
    })());

    function graphBackgroundTheme() {
      return GRAPH_BACKGROUND_MODES[normalizeGraphBackgroundMode(graphBackgroundMode)];
    }

    const chartCanvasBackgroundPlugin = {
      id: "chartCanvasBackground",
      beforeDraw(chart) {
        try {
          const theme = graphBackgroundTheme();
          if (!theme || theme.canvas === "transparent") return;
          const context = chart.ctx;
          context.save();
          context.globalCompositeOperation = "destination-over";
          context.fillStyle = theme.canvas;
          context.fillRect(0, 0, chart.width, chart.height);
          context.restore();
        } catch (error) {}
      }
    };

    try { Chart.register(chartCanvasBackgroundPlugin); } catch (error) {}

    const barValueLabelPlugin = {
      id: "barValueLabel",
      afterDatasetsDraw(chart, args, pluginOptions) {
        try {
          const options = pluginOptions || {};
          if (!options.enabled) return;
          const mode = String(options.mode || "all");
          const context = chart.ctx;
          const datasets = chart.data?.datasets || [];

          const isPositiveFiniteNumber = (value) => {
            const number = Number(value);
            return Number.isFinite(number) && number > 0;
          };

          const formatValue = (value) => {
            const number = Number(value);
            if (!Number.isFinite(number)) return "";
            return number.toLocaleString(undefined, { maximumFractionDigits: 0 });
          };

          const maxValuePerDataset = new Map();
          let globalMaxValue = -Infinity;

          datasets.forEach((dataset, datasetIndex) => {
            if (!dataset) return;
            if (String(dataset.label || "").startsWith("_")) return;
            const datasetType = String(dataset.type || chart.config.type || "");
            if (datasetType && datasetType !== "bar" && datasetType !== "line") return;
            const meta = chart.getDatasetMeta(datasetIndex);
            if (!meta || meta.hidden) return;
            const dataArray = Array.isArray(dataset.data) ? dataset.data : [];
            let datasetMaxValue = -Infinity;
            dataArray.forEach((dataPoint) => {
              if (!isPositiveFiniteNumber(dataPoint)) return;
              if (dataPoint > datasetMaxValue) datasetMaxValue = dataPoint;
              if (dataPoint > globalMaxValue) globalMaxValue = dataPoint;
            });
            maxValuePerDataset.set(datasetIndex, datasetMaxValue);
          });

          context.save();
          context.textAlign = "center";
          context.textBaseline = "bottom";
          context.font = "650 13px Inter, IBM Plex Sans, Geist, Segoe UI, Arial, sans-serif";
          context.fillStyle = graphBackgroundTheme().label;

          datasets.forEach((dataset, datasetIndex) => {
            if (!dataset) return;
            if (String(dataset.label || "").startsWith("_")) return;
            const datasetType = String(dataset.type || chart.config.type || "");
            if (datasetType && datasetType !== "bar" && datasetType !== "line") return;
            const meta = chart.getDatasetMeta(datasetIndex);
            if (!meta || meta.hidden) return;
            const datasetMaxValue = maxValuePerDataset.get(datasetIndex);
            const dataArray = Array.isArray(dataset.data) ? dataset.data : [];
            const chartElements = meta.data || [];
            if (mode === "max-per-dataset" && !isPositiveFiniteNumber(datasetMaxValue)) return;

            chartElements.forEach((element, dataIndex) => {
              const value = Number(dataArray[dataIndex]);
              if (!element || !isPositiveFiniteNumber(value)) return;
              let shouldDrawLabel = false;
              if (mode === "all") shouldDrawLabel = true;
              else if (mode === "max-global") shouldDrawLabel = value === globalMaxValue;
              else if (mode === "max-per-dataset") shouldDrawLabel = value === datasetMaxValue;
              if (!shouldDrawLabel) return;
              const position = (typeof element.getProps === "function")
                ? element.getProps(["x", "y", "base"], true)
                : { x: element.x, y: element.y, base: element.base };
              const xPosition = position.x;
              const yTop = Number.isFinite(position.base) ? Math.min(position.y, position.base) : position.y;
              context.fillText(formatValue(value), xPosition, yTop - 4);
            });
          });
          context.restore();
        } catch (error) {}
      }
    };

    try { Chart.register(barValueLabelPlugin); } catch (error) {}

    const snapLinePointsToBars = {
      id: "snapLinePointsToBars",
      beforeDatasetDraw(chart, args) {
        try {
          const lineDatasetIndex = args.index;
          const datasetsList = chart?.data?.datasets || [];
          const lineDataset = datasetsList[lineDatasetIndex];
          if (!lineDataset || lineDataset.type !== "line") return;
          const barDatasetIndex = Number(lineDataset.snapToBarIndex);
          if (!isFinite(barDatasetIndex)) return;
          const barMeta = chart.getDatasetMeta(barDatasetIndex);
          const lineMeta = chart.getDatasetMeta(lineDatasetIndex);
          if (!barMeta || !lineMeta) return;
          const barElements = barMeta.data || [];
          const linePoints = lineMeta.data || [];
          const count = Math.min(barElements.length, linePoints.length);
          for (let index = 0; index < count; index++) {
            const barElement = barElements[index];
            const linePoint = linePoints[index];
            if (!barElement || !linePoint) continue;
            const barXPosition = (typeof barElement.getProps === "function") ? barElement.getProps(["x"], true).x : barElement.x;
            if (typeof barXPosition === "number") {
              linePoint.x = barXPosition;
              if (typeof linePoint.controlPointPreviousX === "number") linePoint.controlPointPreviousX = barXPosition;
              if (typeof linePoint.controlPointNextX === "number") linePoint.controlPointNextX = barXPosition;
            }
          }
        } catch (error) {}
      }
    };

    try { Chart.register(snapLinePointsToBars); } catch (error) {}

    const enterpriseInteractionPlugin = {
      id: "enterpriseInteraction",
      afterEvent(chart, args) {
        try {
          const event = args && args.event;
          if (!event || !chart.chartArea) return;
          const area = chart.chartArea;
          const inArea = event.x >= area.left && event.x <= area.right && event.y >= area.top && event.y <= area.bottom;
          if (event.type === "mouseout" || !inArea) {
            chart.$crosshair = null;
          } else {
            chart.$crosshair = { x: event.x, y: event.y };
          }
          args.changed = true;
        } catch (error) {}
      },
      afterDraw(chart) {
        try {
          const pointer = chart.$crosshair;
          if (!pointer || !chart.chartArea) return;
          const ctx = chart.ctx;
          const area = chart.chartArea;
          const theme = graphBackgroundTheme();
          const xScale = chart.scales && chart.scales.x;
          const yScale = chart.scales && chart.scales.y;
          const labels = chart.data && chart.data.labels ? chart.data.labels : [];
          const xIndex = xScale && typeof xScale.getValueForPixel === "function"
            ? Math.max(0, Math.min(labels.length - 1, Math.round(Number(xScale.getValueForPixel(pointer.x)))))
            : -1;
          const yValue = yScale && typeof yScale.getValueForPixel === "function" ? yScale.getValueForPixel(pointer.y) : null;

          ctx.save();
          ctx.lineWidth = 1;
          ctx.setLineDash([4, 4]);
          ctx.strokeStyle = theme.text === "#e5e7eb" ? "rgba(226,232,240,0.48)" : "rgba(15,23,42,0.34)";
          ctx.beginPath();
          ctx.moveTo(pointer.x, area.top);
          ctx.lineTo(pointer.x, area.bottom);
          ctx.moveTo(area.left, pointer.y);
          ctx.lineTo(area.right, pointer.y);
          ctx.stroke();
          ctx.setLineDash([]);

          const xLabel = xIndex >= 0 ? String(labels[xIndex]) : "";
          const yLabel = Number.isFinite(Number(yValue)) ? formatAxisNumber(yValue) : "";
          const badge = [xLabel, yLabel].filter(Boolean).join("  |  ");
          if (badge) {
            ctx.font = "650 11px " + CHART_FONT_STACK;
            const width = ctx.measureText(badge).width + 18;
            const height = 24;
            let left = Math.min(area.right - width, Math.max(area.left, pointer.x + 10));
            let top = Math.max(area.top + 6, pointer.y - height - 8);
            ctx.fillStyle = "rgba(15,23,42,0.90)";
            ctx.strokeStyle = "rgba(255,255,255,0.18)";
            ctx.beginPath();
            ctx.roundRect(left, top, width, height, 7);
            ctx.fill();
            ctx.stroke();
            ctx.fillStyle = "#f8fafc";
            ctx.fillText(badge, left + 9, top + 16);
          }
          ctx.restore();
        } catch (error) {}
      }
    };

    const enterpriseAnnotationPlugin = {
      id: "enterpriseAnnotation",
      afterDatasetsDraw(chart) {
        try {
          const annotations = Array.isArray(chart.$analyticsAnnotations) ? chart.$analyticsAnnotations : [];
          const events = Array.isArray(chart.$analyticsMilestones) ? chart.$analyticsMilestones : [];
          const overlays = chart.$analyticsOverlays || {};
          const ctx = chart.ctx;
          const area = chart.chartArea;
          const xScale = chart.scales && chart.scales.x;
          const yScale = chart.scales && chart.scales.y;
          if (!area || !xScale || !yScale) return;
          const labels = chart.data && chart.data.labels ? chart.data.labels : [];
          const pxForIndex = (index) => xScale.getPixelForValue(Math.max(0, Math.min(labels.length - 1, index)));
          const pyForValue = (value) => yScale.getPixelForValue(Number(value || 0));

          function drawTextPill(text, x, y, color) {
            const label = String(text || "");
            if (!label) return;
            ctx.font = "650 11px " + CHART_FONT_STACK;
            const w = Math.min(190, ctx.measureText(label).width + 18);
            const h = 24;
            const left = Math.max(area.left + 4, Math.min(area.right - w - 4, x + 8));
            const top = Math.max(area.top + 4, Math.min(area.bottom - h - 4, y - h - 8));
            ctx.fillStyle = "rgba(15,23,42,0.88)";
            ctx.strokeStyle = color || "rgba(255,255,255,0.18)";
            ctx.beginPath();
            ctx.roundRect(left, top, w, h, 7);
            ctx.fill();
            ctx.stroke();
            ctx.fillStyle = "#f8fafc";
            ctx.fillText(label, left + 9, top + 16, w - 16);
          }

          function drawLineThrough(points, color, dash) {
            if (!points || points.length < 2) return;
            ctx.save();
            ctx.strokeStyle = color;
            ctx.lineWidth = 2;
            ctx.setLineDash(dash || []);
            ctx.beginPath();
            points.forEach((point, index) => {
              const x = pxForIndex(point.index);
              const y = pyForValue(point.value);
              if (index === 0) ctx.moveTo(x, y);
              else ctx.lineTo(x, y);
            });
            ctx.stroke();
            ctx.restore();
          }

          if (overlays.benchmark != null) {
            const y = pyForValue(overlays.benchmark);
            ctx.save();
            ctx.strokeStyle = "rgba(15,23,42,0.46)";
            ctx.lineWidth = 1.5;
            ctx.setLineDash([6, 6]);
            ctx.beginPath();
            ctx.moveTo(area.left, y);
            ctx.lineTo(area.right, y);
            ctx.stroke();
            drawTextPill("Benchmark " + formatAxisNumber(overlays.benchmark), area.left + 8, y, "rgba(15,23,42,0.46)");
            ctx.restore();
          }

          if (overlays.target != null) {
            const y = pyForValue(overlays.target);
            ctx.save();
            ctx.strokeStyle = "rgba(22,101,52,0.72)";
            ctx.lineWidth = 1.5;
            ctx.setLineDash([3, 5]);
            ctx.beginPath();
            ctx.moveTo(area.left, y);
            ctx.lineTo(area.right, y);
            ctx.stroke();
            // Anchored at the right edge so it never collides with the
            // benchmark pill, whose value (and therefore y position) is close.
            drawTextPill("Target " + formatAxisNumber(overlays.target), area.right - 190, y, "rgba(22,101,52,0.72)");
            ctx.restore();
          }

          drawLineThrough(overlays.movingAverage, "rgba(124,58,237,0.72)", [3, 4]);
          drawLineThrough(overlays.trendLine, "rgba(234,88,12,0.72)", [8, 5]);
          drawLineThrough(overlays.forecast, "rgba(8,145,178,0.62)", [2, 5]);

          events.forEach((item) => {
            const index = Number(item.index);
            if (!Number.isFinite(index)) return;
            const x = pxForIndex(index);
            ctx.save();
            ctx.strokeStyle = item.color || "rgba(37,99,235,0.58)";
            ctx.lineWidth = 1.5;
            ctx.setLineDash([5, 5]);
            ctx.beginPath();
            ctx.moveTo(x, area.top);
            ctx.lineTo(x, area.bottom);
            ctx.stroke();
            ctx.setLineDash([]);
            ctx.fillStyle = item.color || "rgba(37,99,235,0.82)";
            ctx.beginPath();
            ctx.arc(x, area.top + 10, 4, 0, Math.PI * 2);
            ctx.fill();
            drawTextPill(item.label, x, area.top + 34, item.color);
            ctx.restore();
          });

          annotations.forEach((annotation) => {
            const x = pxForIndex(Number(annotation.xIndex || 0));
            const y = pyForValue(annotation.yValue);
            const color = annotation.color || "rgba(37,99,235,0.82)";
            ctx.save();
            ctx.strokeStyle = color;
            ctx.fillStyle = color;
            ctx.lineWidth = 2;
            if (annotation.type === "region") {
              const x2 = pxForIndex(Math.min(labels.length - 1, Number(annotation.xIndex || 0) + Math.max(1, Math.round(labels.length / 8))));
              ctx.fillStyle = "rgba(37,99,235,0.10)";
              ctx.fillRect(Math.min(x, x2), area.top, Math.abs(x2 - x), area.bottom - area.top);
            } else if (annotation.type === "event") {
              ctx.setLineDash([4, 5]);
              ctx.beginPath();
              ctx.moveTo(x, area.top);
              ctx.lineTo(x, area.bottom);
              ctx.stroke();
            } else if (annotation.type === "arrow") {
              ctx.beginPath();
              ctx.moveTo(x - 34, y - 28);
              ctx.lineTo(x, y);
              ctx.stroke();
              ctx.beginPath();
              ctx.moveTo(x, y);
              ctx.lineTo(x - 8, y - 2);
              ctx.lineTo(x - 2, y - 9);
              ctx.closePath();
              ctx.fill();
            } else if (annotation.type === "trend") {
              const x2 = pxForIndex(Math.min(labels.length - 1, Number(annotation.xIndex || 0) + Math.max(2, Math.round(labels.length / 5))));
              const y2 = pyForValue(Number(annotation.yValue || 0) * 1.08);
              ctx.beginPath();
              ctx.moveTo(x, y);
              ctx.lineTo(x2, y2);
              ctx.stroke();
            } else {
              ctx.beginPath();
              ctx.arc(x, y, annotation.type === "note" ? 5 : 4, 0, Math.PI * 2);
              ctx.fill();
            }
            drawTextPill(annotation.note || annotation.type, x, y, color);
            ctx.restore();
          });
        } catch (error) {}
      }
    };

    try { Chart.register(enterpriseInteractionPlugin, enterpriseAnnotationPlugin); } catch (error) {}

    const campusSegmentationPlugin = {
      id: "campusSegmentation",
      beforeDatasetsDraw(chart) {
        try {
          const area = chart.chartArea;
          const xScale = chart.scales && chart.scales.x;
          const yScale = chart.scales && chart.scales.y;
          if (!area || !xScale || !yScale) return;
          const ctx = chart.ctx;
          const segments = Array.isArray(chart.$timeSegments) ? chart.$timeSegments : [];
          const labels = chart.data && chart.data.labels ? chart.data.labels : [];

          segments.forEach((segment, segmentIndex) => {
            const start = Math.max(0, Math.min(labels.length - 1, Number(segment.start || 0)));
            const end = Math.max(start, Math.min(labels.length - 1, Number(segment.end || start)));
            const startCenter = xScale.getPixelForValue(start);
            const endCenter = xScale.getPixelForValue(end);
            const step = labels.length > 1 ? Math.abs(xScale.getPixelForValue(Math.min(labels.length - 1, start + 1)) - startCenter) : (area.right - area.left);
            const left = Math.max(area.left, startCenter - step / 2);
            const right = Math.min(area.right, endCenter + step / 2);
            if (right <= left) return;
            ctx.save();
            ctx.fillStyle = segmentIndex % 2 === 0 ? "rgba(37,99,235,0.045)" : "rgba(15,23,42,0.026)";
            ctx.fillRect(left, area.top, right - left, area.bottom - area.top);
            ctx.restore();
          });

          const bands = Array.isArray(chart.$forecastBands) ? chart.$forecastBands : [];
          bands.forEach((band) => {
            const upper = Array.isArray(band.upper) ? band.upper : [];
            const lower = Array.isArray(band.lower) ? band.lower : [];
            if (!upper.length || !lower.length) return;
            const points = [];
            upper.forEach((value, index) => {
              if (value == null || lower[index] == null) return;
              points.push({ index, upper: Number(value), lower: Number(lower[index]) });
            });
            if (points.length < 2) return;
            ctx.save();
            ctx.fillStyle = band.color || "rgba(37,99,235,0.10)";
            ctx.beginPath();
            points.forEach((point, pointIndex) => {
              const x = xScale.getPixelForValue(point.index);
              const y = yScale.getPixelForValue(point.upper);
              if (pointIndex === 0) ctx.moveTo(x, y);
              else ctx.lineTo(x, y);
            });
            points.slice().reverse().forEach((point) => {
              ctx.lineTo(xScale.getPixelForValue(point.index), yScale.getPixelForValue(point.lower));
            });
            ctx.closePath();
            ctx.fill();
            ctx.restore();
          });
        } catch (error) {}
      },
      afterDraw(chart) {
        try {
          const area = chart.chartArea;
          const xScale = chart.scales && chart.scales.x;
          if (!area || !xScale) return;
          const segments = Array.isArray(chart.$timeSegments) ? chart.$timeSegments : [];
          if (!segments.length) return;
          const ctx = chart.ctx;
          const theme = graphBackgroundTheme();
          ctx.save();
          ctx.font = "700 10px " + CHART_FONT_STACK;
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          ctx.fillStyle = theme.text === "#e5e7eb" ? "rgba(226,232,240,0.82)" : "rgba(51,65,85,0.78)";
          segments.forEach((segment) => {
            const start = Number(segment.start || 0);
            const end = Number(segment.end || start);
            const mid = (xScale.getPixelForValue(start) + xScale.getPixelForValue(end)) / 2;
            if (mid < area.left + 18 || mid > area.right - 18) return;
            ctx.fillText(String(segment.label || ""), mid, area.bottom + 24, Math.max(44, Math.abs(xScale.getPixelForValue(end) - xScale.getPixelForValue(start))));
          });
          ctx.restore();
        } catch (error) {}
      }
    };

    try { Chart.register(campusSegmentationPlugin); } catch (error) {}

    // ============================================================
    // CHART OPTIONS + HELPERS
    // ============================================================
    const CHART_FONT_STACK = 'Inter, "IBM Plex Sans", Geist, "Segoe UI", Arial, sans-serif';
    const CHART_TYPOGRAPHY = {
      title: { size: 26, weight: "650" },
      subtitle: { size: 16, weight: "500" },
      axisTitle: { size: 15, weight: "500" },
      axisLabel: { size: 13, weight: "400" },
      legend: { size: 13, weight: "500" },
      tooltip: { size: 14, weight: "400" },
      tooltipTitle: { size: 14, weight: "650" }
    };
    const CHART_LAYOUT = {
      padding: { top: 18, right: 36, bottom: 26, left: 36 },
      xTickPadding: 16,
      yTickPadding: 12,
      axisTitlePadding: 12,
      maxLinearTicks: 5
    };
    const CHART_STROKES = {
      gridWidth: 1,
      axisWidth: 1
    };
    const CHART_BAR_STYLE = {
      radius: 6,
      categoryPercentage: 0.72,
      barPercentage: 0.82,
      maxBarThickness: 38
    };
    const CHART_LINE_STYLE = {
      borderWidth: 3.4,
      pointRadius: 2.8,
      pointHoverRadius: 6,
      pointBorderWidth: 2
    };

    try {
      Chart.defaults.font.family = CHART_FONT_STACK;
      Chart.defaults.font.size = CHART_TYPOGRAPHY.axisLabel.size;
      Chart.defaults.font.weight = CHART_TYPOGRAPHY.axisLabel.weight;
      Chart.defaults.color = ESG_CHART_COLORS.text;
    } catch (error) {}

    function createLegendClickHandler() {
      return function(event, legendItem, legend) {
        const chart = legend.chart;
        const clickedIndex = legendItem.datasetIndex;
        const clickedDataset = chart.data.datasets[clickedIndex];
        if (!clickedDataset) return;
        const meta = chart.getDatasetMeta(clickedIndex);
        meta.hidden = meta.hidden === null ? !chart.data.datasets[clickedIndex].hidden : !meta.hidden;
        chart.data.datasets.forEach((dataset, index) => {
          if (dataset.type === "line" && dataset.snapToBarIndex === clickedIndex) {
            const lineMeta = chart.getDatasetMeta(index);
            lineMeta.hidden = meta.hidden;
          }
        });
        if (clickedDataset.type === "line" && typeof clickedDataset.snapToBarIndex === "number") {
          const barIndex = clickedDataset.snapToBarIndex;
          const barMeta = chart.getDatasetMeta(barIndex);
          if (barMeta) barMeta.hidden = meta.hidden;
        }
        chart.update();
      };
    }

    function chartTextSize(kind) {
      if (kind === "axisTitle") return CHART_TYPOGRAPHY.axisTitle.size;
      if (kind === "legend") return CHART_TYPOGRAPHY.legend.size;
      if (kind === "tooltipTitle") return CHART_TYPOGRAPHY.tooltipTitle.size;
      if (kind === "tooltipBody") return CHART_TYPOGRAPHY.tooltip.size;
      return CHART_TYPOGRAPHY.axisLabel.size;
    }

    function formatAxisNumber(value) {
      const number = Number(value);
      if (!Number.isFinite(number)) return "";
      const absolute = Math.abs(number);
      if (absolute >= 1000000) return (number / 1000000).toLocaleString(undefined, { maximumFractionDigits: 1 }) + "M";
      if (absolute >= 1000) return (number / 1000).toLocaleString(undefined, { maximumFractionDigits: 1 }) + "K";
      return number.toLocaleString(undefined, { maximumFractionDigits: 0 });
    }

    function formatLogAxisNumber(value) {
      const number = Number(value);
      if (!Number.isFinite(number) || number <= 0) return "";
      if (number >= 1000000) return (number / 1000000).toLocaleString(undefined, { maximumFractionDigits: 0 }) + "M";
      if (number >= 1000) return (number / 1000).toLocaleString(undefined, { maximumFractionDigits: 0 }) + "K";
      return number.toLocaleString(undefined, { maximumFractionDigits: 0 });
    }

    function compactChartWord(word) {
      const raw = String(word || "");
      const upper = raw.toUpperCase();
      const dictionary = {
        "REPUBLIC": "Rep.",
        "POLYTECHNIC": "Poly",
        "TECHNOLOGY": "Tech",
        "CENTRE": "Ctr",
        "CENTER": "Ctr",
        "COMPLEX": "Complex",
        "BUILDING": "Bldg",
        "RENEWABLES": "Renew.",
        "GREENHOUSE": "Green Hse"
      };
      if (dictionary[upper]) return dictionary[upper];
      if (raw.length <= 12) return raw;
      return raw.slice(0, 11) + ".";
    }

    function smartTwoLineChartLabel(value) {
      const rawLabel = Array.isArray(value) ? value.join(" ") : String(value || "");
      const normalized = rawLabel.replace(/\s+/g, " ").trim();
      if (!normalized) return "";
      const knownLabels = {
        "GREEN HOUSE": ["Green", "Hse"],
        "SPORTS COMPLEX": ["Sports", "Cplx"],
        "SPORTS HALL": ["Sports", "Hall"],
        "THE ARCH": ["The", "Arch"],
        "URBAN RENEWABLES": ["Urban", "Renew."],
        "GENERAL WASTE": ["General", "Waste"],
        "RECYCLABLE WASTE": ["Recycl.", "Waste"]
      };
      const known = knownLabels[normalized.toUpperCase()];
      if (known) return known;
      if (normalized.length <= 8) return normalized;
      const words = normalized.split(" ").map(compactChartWord);
      if (words.length === 1) return [words[0].slice(0, 12), words[0].slice(12, 24)].filter(Boolean);
      let bestIndex = 1;
      let bestScore = Infinity;
      for (let index = 1; index < words.length; index++) {
        const left = words.slice(0, index).join(" ");
        const right = words.slice(index).join(" ");
        const longest = Math.max(left.length, right.length);
        const balance = Math.abs(left.length - right.length);
        const score = longest * 2 + balance;
        if (score < bestScore) {
          bestScore = score;
          bestIndex = index;
        }
      }
      let lineA = words.slice(0, bestIndex).join(" ");
      let lineB = words.slice(bestIndex).join(" ");
      if (lineA.length > 14) lineA = lineA.slice(0, 13) + ".";
      if (lineB.length > 14) lineB = lineB.slice(0, 13) + ".";
      return [lineA, lineB];
    }

    function isMonthAxis(labels) {
      const months = new Set(["jan","feb","mar","apr","may","jun","jul","aug","sep","oct","nov","dec"]);
      return Array.isArray(labels) && labels.length >= 10 && labels.every(label => months.has(String(label || "").toLowerCase()));
    }

    function shouldHideIntermediateMonthTick(labels, index, chart) {
      if (!isMonthAxis(labels)) return false;
      const width = chart && chart.chartArea ? chart.chartArea.right - chart.chartArea.left : 0;
      if (width >= 520) return false;
      return index % 2 !== 0;
    }

    function wrapChartLabel(value) {
      return smartTwoLineChartLabel(value);
    }

    function displayDatasetLabel(label) {
      return String(label || "").replace(/^_Line/, "");
    }

    function formatTooltipValue(value, unit) {
      const number = Number(value);
      if (!Number.isFinite(number)) return String(value || "");
      return number.toLocaleString(undefined, { maximumFractionDigits: 1 }) + (unit ? " " + unit : "");
    }

    function inferDatasetUnit(dataset, chart) {
      const label = String(dataset && dataset.label || "").toLowerCase();
      const yAxisId = String(dataset && dataset.yAxisID || "y");
      const axisTitle = chart && chart.options && chart.options.scales && chart.options.scales[yAxisId] && chart.options.scales[yAxisId].title
        ? String(chart.options.scales[yAxisId].title.text || "")
        : "";
      const source = (label + " " + axisTitle).toLowerCase();
      if (source.indexOf("kwh") !== -1 || source.indexOf("electricity") !== -1 || source.indexOf("solar") !== -1) return "kWh";
      if (source.indexOf("m³") !== -1 || source.indexOf("m3") !== -1 || source.indexOf("water") !== -1) return "m³";
      if (source.indexOf("kg") !== -1 || source.indexOf("waste") !== -1 || source.indexOf("recyclable") !== -1) return "kg";
      return "";
    }

    function pctChange(current, previous) {
      const now = Number(current);
      const before = Number(previous);
      if (!Number.isFinite(now) || !Number.isFinite(before) || before === 0) return null;
      return ((now - before) / Math.abs(before)) * 100;
    }

    function formatPercent(value) {
      const number = Number(value);
      if (!Number.isFinite(number)) return "n/a";
      const sign = number > 0 ? "+" : "";
      return sign + number.toLocaleString(undefined, { maximumFractionDigits: 1 }) + "%";
    }

    function visibleDatasetValues(chart, datasetIndex, startIndex, endIndex) {
      if (!chart || !chart.data || !chart.data.datasets) return [];
      if (!chart.isDatasetVisible(datasetIndex)) return [];
      const dataset = chart.data.datasets[datasetIndex];
      const values = Array.isArray(dataset && dataset.data) ? dataset.data : [];
      const start = Math.max(0, Number.isFinite(startIndex) ? startIndex : 0);
      const end = Math.min(values.length - 1, Number.isFinite(endIndex) ? endIndex : values.length - 1);
      const output = [];
      for (let index = start; index <= end; index++) {
        if (values[index] == null) continue; // null = no reading for this period
        const value = Number(values[index]);
        if (Number.isFinite(value)) output.push(value);
      }
      return output;
    }

    function getVisibleRange(chart) {
      const labels = (chart && chart.data && chart.data.labels) || [];
      if (!labels.length) return { start: 0, end: 0 };
      const xOptions = chart.options && chart.options.scales && chart.options.scales.x ? chart.options.scales.x : {};
      const minRaw = xOptions.min;
      const maxRaw = xOptions.max;
      const indexFor = (value, fallback) => {
        if (value == null || value === "") return fallback;
        const numeric = Number(value);
        if (Number.isFinite(numeric)) return Math.max(0, Math.min(labels.length - 1, Math.round(numeric)));
        const found = labels.findIndex(label => String(label) === String(value));
        return found >= 0 ? found : fallback;
      };
      return {
        start: indexFor(minRaw, 0),
        end: indexFor(maxRaw, labels.length - 1)
      };
    }

    function summarizeValues(values) {
      const clean = (values || []).filter(value => value != null).map(Number).filter(Number.isFinite).sort((a, b) => a - b);
      if (!clean.length) return null;
      const total = clean.reduce((sum, value) => sum + value, 0);
      const average = total / clean.length;
      const mid = Math.floor(clean.length / 2);
      const median = clean.length % 2 ? clean[mid] : (clean[mid - 1] + clean[mid]) / 2;
      const variance = clean.reduce((sum, value) => sum + Math.pow(value - average, 2), 0) / clean.length;
      return {
        min: clean[0],
        max: clean[clean.length - 1],
        average,
        median,
        total,
        variance,
        count: clean.length
      };
    }

    function primaryVisibleDataset(chart) {
      if (!chart || !chart.data || !Array.isArray(chart.data.datasets)) return null;
      for (let index = 0; index < chart.data.datasets.length; index++) {
        const dataset = chart.data.datasets[index];
        if (!dataset || String(dataset.label || "").startsWith("_")) continue;
        if (chart.isDatasetVisible && !chart.isDatasetVisible(index)) continue;
        // Skip series with no readings at all (e.g. a year with no data) so
        // overlays and insights anchor on a series that actually has values.
        const hasData = (dataset.data || []).some(value => value != null && Number.isFinite(Number(value)));
        if (!hasData) continue;
        return { dataset, index };
      }
      return null;
    }

    function computeDatasetAverage(chart, datasetIndex) {
      const values = visibleDatasetValues(chart, datasetIndex);
      if (!values.length) return null;
      return values.reduce((sum, value) => sum + value, 0) / values.length;
    }

    function computeRankAtIndex(chart, datasetIndex, dataIndex) {
      if (!chart || !chart.data || !Array.isArray(chart.data.datasets)) return null;
      const target = Number(chart.data.datasets[datasetIndex] && chart.data.datasets[datasetIndex].data ? chart.data.datasets[datasetIndex].data[dataIndex] : NaN);
      if (!Number.isFinite(target)) return null;
      const values = chart.data.datasets
        .map((dataset, index) => {
          const raw = dataset && dataset.data ? dataset.data[dataIndex] : null;
          return { index, value: raw == null ? NaN : Number(raw) };
        })
        .filter(item => Number.isFinite(item.value) && (!chart.isDatasetVisible || chart.isDatasetVisible(item.index)))
        .sort((a, b) => b.value - a.value);
      const rank = values.findIndex(item => item.index === datasetIndex);
      return rank >= 0 ? { rank: rank + 1, total: values.length } : null;
    }

    function makeAxisFont(kind) {
      const spec = CHART_TYPOGRAPHY[kind] || CHART_TYPOGRAPHY.axisLabel;
      return { family: CHART_FONT_STACK, size: spec.size, weight: spec.weight };
    }

    function makeAxisTitle(text, color) {
      return {
        display: true,
        text: text,
        color: color || graphBackgroundTheme().axisTitle,
        font: makeAxisFont("axisTitle"),
        padding: { bottom: CHART_LAYOUT.axisTitlePadding }
      };
    }

    function buildLinearTicks(min, max, count) {
      const tickCount = Math.max(2, Number(count || CHART_LAYOUT.maxLinearTicks));
      const low = Number.isFinite(Number(min)) ? Number(min) : 0;
      const highRaw = Number.isFinite(Number(max)) ? Number(max) : 1;
      const high = highRaw <= low ? low + 1 : highRaw;
      const step = (high - low) / (tickCount - 1);
      const ticks = [];
      for (let index = 0; index < tickCount; index++) {
        ticks.push({ value: low + (step * index) });
      }
      return ticks;
    }

    function syncSecondaryAxisTicks(scale) {
      try {
        const primary = scale && scale.chart && scale.chart.scales && scale.chart.scales.y;
        if (!primary || !Array.isArray(primary.ticks) || primary.ticks.length < 2) return;
        const count = primary.ticks.length;
        if (scale.type === "logarithmic") {
          scale.ticks = primary.ticks.map(tick => ({ value: tick.value }));
          scale.min = primary.min;
          scale.max = primary.max;
          return;
        }
        scale.ticks = buildLinearTicks(scale.min, scale.max, count);
      } catch (error) {}
    }

    function mirrorPrimaryAxisTicks(scale) {
      try {
        const primary = scale && scale.chart && scale.chart.scales && scale.chart.scales.y;
        if (!primary || !Array.isArray(primary.ticks) || primary.ticks.length < 2) return;
        scale.ticks = primary.ticks.map(tick => ({ value: tick.value }));
        scale.min = primary.min;
        scale.max = primary.max;
      } catch (error) {}
    }

    function buildLogTicksForRange(min, max) {
      const low = Math.max(1, Number.isFinite(Number(min)) ? Number(min) : 1);
      const high = Math.max(low, Number.isFinite(Number(max)) ? Number(max) : 10);
      const ticks = [];
      let value = 1;
      while (value < low && value < 10000000) value *= 10;
      if (value > low && value > 1) value /= 10;
      while (value <= Math.max(high, 10) && value <= 10000000) {
        ticks.push({ value: value });
        value *= 10;
      }
      if (!ticks.some(tick => tick.value >= high) && value <= 100000000) ticks.push({ value: value });
      return ticks.length ? ticks : [{ value: 1 }, { value: 10 }];
    }

    function enforceLogScaleTicks(scale) {
      try {
        const ticks = buildLogTicksForRange(scale.min, scale.max);
        scale.ticks = ticks;
        scale.min = Math.min(scale.min || ticks[0].value, ticks[0].value);
        scale.max = Math.max(scale.max || ticks[ticks.length - 1].value, ticks[ticks.length - 1].value);
      } catch (error) {}
    }

    function getChartTooltipElement(chart) {
      let tooltipElement = chart.canvas && chart.canvas.parentNode
        ? chart.canvas.parentNode.querySelector(".premium-chart-tooltip")
        : null;
      if (!tooltipElement && chart.canvas && chart.canvas.parentNode) {
        tooltipElement = document.createElement("div");
        tooltipElement.className = "premium-chart-tooltip";
        tooltipElement.innerHTML = '<div class="pct-title"></div><div class="pct-body"></div>';
        chart.canvas.parentNode.appendChild(tooltipElement);
      }
      return tooltipElement;
    }

    function externalChartTooltip(context) {
      const chart = context.chart;
      const tooltip = context.tooltip;
      const tooltipElement = getChartTooltipElement(chart);
      if (!tooltipElement) return;

      if (!tooltip || tooltip.opacity === 0) {
        tooltipElement.style.opacity = "0";
        tooltipElement.style.transform = "translate(-50%, calc(-100% - 14px)) scale(0.97)";
        return;
      }

      const title = (tooltip.title || []).join(" ");
      tooltipElement.querySelector(".pct-title").textContent = title;
      const body = tooltipElement.querySelector(".pct-body");
      body.innerHTML = "";

      (tooltip.dataPoints || []).forEach((point) => {
        const dataset = point.dataset || {};
        const datasetIndex = Number(point.datasetIndex);
        const dataIndex = Number(point.dataIndex);
        const row = document.createElement("div");
        row.className = "pct-row";
        const color = dataset.borderColor || dataset.backgroundColor || "#64748b";
        const numericValue = point.parsed && Number.isFinite(Number(point.parsed.y)) ? point.parsed.y : point.raw;
        row.innerHTML =
          '<span class="pct-dot"></span>' +
          '<span class="pct-label"></span>' +
          '<span class="pct-value"></span>';
        row.querySelector(".pct-dot").style.background = typeof color === "string" ? color : "#64748b";
        row.querySelector(".pct-label").textContent = displayDatasetLabel(dataset.label);
        row.querySelector(".pct-value").textContent = formatTooltipValue(numericValue, inferDatasetUnit(dataset, chart));
        body.appendChild(row);

        const previousRaw = Array.isArray(dataset.data) && dataIndex > 0 ? dataset.data[dataIndex - 1] : null;
        const previous = previousRaw == null ? NaN : Number(previousRaw);
        const currentAverage = computeDatasetAverage(chart, datasetIndex);
        const periodChange = pctChange(numericValue, previous);
        const deviation = Number.isFinite(Number(currentAverage)) && currentAverage !== 0
          ? ((Number(numericValue) - currentAverage) / Math.abs(currentAverage)) * 100
          : null;
        const rank = computeRankAtIndex(chart, datasetIndex, dataIndex);
        const meta = document.createElement("div");
        meta.className = "pct-meta";
        meta.innerHTML =
          '<span><strong>Period change</strong> ' + formatPercent(periodChange) + '</span>' +
          '<span><strong>Vs average</strong> ' + formatPercent(deviation) + '</span>' +
          (rank ? '<span><strong>Visible rank</strong> ' + rank.rank + ' of ' + rank.total + '</span>' : "");
        body.appendChild(meta);
      });

      const canvasRect = chart.canvas.getBoundingClientRect();
      const parentRect = chart.canvas.parentNode.getBoundingClientRect();
      let left = tooltip.caretX + (canvasRect.left - parentRect.left);
      let top = tooltip.caretY + (canvasRect.top - parentRect.top);
      const maxLeft = parentRect.width - 12;
      left = Math.max(12, Math.min(maxLeft, left));
      top = Math.max(64, top);
      tooltipElement.style.left = left + "px";
      tooltipElement.style.top = top + "px";
      tooltipElement.style.opacity = "1";
      tooltipElement.style.transform = "translate(-50%, calc(-100% - 14px)) scale(1)";
    }

    function applyGraphBackgroundToChartOptions(options) {
      const theme = graphBackgroundTheme();
      if (!options || !theme) return options;

      if (options.plugins && options.plugins.legend && options.plugins.legend.labels) {
        options.plugins.legend.labels.color = theme.text;
      }

      const scales = options.scales || {};
      Object.keys(scales).forEach((scaleKey) => {
        const scale = scales[scaleKey];
        if (!scale) return;
        if (!scale.ticks) scale.ticks = {};
        scale.ticks.color = theme.text;
        if (!scale.grid) scale.grid = {};
        if (scaleKey !== "y1" || scale.grid.drawOnChartArea !== false) scale.grid.color = theme.grid;
        if (!scale.border) scale.border = {};
        scale.border.color = theme.axis;
        scale.border.width = CHART_STROKES.axisWidth;
        if (scale.title && scale.title.display) {
          const titleText = String(scale.title.text || "").toLowerCase();
          if (titleText.indexOf("electricity") !== -1) scale.title.color = theme.electricityTitle;
          else if (titleText.indexOf("water") !== -1) scale.title.color = theme.waterTitle;
          else scale.title.color = theme.axisTitle;
        }
      });

      return options;
    }

    function baseChartOptions() {
      return applyGraphBackgroundToChartOptions({
        responsive: true,
        maintainAspectRatio: false,
        layout: { padding: CHART_LAYOUT.padding },
        animation: { duration: 720, easing: "easeOutQuart" },
        animations: {
          y: {
            from: 0,
            duration: 720,
            easing: "easeOutQuart",
            delay(context) {
              if (context.type === "data" && context.mode === "default") return Math.min(context.dataIndex * 14, 220);
              return 0;
            }
          },
          tension: {
            duration: 520,
            easing: "easeOutQuart",
            from: 0.28,
            to: 0.38
          }
        },
        interaction: { mode: "index", intersect: false },
        hover: { mode: "nearest", intersect: false, animationDuration: 160 },
        plugins: {
          barValueLabel: { enabled: false, mode: "max-per-dataset" },
          legend: {
            display: false,
            onClick: createLegendClickHandler(),
            labels: {
              color: "#111827",
              boxWidth: 10,
              boxHeight: 10,
              borderRadius: 3,
              padding: 14,
              usePointStyle: true,
              pointStyle: "rectRounded",
              font: makeAxisFont("legend"),
              filter: (legendItem) => !String(legendItem.text || "").startsWith("_")
            }
          },
          tooltip: {
            enabled: false,
            external: externalChartTooltip,
            backgroundColor: "rgba(15,23,42,0.94)",
            titleColor: "#ffffff",
            bodyColor: "#e5e7eb",
            borderColor: "rgba(255,255,255,0.16)",
            borderWidth: 1,
            cornerRadius: 10,
            displayColors: true,
            padding: 12,
            titleFont: makeAxisFont("tooltipTitle"),
            bodyFont: makeAxisFont("tooltip"),
            callbacks: {
              label(context) {
                const label = context.dataset && context.dataset.label ? String(context.dataset.label).replace(/^_Line/, "") : "";
                const value = Number(context.parsed && context.parsed.y);
                return `${label}: ${Number.isFinite(value) ? value.toLocaleString(undefined, { maximumFractionDigits: 0 }) : context.formattedValue}`;
              }
            }
          }
        },
        scales: {
          x: {
            ticks: {
              color: "#111827",
              padding: CHART_LAYOUT.xTickPadding,
              maxRotation: 0,
              minRotation: 0,
              autoSkip: false,
              align: "center",
              crossAlign: "center",
              font: makeAxisFont("axisLabel"),
              callback(value) {
                const label = this.getLabelForValue ? this.getLabelForValue(value) : value;
                if (shouldHideIntermediateMonthTick(this.chart && this.chart.data ? this.chart.data.labels : [], Number(value), this.chart)) return "";
                return wrapChartLabel(label);
              }
            },
            grid: { display: false, drawTicks: false, tickLength: 0, color: "rgba(17,24,39,0.05)", lineWidth: CHART_STROKES.gridWidth },
            border: { display: true, color: ESG_CHART_COLORS.axis, width: CHART_STROKES.axisWidth }
          },
          y: {
            ticks: {
              color: "#111827",
              padding: CHART_LAYOUT.yTickPadding,
              maxTicksLimit: CHART_LAYOUT.maxLinearTicks,
              count: CHART_LAYOUT.maxLinearTicks,
              font: makeAxisFont("axisLabel"),
              callback: formatAxisNumber
            },
            grid: {
              color: ESG_CHART_COLORS.grid,
              drawBorder: false,
              drawTicks: false,
              lineWidth: CHART_STROKES.gridWidth,
              tickLength: 0
            },
            border: { display: true, color: ESG_CHART_COLORS.axis, width: CHART_STROKES.axisWidth },
            position: "left",
            beginAtZero: true,
            grace: "8%"
          },
          y1: {
            ticks: {
              color: "#111827",
              padding: CHART_LAYOUT.yTickPadding,
              maxTicksLimit: CHART_LAYOUT.maxLinearTicks,
              count: CHART_LAYOUT.maxLinearTicks,
              font: makeAxisFont("axisLabel"),
              callback: formatAxisNumber
            },
            grid: {
              drawOnChartArea: false,
              drawTicks: false,
              tickLength: 0,
              lineWidth: CHART_STROKES.gridWidth,
              color: ESG_CHART_COLORS.grid
            },
            border: { display: true, color: ESG_CHART_COLORS.axis, width: CHART_STROKES.axisWidth },
            position: "right",
            beginAtZero: true,
            grace: "8%",
            afterBuildTicks: syncSecondaryAxisTicks
          }
        }
      });
    }

    const month_labels = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
    const color_electricity = ESG_CHART_COLORS.electricity;
    const color_water = ESG_CHART_COLORS.water;
    const color_solar_urban = ESG_CHART_COLORS.solar;
    const color_solar_gh = "#65a30d";
    const color_waste_gen = ESG_CHART_COLORS.waste;
    const color_waste_rec = ESG_CHART_COLORS.recyclable;

    // A month recorded as 0 inside a series that has real readings elsewhere is
    // almost always a missing bill, not a true zero. Convert those to null so
    // Chart.js draws a gap instead of a dive to zero, and stats skip them.
    // A series that is entirely zero is kept as-is — that is a genuine
    // "nothing recorded" story (e.g. no recyclable waste yet).
    function nullifyMissingReadings(series) {
      const values = (series || []).map(value => (value == null ? null : Number(value)));
      const hasRealReading = values.some(value => Number.isFinite(value) && value !== 0);
      if (!hasRealReading) return values;
      return values.map(value => (value === 0 ? null : value));
    }

    function hideZeroMonths(labels, ...series) {
      const keep = labels.map((_, index) => series.some(arr => Number(arr[index] || 0) !== 0));
      const outLabels = [];
      const outSeries = series.map(() => []);
      for (let index = 0; index < labels.length; index++) {
        if (!keep[index]) continue;
        outLabels.push(labels[index]);
        series.forEach((arr, seriesIndex) => outSeries[seriesIndex].push(Number(arr[index] || 0)));
      }
      if (!outLabels.length) return { labels: labels.slice(), series: series.map(array => array.map(value => Number(value || 0))) };
      return { labels: outLabels, series: outSeries.map(nullifyMissingReadings) };
    }

    function formatNumber(number) {
      const value = Number(number || 0);
      if (!isFinite(value)) return "0";
      return value.toLocaleString(undefined, { maximumFractionDigits: 0 });
    }

    // Shrink a solar/waste info panel just enough to fit its fixed-height column
    // so NO card is clipped. Uses Chrome's `zoom` (the kiosk browser), which
    // reduces layout height and keeps full width. Never enlarges; floors at 0.7
    // and the column still scrolls as a last resort.
    function fitPanelToHeight(bodyEl) {
      if (!bodyEl) return;
      function apply() {
        const content = bodyEl.firstElementChild;
        if (!content) return;
        content.style.zoom = "1";
        content.style.width = "";
        const avail = bodyEl.clientHeight;
        const needed = content.scrollHeight;
        if (avail > 0 && needed > avail + 2) {
          const z = Math.max(0.7, (avail / needed) * 0.99);
          content.style.zoom = z;
          // Final visual width = specified width * z, so (100/z)% always fills
          // the column regardless of how `zoom` treats auto width.
          content.style.width = (100 / z) + "%";
        }
      }
      requestAnimationFrame(function () { apply(); requestAnimationFrame(apply); });
      setTimeout(apply, 300); // re-measure once the page-slide settles
    }
    // Re-fit if the window is resized while a solar/waste panel is showing.
    window.addEventListener("resize", function () {
      fitPanelToHeight(document.getElementById("solarLeftBody"));
      fitPanelToHeight(document.getElementById("wasteLeftBody"));
    });

    function normalizeBuildingKey(name) {
      if (!name) return "";
      const raw = String(name).trim();
      if (!raw) return "";
      
      const normalized = raw.replace(/\s+/g, ' ');
      const upper = normalized.toUpperCase();
      
      if (/^E[1-6]\b/.test(upper)) return upper.slice(0, 2);
      if (/^W[1-6]\b/.test(upper)) return upper.slice(0, 2);
      
      if (upper.includes("SPORT") && (upper.includes("HALL") || upper.includes("COMPLEX"))) {
        return "SPORTS COMPLEX";
      }
      if (upper.includes("GREEN") && upper.includes("HOUSE")) {
        return "GREEN HOUSE";
      }
      if (upper.includes("ARCH")) {
        return "THE ARCH";
      }
      if ((upper.includes("BLK") || upper.includes("BLOCK")) && upper.includes("43") || upper === "SIT") {
        return "BLK 43";
      }
      
      if (upper === "RPIC" || upper === "RIPC") return "RPIC";
      if (upper === "ECMC") return "ECMC";
      if (upper === "RPC") return "RPC";
      if (upper === "TRCC") return "TRCC";
      if (upper === "XLC") return "XLC";
      if (upper === "ALC") return "ALC";
      
      return upper;
    }

    function labelForBuilding(code) {
      const key = normalizeBuildingKey(code);
      const dbLabel = building_label_map && building_label_map[key];
      if (dbLabel) return dbLabel;
      return key;
    }

    function cardLabelForBuilding(code) {
      const key = normalizeBuildingKey(code);
      const cardLabel = building_card_label_map && building_card_label_map[key];
      if (cardLabel) return cardLabel;
      const displayLabel = building_label_map && building_label_map[key];
      if (displayLabel) return displayLabel;
      return key;
    }

    function buildingSlugFromCode(code) {
      const key = normalizeBuildingKey(code);
      return String(key || "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
    }

    // ============================================================
    // MULTI-YEAR COLOR PALETTE
    // ============================================================
    const yearColorPalette = [
      "#1d4ed8", "#2563eb", "#3b82f6", "#60a5fa",
      "#0891b2", "#06b6d4", "#22d3ee", "#0f766e",
      "#64748b", "#475569", "#16a34a", "#65a30d",
      "#d97706", "#ea580c", "#7c3aed", "#8b5cf6"
    ];

    function getColorForYear(yearIndex, totalYears) {
      if (totalYears <= 1) return yearColorPalette[5];
      const step = Math.floor(yearColorPalette.length / Math.min(totalYears, yearColorPalette.length));
      const colorIndex = (yearIndex * step) % yearColorPalette.length;
      return yearColorPalette[colorIndex];
    }

    // Per-metric year colours. Each stays in the metric's colour family but the
    // steps are far enough apart (hue + lightness) to tell years apart at a
    // glance — the old ramps had near-identical neighbours (#1d4ed8 vs #2563eb).
    const METRIC_YEAR_PALETTES = {
      electricity: ["#1e3a8a", "#2563eb", "#0ea5e9", "#6366f1", "#38bdf8", "#4338ca"],
      water: ["#164e63", "#0891b2", "#22d3ee", "#14b8a6", "#0369a1", "#5eead4"],
      solar: ["#92400e", "#ea580c", "#f59e0b", "#fbbf24", "#b45309", "#facc15"],
      waste: ["#1f2937", "#64748b", "#94a3b8", "#475569", "#334155", "#a1a1aa"]
    };

    function getMetricYearColor(metric, yearIndex, totalYears) {
      const palette = METRIC_YEAR_PALETTES[metric] || yearColorPalette;
      if (totalYears <= 1) return palette[0];
      return palette[yearIndex % palette.length];
    }

    // ============================================================
    // CHART COLOUR CUSTOMISATION (Electricity & Water "by building" charts)
    // ------------------------------------------------------------
    // Pick a basic colour for each year; that one colour is used for BOTH the
    // year's bars and its trend line. Different years stay different colours.
    // Saved per-browser in localStorage; UI lives in the floating "🎨" panel.
    // ============================================================
    const CHART_COLOR_STORAGE_KEY = "esgChartColorPrefs";
    // Colour choices shown in the pop-up grid picker (4 per row).
    const COLOR_GRID = [
      "#1d4ed8", "#2563eb", "#3b82f6", "#60a5fa",
      "#0891b2", "#06b6d4", "#22d3ee", "#0f766e",
      "#64748b", "#475569", "#94a3b8", "#16a34a",
      "#65a30d", "#d97706", "#ea580c", "#7c3aed",
      "#0f172a", "#f4f7fb", "#ffffff"
    ];

    // Colours are stored PER CHART ("electricity" / "water") so each one keeps
    // its own per-year colours and changing one never affects the other.
    function defaultColorPrefs() {
      return { electricity: {}, water: {}, solar: {}, waste: {} };
    }

    let chartColorPrefs = (function loadColorPrefs() {
      try {
        const raw = localStorage.getItem(CHART_COLOR_STORAGE_KEY);
        const parsed = raw ? (JSON.parse(raw) || {}) : {};
        return {
          electricity: (parsed && parsed.electricity) || {},
          water: (parsed && parsed.water) || {},
          solar: (parsed && parsed.solar) || {},
          waste: (parsed && parsed.waste) || {}
        };
      } catch (e) { return defaultColorPrefs(); }
    })();

    function saveColorPrefs() {
      try { localStorage.setItem(CHART_COLOR_STORAGE_KEY, JSON.stringify(chartColorPrefs)); } catch (e) {}
    }

    // ---- small colour helpers (work on #rrggbb) ----
    function normalizeHex(hex) {
      let h = String(hex || "").trim();
      if (h[0] !== "#") h = "#" + h;
      return h.toLowerCase();
    }
    function isHex6(hex) { return /^#?[0-9a-fA-F]{6}$/.test(String(hex || "")); }
    function hexToRgb(hex) {
      const h = normalizeHex(hex).replace("#", "");
      return { r: parseInt(h.slice(0, 2), 16), g: parseInt(h.slice(2, 4), 16), b: parseInt(h.slice(4, 6), 16) };
    }
    function hexToRgba(hex, alpha) {
      if (!isHex6(hex)) return hex; // fall back gracefully for any non-hex value
      const { r, g, b } = hexToRgb(hex);
      return `rgba(${r}, ${g}, ${b}, ${alpha})`;
    }
    function darkenHex(hex, amount) {
      if (!isHex6(hex)) return hex;
      const { r, g, b } = hexToRgb(hex);
      const f = 1 - Math.max(0, Math.min(1, amount));
      const to2 = (n) => Math.round(n * f).toString(16).padStart(2, "0");
      return `#${to2(r)}${to2(g)}${to2(b)}`;
    }
    function lightenHex(hex, amount) {
      if (!isHex6(hex)) return hex;
      const { r, g, b } = hexToRgb(hex);
      const f = Math.max(0, Math.min(1, amount));
      const to2 = (n) => Math.round(n + (255 - n) * f).toString(16).padStart(2, "0");
      return `#${to2(r)}${to2(g)}${to2(b)}`;
    }
    function makeBarGradient(hex) {
      const base = normalizeHex(hex);
      return function(context) {
        try {
          const chart = context.chart;
          const area = chart.chartArea;
          if (!area) return base;
          const gradient = chart.ctx.createLinearGradient(0, area.top, 0, area.bottom);
          gradient.addColorStop(0, lightenHex(base, 0.24));
          gradient.addColorStop(0.54, base);
          gradient.addColorStop(1, darkenHex(base, 0.10));
          return gradient;
        } catch (error) {
          return base;
        }
      };
    }
    function styleBarDataset(dataset, color, options) {
      const cfg = options || {};
      dataset.backgroundColor = makeBarGradient(color);
      dataset.borderColor = lightenHex(color, 0.06);
      dataset.hoverBackgroundColor = lightenHex(color, 0.15);
      dataset.hoverBorderColor = lightenHex(color, 0.26);
      dataset.borderWidth = 1;
      dataset.borderRadius = cfg.radius || CHART_BAR_STYLE.radius;
      dataset.borderSkipped = false;
      dataset.categoryPercentage = cfg.categoryPercentage || CHART_BAR_STYLE.categoryPercentage;
      dataset.barPercentage = cfg.barPercentage || CHART_BAR_STYLE.barPercentage;
      dataset.maxBarThickness = cfg.maxBarThickness || CHART_BAR_STYLE.maxBarThickness;
      return dataset;
    }
    function styleLineDataset(dataset, color, options) {
      const cfg = options || {};
      dataset.borderColor = color;
      dataset.backgroundColor = hexToRgba(color, 0.10);
      dataset.pointBackgroundColor = "#ffffff";
      dataset.pointBorderColor = color;
      dataset.pointBorderWidth = cfg.pointBorderWidth || CHART_LINE_STYLE.pointBorderWidth;
      dataset.pointRadius = cfg.pointRadius || CHART_LINE_STYLE.pointRadius;
      dataset.pointHoverRadius = cfg.pointHoverRadius || CHART_LINE_STYLE.pointHoverRadius;
      dataset.pointHoverBorderWidth = 3;
      dataset.pointHoverBackgroundColor = "#ffffff";
      dataset.pointHoverBorderColor = lightenHex(color, 0.18);
      dataset.borderWidth = cfg.borderWidth || CHART_LINE_STYLE.borderWidth;
      dataset.hoverBorderWidth = (cfg.borderWidth || CHART_LINE_STYLE.borderWidth) + 0.6;
      dataset.tension = cfg.tension == null ? 0.38 : cfg.tension;
      dataset.cubicInterpolationMode = "monotone";
      dataset.capBezierPoints = true;
      dataset.fill = false;
      return dataset;
    }

    // Resolve a year's colour for a SPECIFIC chart ("electricity" or "water").
    // Bars and the trend line of that year share this one colour.
    function getYearColor(chartKey, year, yearIndex, totalYears) {
      const map = chartColorPrefs[chartKey] || {};
      const override = map[String(year)];
      if (isHex6(override)) return normalizeHex(override);
      return getMetricYearColor(chartKey, yearIndex, totalYears);
    }

    const BUILDING_COLOR_PALETTE = [
      "#2563eb", "#0891b2", "#16a34a", "#d97706", "#7c3aed", "#dc2626",
      "#0f766e", "#9333ea", "#ea580c", "#0284c7", "#65a30d", "#be123c",
      "#475569", "#c2410c", "#4338ca", "#0d9488", "#a16207", "#4f46e5",
      "#15803d", "#b45309", "#0369a1", "#7e22ce", "#1f2937", "#059669"
    ];

    function hashStringToIndex(value, modulo) {
      const text = String(value || "");
      let hash = 0;
      for (let index = 0; index < text.length; index++) {
        hash = ((hash << 5) - hash) + text.charCodeAt(index);
        hash |= 0;
      }
      return Math.abs(hash) % Math.max(1, modulo || 1);
    }

    // One stable colour per building, assigned by its position in the campus
    // building list. With 24 palette entries and ~22 buildings every building
    // gets a unique colour — a name hash used to collide (e.g. E1 and E4).
    function buildingSeriesColor(buildingKey) {
      const key = normalizeBuildingKey(buildingKey);
      const index = (typeof allBuildingCodes !== "undefined" && Array.isArray(allBuildingCodes))
        ? allBuildingCodes.indexOf(key)
        : -1;
      if (index >= 0) return BUILDING_COLOR_PALETTE[index % BUILDING_COLOR_PALETTE.length];
      return BUILDING_COLOR_PALETTE[hashStringToIndex(key, BUILDING_COLOR_PALETTE.length)];
    }

    // Set one year's colour for one chart, persist, re-skin the chart, refresh swatches.
    function setYearColor(chartKey, year, hex) {
      if (!isHex6(hex)) return;
      if (!chartColorPrefs[chartKey]) chartColorPrefs[chartKey] = {};
      chartColorPrefs[chartKey][String(year)] = normalizeHex(hex);
      saveColorPrefs();
      applyChartColors();
      buildInlineColorControls();
      applyBuildingChartColors();
      buildBuildingColorControls();
      refreshCategoryChartsAndControls();
    }

    // Recolour an already-built compare chart in place (no rebuild, keeps timers running).
    function recolorCompareChart(chart, chartKey) {
      if (!chart || !chart.data || !Array.isArray(chart.data.datasets)) return;
      const sortedYears = [...allYears].sort((a, b) => a - b);
      const total = sortedYears.length;
      chart.data.datasets.forEach((ds) => {
        const label = String(ds.label || "");
        let year, isLine = false;
        if (label.indexOf("_Line") === 0) { year = label.slice(5); isLine = true; }
        else { year = label; }
        const idx = sortedYears.findIndex((y) => String(y) === String(year));
        const yearIndex = idx < 0 ? 0 : idx;
        const color = getYearColor(chartKey, year, yearIndex, total);
        if (isLine) {
          styleLineDataset(ds, color);
        } else {
          styleBarDataset(ds, color);
        }
      });
      chart.update();
    }
    function applyChartColors() {
      recolorCompareChart(electricityCompareChart, "electricity");
      recolorCompareChart(electricityCompareLineChart, "electricity");
      recolorCompareChart(waterCompareChart, "water");
      recolorCompareChart(waterCompareLineChart, "water");
    }

    // ---- Year FILTER (show/hide) — clicking the year NUMBER toggles it. ----
    // Transient (not saved). Hides/shows that year's bars + line for one chart.
    const hiddenYears = { electricity: {}, water: {} };
    function isYearHidden(chartKey, year) {
      return !!(hiddenYears[chartKey] && hiddenYears[chartKey][String(year)]);
    }
    function compareChartsFor(chartKey) {
      return chartKey === "electricity"
        ? [electricityCompareChart, electricityCompareLineChart]
        : [waterCompareChart, waterCompareLineChart];
    }
    function applyYearVisibility(chartKey, year, hide) {
      compareChartsFor(chartKey).forEach(function (chart) {
        if (!chart || !chart.data) return;
        chart.data.datasets.forEach(function (ds, i) {
          const lbl = String(ds.label || "");
          const dsYear = lbl.indexOf("_Line") === 0 ? lbl.slice(5) : lbl;
          if (String(dsYear) === String(year)) chart.setDatasetVisibility(i, !hide);
        });
        chart.update();
      });
    }
    function toggleYearVisibility(chartKey, year) {
      const hide = !isYearHidden(chartKey, year);
      if (!hiddenYears[chartKey]) hiddenYears[chartKey] = {};
      hiddenYears[chartKey][String(year)] = hide;
      applyYearVisibility(chartKey, year, hide);
      buildInlineColorControls();
      refreshEnterpriseAnalytics();
    }
    function isolateYearVisibility(chartKey, year) {
      const sortedYears = [...allYears].map((y) => parseInt(y, 10)).filter((y) => !isNaN(y));
      if (!hiddenYears[chartKey]) hiddenYears[chartKey] = {};
      sortedYears.forEach(function (itemYear) {
        const hide = String(itemYear) !== String(year);
        hiddenYears[chartKey][String(itemYear)] = hide;
        applyYearVisibility(chartKey, itemYear, hide);
      });
      buildInlineColorControls();
      refreshEnterpriseAnalytics();
    }
    // Re-apply hidden-year state after a chart is rebuilt (e.g. on page rotation).
    function reapplyYearVisibility(chartKey) {
      const map = hiddenYears[chartKey] || {};
      Object.keys(map).forEach(function (year) {
        if (map[year]) applyYearVisibility(chartKey, year, true);
      });
    }

    // ============================================================
    // SUBTITLE DISPLAY
    // ============================================================
    (function setCompareSubtitles() {
      const elecElement = document.getElementById("elecCompareSubtitleYears");
      const waterElement = document.getElementById("waterCompareSubtitleYears");
      
      let displayText;
      if (!allYears || allYears.length === 0) {
        displayText = "No data available";
      } else if (allYears.length === 1) {
        displayText = String(allYears[0]);
      } else {
        const sortedYears = [...allYears].sort((yearA, yearB) => yearA - yearB);
        if (sortedYears.length <= 4) {
          displayText = sortedYears.join(", ");
        } else {
          displayText = `${sortedYears[0]} – ${sortedYears[sortedYears.length - 1]} (${sortedYears.length} years)`;
        }
      }
      
      if (elecElement) elecElement.textContent = displayText;
      if (waterElement) waterElement.textContent = displayText;
    })();
    
    // ============================================================
    // NAVIGATION + PROGRESS STATE
    // ============================================================
    let currentPageNumber = 1;

    const hasVideos = Array.isArray(mediaVideos) && mediaVideos.length > 0;
    const hasImages = Array.isArray(mediaImages) && mediaImages.length > 0;

    function buildEnabledPages() {
      const pages = [1, 2, 3, 4, 11, 5, 6, 7];
      if (hasVideos) pages.push(8);
      if (hasImages) pages.push(9);
      pages.push(10);
      return pages;
    }

    const enabled_pages_auto = buildEnabledPages();
    const enabled_pages_interactive = buildEnabledPages();

    function enabledPages() {
      return is_auto_mode ? enabled_pages_auto : enabled_pages_interactive;
    }

    function nextEnabledPage(from, direction) {
      const pages = enabledPages();
      const index = pages.indexOf(from);
      if (index === -1) return pages[0];
      const nextIndex = (index + (direction || 1) + pages.length) % pages.length;
      return pages[nextIndex];
    }

    // Use timer-based default duration
    const defaultPageDurationMs = getPageDuration(1);
    
    const backArrowButton = document.getElementById("backArrowButton");
    const nextArrowButton = document.getElementById("nextArrowButton");
    const progressBarContainerElement = document.getElementById("progressBarContainer");
    const progressBarFillElement = document.getElementById("progressBarFill");

    let progressIntervalId = null;
    let progressStartTimestampMs = 0;
    let progressTotalDurationMs = defaultPageDurationMs;
    let progressElapsedMs = 0;
    let isAutoAdvanceEnabled = true;
    let progressActivePage = 1;
    let pageTransitionSeq = 0;
    let pageTransitionBusy = false;

    function hardResetProgressBar() {
      if (progressIntervalId) clearInterval(progressIntervalId);
      progressIntervalId = null;
      progressTotalDurationMs = getPageDuration(currentPageNumber);
      progressElapsedMs = 0;
      progressStartTimestampMs = 0;
      isAutoAdvanceEnabled = true;
      progressActivePage = currentPageNumber;
      if (progressBarFillElement) progressBarFillElement.style.width = "0%";
      if (progressBarContainerElement && is_auto_mode) progressBarContainerElement.style.display = "";
    }

    function stopProgressBarAnimation() {
      if (progressIntervalId) clearInterval(progressIntervalId);
      progressIntervalId = null;
      progressElapsedMs = 0;
      if (progressBarFillElement) progressBarFillElement.style.width = "0%";
    }

    function setProgressBarToComputedElapsed(totalMs, elapsedMs, autoAdvance) {
      if (!is_auto_mode) return;
      progressTotalDurationMs = Math.max(1, Number(totalMs || 1));
      progressElapsedMs = Math.max(0, Number(elapsedMs || 0));
      progressStartTimestampMs = Date.now() - progressElapsedMs;
      isAutoAdvanceEnabled = !!autoAdvance;
      progressActivePage = currentPageNumber;
      if (!progressBarFillElement) return;
      const percentage = Math.max(0, Math.min(100, (progressElapsedMs / progressTotalDurationMs) * 100));
      progressBarFillElement.style.width = percentage + "%";
      if (progressIntervalId) clearInterval(progressIntervalId);
      progressIntervalId = setInterval(() => {
        if (progressActivePage !== currentPageNumber) return;
        const now = Date.now();
        const elapsed = now - progressStartTimestampMs;
        progressElapsedMs = elapsed;
        const percent = Math.max(0, Math.min(100, (elapsed / progressTotalDurationMs) * 100));
        progressBarFillElement.style.width = percent + "%";
        if (elapsed >= progressTotalDurationMs) {
          clearInterval(progressIntervalId);
          progressIntervalId = null;
          progressBarFillElement.style.width = "100%";
          if (isAutoAdvanceEnabled && progressActivePage === currentPageNumber) {
            navigateToNextPage();
          }
        }
      }, 100);
    }

    function updateProgressBarWidthFromState() {
      if (!progressBarFillElement) return;
      const percentage = Math.max(0, Math.min(100, (progressElapsedMs / progressTotalDurationMs) * 100));
      progressBarFillElement.style.width = percentage + "%";
    }

    function startManualProgress(totalMs, elapsedMs) {
      if (!is_auto_mode) return;
      if (progressIntervalId) clearInterval(progressIntervalId);
      progressIntervalId = null;
      progressTotalDurationMs = Math.max(1, Number(totalMs || 1));
      progressElapsedMs = Math.max(0, Number(elapsedMs || 0));
      progressStartTimestampMs = Date.now() - progressElapsedMs;
      isAutoAdvanceEnabled = false;
      progressActivePage = currentPageNumber;
      updateProgressBarWidthFromState();
    }

    function runProgressForPage(pageNum, totalMs, autoAdvance) {
      if (!is_auto_mode) return;
      setProgressBarToComputedElapsed(totalMs, 0, autoAdvance);
    }

    // ============================================================
    // INTERACTIVE MODE AUTO-REVERT
    // ============================================================
    const interactive_config = (runtime_config && runtime_config.interactiveMode) ? runtime_config.interactiveMode : {};
    const interactive_auto_switch_enabled = interactive_config.autoSwitchOnActivity !== false;
    const interactive_auto_revert_enabled = !!interactive_config.autoRevertEnabled;
    const interactive_idle_timeout_ms = Math.max(1, Number(interactive_config.idleTimeoutMinutes || 15)) * 60 * 1000;
    let interactiveLastActivityAt = Date.now();
    let interactiveActivityPingTimer = null;
    let interactiveRevertTimer = null;
    let interactiveSwitchPending = false;

    async function pingInteractiveActivity() {
      if ((!is_auto_mode && !interactive_auto_revert_enabled) || interactiveSwitchPending) return;
      try {
        if (is_auto_mode) interactiveSwitchPending = true;
        const response = await fetch("/dashboard/interactive-activity", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ activityAt: new Date().toISOString() })
        });
        const json = await response.json().catch(() => ({}));
        if (json.switched) {
          window.location.href = "/";
          return;
        }
      } catch (error) {
      } finally {
        interactiveSwitchPending = false;
      }
    }

    function markInteractiveActivityClient() {
      if (is_auto_mode && !interactive_auto_switch_enabled) return;
      if (!is_auto_mode && !interactive_auto_revert_enabled) return;
      interactiveLastActivityAt = Date.now();
      if (interactiveActivityPingTimer) return;
      interactiveActivityPingTimer = setTimeout(() => {
        interactiveActivityPingTimer = null;
        pingInteractiveActivity();
      }, 1000);
    }

    function startInteractiveAutoRevertWatcher() {
      if (is_auto_mode || !interactive_auto_revert_enabled) return;
      pingInteractiveActivity();
      if (interactiveRevertTimer) clearInterval(interactiveRevertTimer);
      interactiveRevertTimer = setInterval(async () => {
        if (Date.now() - interactiveLastActivityAt < interactive_idle_timeout_ms) return;
        try {
          await fetch("/dashboard/interactive-revert", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({})
          });
        } catch (error) {}
        window.location.href = "/?mode=auto";
      }, 5000);
    }

    ["mousemove", "mousedown", "keydown", "touchstart", "scroll"].forEach((eventName) => {
      window.addEventListener(eventName, markInteractiveActivityClient, { passive: true });
    });

    // ============================================================
    // ADMIN VIDEO SETTINGS
    // ============================================================
    const ADMIN_VIDEO_SETTINGS_KEY = "esg_video_settings";
    const ADMIN_VIDEO_SETTINGS_BY_FILE_KEY = "esg_video_settings_by_file";
    const ADMIN_VIDEO_SETTINGS_CHANNEL = "esg_video_settings_channel";

    function clamp01(inputValue) {
      const number = Number(inputValue);
      if (!isFinite(number)) return null;
      return Math.max(0, Math.min(1, number));
    }

    function parseAdminVideoTime(inputValue) {
      if (inputValue === null || inputValue === undefined || String(inputValue).trim() === "") return null;
      const number = Number(inputValue);
      if (!isFinite(number) || number < 0) return null;
      return Math.max(0, Math.floor(number));
    }

    function readAdminVideoSettings() {
      try {
        const raw = localStorage.getItem(ADMIN_VIDEO_SETTINGS_KEY);
        if (!raw) return null;
        const settings = JSON.parse(raw);
        if (!settings || typeof settings !== "object") return null;
        const volume = (settings.volume != null) ? clamp01(settings.volume) : null;
        const muted = (typeof settings.muted === "boolean") ? settings.muted : null;
        const startTime = (settings.startTime != null) ? parseAdminVideoTime(settings.startTime) : null;
        const duration = (settings.duration != null) ? parseAdminVideoTime(settings.duration) : null;
        return { volume: volume, muted, startTime, duration };
      } catch (error) { return null; }
    }

    function saveAdminVideoSettings(next) {
      try {
        const current = readAdminVideoSettings() || {};
        const merged = {
          volume: (next && next.volume != null) ? clamp01(next.volume) : current.volume,
          muted: (next && typeof next.muted === "boolean") ? !!next.muted : current.muted,
          startTime: (next && next.startTime != null) ? parseAdminVideoTime(next.startTime) : current.startTime,
          duration: (next && next.duration != null) ? parseAdminVideoTime(next.duration) : current.duration
        };
        localStorage.setItem(ADMIN_VIDEO_SETTINGS_KEY, JSON.stringify(merged));
        return merged;
      } catch (error) { return null; }
    }

    function readAdminVideoSettingsByFile() {
      try {
        const raw = localStorage.getItem(ADMIN_VIDEO_SETTINGS_BY_FILE_KEY);
        if (!raw) return {};
        const payload = JSON.parse(raw);
        return (payload && typeof payload === "object") ? payload : {};
      } catch (error) {
        return {};
      }
    }

    function readAdminVideoSettingsForFile(filename) {
      if (!filename) return null;
      const fileSettings = readAdminVideoSettingsByFile();
      const entry = (fileSettings && typeof fileSettings === "object") ? fileSettings[filename] : null;
      if (!entry || typeof entry !== "object") return null;
      const startTime = (entry.startTime != null) ? parseAdminVideoTime(entry.startTime) : null;
      const duration = (entry.duration != null) ? parseAdminVideoTime(entry.duration) : null;
      return { startTime, duration };
    }

    function applyAdminVideoSettingsToPlayer(videoElement) {
      const video = videoElement || document.getElementById("esgVideoElement");
      if (!video) return;
      try { video.removeAttribute("muted"); } catch (error) {}
      const settings = readAdminVideoSettings();
      const targetVolume = (settings && typeof settings.volume === "number") ? settings.volume : 0.5;
      const targetMuted = (settings && typeof settings.muted === "boolean") ? settings.muted : true;
      try {
        const clampedVolume = clamp01(targetVolume);
        if (clampedVolume != null) video.volume = clampedVolume;
      } catch (error) {}
      try { video.muted = !!targetMuted; } catch (error) {}
    }

    function applyAdminVideoSegmentToPlayer(videoElement, filename) {
      const video = videoElement || document.getElementById("esgVideoElement");
      if (!video) return;
      const settings = readAdminVideoSettings();
      const fileSettings = readAdminVideoSettingsForFile(filename || video._adminFilename);
      const startTime = (fileSettings && fileSettings.startTime != null)
        ? fileSettings.startTime
        : ((settings && settings.startTime != null) ? settings.startTime : 0);
      const duration = (fileSettings && fileSettings.duration != null)
        ? fileSettings.duration
        : ((settings && settings.duration != null && settings.duration > 0) ? settings.duration : null);
      const clampedStart = Math.max(0, startTime);
      const segmentEnd = (duration != null && duration > 0) ? clampedStart + duration : null;
      video._adminSegmentStart = clampedStart;
      video._adminSegmentDuration = (duration != null && duration > 0) ? duration : null;
      video._adminSegmentEnd = segmentEnd;

      const seekToStart = () => {
        if (!video.duration || !isFinite(video.duration)) return;
        const safeStart = Math.min(clampedStart, video.duration);
        if (Math.abs(video.currentTime - safeStart) > 0.5) {
          try { video.currentTime = safeStart; } catch (_error) {}
        }
      };

      if (video.readyState >= 1) {
        seekToStart();
      } else {
        video.addEventListener("loadedmetadata", function onVideoLoaded() {
          seekToStart();
        }, { once: true });
      }
    }

    function applyAdminVideoSettingsToPlayerAndSegment(videoElement, filename) {
      applyAdminVideoSettingsToPlayer(videoElement);
      applyAdminVideoSegmentToPlayer(videoElement, filename);
    }

    (function initAdminVideoSettingsListeners() {
      window.addEventListener("load", () => { applyAdminVideoSettingsToPlayerAndSegment(); });
      window.addEventListener("storage", (event) => {
        if (event.key === ADMIN_VIDEO_SETTINGS_KEY || event.key === ADMIN_VIDEO_SETTINGS_BY_FILE_KEY) {
          applyAdminVideoSettingsToPlayerAndSegment();
          if (!is_auto_mode && currentPageNumber === 8) sendVideoStateToControls();
        }
      });
      try {
        const broadcastChannel = new BroadcastChannel(ADMIN_VIDEO_SETTINGS_CHANNEL);
        broadcastChannel.onmessage = (event) => {
          const message = event && event.data;
        if (!message) return;
        if (message.type === "ADMIN_VIDEO_SETTINGS") {
          saveAdminVideoSettings({
            volume: message.volume,
            muted: message.muted,
            startTime: message.startTime,
            duration: message.duration
          });
          applyAdminVideoSettingsToPlayerAndSegment();
        } else if (message.type === "ADMIN_VIDEO_SETTINGS_PER_FILE") {
          applyAdminVideoSettingsToPlayerAndSegment();
        } else {
          return;
        }
        if (!is_auto_mode && currentPageNumber === 8) sendVideoStateToControls();
        };
      } catch (error) {}
    })();

    // ============================================================
    // BUILDING CONTROLS WINDOW
    // ============================================================
    window.buildingControlWin = null;

    function safePostToControls(payload) {
      try {
        if (window.buildingControlWin && !window.buildingControlWin.closed) {
          window.buildingControlWin.postMessage(payload, window.location.origin);
        }
      } catch (error) {}
    }

    function controlModeForPage(pageNum) {
      if (pageNum >= 5 && pageNum <= 7) return "building";
      if (pageNum === 8 && hasVideos) return "video";
      if (pageNum === 9 && hasImages) return "carousel";
      return "nav";
    }

    function sendDashboardMetaToControls() {
      if (is_auto_mode) return;
      safePostToControls({
        type: "DASHBOARD_META",
        allYears: allYears,
        oldestYear: oldestYear,
        newestYear: newestYear,
        latestYear: latestDataYear,
        currentPage: currentPageNumber
      });
    }

    function sendControlPageUpdate() {
      if (is_auto_mode) return;
      safePostToControls({
        type: "DASHBOARD_PAGE_UPDATE",
        page: currentPageNumber,
        mode: controlModeForPage(currentPageNumber),
        buildingPages: [5, 6, 7],
        videoPage: hasVideos ? 8 : null,
        carouselPage: hasImages ? 9 : null,
        hasVideos: hasVideos,
        hasImages: hasImages,
        enabledPages: enabledPages()
      });
      sendDashboardMetaToControls();
      if (currentPageNumber === 8 && hasVideos) sendVideoStateToControls();
      if (currentPageNumber === 9 && hasImages) sendCarouselStateToControls();
      if (currentPageNumber === 5) sendCurrentBuildingToControls();
    }

    function sendVideoStateToControls() {
      if (is_auto_mode) return;
      const video = document.getElementById("esgVideoElement");
      if (!video) return;
      safePostToControls({
        type: "VIDEO_STATE",
        paused: !!video.paused,
        muted: !!video.muted,
        volume: (typeof video.volume === "number") ? video.volume : 1,
        currentTime: (typeof video.currentTime === "number") ? video.currentTime : 0,
        duration: (typeof video.duration === "number" && isFinite(video.duration)) ? video.duration : 0
      });
    }

    function sendCarouselStateToControls() {
      if (is_auto_mode) return;
      const carouselElement = document.getElementById("esgImageCarousel");
      if (!carouselElement) return;
      const items = carouselElement.querySelectorAll(".carousel-item");
      const activeIndex = Array.from(items).findIndex(item => item.classList.contains("active"));
      safePostToControls({
        type: "CAROUSEL_STATE",
        index: Math.max(0, activeIndex),
        total: items.length || 0
      });
    }

    function sendCurrentBuildingToControls() {
      if (is_auto_mode) return;
      const titleElement = document.getElementById("threeInfoTitle");
      if (!titleElement) return;
      const buildingCode = normalizeBuildingKey(titleElement.textContent);
      const totals = buildingTotals(buildingCode);
      safePostToControls({
        type: "BUILDING_UPDATE",
        building: buildingCode,
        label: labelForBuilding(buildingCode),
        electricity: totals.electricity,
        water: totals.water
