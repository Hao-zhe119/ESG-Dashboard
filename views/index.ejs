<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RP ESG Dashboard</title>

  <!-- Bootstrap + Animate.css -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
:root {
  --navH: 56px;
  --pad: clamp(12px, 1.1vw, 20px);
  --gap: clamp(10px, 1.2vw, 18px);
  --progH: clamp(6px, 0.7vh, 10px);
  --bFs: clamp(12px, 0.9vw, 16px);
  --vh: 1vh;
  --arrowGutter: clamp(72px, 5.5vw, 130px);
  --stageAvailH: calc((var(--vh) * 100) - var(--navH) - var(--progH) - (var(--pad) * 2) - 24px);
  --stageMaxW: 92vw;
  --stageW: min(var(--stageMaxW), calc(var(--stageAvailH) * (16 / 9)));
  --bg: #0f1318;
  --text: #e5e7eb;
  --muted: #9ca3af;
  --panel: #161b22;
  --panelBorder: rgba(255,255,255,0.10);
  --shadow: 0 10px 24px rgba(0,0,0,0.45);
  --accent: #60a5fa;
  --listRow: rgba(255,255,255,0.04);
  --listRowAlt: rgba(255,255,255,0.02);
  --listRowHover: rgba(96,165,250,0.16);
  --listRowActive: rgba(52,211,153,0.18);
  --progressBg: rgba(255,255,255,0.10);
  --progressFill: #34d399;
  --cardBg: #ffffff;
  --cardText: #111827;
  --pageBreathTB: 4px;
  --threeBreathTB: 4px;

  /* ========================================
     SHARED PANEL RATIOS (Pages 5, 6, 7)
     Change these 4 values to adjust all 3 pages
     ======================================== */
  --panel-ratio-left: 0.75;
  --panel-ratio-mid: 1.5;
  --panel-ratio-right: 0.75;
  --panel-ratio-total: 3; /* must equal sum of above */
}

@media (min-aspect-ratio: 48/10) {
  :root { --stageMaxW: calc(100vw / 3); }
}

html, body {
  margin: 0;
  padding: 0;
  height: 100%;
  font-family: Arial, sans-serif;
  color: var(--text);
  background: var(--bg);
  overflow: hidden;
}

/* ========================================
   PAGE 1: WELCOME
   ======================================== */
#page1 { position: relative; }

#page1 .welcome-logo {
  height: 350px;
  width: auto;
  border-radius: 18px;
  box-shadow: 0 10px 24px rgba(0,0,0,0.45);
  position: absolute;
  top: 50%;
  left: 100px;
  transform: translateY(-50%);
  z-index: 1;
}

#page1 .welcome-title {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: clamp(2.2rem, 4.2vw, 4.5rem);
  font-weight: 700;
  letter-spacing: 0.06em;
  text-align: center;
  color: var(--text);
  padding: 0 clamp(10px, 2vw, 24px);
  max-width: 92vw;
}

#page1 .welcome-subtitle {
  position: absolute;
  right: clamp(12px, 2vw, 28px);
  bottom: calc(var(--progH) + clamp(12px, 2.6vh, 28px));
  font-size: clamp(12px, 1.4vw, 16px);
  color: var(--muted);
}

#welcome-page .welcome-rp-text,
#page1 .welcome-rp-text {
  display: inline-block;
  animation-duration: 2.2s;
  animation-timing-function: ease-in-out;
}

/* ========================================
   PAGE BASE STYLES
   ======================================== */
.page {
  height: calc(var(--vh) * 100);
  box-sizing: border-box;
  padding: var(--pad);
  padding-top: calc(var(--navH) + var(--pad) + var(--pageBreathTB));
  padding-bottom: calc(var(--pad) + var(--progH) + var(--pageBreathTB));
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  overflow: hidden;
  min-height: 0;
  min-width: 0;
  background: var(--bg);
  color: var(--text);
  transform: translateX(100%);
  opacity: 0;
  pointer-events: none;
  transition: transform 0.45s cubic-bezier(.4, 0, .2, 1), opacity 0.35s ease;
}

.page.active-page {
  transform: translateX(0);
  opacity: 1;
  pointer-events: auto;
  z-index: 2;
}

.page.enter-left { transform: translateX(-100%); opacity: 0; z-index: 2; }
.page.enter-right { transform: translateX(100%); opacity: 0; z-index: 2; }
.page.exit-left { transform: translateX(-100%); opacity: 0; pointer-events: none; z-index: 1; }
.page.exit-right { transform: translateX(100%); opacity: 0; pointer-events: none; z-index: 1; }

@media (prefers-reduced-motion: reduce) {
  .page { transition: none !important; }
}

/* ========================================
   PAGE BACKGROUNDS
   ======================================== */
#page1, #page2, #page3, #page4, #page5, #page6, #page7, #page8, #page9, #page10 {
  background: url("/images/rp-main.jpg") no-repeat center center / cover;
}

#page1::before, #page2::before, #page3::before, #page4::before, #page5::before, 
#page6::before, #page7::before, #page8::before, #page9::before, #page10::before {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(38, 45, 53, 0.72);
  z-index: 0;
}

#page1 > *, #page2 > *, #page3 > *, #page4 > *, #page8 > *, #page9 > *, #page10 > * {
  position: relative;
  z-index: 1;
  color: var(--text);
}

/* ========================================
   NAVBAR
   ======================================== */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
}

.navbar.bg-light {
  background: rgba(22,27,34,0.92) !important;
  backdrop-filter: blur(6px);
  border-bottom: 1px solid rgba(255,255,255,0.10) !important;
}

.navbar .navbar-brand { color: var(--text) !important; }
.navbar .navbar-toggler { border-color: rgba(255,255,255,0.18) !important; }
.navbar .navbar-toggler-icon { filter: invert(1) grayscale(1); opacity: 0.9; }

:fullscreen .navbar { display: none !important; }
:-webkit-full-screen .navbar { display: none !important; }
body.is-fullscreen .navbar { display: none !important; }

/* ========================================
   ARROW BUTTONS
   ======================================== */
.arrow-btn {
  position: fixed;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.18);
  color: var(--text);
  padding: clamp(8px, 1vh, 12px) clamp(12px, 1.2vw, 18px);
  border-radius: 50%;
  cursor: pointer;
  z-index: 1500;
  font-size: clamp(18px, 1.8vw, 26px);
  transition: 0.2s;
  box-shadow: 0 10px 22px rgba(0,0,0,0.35);
  user-select: none;
}

.arrow-btn:hover { background: rgba(96,165,250,0.18); }
#backArrowButton { left: clamp(10px, 1.2vw, 20px); }
#nextArrowButton { right: clamp(10px, 1.2vw, 20px); }

/* ========================================
   PROGRESS BAR
   ======================================== */
#progressBarContainer {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: var(--progH);
  z-index: 2000;
  background: var(--progressBg);
  border-top: 1px solid rgba(255,255,255,0.10);
}

#progressBarFill {
  width: 0%;
  height: 100%;
  background: var(--progressFill);
  transition: width 0.1s linear;
}

body.mode-interactive #progressBarContainer { display: none; }

/* ========================================
   BUTTONS
   ======================================== */
.btn-outline-secondary {
  color: var(--text) !important;
  border-color: rgba(255,255,255,0.22) !important;
  background: rgba(255,255,255,0.04) !important;
}

.btn-outline-secondary:hover {
  background: rgba(96,165,250,0.18) !important;
  border-color: rgba(96,165,250,0.35) !important;
}

.btn-outline-light {
  color: var(--text) !important;
  border-color: rgba(255,255,255,0.22) !important;
}

.btn-outline-light:hover {
  background: rgba(96,165,250,0.18) !important;
  border-color: rgba(96,165,250,0.35) !important;
}

#page5 .panel .btn,
#page6 .panel .btn,
#page7 .panel .btn {
  color: #111827 !important;
  border-color: rgba(17,24,39,0.25) !important;
  background: rgba(17,24,39,0.06) !important;
}

#page5 .panel .btn:hover,
#page6 .panel .btn:hover,
#page7 .panel .btn:hover {
  background: rgba(37,99,235,0.10) !important;
  border-color: rgba(37,99,235,0.35) !important;
  color: #111827 !important;
}

/* ========================================
   PAGE 2: BUILDING OVERVIEW
   ======================================== */
#page2 {
  justify-content: flex-start;
  align-items: stretch;
  text-align: center;
  padding-left: calc(var(--pad) + var(--arrowGutter));
  padding-right: calc(var(--pad) + var(--arrowGutter));
}

.multi-building-title {
  font-size: clamp(22px, 2.2vw, 36px);
  margin: 0 0 10px 0;
  color: var(--text);
  text-align: center;
  font-weight: 700;
}

.multi-building-subtitle {
  font-size: clamp(14px, 1.2vw, 18px);
  margin: 0 0 12px 0;
  color: var(--muted);
  text-align: center;
}

#page2 .page2-body {
  flex: 1;
  min-height: 0;
  width: 100%;
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: clamp(10px, 1.1vw, 16px);
  align-items: stretch;
  overflow: hidden;
}

#page2 .page2-cards {
  min-height: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

#page2 .multi-building-grid {
  flex: 1;
  min-height: 0;
  width: 100%;
  display: grid;
  gap: clamp(8px, 0.9vw, 12px);
  grid-template-columns: repeat(auto-fit, minmax(185px, 1fr));
  align-content: start;
  overflow: hidden;
}

@media (min-width: 2560px) {
  #page2 .multi-building-grid {
    grid-template-columns: repeat(auto-fit, minmax(clamp(260px, 16vw, 360px), 1fr));
    max-width: none;
  }
}

#page2 .building-card { scroll-snap-align: start; }

#page2 .page2-map {
  min-height: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

#page2 .map-stage {
  width: 100%;
  height: 100%;
  min-height: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

#page2 .map-stage img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
  border-radius: 0;
}

/* ========================================
   BUILDING CARDS
   ======================================== */
.building-card {
  border-radius: 12px;
  background: var(--cardBg);
  color: var(--cardText);
  padding: 10px 12px;
  min-width: 0;
  box-shadow: 0 10px 22px rgba(0,0,0,0.18);
  border: 1px solid rgba(17,24,39,0.10);
  pointer-events: none;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  gap: 2px;
}

.building-name {
  font-size: clamp(14px, 1.2vw, 18px);
  font-weight: 400;
  margin: 0 0 2px 0;
  white-space: nowrap;
  overflow: visible;
  text-overflow: unset;
}

.building-metric {
  font-size: clamp(12px, 0.95vw, 14px);
  margin: 0;
  line-height: 1.15;
  white-space: nowrap;
  overflow: visible;
  text-overflow: unset;
  color: rgba(17,24,39,0.78);
}

/* ========================================
   PAGE 8: VIDEO
   ======================================== */
#page8 {
  justify-content: center;
  align-items: center;
}

#page8 h2 {
  color: var(--text);
  margin-bottom: clamp(10px, 1.2vh, 16px);
}

#page8 video {
  width: var(--stageW);
  height: auto;
  aspect-ratio: 16 / 9;
  max-height: var(--stageAvailH);
  object-fit: contain;
  border-radius: 12px;
  box-shadow: var(--shadow);
  background: #000;
  border: 1px solid rgba(255,255,255,0.10);
}

/* ========================================
   PAGE 9: CAROUSEL
   ======================================== */
#page9 {
  justify-content: center;
  align-items: center;
}

#page9 h2 {
  color: var(--text);
  margin-bottom: clamp(10px, 1.2vh, 16px);
}

#page9 .carousel {
  width: var(--stageW);
  margin: 0 auto;
}

#page9 .carousel img {
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 9;
  max-height: var(--stageAvailH);
  object-fit: contain;
  border-radius: 16px;
  box-shadow: var(--shadow);
  border: 1px solid rgba(255,255,255,0.10);
  background: #000;
}

/* ========================================
   PAGES 5, 6, 7: THREE-PANEL LAYOUT
   ======================================== */
#page5, #page6, #page7 {
  padding: 0 !important;
  justify-content: flex-start;
  align-items: stretch;
  background: var(--bg);
}

.three-panel {
  position: absolute;
  top: calc(var(--navH) + var(--threeBreathTB));
  left: var(--pad);
  right: var(--pad);
  bottom: calc(var(--progH) + var(--threeBreathTB));
  display: flex;
  gap: var(--gap);
  align-items: stretch;
  justify-content: center;
  text-align: left;
  overflow: hidden;
  margin: 0;
  min-height: 0;
  min-width: 0;
}

body.mode-interactive #page5 .three-panel,
body.mode-interactive #page6 .three-panel,
body.mode-interactive #page7 .three-panel {
  left: calc(var(--pad) + var(--arrowGutter));
  right: calc(var(--pad) + var(--arrowGutter));
}

/* Default: Equal thirds */
.three-panel .panel {
  flex: 0 0 calc((100% - (2 * var(--gap))) / 3);
  background: #ffffff;
  border: 1px solid rgba(17,24,39,0.10);
  border-radius: 16px;
  padding: 12px;
  overflow: hidden;
  min-width: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  box-shadow: 0 10px 22px rgba(0,0,0,0.18);
  color: #111827;
}

/* Default: Responsive stacking */
@media (max-aspect-ratio: 4/3), (max-width: 1200px) {
  .three-panel { flex-direction: column; }
  .three-panel .panel { flex: 1 1 auto; }
}

/* ========================================
   PAGES 5, 6, 7: SHARED PANEL RATIOS
   Uses variables from :root
   ======================================== */
#page5 .three-panel .panel-left,
#page6 .three-panel .panel-left,
#page7 .three-panel .panel-left {
  flex: 0 0 calc((100% - (2 * var(--gap))) * var(--panel-ratio-left) / var(--panel-ratio-total));
}

#page5 .three-panel .panel-mid,
#page6 .three-panel .panel-mid,
#page7 .three-panel .panel-mid {
  flex: 0 0 calc((100% - (2 * var(--gap))) * var(--panel-ratio-mid) / var(--panel-ratio-total));
}

#page5 .three-panel .panel-right,
#page6 .three-panel .panel-right,
#page7 .three-panel .panel-right {
  flex: 0 0 calc((100% - (2 * var(--gap))) * var(--panel-ratio-right) / var(--panel-ratio-total));
}

/* Responsive: Stack vertically */
@media (max-aspect-ratio: 4/3), (max-width: 1200px) {
  #page5 .three-panel .panel-left,
  #page5 .three-panel .panel-mid,
  #page5 .three-panel .panel-right,
  #page6 .three-panel .panel-left,
  #page6 .three-panel .panel-mid,
  #page6 .three-panel .panel-right,
  #page7 .three-panel .panel-left,
  #page7 .three-panel .panel-mid,
  #page7 .three-panel .panel-right {
    flex: 1 1 auto;
  }
}

/* ========================================
   THREE-PANEL CONTENT STYLES
   ======================================== */
.three-building-title {
  font-size: clamp(16px, 1.4vw, 22px);
  margin: 0 0 6px 0;
  color: #111827;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-weight: 700;
}

#page5 .three-building-title,
#page6 .three-building-title,
#page7 .three-building-title {
  text-align: center;
}

.three-info-body {
  color: rgba(17,24,39,0.72);
  font-size: clamp(12px, 1.0vw, 14px);
  line-height: 1.35;
  overflow: hidden;
  min-height: 0;
  flex: 1;
}

#page5 #threeInfoBody {
  grid-column: 1 / -1;
  width: 100%;
  min-width: 0;
  overflow: auto;
  min-height: 0;
}

.three-metrics {
  margin-top: 10px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  flex: 0 0 auto;
}

.metric-box {
  background: rgba(37,99,235,0.06);
  border: 1px solid rgba(37,99,235,0.12);
  border-radius: 12px;
  padding: 8px;
  overflow: hidden;
  min-width: 0;
}

.metric-label {
  font-size: 12px;
  color: rgba(17,24,39,0.72);
}

.metric-value {
  font-size: 18px;
  font-weight: 700;
  color: #111827;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.three-chart-wrap {
  flex: 1;
  min-height: 240px;
  margin-top: 8px;
}

.three-chart-wrap canvas {
  width: 100% !important;
  height: 100% !important;
  background: #ffffff;
  border-radius: 12px;
  border: 1px solid rgba(17,24,39,0.10);
}

/* ========================================
   PAGE 5: RIGHT PANEL - SCROLLABLE LIST
   ======================================== */
#page5 #threeRightBody {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  padding: 6px 4px;
}

#page5 #threeRightBody img { display: none !important; }

#page5 #threeRightBody .building-list {
  height: 100%;
  overflow: hidden;
}

#page5 #threeRightBody .building-list ul {
  margin: 0;
  padding: 0;
  list-style: none;
  height: 100%;
  overflow-y: auto;
  overflow-x: hidden;
  display: block;
}

#page5 #threeRightBody .building-list-item {
  flex: none;
  min-height: auto;
  padding: 6px 12px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  font-size: var(--bFs);
  line-height: 1.05;
  border: 0.03px solid rgba(17,24,39,0.08);
  border-bottom: 1px solid rgba(17,24,39,0.08);
  background: #ffffff;
  cursor: pointer;
  overflow: hidden;
}

#page5 #threeRightBody .building-list-item:nth-child(even) {
  background: rgba(17,24,39,0.03);
}

#page5 #threeRightBody .building-list-item:hover {
  background: rgba(37,99,235,0.10);
}

#page5 #threeRightBody .building-list-item.active {
  background: rgba(22,163,74,0.14);
}

#page5 #threeRightBody .building-list-item .fw-bold {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #111827;
}

#page5 #threeRightBody .building-list-item small {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: rgba(17,24,39,0.70);
}

/* Thin scrollbar for Page 5 right panel */
#page5 #threeRightBody .building-list ul::-webkit-scrollbar {
  width: 4px;
}

#page5 #threeRightBody .building-list ul::-webkit-scrollbar-track {
  background: rgba(17,24,39,0.04);
  border-radius: 2px;
}

#page5 #threeRightBody .building-list ul::-webkit-scrollbar-thumb {
  background: rgba(17,24,39,0.18);
  border-radius: 2px;
}

#page5 #threeRightBody .building-list ul::-webkit-scrollbar-thumb:hover {
  background: rgba(17,24,39,0.30);
}

/* ========================================
   PAGES 6 & 7: YEAR LIST PANELS
   ======================================== */
#page6 #solar-year-list,
#page7 #waste-year-list {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

#page6 #solar-year-list ul,
#page7 #waste-year-list ul {
  margin: 0;
  padding: 0;
  list-style: none;
  height: 100%;
  overflow-y: auto;
  overflow-x: hidden;
  display: flex;
  flex-direction: column;
}

#page6 #solar-year-list .building-list-item,
#page7 #waste-year-list .building-list-item {
  flex: 1;
  min-height: 0;
  padding: 6px 12px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  font-size: var(--bFs);
  line-height: 1.05;
  border: 0.03px solid rgba(17,24,39,0.08);
  border-bottom: 1px solid rgba(17,24,39,0.08);
  background: #ffffff;
  cursor: pointer;
  overflow: hidden;
}

#page6 #solar-year-list .building-list-item:nth-child(even),
#page7 #waste-year-list .building-list-item:nth-child(even) {
  background: rgba(17,24,39,0.03);
}

#page6 #solar-year-list .building-list-item:hover,
#page7 #waste-year-list .building-list-item:hover {
  background: rgba(37,99,235,0.10);
}

#page6 #solar-year-list .building-list-item.active,
#page7 #waste-year-list .building-list-item.active {
  background: rgba(22,163,74,0.14);
}

#page6 #solar-year-list .building-list-item .fw-bold,
#page7 #waste-year-list .building-list-item .fw-bold {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #111827;
}

#page6 #solar-year-list .building-list-item small,
#page7 #waste-year-list .building-list-item small {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: rgba(17,24,39,0.70);
}

/* Thin scrollbar for Pages 6 & 7 year lists */
#page6 #solar-year-list ul::-webkit-scrollbar,
#page7 #waste-year-list ul::-webkit-scrollbar {
  width: 4px;
}

#page6 #solar-year-list ul::-webkit-scrollbar-track,
#page7 #waste-year-list ul::-webkit-scrollbar-track {
  background: rgba(17,24,39,0.04);
  border-radius: 2px;
}

#page6 #solar-year-list ul::-webkit-scrollbar-thumb,
#page7 #waste-year-list ul::-webkit-scrollbar-thumb {
  background: rgba(17,24,39,0.18);
  border-radius: 2px;
}

#page6 #solar-year-list ul::-webkit-scrollbar-thumb:hover,
#page7 #waste-year-list ul::-webkit-scrollbar-thumb:hover {
  background: rgba(17,24,39,0.30);
}

/* ========================================
   BUILDING LIST (SHARED)
   ======================================== */
.building-list {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.building-list ul {
  margin: 0;
  padding: 0;
  list-style: none;
  height: 100%;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.building-list-item {
  flex: 1;
  min-height: 0;
  padding: 6px 12px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  font-size: var(--bFs);
  line-height: 1.05;
  border-bottom: 1px solid rgba(17,24,39,0.08);
  background: #ffffff;
  cursor: pointer;
  overflow: hidden;
}

.building-list-item:nth-child(even) { background: rgba(17,24,39,0.03); }

.building-list-item .fw-bold,
.building-list-item small {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #111827;
}

.building-list-item small { color: rgba(17,24,39,0.70); }
.building-list-item:hover { background: rgba(37,99,235,0.10); }
.building-list-item.active { background: rgba(22,163,74,0.14); }

/* ========================================
   SLUG SANDBOX (INJECTED CONTENT)
   ======================================== */
.slug-sandbox {
  height: 100%;
  min-height: 0;
  overflow: hidden;
  color: inherit;
  background: transparent;
  box-sizing: border-box;
  max-width: 100%;
}

.slug-sandbox * {
  box-sizing: border-box;
  max-width: 100%;
}

.slug-sandbox html,
.slug-sandbox body {
  background: transparent !important;
  overflow: hidden !important;
  margin: 0 !important;
  padding: 0 !important;
}

.slug-sandbox h1,
.slug-sandbox h2,
.slug-sandbox h3,
.slug-sandbox h4,
.slug-sandbox h5 {
  color: #111827;
  margin: 0 0 8px 0;
}

.slug-sandbox .muted,
.slug-sandbox .text-muted,
.slug-sandbox small {
  color: rgba(17,24,39,0.72);
}

.slug-sandbox .panel,
.slug-sandbox .wrap {
  background: transparent;
  border: 0;
  padding: 0;
  height: auto;
  box-shadow: none;
  gap: 10px;
}

.slug-sandbox .content {
  overflow: hidden;
  padding-right: 0;
}

.slug-sandbox .container,
.slug-sandbox .container-fluid,
.slug-sandbox .row,
.slug-sandbox [class*="col-"] {
  margin: 0 !important;
  padding: 0 !important;
  max-width: 100% !important;
}

/* ========================================
   BUILDING INFO PANEL - DASHBOARD OVERRIDES
   ======================================== */
#threeInfoBody .slug-sandbox,
#threeInfoBody > .building-info-panel,
#threeInfoBody .building-info-panel {
  overflow: visible !important;
  height: auto !important;
  min-height: 0 !important;
  background: transparent !important;
}

#threeInfoBody .building-info-panel,
#threeInfoBody .building-info-panel * {
  max-width: none !important;
}

#threeInfoBody .building-info-panel .bip-head {
  text-align: center !important;
  padding: 10px 8px !important;
  background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%) !important;
  border-radius: 8px !important;
  border: 1px solid rgba(37,99,235,0.14) !important;
}

#threeInfoBody .building-info-panel .bip-icon {
  font-size: 2rem !important;
  margin-bottom: 2px !important;
}

#threeInfoBody .building-info-panel .bip-title {
  font-size: 1.1rem !important;
  font-weight: 700 !important;
  color: #1e40af !important;
}

#threeInfoBody .building-info-panel .bip-subtitle {
  font-size: 0.85rem !important;
  color: #3b82f6 !important;
  font-weight: 500 !important;
}

#threeInfoBody .building-info-panel .bip-section {
  padding: 8px !important;
  background: #f9fafb !important;
  border-radius: 8px !important;
  border: 1px solid rgba(17,24,39,0.10) !important;
}

#threeInfoBody .building-info-panel .bip-section-header {
  font-size: 0.8rem !important;
  font-weight: 600 !important;
  color: #374151 !important;
  margin-bottom: 6px !important;
  padding-bottom: 4px !important;
  border-bottom: 1px solid #e5e7eb !important;
}

#threeInfoBody .building-info-panel .bip-image-container {
  border-radius: 6px !important;
  overflow: hidden !important;
  border: 1px solid #e5e7eb !important;
}

#threeInfoBody .building-info-panel .bip-image {
  width: 100% !important;
  height: auto !important;
  max-height: 600px !important;
  object-fit: cover !important;
  display: block !important;
}

#threeInfoBody .building-info-panel .bip-table {
  width: 100% !important;
  border-collapse: collapse !important;
  font-size: 0.75rem !important;
}

#threeInfoBody .building-info-panel .bip-table th,
#threeInfoBody .building-info-panel .bip-table td {
  padding: 5px 6px !important;
  text-align: center !important;
  border-bottom: 1px solid #e5e7eb !important;
}

#threeInfoBody .building-info-panel .bip-table th {
  background: #f3f4f6 !important;
  font-weight: 600 !important;
  color: #374151 !important;
}

#threeInfoBody .building-info-panel .bip-table td:first-child,
#threeInfoBody .building-info-panel .bip-table th:first-child {
  text-align: left !important;
}

#threeInfoBody .building-info-panel .bip-row-available {
  background: #f0fdf4 !important;
}

#threeInfoBody .building-info-panel .bip-row-unavailable {
  background: #fef2f2 !important;
}

#threeInfoBody .building-info-panel .bip-badge {
  display: inline-block !important;
  padding: 2px 6px !important;
  border-radius: 10px !important;
  font-size: 0.7rem !important;
  font-weight: 600 !important;
}

#threeInfoBody .building-info-panel .bip-badge-available {
  background: #dcfce7 !important;
  color: #166534 !important;
}

#threeInfoBody .building-info-panel .bip-badge-unavailable {
  background: #fee2e2 !important;
  color: #991b1b !important;
}

#threeInfoBody .building-info-panel .bip-desc {
  font-size: 0.85rem !important;
  line-height: 1.5 !important;
  color: #374151 !important;
  margin: 0 !important;
}

#threeInfoBody .building-info-panel .bip-desc-empty {
  color: #9ca3af !important;
  font-style: italic !important;
}

/* ========================================
   INFOGRAPHIC STYLES
   ======================================== */
.infographic {
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.info-head {
  padding: 10px 12px;
  border-radius: 14px;
  background: rgba(37,99,235,0.06);
  border: 1px solid rgba(37,99,235,0.14);
}

.info-title {
  font-weight: 800;
  font-size: 20px;
  line-height: 1.1;
  color: #111827;
}

.info-subtitle {
  margin-top: 2px;
  font-size: 13px;
  color: rgba(17,24,39,0.70);
}

.info-icons,
.info-footer-icons {
  display: flex;
  gap: 10px;
  justify-content: center;
  opacity: 0.9;
}

.info-ico {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  background: rgba(17,24,39,0.04);
  border: 1px solid rgba(17,24,39,0.10);
}

.info-section {
  padding: 10px 12px;
  border-radius: 14px;
  border: 1px solid rgba(17,24,39,0.10);
  background: #ffffff;
  overflow: hidden;
}

.info-section-h {
  font-weight: 800;
  font-size: 14px;
  margin-bottom: 6px;
  color: #111827;
}

.info-bullets {
  margin: 0;
  padding-left: 18px;
  color: rgba(17,24,39,0.78);
  font-size: 13px;
