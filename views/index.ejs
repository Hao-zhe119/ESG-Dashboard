    // Helper function to animate count values with suffix
    function animateCountValue(element, endValue, duration = 1000, suffix = '') {
      if (!element) return;
      
      const startValue = Math.floor(endValue * 0.1);
      const startTime = Date.now();
      
      function formatNumberValue(number) {
        return number.toLocaleString(undefined, { maximumFractionDigits: 0 }) + suffix;
      }
      
      function updateCount() {
        const now = Date.now();
        const progress = Math.min((now - startTime) / duration, 1);
        
        // Easing function for smooth animation
        const easeOutQuart = 1 - Math.pow(1 - progress, 4);
        const currentValue = Math.floor(startValue + (endValue - startValue) * easeOutQuart);
        
        element.textContent = formatNumberValue(currentValue);
        
        if (progress < 1) {
          requestAnimationFrame(updateCount);
        } else {
          element.textContent = formatNumberValue(endValue);
        }
      }
      
      // Start the animation
      requestAnimationFrame(updateCount);
    }

    // Helper function to animate progress bars
    function animateProgressBar(element, endPercent, duration = 1000) {
      if (!element) return;
      
      const startTime = Date.now();
      
      function updateBar() {
        const now = Date.now();
        const progress = Math.min((now - startTime) / duration, 1);
        
        // Use quadratic easing - smoother than quartic
        const easeOutQuad = progress * (2 - progress);
        const currentPercent = easeOutQuad * endPercent;
        
        element.style.width = currentPercent + '%';
        
        if (progress < 1) {
          requestAnimationFrame(updateBar);
        } else {
          element.style.width = endPercent + '%';
        }
      }
      
      // Start the animation
      requestAnimationFrame(updateBar);
    }
      
    // Helper function to animate percentage text
    function animatePercentage(element, endPercent, duration = 1000, suffix = '') {
      if (!element) return;
      
      const startTime = Date.now();
      
      function updatePercentage() {
        const now = Date.now();
        const progress = Math.min((now - startTime) / duration, 1);
        
        // Easing function for smooth animation
        const easeOutQuad = progress * (2 - progress);
        const currentPercent = (easeOutQuad * endPercent).toFixed(1);
        
        element.textContent = currentPercent + suffix;
        
        if (progress < 1) {
          requestAnimationFrame(updatePercentage);
        } else {
          element.textContent = endPercent.toFixed(1) + suffix;
        }
      }
      
      // Start the animation
      requestAnimationFrame(updatePercentage);
    }

