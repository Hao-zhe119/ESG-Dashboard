    function createLegendClickHandler() {
      return function(event, legendItem, legend) {
        const chart = legend.chart;
        const clickedIndex = legendItem.datasetIndex;
        const clickedDataset = chart.data.datasets[clickedIndex];
        if (!clickedDataset) return;
        const meta = chart.getDatasetMeta(clickedIndex);
        meta.hidden = meta.hidden === null ? !chart.data.datasets[clickedIndex].hidden : !meta.hidden;
        chart.data.datasets.forEach((dataset, index) => {
          if (dataset.type === "line" && dataset.snapToBarIndex === clickedIndex) {
            const lineMeta = chart.getDatasetMeta(index);
            lineMeta.hidden = meta.hidden;
          }
        });
        if (clickedDataset.type === "line" && typeof clickedDataset.snapToBarIndex === "number") {
          const barIndex = clickedDataset.snapToBarIndex;
          const barMeta = chart.getDatasetMeta(barIndex);
          if (barMeta) barMeta.hidden = meta.hidden;
        }
        chart.update();
      };
