    // Animation function
    function animateCountUp(element, endValue, duration = 1000) {
      if (!element) return;
      
      const startValue = Math.floor(endValue * 0.1);
      const startTime = Date.now();
      
      function formatNumberValue(number) {
        return number.toLocaleString(undefined, { maximumFractionDigits: 0 });
      }
      
      function updateCount() {
        const now = Date.now();
        const progress = Math.min((now - startTime) / duration, 1);
        
        const easeOutQuart = 1 - Math.pow(1 - progress, 4);
        const currentValue = Math.floor(startValue + (endValue - startValue) * easeOutQuart);
        
        element.textContent = formatNumberValue(currentValue);
        
        if (progress < 1) {
          requestAnimationFrame(updateCount);
        } else {
          element.textContent = formatNumberValue(endValue);
        }
      }
      
      // Start the animation
      requestAnimationFrame(updateCount);
    }

    // Function to initialize solar count animation
    function initSolarCountAnimation() {
      const element = document.getElementById('solarTotalValue');
      if (!element) return;
      
      const totalValue = parseInt(element.getAttribute('data-total')) || 0;
      if (totalValue <= 0) return;
      
      // Animate from 0 to total
      animateCountUp(element, totalValue, 1000);
      
      // Also animate the breakdown bars and values
      animateBreakdownBars();
    }

    function animateBreakdownBars() {
      // Animate Urban values
      const urbanValueElement = document.getElementById('urbanValue');
      const urbanBarElement = document.getElementById('urbanBar');
      const urbanPercentElement = document.getElementById('urbanPercent');
      
      if (urbanValueElement && urbanBarElement && urbanPercentElement) {
        const urbanTotal = parseInt(urbanValueElement.getAttribute('data-value')) || 0;
        const urbanPercent = parseFloat(urbanBarElement.getAttribute('data-percent')) || 0;
        
        // Animate the value
        animateCountValue(urbanValueElement, urbanTotal, 1000, ' kWh');
        
        // Animate the progress bar
        animateProgressBar(urbanBarElement, urbanPercent, 1000);
        
        // Animate the percentage text
        animatePercentage(urbanPercentElement, urbanPercent, 1000, '% of total');
      }
      
      // Animate Greenhouse values
      const greenhouseValueElement = document.getElementById('greenhouseValue');
      const greenhouseBarElement = document.getElementById('greenhouseBar');
      const greenhousePercentElement = document.getElementById('greenhousePercent');
      
      if (greenhouseValueElement && greenhouseBarElement && greenhousePercentElement) {
        const greenhouseTotal = parseInt(greenhouseValueElement.getAttribute('data-value')) || 0;
        const greenhousePercent = parseFloat(greenhouseBarElement.getAttribute('data-percent')) || 0;
        
        // Animate the value
        animateCountValue(greenhouseValueElement, greenhouseTotal, 1000, ' kWh');
        
        // Animate the progress bar
        animateProgressBar(greenhouseBarElement, greenhousePercent, 1000);
        
        // Animate the percentage text
        animatePercentage(greenhousePercentElement, greenhousePercent, 1000, '% of total');
      }
    }

    function animateCountValue(element, endValue, duration = 1000, suffix = '') {
      if (!element) return;
      
      const startValue = Math.floor(endValue * 0.1);
      const startTime = Date.now();
      
      function formatNumberValue(number) {
        return number.toLocaleString(undefined, { maximumFractionDigits: 0 }) + suffix;
      }
      
      function updateCount() {
        const now = Date.now();
        const progress = Math.min((now - startTime) / duration, 1);
        
        const easeOutQuart = 1 - Math.pow(1 - progress, 4);
        const currentValue = Math.floor(startValue + (endValue - startValue) * easeOutQuart);
        
        element.textContent = formatNumberValue(currentValue);
        
        if (progress < 1) {
          requestAnimationFrame(updateCount);
        } else {
          element.textContent = formatNumberValue(endValue);
        }
      }
      
      // Start the animation
      requestAnimationFrame(updateCount);
    }

    function animateProgressBar(element, endPercent, duration = 1000) {
      if (!element) return;
      
      const startTime = Date.now();
      
      function updateBar() {
        const now = Date.now();
        const progress = Math.min((now - startTime) / duration, 1);
        
        const easeOutQuad = progress * (2 - progress);
        const currentPercent = easeOutQuad * endPercent;
        
        element.style.width = currentPercent + '%';
        
        if (progress < 1) {
          requestAnimationFrame(updateBar);
        } else {
          element.style.width = endPercent + '%';
        }
      }
      
      // Start the animation
      requestAnimationFrame(updateBar);
    }
      
    function animatePercentage(element, endPercent, duration = 1000, suffix = '') {
      if (!element) return;
      
      const startTime = Date.now();
      
      function updatePercentage() {
        const now = Date.now();
        const progress = Math.min((now - startTime) / duration, 1);
        
        const easeOutQuad = progress * (2 - progress);
        const currentPercent = (easeOutQuad * endPercent).toFixed(1);
        
        element.textContent = currentPercent + suffix;
        
        if (progress < 1) {
          requestAnimationFrame(updatePercentage);
        } else {
          element.textContent = endPercent.toFixed(1) + suffix;
        }
      }
      
      // Start the animation
      requestAnimationFrame(updatePercentage);
    }

    function animateCountUp(element, endValue, duration = 1000) {
