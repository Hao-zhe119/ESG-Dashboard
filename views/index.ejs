    function hideZeroMonths(labels, ...series) {
      const keep = labels.map((_, index) => series.some(arr => Number(arr[index] || 0) !== 0));
      const outLabels = [];
      const outSeries = series.map(() => []);
      for (let index = 0; index < labels.length; index++) {
        if (!keep[index]) continue;
        outLabels.push(labels[index]);
        series.forEach((arr, seriesIndex) => outSeries[seriesIndex].push(Number(arr[index] || 0)));
      }
      if (!outLabels.length) return { labels: labels.slice(), series: series.map(array => array.map(value => Number(value || 0))) };
      return { labels: outLabels, series: outSeries };
    }

    function formatNumber(number) {
      const value = Number(number || 0);
      if (!isFinite(value)) return "0";
      return value.toLocaleString(undefined, { maximumFractionDigits: 0 });
    }

    function normalizeBuildingKey(name) {
      if (!name) return "";
      const raw = String(name).trim();
      if (!raw) return "";
      
      const normalized = raw.replace(/\s+/g, ' ');
      const upper = normalized.toUpperCase();
      
      if (/^E[1-6]\b/.test(upper)) return upper.slice(0, 2);
      if (/^W[1-6]\b/.test(upper)) return upper.slice(0, 2);
      
      if (upper.includes("SPORT") && (upper.includes("HALL") || upper.includes("COMPLEX"))) {
        return "SPORTS COMPLEX";
      }
      if (upper.includes("GREEN") && upper.includes("HOUSE")) {
        return "GREEN HOUSE";
      }
      if (upper.includes("ARCH")) {
        return "THE ARCH";
      }
      if ((upper.includes("BLK") || upper.includes("BLOCK")) && upper.includes("43") || upper === "SIT") {
        return "BLK 43";
      }
      
      if (upper === "RPIC" || upper === "RIPC") return "RPIC";
      if (upper === "ECMC") return "ECMC";
      if (upper === "RPC") return "RPC";
      if (upper === "TRCC") return "TRCC";
      if (upper === "XLC") return "XLC";
      if (upper === "ALC") return "ALC";
      
      return upper;
    }

    function labelForBuilding(code) {
      const key = normalizeBuildingKey(code);
      const dbLabel = building_label_map && building_label_map[key];
      if (dbLabel) return dbLabel;
      return key;
    }

    function cardLabelForBuilding(code) {
      const key = normalizeBuildingKey(code);
      const cardLabel = building_card_label_map && building_card_label_map[key];
      if (cardLabel) return cardLabel;
      const displayLabel = building_label_map && building_label_map[key];
      if (displayLabel) return displayLabel;
      return key;
    }

    function buildingSlugFromCode(code) {
      const key = normalizeBuildingKey(code);
      return String(key || "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
    }

