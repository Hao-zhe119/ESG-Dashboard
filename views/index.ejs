@media (max-width: 1100px) {
  .campus-analytics-shell {
    grid-template-columns: 1fr;
    grid-template-rows: auto minmax(0, 1fr);
    height: calc((var(--vh) * 100) - var(--navH) - var(--progH) - 24px);
  }
  .campus-selector-panel {
    max-height: 240px;
  }
  .campus-forecast-panel {
    grid-template-columns: 1fr;
  }
  .campus-forecast-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

.premium-chart-tooltip {
  position: absolute;
  z-index: 20;
  pointer-events: none;
  min-width: 184px;
  max-width: min(340px, 82vw);
  padding: 12px;
  border-radius: 10px;
  border: 1px solid rgba(255,255,255,0.12);
  background: rgba(15,23,42,0.96);
  box-shadow: 0 16px 38px rgba(2,6,23,0.28), inset 0 1px 0 rgba(255,255,255,0.07);
  color: #f8fafc;
  font-family: var(--chartFont);
  opacity: 0;
  transform: translate(-50%, calc(-100% - 14px)) scale(0.97);
  transform-origin: 50% 100%;
  transition: opacity .16s ease, transform .16s ease;
  -webkit-backdrop-filter: blur(18px) saturate(155%);
  backdrop-filter: blur(18px) saturate(155%);
}

.pct-title {
  margin-bottom: 8px;
