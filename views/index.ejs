    function sanitizeInjectedHtml(html) {
      const temp = document.createElement("div");
      temp.innerHTML = String(html || "");
      temp.querySelectorAll("script, link, meta, title, head").forEach(node => node.remove());
      temp.querySelectorAll("style").forEach(styleElement => {
        const css = String(styleElement.textContent || "");
        if (/(^|\W)(:root|html|body|\*)(\W|$)|@import/i.test(css)) styleElement.remove();
      });
      const body = temp.querySelector("body");
      const content = body ? body.innerHTML : temp.innerHTML;
      return `<div class="slug-sandbox">${content}</div>`;
    }

    // ============================================================
    // SCROLL HELPER - Incremental scroll
    // ============================================================
    function scrollActiveItemIntoView(containerSelector, activeSelector) {
      requestAnimationFrame(() => {
        const container = document.querySelector(containerSelector);
        const activeItem = container ? container.querySelector(activeSelector) : null;
        if (!activeItem || !container) return;
        
        const ul = container.querySelector('ul') || container;
        if (!ul) return;
        
        const containerRect = ul.getBoundingClientRect();
        const itemRect = activeItem.getBoundingClientRect();
        
        const buffer = 4;
        const padding = 8;
        
        // Check if item is visible within container
        const isAboveView = itemRect.top < (containerRect.top + buffer);
        const isBelowView = itemRect.bottom > (containerRect.bottom - buffer);
        const isFullyVisible = !isAboveView && !isBelowView;
        
        // Only scroll if item is not fully visible
        if (isFullyVisible) return;
        
        if (isAboveView) {
          // Item is above visible area - scroll up minimally to show it at top
          const scrollAmount = itemRect.top - containerRect.top - padding;
          ul.scrollTop = Math.max(0, ul.scrollTop + scrollAmount);
        } else if (isBelowView) {
          // Item is below visible area - scroll down minimally to show it at bottom
          const scrollAmount = itemRect.bottom - containerRect.bottom + padding;
          ul.scrollTop = ul.scrollTop + scrollAmount;
        }
      });
    }

    // ============================================================
    // PAGE 5: SET THREE PANEL BUILDING
    // ============================================================
    function setThreePanelBuilding(buildingCode) {
      ensureAllBuildingsPrepared();

      const title = document.getElementById("threeInfoTitle");
      const elecTotal = document.getElementById("threeElecTotal");
      const waterTotal = document.getElementById("threeWaterTotal");
      const elecMetricLabel = document.getElementById("elecMetricLabel");
      const waterMetricLabel = document.getElementById("waterMetricLabel");
      const chartTitle = document.querySelector("#page5 .panel-mid #threeChartTitle");

      const buildingName = labelForBuilding(buildingCode);
      const buildingSlug = buildingSlugFromCode(buildingCode);

      const ranges = buildingYearRanges[buildingCode] || {};
      const elecStartYear = ranges.elecStartYear;
      const elecEndYear = ranges.elecEndYear;
      const waterStartYear = ranges.waterStartYear;
      const waterEndYear = ranges.waterEndYear;

      function buildYearArray(startYear, endYear, validYears) {
        if (!startYear && !endYear) {
          if (validYears && validYears.length > 0) {
            const sorted = [...validYears].sort((yearA, yearB) => yearB - yearA);
            return [sorted[0]];
          }
          return [];
        }

        const start = startYear || (validYears && validYears.length > 0 ? Math.min(...validYears) : null);
        const end = endYear || (validYears && validYears.length > 0 ? Math.max(...validYears) : null);

        if (!start || !end) return [];

        const years = [];
        for (let year = start; year <= end; year++) {
          if (!validYears || validYears.length === 0 || validYears.includes(year)) {
            years.push(year);
          }
        }
        return years.sort((yearA, yearB) => yearA - yearB);
      }

      const buildingData = buildingMonthlyByYear[buildingCode] || buildingMonthlyByYear[buildingCode] || {};
      const validElecYears = buildingData.validElecYears || buildingData.validYears || allYears;
      const validWaterYears = buildingData.validWaterYears || buildingData.validYears || allYears;

      const elecYearsForChart = buildYearArray(elecStartYear, elecEndYear, validElecYears);
      const waterYearsForChart = buildYearArray(waterStartYear, waterEndYear, validWaterYears);

      if (title) title.textContent = buildingName;

      const allChartYears = [...new Set([...elecYearsForChart, ...waterYearsForChart])].sort((yearA, yearB) => yearA - yearB);
      let yearRangeText;
      if (allChartYears.length === 0) {
        yearRangeText = latestDataYear || "Latest";
      } else if (allChartYears.length === 1) {
        yearRangeText = String(allChartYears[0]);
      } else {
        yearRangeText = `${allChartYears[0]} to ${allChartYears[allChartYears.length - 1]}`;
      }

      if (chartTitle) {
        chartTitle.textContent = `${cardLabelForBuilding(buildingCode)} Monthly Trend - ${yearRangeText}`;
      }

      let totalElectricity = 0;
      let totalWater = 0;

      elecYearsForChart.forEach(year => {
        const yearData = getBuildingMonthlyForYear(buildingCode, year);
        totalElectricity += (yearData.elec || []).reduce((sum, value) => sum + Number(value || 0), 0);
      });

      waterYearsForChart.forEach(year => {
        const yearData = getBuildingMonthlyForYear(buildingCode, year);
        totalWater += (yearData.water || []).reduce((sum, value) => sum + Number(value || 0), 0);
      });

      if (elecMetricLabel) {
        if (elecYearsForChart.length === 0) {
          elecMetricLabel.textContent = "Electricity (N/A)";
        } else if (elecYearsForChart.length === 1) {
          elecMetricLabel.textContent = `Electricity (${elecYearsForChart[0]})`;
        } else {
          elecMetricLabel.textContent = `Electricity (${elecYearsForChart[0]}-${elecYearsForChart[elecYearsForChart.length - 1]})`;
        }
      }

      if (waterMetricLabel) {
        if (waterYearsForChart.length === 0) {
          waterMetricLabel.textContent = "Water (N/A)";
        } else if (waterYearsForChart.length === 1) {
          waterMetricLabel.textContent = `Water (${waterYearsForChart[0]})`;
        } else {
          waterMetricLabel.textContent = `Water (${waterYearsForChart[0]}-${waterYearsForChart[waterYearsForChart.length - 1]})`;
        }
      }

      if (elecTotal) elecTotal.textContent = formatNumber(totalElectricity) + " kWh";
      if (waterTotal) waterTotal.textContent = formatNumber(totalWater) + " m³";

      fetch(`/building-left/${encodeURIComponent(buildingSlug)}`)
        .then(response => response.text())
        .then(html => {
          const body = document.getElementById("threeInfoBody");
          if (!body) return;
          body.innerHTML = sanitizeInjectedHtml(html);
          const elecElement = body.querySelector(".js-elec-total");
          const waterElement = body.querySelector(".js-water-total");
          if (elecElement) elecElement.textContent = formatNumber(totalElectricity);
          if (waterElement) waterElement.textContent = formatNumber(totalWater);
        })
        .catch(() => {
          const body = document.getElementById("threeInfoBody");
          if (body) body.innerHTML = "<div class='slug-sandbox'><p class='text-muted'>No building info available.</p></div>";
        });

      // Render building list in right panel
      (function renderRightPanelBuildingList() {
        const rightBody = document.getElementById("threeRightBody");
        if (!rightBody) return;

        const existingUl = rightBody.querySelector(".building-list ul");
        if (existingUl) {
          rightPanelScrollTop = existingUl.scrollTop;
        }

        rightBody.innerHTML = "";

        const listContainer = document.createElement("div");
        listContainer.className = "building-list";

        const ul = document.createElement("ul");
        
        allBuildingCodes.forEach(code => {
          const isCurrentBuilding = normalizeBuildingKey(code) === buildingCode;
          const codeKey = normalizeBuildingKey(code);
          
          const codeBuildingData = buildingMonthlyByYear[codeKey] || buildingMonthlyByYear[code] || {};
          const codeRanges = buildingYearRanges[codeKey] || {};
          
          const elecStart = codeRanges.elecStartYear;
          const elecEnd = codeRanges.elecEndYear;
          const waterStart = codeRanges.waterStartYear;
          const waterEnd = codeRanges.waterEndYear;
          
          const codeValidElecYears = (codeBuildingData.validElecYears || codeBuildingData.validYears || allYears)
            .map(yearValue => parseInt(yearValue, 10)).filter(yearValue => !isNaN(yearValue));
          const codeValidWaterYears = (codeBuildingData.validWaterYears || codeBuildingData.validYears || allYears)
            .map(yearValue => parseInt(yearValue, 10)).filter(yearValue => !isNaN(yearValue));
          
          function getYearsInRange(startYear, endYear, validYears) {
            if (!startYear && !endYear) {
              if (validYears && validYears.length > 0) {
                const sorted = [...validYears].sort((yearA, yearB) => yearB - yearA);
                return [sorted[0]];
              }
              return [];
            }

            const start = startYear || (validYears.length > 0 ? Math.min(...validYears) : null);
            const end = endYear || (validYears.length > 0 ? Math.max(...validYears) : null);
            
            if (!start || !end) return [];
            
            const years = [];
            for (let year = start; year <= end; year++) {
              if (validYears.length === 0 || validYears.includes(year)) {
                years.push(year);
              }
            }
            return years.sort((yearA, yearB) => yearA - yearB);
          }
          
          const elecYearsToShow = getYearsInRange(elecStart, elecEnd, codeValidElecYears);
          const waterYearsToShow = getYearsInRange(waterStart, waterEnd, codeValidWaterYears);
          
          const allYearsToShow = [...new Set([...elecYearsToShow, ...waterYearsToShow])]
            .sort((yearA, yearB) => yearA - yearB);
          
          const yearlyData = allYearsToShow.map(year => {
            const yearData = getBuildingMonthlyForYear(codeKey, year);
            
            const includeElec = elecYearsToShow.includes(year);
            const includeWater = waterYearsToShow.includes(year);
            
            const elecTotal = includeElec 
              ? (yearData.elec || []).reduce((sum, value) => sum + Number(value || 0), 0)
              : null;
            const waterTotal = includeWater
              ? (yearData.water || []).reduce((sum, value) => sum + Number(value || 0), 0)
              : null;

            return { year, elec: elecTotal, water: waterTotal };
          });

          const li = document.createElement("li");
          li.className = "building-list-item";
          li.dataset.building = code;

          if (isCurrentBuilding) {
            li.classList.add("active");
          }

          const name = document.createElement("div");
          name.className = "fw-bold";
          if (isCurrentBuilding) {
            name.textContent = "Active ▸ " + cardLabelForBuilding(code);
          } else {
            name.textContent = cardLabelForBuilding(code);
          }
          li.appendChild(name);

          yearlyData.forEach(({ year, elec, water }) => {
            const yearLine = document.createElement("small");
            yearLine.style.display = "block";

            const parts = [];
            if (elec !== null) {
              parts.push("Elec: " + formatNumber(elec) + " kWh");
            }
            if (water !== null) {
              parts.push("Water: " + formatNumber(water) + " m³");
            }

            if (parts.length > 0) {
              yearLine.textContent = parts.join(" • ") + " (" + year + ")";
            } else {
              yearLine.textContent = "No data (" + year + ")";
            }

            li.appendChild(yearLine);
          });

          li.addEventListener("click", () => {
            clearThreeCycleTimer();
            setThreePanelBuilding(normalizeBuildingKey(code));
          });

          ul.appendChild(li);
        });

        listContainer.appendChild(ul);
        rightBody.appendChild(listContainer);

        // Auto-scroll to active element using incremental scroll
        scrollActiveItemIntoView("#page5 #threeRightBody .building-list", ".building-list-item.active");
      })();

      // Build chart datasets
      const elecDataByYear = {};
      const waterDataByYear = {};

      elecYearsForChart.forEach(year => {
        const yearData = getBuildingMonthlyForYear(buildingCode, year);
        elecDataByYear[year] = yearData.elec || Array(12).fill(0);
      });

      waterYearsForChart.forEach(year => {
        const yearData = getBuildingMonthlyForYear(buildingCode, year);
        waterDataByYear[year] = yearData.water || Array(12).fill(0);
      });

      const allSeries = [];
      elecYearsForChart.forEach(year => allSeries.push(elecDataByYear[year]));
      waterYearsForChart.forEach(year => allSeries.push(waterDataByYear[year]));

      const labels = month_labels.slice();
      const filtered = hideZeroMonths(labels, ...allSeries);

      let seriesIndex = 0;
      const filteredElecData = {};
      elecYearsForChart.forEach(year => {
        filteredElecData[year] = filtered.series[seriesIndex];
        seriesIndex++;
      });

      const filteredWaterData = {};
      waterYearsForChart.forEach(year => {
        filteredWaterData[year] = filtered.series[seriesIndex];
        seriesIndex++;
      });

      // Colours come from the shared per-year colour prefs (same store the
      // Electricity/Water "by building" pages use) so a year keeps one colour
      // everywhere. Electricity -> left axis (y, kWh); Water -> right axis (y1, m³).
      _buildingElecYears  = elecYearsForChart.slice();
      _buildingWaterYears = waterYearsForChart.slice();

      const barDatasets  = [];
      const lineDatasets = [];

      function pushSeries(metric, year, yearIndex, total, data, axisId, unit) {
        const color = buildingYearColor(metric, year, yearIndex, total);
        const meta  = { _metric: metric, _year: year, _yearIndex: yearIndex, _yearTotal: total };
        const label = (metric === "electricity" ? "Electricity " : "Water ") + year + " (" + unit + ")";
        barDatasets.push(styleBarDataset(Object.assign({
          label: label,
          data: data,
          yAxisID: axisId
        }, meta), color));
        lineDatasets.push(styleLineDataset(Object.assign({
          label: label,
          data: data,
          yAxisID: axisId
        }, meta), color));
      }

      elecYearsForChart.forEach((year, index) =>
        pushSeries("electricity", year, index, elecYearsForChart.length, filteredElecData[year] || [], "y", "kWh"));
      waterYearsForChart.forEach((year, index) =>
        pushSeries("water", year, index, waterYearsForChart.length, filteredWaterData[year] || [], "y1", "m³"));

      if (threeBuildingBarChart)  { threeBuildingBarChart.destroy();  threeBuildingBarChart = null; }
      if (threeBuildingLineChart) { threeBuildingLineChart.destroy(); threeBuildingLineChart = null; }

      const built = makeBuildingPanels({
        barCanvasId: "threeBuildingBarChart",
        lineCanvasId: "threeBuildingLineChart",
        labels: filtered.labels,
        barDatasets: barDatasets,
        lineDatasets: lineDatasets
      });
      threeBuildingBarChart  = built.barChart;
      threeBuildingLineChart = built.lineChart;

      buildBuildingColorControls();
      reapplyBuildingVisibility();
      refreshEnterpriseAnalytics();

      document.querySelectorAll("#three-buildings-grid .building-list-item").forEach((card) => {
        if (card && card.dataset && card.dataset.building === buildingCode) card.classList.add("active");
        else card.classList.remove("active");
      });

      if (!is_auto_mode) sendCurrentBuildingToControls();
    }

    function buildTotalsMapFromOverview(rows) {
      const map = {};
      (rows || []).forEach(rowItem => {
        const key = normalizeBuildingKey(rowItem && rowItem.building);
        if (!key) return;
        map[key] = { label: key, electricity: Number(rowItem.electricity || 0), water: Number(rowItem.water || 0) };
      });
      return map;
    }

    function getUnionBuildingKeys(mapA, mapB) {
      const keys = new Set();
      Object.keys(mapA || {}).forEach(keyItem => keys.add(keyItem));
      Object.keys(mapB || {}).forEach(keyItem => keys.add(keyItem));
      return Array.from(keys).sort((keyA, keyB) => labelForBuilding(keyA).localeCompare(labelForBuilding(keyB)));
    }

    // ============================================================
    // CAMPUS ANALYTICS
    // ============================================================
    function campusMetricUnit() {
      return campusAnalyticsState.metric === "water" ? "m³" : "kWh";
    }

    function campusMetricLabel() {
      return campusAnalyticsState.metric === "water" ? "Water" : "Electricity";
    }

    function campusYearMonthLabel(year, monthIndex) {
      return String(year) + " " + month_labels[monthIndex];
    }

    function campusParsePeriodLabel(label) {
      const parts = String(label || "").split(/\s+/);
      const year = parseInt(parts[0], 10);
      const monthIndex = month_labels.findIndex(month => month.toLowerCase() === String(parts[1] || "").toLowerCase());
      return {
        year: Number.isFinite(year) ? year : null,
        monthIndex: monthIndex >= 0 ? monthIndex : 0
      };
    }

    function campusNextPeriodLabel(label, offset) {
      const parsed = campusParsePeriodLabel(label);
      const startMonth = parsed.monthIndex + Number(offset || 0);
      const year = Number(parsed.year || latestDataYear || new Date().getFullYear()) + Math.floor(startMonth / 12);
      const monthIndex = ((startMonth % 12) + 12) % 12;
      return campusYearMonthLabel(year, monthIndex);
    }

    function campusHistoricalPeriods() {
      const years = orderedDashboardYears(false);
      const labels = [];
      years.forEach(year => {
        for (let monthIndex = 0; monthIndex < 12; monthIndex++) {
          labels.push(campusYearMonthLabel(year, monthIndex));
        }
      });
      return labels;
    }

    function campusSeriesForBuilding(buildingKey, periods) {
      const metricKey = campusAnalyticsState.metric === "water" ? "water" : "elec";
      return nullifyMissingReadings(periods.map(label => {
        const parsed = campusParsePeriodLabel(label);
        const monthly = getBuildingMonthlyForYear(buildingKey, parsed.year);
        const values = monthly && Array.isArray(monthly[metricKey]) ? monthly[metricKey] : [];
        return Number(values[parsed.monthIndex] || 0);
      }));
    }

    function campusSelectedBuildings() {
      ensureAllBuildingsPrepared();
      const selected = Array.from(campusAnalyticsState.selected || []);
      return selected.filter(code => allBuildingCodes.includes(code));
    }

    function campusTotalForBuilding(buildingKey) {
      const years = orderedDashboardYears(false);
      return years.reduce((sum, year) => {
        const totals = getBuildingTotalsForYear(buildingKey, year);
        return sum + Number(totals[campusAnalyticsState.metric] || 0);
      }, 0);
    }

    function campusVisibleBuildings() {
      const query = String(campusAnalyticsState.search || "").trim().toLowerCase();
      if (!query) return allBuildingCodes.slice();
      return allBuildingCodes.filter(code => {
        const label = labelForBuilding(code).toLowerCase();
        return label.includes(query) || String(code || "").toLowerCase().includes(query);
      });
    }

    function campusSetSelection(nextSelection) {
      campusAnalyticsState.selected = new Set((nextSelection || []).map(normalizeBuildingKey).filter(Boolean));
      if (campusAnalyticsState.focused && !campusAnalyticsState.selected.has(campusAnalyticsState.focused)) {
        campusAnalyticsState.focused = null;
      }
      renderCampusBuildingSelector();
      renderCampusAnalyticsChart();
    }

    function renderCampusBuildingSelector() {
      ensureAllBuildingsPrepared();
      const list = document.getElementById("campusBuildingList");
      const count = document.getElementById("campusSelectionCount");
      const focusButton = document.getElementById("campusFocusClearBtn");
      if (count) count.textContent = campusAnalyticsState.selected.size + " selected";
      if (focusButton) focusButton.textContent = campusAnalyticsState.focused ? "Clear Focus" : "Focus Off";
      if (!list) return;
      const visible = campusVisibleBuildings();
      const totals = {};
      allBuildingCodes.forEach(code => { totals[code] = campusTotalForBuilding(code); });
      list.innerHTML = "";
      visible.forEach(code => {
        const selected = campusAnalyticsState.selected.has(code);
        const row = document.createElement("div");
        row.className = "campus-building-row" + (selected ? " is-selected" : "") + (campusAnalyticsState.focused && campusAnalyticsState.focused !== code ? " is-muted" : "");
        row.dataset.building = code;
        row.innerHTML =
          '<span class="campus-building-check" aria-hidden="true"></span>' +
          '<span class="campus-building-name"></span>' +
          '<span class="campus-building-swatch"></span>';
        const name = row.querySelector(".campus-building-name");
        name.innerHTML =
          '<span></span>' +
          '<span class="campus-building-meta"></span>';
        name.querySelector("span").textContent = labelForBuilding(code);
        name.querySelector(".campus-building-meta").textContent = formatNumber(totals[code]) + " " + campusMetricUnit();
        row.querySelector(".campus-building-swatch").style.background = buildingSeriesColor(code);
        row.addEventListener("click", function () {
          const next = new Set(campusAnalyticsState.selected);
          if (next.has(code)) next.delete(code);
          else next.add(code);
          campusSetSelection(Array.from(next));
        });
        row.addEventListener("dblclick", function (event) {
          event.preventDefault();
          event.stopPropagation();
          campusAnalyticsState.focused = campusAnalyticsState.focused === code ? null : code;
          campusSetSelection([code]);
        });
        list.appendChild(row);
      });
    }

    function campusBuildSegments(labels) {
      const mode = campusAnalyticsState.segment;
      const groups = [];
      let currentKey = null;
      let current = null;

      function segmentFor(label) {
        const parsed = campusParsePeriodLabel(label);
        const year = parsed.year || "";
        const month = parsed.monthIndex;
        if (mode === "quarters") {
          const q = Math.floor(month / 3) + 1;
          return { key: year + "-Q" + q, label: "Q" + q + " " + year };
        }
        if (mode === "semesters") {
          const sem = month < 6 ? "S1" : "S2";
          return { key: year + "-" + sem, label: sem + " " + year };
        }
        if (mode === "fiscal") {
          const fy = month >= 3 ? year + 1 : year;
          return { key: "FY" + fy, label: "FY " + fy };
        }
        return { key: year + "-" + month, label: month_labels[month] + " " + year };
      }

      labels.forEach((label, index) => {
        const segment = segmentFor(label);
        if (segment.key !== currentKey) {
          if (current) groups.push(current);
          currentKey = segment.key;
          current = { start: index, end: index, label: segment.label };
        } else {
          current.end = index;
        }
      });
      if (current) groups.push(current);
      if (mode === "months" && groups.length > 18) {
        return groups.filter((segment, index) => index % 3 === 0 || index === groups.length - 1);
      }
      return groups;
    }

    function campusForecastValues(values, horizon) {
      const clean = (values || []).map(Number).filter(Number.isFinite);
      if (clean.length < 2) return { forecast: [], lower: [], upper: [], slope: 0, avg: 0, method: "moving average" };
      const recent = clean.slice(Math.max(0, clean.length - 6));
      const avg = recent.reduce((sum, value) => sum + value, 0) / recent.length;
      const alpha = clean.length >= 12 ? 0.42 : 0.55;
      let smooth = clean[0];
      clean.forEach(value => { smooth = alpha * value + (1 - alpha) * smooth; });
      const trendLine = computeLinearTrend(clean, Math.max(0, clean.length - Math.min(12, clean.length)), clean.length - 1);
      const slope = trendLine.length === 2 ? (trendLine[1].value - trendLine[0].value) / Math.max(1, trendLine[1].index - trendLine[0].index) : 0;
      const residuals = recent.map((value, index) => {
        const projected = smooth + slope * (index - recent.length + 1);
        return Math.abs(value - projected);
      });
      const uncertaintyBase = Math.max(avg * 0.06, residuals.reduce((sum, value) => sum + value, 0) / Math.max(1, residuals.length));
      const forecast = [];
      const lower = [];
      const upper = [];
      for (let step = 1; step <= horizon; step++) {
        const seasonal = clean.length >= 12 ? Number(clean[clean.length - 12 + ((step - 1) % 12)] || avg) : avg;
        const blended = (smooth + slope * step) * 0.68 + seasonal * 0.32;
        const value = Math.max(0, blended);
        const uncertainty = uncertaintyBase * (1 + step * 0.16);
        forecast.push(value);
        lower.push(Math.max(0, value - uncertainty));
        upper.push(value + uncertainty);
      }
      return { forecast, lower, upper, slope, avg, method: clean.length >= 12 ? "exponential smoothing with seasonal blending" : "linear trend with moving average" };
    }

    function campusProjectionSummary(selectedBuildings, labels, seriesByBuilding, forecastByBuilding) {
      const explanation = document.getElementById("campusForecastExplanation");
      const statsGrid = document.getElementById("campusForecastStats");
      if (!explanation || !statsGrid) return;
      const unit = campusMetricUnit();
      if (!campusAnalyticsState.forecast || !selectedBuildings.length) {
        explanation.textContent = "Enable forecast mode to extend the selected comparison with projected usage and uncertainty bands.";
        statsGrid.innerHTML = [
          ["Future Total", "n/a"],
          ["Projected Avg", "n/a"],
          ["Peak Period", "n/a"],
          ["ESG Target", "n/a"],
          ["Vs History", "n/a"],
          ["Status", "n/a"]
        ].map(item => '<div class="campus-forecast-stat"><span>' + item[0] + '</span><strong>' + item[1] + '</strong></div>').join("");
        return;
      }

      const historyTotalsByPeriod = labels.map((_, index) => selectedBuildings.reduce((sum, code) => sum + Number((seriesByBuilding[code] || [])[index] || 0), 0));
      const futureLabels = [];
      const lastLabel = labels[labels.length - 1] || campusYearMonthLabel(latestDataYear || new Date().getFullYear(), 0);
      for (let index = 1; index <= 6; index++) futureLabels.push(campusNextPeriodLabel(lastLabel, index));
      const forecastTotals = futureLabels.map((_, index) => selectedBuildings.reduce((sum, code) => sum + Number((forecastByBuilding[code]?.forecast || [])[index] || 0), 0));
      const futureTotal = forecastTotals.reduce((sum, value) => sum + value, 0);
      const futureAvg = futureTotal / Math.max(1, forecastTotals.length);
      const recentHistory = historyTotalsByPeriod.slice(Math.max(0, historyTotalsByPeriod.length - 6));
      const historyAvg = recentHistory.reduce((sum, value) => sum + value, 0) / Math.max(1, recentHistory.length);
      const change = pctChange(futureAvg, historyAvg);
      const peakValue = Math.max(...forecastTotals);
      const peakIndex = forecastTotals.indexOf(peakValue);
      const target = historyAvg * 0.94;
      const onTrack = futureAvg <= target;
      const direction = Number(change) > 2 ? "increase" : Number(change) < -2 ? "decrease" : "remain stable";
      explanation.textContent = "Based on the current " + campusMetricLabel().toLowerCase() + " trend, selected campus usage is projected to " + direction + " by approximately " + formatPercent(change) + " over the next six months. Forecasts use recent smoothing, linear trend direction, and seasonal history where available, with confidence bands showing uncertainty.";
      statsGrid.innerHTML = [
        ["Future Total", formatNumber(futureTotal) + " " + unit],
        ["Projected Avg", formatNumber(futureAvg) + " " + unit],
        ["Peak Period", futureLabels[peakIndex] || "n/a"],
        ["ESG Target", formatNumber(target) + " " + unit],
        ["Vs History", formatPercent(change)],
        ["Status", onTrack ? "On track" : "Needs attention"]
      ].map(item => '<div class="campus-forecast-stat"><span>' + item[0] + '</span><strong>' + item[1] + '</strong></div>').join("");
    }

    function campusChartOptions(labels) {
      const options = baseChartOptions();
      options.plugins.legend.display = false;
      options.plugins.barValueLabel = { enabled: campusAnalyticsState.chartMode === "bar", mode: "max-per-dataset" };
      options.interaction.mode = campusAnalyticsState.chartMode === "bar" ? "nearest" : "index";
      options.scales.x.offset = true;
      options.scales.x.grid.display = false;
      options.scales.x.ticks.autoSkip = campusAnalyticsState.chartMode !== "bar" && labels.length > 30;
      options.scales.x.ticks.maxTicksLimit = campusAnalyticsState.chartMode === "bar" ? Math.min(24, labels.length) : 14;
      options.scales.x.ticks.callback = function(value) {
        const label = this.getLabelForValue ? this.getLabelForValue(value) : value;
        if (campusAnalyticsState.chartMode === "bar") return smartTwoLineChartLabel(label);
        const labelsList = this.chart && this.chart.data ? this.chart.data.labels : [];
        const index = Number(value);
        if (labelsList.length > 30 && index % Math.ceil(labelsList.length / 14) !== 0 && index !== labelsList.length - 1) return "";
        const parsed = campusParsePeriodLabel(label);
        // Year is stamped on January and on the very first visible tick (the
        // trimmed range can start mid-year), plain month names in between.
        if (parsed.monthIndex === 0 || index === 0) return month_labels[parsed.monthIndex] + " " + String(parsed.year);
        return month_labels[parsed.monthIndex];
      };
      options.scales.y.title = makeAxisTitle(campusMetricLabel() + " (" + campusMetricUnit() + ")", campusAnalyticsState.metric === "water" ? ESG_CHART_COLORS.water : ESG_CHART_COLORS.electricity);
      options.scales.y1.display = false;
      // In quarter/semester/fiscal views the shaded segment row IS the x axis —
      // hide the per-month ticks so the two label rows don't overlap, and leave
      // room below the plot for the segment captions.
      const showSegmentRow = campusAnalyticsState.chartMode !== "bar" && campusAnalyticsState.segment !== "months";
      if (showSegmentRow) {
        options.scales.x.ticks.display = false;
        options.layout.padding = Object.assign({}, CHART_LAYOUT.padding, { bottom: 44 });
      }
      options.plugins.tooltip.callbacks.label = function(context) {
        const label = displayDatasetLabel(context.dataset && context.dataset.label);
        const value = Number(context.parsed && context.parsed.y);
        return label + ": " + (Number.isFinite(value) ? formatNumber(value) + " " + campusMetricUnit() : context.formattedValue);
      };
      return applyGraphBackgroundToChartOptions(options);
    }

    function renderCampusLegend(selectedBuildings) {
      const legend = document.getElementById("campusAdaptiveLegend");
      if (!legend) return;
      const maxVisible = selectedBuildings.length > 12 ? 10 : selectedBuildings.length;
      const chips = selectedBuildings.slice(0, maxVisible).map(code =>
        '<span class="campus-legend-chip"><span class="campus-legend-dot" style="background:' + buildingSeriesColor(code) + '"></span><span class="campus-legend-label">' + labelForBuilding(code) + '</span></span>'
      );
      if (selectedBuildings.length > maxVisible) {
        chips.push('<span class="campus-legend-more">+' + (selectedBuildings.length - maxVisible) + ' more</span>');
      }
      legend.innerHTML = chips.join("");
    }

    function renderCampusAnalyticsChart() {
      ensureAllBuildingsPrepared();
      const canvas = document.getElementById("campusAnalyticsChart");
      if (!canvas) return;
      const selectedBuildings = campusSelectedBuildings();
      const allPeriods = campusHistoricalPeriods();
      const subtitle = document.getElementById("campusAnalyticsSubtitle");
      const seriesByBuilding = {};
      selectedBuildings.forEach(code => { seriesByBuilding[code] = campusSeriesForBuilding(code, allPeriods); });

      // Trim leading/trailing periods where NO selected building has a reading,
      // so the chart opens on the span that actually contains data instead of
      // long flat runs of empty years.
      let firstIdx = -1;
      let lastIdx = -1;
      allPeriods.forEach((_, index) => {
        const hasReading = selectedBuildings.some(code => {
          const value = (seriesByBuilding[code] || [])[index];
          return Number.isFinite(value) && value !== 0;
        });
        if (hasReading) {
          if (firstIdx < 0) firstIdx = index;
          lastIdx = index;
        }
      });
      const historicalLabels = firstIdx >= 0 ? allPeriods.slice(firstIdx, lastIdx + 1) : allPeriods.slice();
      if (firstIdx >= 0) {
        selectedBuildings.forEach(code => {
          seriesByBuilding[code] = (seriesByBuilding[code] || []).slice(firstIdx, lastIdx + 1);
        });
      }

      let labels = historicalLabels.slice();
      const datasets = [];
      const forecastByBuilding = {};
      const selectedCount = selectedBuildings.length;
      const focused = campusAnalyticsState.focused;

      if (campusAnalyticsState.chartMode === "bar") {
        labels = selectedBuildings.map(code => labelForBuilding(code));
        const barValues = selectedBuildings.map(code => (seriesByBuilding[code] || []).reduce((sum, value) => sum + Number(value || 0), 0));
        const barColors = selectedBuildings.map(code => {
          const color = buildingSeriesColor(code);
          const alpha = focused && focused !== code ? 0.34 : (selectedCount > 12 ? 0.72 : 0.92);
          return hexToRgba(color, alpha);
        });
        const barBorders = selectedBuildings.map(code => buildingSeriesColor(code));
        const barDataset = styleBarDataset({
          label: campusMetricLabel() + " total",
          data: barValues,
          _campusTotals: true
        }, campusAnalyticsState.metric === "water" ? ESG_CHART_COLORS.water : ESG_CHART_COLORS.electricity, {
          categoryPercentage: 0.74,
          barPercentage: 0.82,
          maxBarThickness: selectedCount > 16 ? 24 : 42
        });
        barDataset.backgroundColor = barColors;
        barDataset.hoverBackgroundColor = selectedBuildings.map(code => lightenHex(buildingSeriesColor(code), 0.14));
        barDataset.borderColor = barBorders;
        datasets.push(barDataset);
      } else {
        const futureLabels = [];
        if (campusAnalyticsState.forecast && labels.length) {
          const lastLabel = labels[labels.length - 1];
          for (let step = 1; step <= 6; step++) futureLabels.push(campusNextPeriodLabel(lastLabel, step));
          labels = labels.concat(futureLabels);
        }
        selectedBuildings.forEach(code => {
          const color = buildingSeriesColor(code);
          const historical = seriesByBuilding[code] || [];
          const alpha = focused && focused !== code ? 0.22 : (selectedCount > 14 ? 0.58 : selectedCount > 8 ? 0.74 : 0.96);
          const line = styleLineDataset({
            label: labelForBuilding(code),
            data: historical.concat(Array(futureLabels.length).fill(null)),
            _building: code
          }, color, {
            borderWidth: focused === code ? 4.4 : (selectedCount > 12 ? 2.1 : 3.1),
            pointRadius: selectedCount > 10 ? 0 : 2.4,
            pointHoverRadius: 5
          });
          line.borderColor = hexToRgba(color, alpha);
          line.backgroundColor = hexToRgba(color, 0.08);
          datasets.push(line);

          if (campusAnalyticsState.forecast && futureLabels.length) {
            const forecast = campusForecastValues(historical, futureLabels.length);
            forecastByBuilding[code] = forecast;
            const lastReal = [...historical].reverse().find(value => Number.isFinite(value));
            const forecastData = Array(historical.length - 1).fill(null).concat([lastReal || 0], forecast.forecast);
            const forecastDataset = styleLineDataset({
              label: labelForBuilding(code) + " forecast",
              data: forecastData,
              _building: code,
              _forecast: true
            }, color, {
              borderWidth: focused === code ? 3.4 : 2,
              pointRadius: 0,
              pointHoverRadius: 4,
              tension: 0.28
            });
            forecastDataset.borderDash = [7, 5];
            forecastDataset.borderColor = hexToRgba(color, focused && focused !== code ? 0.18 : 0.72);
            forecastDataset.backgroundColor = hexToRgba(color, 0.05);
            datasets.push(forecastDataset);
          }
        });
      }

      if (campusAnalyticsChart) {
        campusAnalyticsChart.destroy();
        campusAnalyticsChart = null;
      }

      campusAnalyticsChart = new Chart(canvas, {
        type: campusAnalyticsState.chartMode === "bar" ? "bar" : "line",
        data: { labels, datasets },
        options: campusChartOptions(labels)
      });

      campusAnalyticsChart.$timeSegments = (campusAnalyticsState.chartMode === "line" && campusAnalyticsState.segment !== "months")
        ? campusBuildSegments(labels)
        : [];
      campusAnalyticsChart.$forecastBands = [];
      if (campusAnalyticsState.forecast && campusAnalyticsState.chartMode === "line") {
        selectedBuildings.slice(0, selectedBuildings.length > 10 ? 4 : selectedBuildings.length).forEach(code => {
          const forecast = forecastByBuilding[code];
          if (!forecast) return;
          const prefix = Array(historicalLabels.length).fill(null);
          campusAnalyticsChart.$forecastBands.push({
            lower: prefix.concat(forecast.lower),
            upper: prefix.concat(forecast.upper),
            color: hexToRgba(buildingSeriesColor(code), selectedBuildings.length > 8 ? 0.045 : 0.08)
          });
        });
        const historyTotals = historicalLabels.map((_, index) => selectedBuildings.reduce((sum, code) => sum + Number((seriesByBuilding[code] || [])[index] || 0), 0));
        const recentAvg = historyTotals.slice(-6).reduce((sum, value) => sum + value, 0) / Math.max(1, Math.min(6, historyTotals.length));
        campusAnalyticsChart.$analyticsOverlays = {
          benchmark: recentAvg,
          target: recentAvg * 0.94
        };
      } else {
        campusAnalyticsChart.$analyticsOverlays = {};
      }
      campusAnalyticsChart.update("none");

      renderCampusLegend(selectedBuildings);
      campusProjectionSummary(selectedBuildings, historicalLabels, seriesByBuilding, forecastByBuilding);
      if (subtitle) {
        const periodText = historicalLabels.length ? historicalLabels[0] + " to " + historicalLabels[historicalLabels.length - 1] : "No periods";
        subtitle.textContent = campusMetricLabel() + " comparison for " + selectedBuildings.length + " buildings, " + periodText;
      }
    }

    function setupCampusAnalyticsPage() {
      ensureAllBuildingsPrepared();
      if (!campusAnalyticsState.selected || campusAnalyticsState.selected.size === 0) {
        campusAnalyticsState.selected = new Set(allBuildingCodes.slice(0, Math.min(6, allBuildingCodes.length)));
      }
      const search = document.getElementById("campusBuildingSearch");
      if (search && search.dataset.campusBound !== "true") {
        search.dataset.campusBound = "true";
        search.addEventListener("input", function () {
          campusAnalyticsState.search = search.value || "";
          renderCampusBuildingSelector();
        });
      }
      document.querySelectorAll("[data-campus-action]").forEach(button => {
        if (button.dataset.campusBound === "true") return;
        button.dataset.campusBound = "true";
        button.addEventListener("click", function () {
          const action = button.dataset.campusAction;
          const visible = campusVisibleBuildings();
          if (action === "selectAll") campusSetSelection(allBuildingCodes);
          else if (action === "clearAll") campusSetSelection([]);
          else if (action === "invert") {
            const next = allBuildingCodes.filter(code => !campusAnalyticsState.selected.has(code));
            campusSetSelection(next);
          } else if (action === "top") {
            campusSetSelection(allBuildingCodes.slice().sort((a, b) => campusTotalForBuilding(b) - campusTotalForBuilding(a)).slice(0, 6));
          } else if (action === "lowest") {
            campusSetSelection(allBuildingCodes.slice().sort((a, b) => campusTotalForBuilding(a) - campusTotalForBuilding(b)).slice(0, 6));
          } else if (action === "similar") {
            const base = campusAnalyticsState.focused || campusSelectedBuildings()[0] || visible[0] || allBuildingCodes[0];
            const baseTotal = campusTotalForBuilding(base);
            const next = allBuildingCodes.slice()
              .sort((a, b) => Math.abs(campusTotalForBuilding(a) - baseTotal) - Math.abs(campusTotalForBuilding(b) - baseTotal))
              .slice(0, 6);
            campusAnalyticsState.focused = base;
            campusSetSelection(next);
          }
        });
      });
      const focusButton = document.getElementById("campusFocusClearBtn");
      if (focusButton && focusButton.dataset.campusBound !== "true") {
        focusButton.dataset.campusBound = "true";
        focusButton.addEventListener("click", function () {
          campusAnalyticsState.focused = null;
          renderCampusBuildingSelector();
          renderCampusAnalyticsChart();
        });
      }
      document.querySelectorAll("[data-campus-metric]").forEach(button => {
        if (button.dataset.campusBound === "true") return;
        button.dataset.campusBound = "true";
        button.addEventListener("click", function () {
          campusAnalyticsState.metric = button.dataset.campusMetric;
          document.querySelectorAll("[data-campus-metric]").forEach(item => item.classList.toggle("active", item === button));
          renderCampusBuildingSelector();
          renderCampusAnalyticsChart();
        });
      });
      document.querySelectorAll("[data-campus-chart-mode]").forEach(button => {
        if (button.dataset.campusBound === "true") return;
        button.dataset.campusBound = "true";
        button.addEventListener("click", function () {
          campusAnalyticsState.chartMode = button.dataset.campusChartMode;
          document.querySelectorAll("[data-campus-chart-mode]").forEach(item => item.classList.toggle("active", item === button));
          renderCampusAnalyticsChart();
        });
      });
      document.querySelectorAll("[data-campus-segment]").forEach(button => {
        if (button.dataset.campusBound === "true") return;
        button.dataset.campusBound = "true";
        button.addEventListener("click", function () {
          campusAnalyticsState.segment = button.dataset.campusSegment;
          document.querySelectorAll("[data-campus-segment]").forEach(item => item.classList.toggle("active", item === button));
          renderCampusAnalyticsChart();
        });
      });
      const forecastToggle = document.getElementById("campusForecastToggle");
      if (forecastToggle && forecastToggle.dataset.campusBound !== "true") {
        forecastToggle.dataset.campusBound = "true";
        forecastToggle.addEventListener("change", function () {
          campusAnalyticsState.forecast = !!forecastToggle.checked;
          renderCampusAnalyticsChart();
        });
      }
      renderCampusBuildingSelector();
      renderCampusAnalyticsChart();
      if (!is_auto_mode) { stopProgressBarAnimation(); return; }
      runProgressForPage(11, getPageDuration(11), true);
    }

    // ============================================================
    // PAGE SETUP FUNCTIONS
    // ============================================================
    function setupAllBuildingsListPage() {
      ensureAllBuildingsPrepared();
      const grid = document.getElementById("all-buildings-grid");
      renderBuildingCards(grid);
      const cards = grid.querySelectorAll('.building-card');
      cards.forEach((card, index) => {
        card.style.opacity = 0;
        setTimeout(() => {
          card.classList.add('animate__animated', 'animate__fadeInUp');
          card.style.opacity = 1;
        }, index * 30);
      });
      if (!is_auto_mode) { stopProgressBarAnimation(); return; }
      runProgressForPage(2, getPageDuration(2), true);
    }

    // Build the two stacked panels for a compare page: BARS on top, TREND LINE
    // below. Both share the same X categories and an identical Y scale (same
    // data -> same auto max) so the columns line up vertically between panels.
    function makeComparePanels(cfg) {
      const barCtx = document.getElementById(cfg.barCanvasId);
      const lineCtx = document.getElementById(cfg.lineCanvasId);

      function compareOptions(showXLabels, showLegend) {
        const options = baseChartOptions();
        options.plugins.legend.display = showLegend;
        options.plugins.legend.labels.font = makeAxisFont("legend");
        options.plugins.tooltip.titleFont = makeAxisFont("tooltipTitle");
        options.plugins.tooltip.bodyFont = makeAxisFont("tooltip");
        options.scales.x.ticks.font = makeAxisFont("axisLabel");
        options.scales.x.ticks.display = showXLabels;
        options.scales.x.offset = true;
        // With ~22 buildings the full names collide, so the axis shows the
        // short building code; tooltips still carry the full display name.
        if (Array.isArray(cfg.tickLabels) && cfg.tickLabels.length) {
          options.scales.x.ticks.callback = function(value) {
            const index = Number(value);
            const code = cfg.tickLabels[index] != null
              ? cfg.tickLabels[index]
              : (this.getLabelForValue ? this.getLabelForValue(value) : value);
            return wrapChartLabel(code);
          };
        }
        options.scales.y.ticks.font = makeAxisFont("axisLabel");
        if (cfg.yTitle) {
          options.scales.y.title = makeAxisTitle(
            cfg.yTitle,
            cfg.metric === "water" ? ESG_CHART_COLORS.water : ESG_CHART_COLORS.electricity
          );
        }
        if (cfg.scaleType === "logarithmic") {
          options.scales.y.type = "logarithmic";
          options.scales.y.beginAtZero = false;
          options.scales.y.min = cfg.minPositiveValue || 1;
          options.scales.y.afterBuildTicks = enforceLogScaleTicks;
          options.scales.y.ticks.callback = formatLogAxisNumber;
        }
        options.scales.y1.display = true;
        options.scales.y1.grid.drawOnChartArea = false;
        options.scales.y1.type = options.scales.y.type;
        options.scales.y1.beginAtZero = options.scales.y.beginAtZero;
        if (options.scales.y.min) options.scales.y1.min = options.scales.y.min;
        options.scales.y1.ticks.font = makeAxisFont("axisLabel");
        options.scales.y1.ticks.callback = options.scales.y.ticks.callback;
        options.scales.y1.afterBuildTicks = mirrorPrimaryAxisTicks;
        return applyGraphBackgroundToChartOptions(options);
      }

      // Top panel: bars. X labels stay visible here so every view mode
      // (bar / line / combined overlay) has readable categories. The built-in
      // legend stays hidden — the on-page swatch row is the year legend/control.
      const barChart = barCtx ? new Chart(barCtx, {
        type: "bar",
        data: { labels: cfg.labels, datasets: cfg.barDatasets },
        options: compareOptions(true, false)
      }) : null;

      // Bottom panel: trend line. Show the X labels here; hide the (empty) legend.
      const lineChart = lineCtx ? new Chart(lineCtx, {
        type: "line",
        data: { labels: cfg.labels, datasets: cfg.lineDatasets },
        options: compareOptions(true, false)
      }) : null;

      return { barChart, lineChart };
    }

    // Two stacked panels for the single-building monthly view: electricity +
    // water BARS on top, the matching TREND LINES below. Electricity uses the
    // left axis (y, kWh), water the right axis (y1, m³) — independent scales.
    function makeBuildingPanels(cfg) {
      const barCtx  = document.getElementById(cfg.barCanvasId);
      const lineCtx = document.getElementById(cfg.lineCanvasId);

      function panelOptions(showXLabels) {
        const options = baseChartOptions();
        options.plugins.legend.display = false;        // on-page swatch row is the legend
        options.plugins.barValueLabel = { enabled: false };
        options.scales.x.ticks.font = makeAxisFont("axisLabel");
        options.scales.x.ticks.display = showXLabels;
        options.scales.x.offset = true; // same x geometry for bar + line panels
        options.scales.y.ticks.font = makeAxisFont("axisLabel");
        options.scales.y.title = makeAxisTitle("Electricity (kWh)", ESG_CHART_COLORS.electricity);
        options.scales.y1.display = true;
        options.scales.y1.grid.drawOnChartArea = false;
        options.scales.y1.ticks.font = makeAxisFont("axisLabel");
        options.scales.y1.title = makeAxisTitle("Water (m³)", ESG_CHART_COLORS.water);
        options.scales.y1.afterBuildTicks = syncSecondaryAxisTicks;
        return applyGraphBackgroundToChartOptions(options);
      }

      const barChart = barCtx ? new Chart(barCtx, {
        type: "bar",
        data: { labels: cfg.labels, datasets: cfg.barDatasets },
        options: panelOptions(true)
      }) : null;

      const lineChart = lineCtx ? new Chart(lineCtx, {
        type: "line",
        data: { labels: cfg.labels, datasets: cfg.lineDatasets },
        options: panelOptions(true)
      }) : null;

      return { barChart, lineChart };
    }

    // Colour for a building-page series. Honours a saved per-year override
    // (shared with the compare pages), else falls back to a metric-specific
    // default palette so electricity (warm) and water (cool) never collide.
    const BUILDING_ELEC_DEFAULTS  = METRIC_YEAR_PALETTES.electricity;
    const BUILDING_WATER_DEFAULTS = METRIC_YEAR_PALETTES.water;
    function buildingYearColor(metric, year, yearIndex, total) {
      const map = chartColorPrefs[metric] || {};
      const override = map[String(year)];
      if (isHex6(override)) return normalizeHex(override);
      const palette = metric === "water" ? BUILDING_WATER_DEFAULTS : BUILDING_ELEC_DEFAULTS;
      return palette[yearIndex % palette.length];
    }

    // ---- Building monthly chart: per-year colour + filter (independent of the
    //      Electricity/Water compare pages' own filter state) ----
    function isBuildingSeriesHidden(metric, year) {
      return !!(buildingHiddenSeries[metric] && buildingHiddenSeries[metric][String(year)]);
    }
    function applyBuildingSeriesVisibility(metric, year, hide) {
      [threeBuildingBarChart, threeBuildingLineChart].forEach(function (chart) {
        if (!chart || !chart.data) return;
        chart.data.datasets.forEach(function (ds, i) {
          if (ds._metric === metric && String(ds._year) === String(year)) {
            chart.setDatasetVisibility(i, !hide);
          }
        });
        chart.update();
      });
    }
    function toggleBuildingSeries(metric, year) {
      const hide = !isBuildingSeriesHidden(metric, year);
      if (!buildingHiddenSeries[metric]) buildingHiddenSeries[metric] = {};
      buildingHiddenSeries[metric][String(year)] = hide;
      applyBuildingSeriesVisibility(metric, year, hide);
      buildBuildingColorControls();
      refreshEnterpriseAnalytics();
    }
    function isolateBuildingSeries(metric, year) {
      ["electricity", "water"].forEach(function (metricKey) {
        if (!buildingHiddenSeries[metricKey]) buildingHiddenSeries[metricKey] = {};
        const years = metricKey === "water" ? _buildingWaterYears : _buildingElecYears;
        years.forEach(function (itemYear) {
          const hide = !(metricKey === metric && String(itemYear) === String(year));
          buildingHiddenSeries[metricKey][String(itemYear)] = hide;
          applyBuildingSeriesVisibility(metricKey, itemYear, hide);
        });
      });
      buildBuildingColorControls();
      refreshEnterpriseAnalytics();
    }
    function reapplyBuildingVisibility() {
      ["electricity", "water"].forEach(function (metric) {
        const map = buildingHiddenSeries[metric] || {};
        Object.keys(map).forEach(function (year) {
          if (map[year]) applyBuildingSeriesVisibility(metric, year, true);
        });
      });
    }
    // Re-skin the building charts in place after a colour pref changes.
    function applyBuildingChartColors() {
      [threeBuildingBarChart, threeBuildingLineChart].forEach(function (chart) {
        if (!chart || !chart.data) return;
        const isLine = (chart === threeBuildingLineChart);
        chart.data.datasets.forEach(function (ds) {
          const color = buildingYearColor(ds._metric, ds._year, ds._yearIndex, ds._yearTotal);
          if (isLine) {
            styleLineDataset(ds, color);
          } else {
            styleBarDataset(ds, color);
          }
        });
        chart.update();
      });
    }
    // Build the colour swatch + year-filter chips for the building monthly chart.
    // Two groups: ⚡ electricity years and 💧 water years.
    function buildBuildingColorControls() {
      const wrap = document.getElementById("buildingColorControls");
      if (!wrap) return;
      wrap.innerHTML = "";

      function addGroup(icon, metric, years) {
        if (!years || years.length === 0) return;
        const tagChip = document.createElement("div");
        tagChip.className = "ccc-chip";
        const tag = document.createElement("span");
        tag.style.fontWeight = "800";
        tag.style.fontSize = "13px";
        tag.textContent = icon;
        tagChip.appendChild(tag);
        wrap.appendChild(tagChip);

        years.forEach(function (year, yearIndex) {
          const active = buildingYearColor(metric, year, yearIndex, years.length).toLowerCase();
          const off = isBuildingSeriesHidden(metric, year);

          const chip = document.createElement("div");
          chip.className = "ccc-chip";

          const colorBtn = document.createElement("button");
          colorBtn.type = "button";
          colorBtn.className = "ccc-color";
          colorBtn.style.background = active;
          colorBtn.title = "Change " + year + " colour";
          colorBtn.addEventListener("click", function (e) {
            e.stopPropagation();
            openColorPopup(metric, year, yearIndex, years.length, colorBtn);
          });
          chip.appendChild(colorBtn);

          const yearBtn = document.createElement("button");
          yearBtn.type = "button";
          yearBtn.className = "ccc-year" + (off ? " off" : "");
          yearBtn.title = (off ? "Show " : "Hide ") + year + " in the chart";
          yearBtn.textContent = year;
          yearBtn.addEventListener("click", function () { toggleBuildingSeries(metric, year); });
          yearBtn.addEventListener("dblclick", function (event) {
            event.preventDefault();
            event.stopPropagation();
            isolateBuildingSeries(metric, year);
          });
          chip.appendChild(yearBtn);

          wrap.appendChild(chip);
        });
      }

      addGroup("⚡", "electricity", _buildingElecYears);
      addGroup("💧", "water", _buildingWaterYears);
    }

    // ============================================================
    // CATEGORY CHARTS (Solar / Waste): one year, fixed categories, split into
    // a top BAR panel + bottom LINE panel, each with colour + filter controls.
    // ============================================================
    let solarBarChart = null, solarLineChart = null;
    let wasteBarChart = null, wasteLineChart = null;
    const categoryHidden = { solar: {}, waste: {} };
    const SOLAR_CATS = [
      { id: "urban",      label: "Urban Renewables", def: color_solar_urban },
      { id: "greenhouse", label: "Green House",      def: color_solar_gh }
    ];
    const WASTE_CATS = [
      { id: "general",    label: "General (kg)",    def: color_waste_gen },
      { id: "recyclable", label: "Recyclable (kg)", def: color_waste_rec }
    ];

    function categoryColor(groupKey, catId, defaultHex) {
      const map = chartColorPrefs[groupKey] || {};
      const override = map[String(catId)];
      if (isHex6(override)) return normalizeHex(override);
      return defaultHex;
    }

    // Top bar panel + bottom line panel on a single Y axis (y1 hidden).
    function makeCategoryPanels(cfg) {
      const barCtx  = document.getElementById(cfg.barCanvasId);
      const lineCtx = document.getElementById(cfg.lineCanvasId);
      function panelOptions(showXLabels) {
        const options = baseChartOptions();
        options.plugins.legend.display = false;
        options.plugins.barValueLabel = { enabled: false };
        options.scales.x.ticks.font = makeAxisFont("axisLabel");
        options.scales.x.ticks.display = showXLabels;
        options.scales.x.offset = true; // same x geometry for bar + line panels
        options.scales.y.ticks.font = makeAxisFont("axisLabel");
        if (cfg.yTitle) options.scales.y.title = makeAxisTitle(cfg.yTitle, "#475569");
        options.scales.y1.display = false;
        return applyGraphBackgroundToChartOptions(options);
      }
      const barChart = barCtx ? new Chart(barCtx, {
        type: "bar", data: { labels: cfg.labels, datasets: cfg.barDatasets }, options: panelOptions(true)
      }) : null;
      const lineChart = lineCtx ? new Chart(lineCtx, {
        type: "line", data: { labels: cfg.labels, datasets: cfg.lineDatasets }, options: panelOptions(true)
      }) : null;
      return { barChart, lineChart };
    }

    // Build bar + line datasets for a group, tagged with _group/_cat for
    // recolour + filtering.
    function buildCategoryDatasets(groupKey, cats, seriesByCat) {
      const barDatasets = [], lineDatasets = [];
      cats.forEach(function (cat) {
        const color = categoryColor(groupKey, cat.id, cat.def);
        const data  = seriesByCat[cat.id] || [];
        const meta  = { _group: groupKey, _cat: cat.id };
        barDatasets.push(styleBarDataset(Object.assign({
          label: cat.label, data: data, yAxisID: "y"
        }, meta), color));
        lineDatasets.push(styleLineDataset(Object.assign({
          label: cat.label, data: data, yAxisID: "y"
        }, meta), color));
      });
      return { barDatasets: barDatasets, lineDatasets: lineDatasets };
    }

    function isCategoryHidden(groupKey, catId) {
      return !!(categoryHidden[groupKey] && categoryHidden[groupKey][String(catId)]);
    }
    function applyCategoryVisibility(charts, groupKey, catId, hide) {
      charts().forEach(function (chart) {
        if (!chart || !chart.data) return;
        chart.data.datasets.forEach(function (ds, i) {
          if (ds._group === groupKey && ds._cat === catId) chart.setDatasetVisibility(i, !hide);
        });
        chart.update();
      });
    }
    function toggleCategory(groupKey, catId, charts, rebuild) {
      const hide = !isCategoryHidden(groupKey, catId);
      if (!categoryHidden[groupKey]) categoryHidden[groupKey] = {};
      categoryHidden[groupKey][String(catId)] = hide;
      applyCategoryVisibility(charts, groupKey, catId, hide);
      rebuild();
      refreshEnterpriseAnalytics();
    }
    function isolateCategory(groupKey, catId, cats, charts, rebuild) {
      if (!categoryHidden[groupKey]) categoryHidden[groupKey] = {};
      cats.forEach(function (cat) {
        const hide = String(cat.id) !== String(catId);
        categoryHidden[groupKey][String(cat.id)] = hide;
        applyCategoryVisibility(charts, groupKey, cat.id, hide);
      });
      rebuild();
      refreshEnterpriseAnalytics();
    }
    function reapplyCategoryVisibility(charts, groupKey) {
      const map = categoryHidden[groupKey] || {};
      Object.keys(map).forEach(function (catId) {
        if (map[catId]) applyCategoryVisibility(charts, groupKey, catId, true);
      });
    }
    function applyCategoryColors(charts, cats) {
      charts().forEach(function (chart) {
        if (!chart || !chart.data) return;
        const isLine = !!(chart.config && chart.config.type === "line");
        chart.data.datasets.forEach(function (ds) {
          const cat = cats.find(function (c) { return c.id === ds._cat; });
          if (!cat) return;
          const color = categoryColor(ds._group, ds._cat, cat.def);
          if (isLine) styleLineDataset(ds, color);
          else styleBarDataset(ds, color);
        });
        chart.update();
      });
    }
    function buildCategoryControls(containerId, groupKey, cats, charts) {
      const wrap = document.getElementById(containerId);
      if (!wrap) return;
      wrap.innerHTML = "";
      cats.forEach(function (cat) {
        const active = categoryColor(groupKey, cat.id, cat.def).toLowerCase();
        const off = isCategoryHidden(groupKey, cat.id);

        const chip = document.createElement("div");
        chip.className = "ccc-chip";

        const colorBtn = document.createElement("button");
        colorBtn.type = "button";
        colorBtn.className = "ccc-color";
        colorBtn.style.background = active;
        colorBtn.title = "Change " + cat.label + " colour";
        colorBtn.addEventListener("click", function (e) {
          e.stopPropagation();
          openColorPopup(groupKey, cat.id, 0, 1, colorBtn);
        });
        chip.appendChild(colorBtn);

        const labelBtn = document.createElement("button");
        labelBtn.type = "button";
        labelBtn.className = "ccc-year" + (off ? " off" : "");
        labelBtn.style.fontSize = "12px";
        labelBtn.textContent = cat.label;
        labelBtn.title = (off ? "Show " : "Hide ") + cat.label + " in the chart";
        labelBtn.addEventListener("click", function () {
          toggleCategory(groupKey, cat.id, charts, function () {
            buildCategoryControls(containerId, groupKey, cats, charts);
          });
        });
        labelBtn.addEventListener("dblclick", function (event) {
          event.preventDefault();
          event.stopPropagation();
          isolateCategory(groupKey, cat.id, cats, charts, function () {
            buildCategoryControls(containerId, groupKey, cats, charts);
          });
        });
        chip.appendChild(labelBtn);

        wrap.appendChild(chip);
      });
    }
    // Re-skin + rebuild the solar/waste controls after a colour pref changes.
    function refreshCategoryChartsAndControls() {
      const solarCharts = function () { return [solarBarChart, solarLineChart]; };
      const wasteCharts = function () { return [wasteBarChart, wasteLineChart]; };
      applyCategoryColors(solarCharts, SOLAR_CATS);
      applyCategoryColors(wasteCharts, WASTE_CATS);
      buildCategoryControls("solarColorControls", "solar", SOLAR_CATS, solarCharts);
      buildCategoryControls("wasteColorControls", "waste", WASTE_CATS, wasteCharts);
    }

    function setupElectricityComparePage() {
      const ctx = document.getElementById("electricityCompareChart");
      if (!ctx) return;

      const sortedYears = [...allYears].sort((yearA, yearB) => yearA - yearB);
      
      const dataByYear = {};
      sortedYears.forEach(year => {
        const rows = overviewByYear[year] || [];
        const map = {};
        rows.forEach(rowItem => {
          const key = normalizeBuildingKey(rowItem && rowItem.building);
          if (!key) return;
          map[key] = { 
            label: key, 
            electricity: Number(rowItem.electricity || 0), 
            water: Number(rowItem.water || 0) 
          };
        });
        dataByYear[year] = map;
      });

      const allBuildingKeys = new Set();
      Object.values(dataByYear).forEach(map => {
        Object.keys(map).forEach(keyItem => allBuildingKeys.add(keyItem));
      });
      const buildingKeys = Array.from(allBuildingKeys).sort((keyA, keyB) => 
        labelForBuilding(keyA).localeCompare(labelForBuilding(keyB))
      );

      const labels = buildingKeys.map(keyItem => labelForBuilding(keyItem));

      if (electricityCompareChart) { electricityCompareChart.destroy(); electricityCompareChart = null; }
      if (electricityCompareLineChart) { electricityCompareLineChart.destroy(); electricityCompareLineChart = null; }

      const barDatasets = [];
      const lineDatasets = [];
      
      sortedYears.forEach((year, yearIndex) => {
        const yearMap = dataByYear[year] || {};
        // A building-year of 0 kWh means "no bill recorded", never true zero
        // consumption — null it so lines gap instead of diving to the floor
        // and a year with no data at all simply draws nothing.
        const data = buildingKeys.map(keyItem => {
          const value = Number((yearMap[keyItem] && yearMap[keyItem].electricity) || 0);
          return value > 0 ? value : null;
        });
        const barColor = getYearColor("electricity", year, yearIndex, sortedYears.length);

        // Bars go in the TOP panel (solid year colour).
        barDatasets.push(styleBarDataset({
          label: String(year),
          data: data
        }, barColor));

        // Trend line goes in the SEPARATE BOTTOM panel (no longer drawn over the bars).
        lineDatasets.push(styleLineDataset({
          label: `_Line${year}`,
          data: data
        }, barColor));
      });

      // Floor the log axis at the decade below the smallest real reading so the
      // scale is not stretched down to 1 kWh (which made every bar look full).
      let minPositive = Infinity;
      barDatasets.forEach(ds => (ds.data || []).forEach(value => {
        if (Number.isFinite(value) && value > 0 && value < minPositive) minPositive = value;
      }));
      const logFloor = Number.isFinite(minPositive) && minPositive !== Infinity
        ? Math.max(1, Math.pow(10, Math.floor(Math.log10(minPositive))))
        : 1;

      const built = makeComparePanels({
        barCanvasId: "electricityCompareChart",
        lineCanvasId: "electricityCompareLineChart",
        labels: labels,
        barDatasets: barDatasets,
        lineDatasets: lineDatasets,
        metric: "electricity",
        yTitle: "Electricity (kWh)",
        scaleType: "logarithmic",
        minPositiveValue: logFloor,
        tickLabels: buildingKeys
      });
      electricityCompareChart = built.barChart;
      electricityCompareLineChart = built.lineChart;
      reapplyYearVisibility("electricity");
      buildInlineColorControls();
      refreshEnterpriseAnalytics();

      if (!is_auto_mode) { stopProgressBarAnimation(); return; }
      runProgressForPage(3, getPageDuration(3), true);
    }

    function setupWaterComparePage() {
      const ctx = document.getElementById("waterCompareChart");
      if (!ctx) return;

      const sortedYears = [...allYears].sort((yearA, yearB) => yearA - yearB);
      
      const dataByYear = {};
      sortedYears.forEach(year => {
        const rows = overviewByYear[year] || [];
        const map = {};
        rows.forEach(rowItem => {
          const key = normalizeBuildingKey(rowItem && rowItem.building);
          if (!key) return;
          map[key] = { 
            label: key, 
            electricity: Number(rowItem.electricity || 0), 
            water: Number(rowItem.water || 0) 
          };
        });
        dataByYear[year] = map;
      });

      const allBuildingKeys = new Set();
      Object.values(dataByYear).forEach(map => {
        Object.keys(map).forEach(keyItem => allBuildingKeys.add(keyItem));
      });
      const buildingKeys = Array.from(allBuildingKeys).sort((keyA, keyB) => 
        labelForBuilding(keyA).localeCompare(labelForBuilding(keyB))
      );

      const labels = buildingKeys.map(keyItem => labelForBuilding(keyItem));

      if (waterCompareChart) { waterCompareChart.destroy(); waterCompareChart = null; }
      if (waterCompareLineChart) { waterCompareLineChart.destroy(); waterCompareLineChart = null; }

      const barDatasets = [];
      const lineDatasets = [];
      
      sortedYears.forEach((year, yearIndex) => {
        const yearMap = dataByYear[year] || {};
        // 0 m³ for a building-year means "no reading recorded" — null it so a
        // data-free year draws nothing instead of a flat line at zero.
        const data = buildingKeys.map(keyItem => {
          const value = Number((yearMap[keyItem] && yearMap[keyItem].water) || 0);
          return value > 0 ? value : null;
        });
        const barColor = getYearColor("water", year, yearIndex, sortedYears.length);

        // Bars go in the TOP panel (solid year colour).
        barDatasets.push(styleBarDataset({
          label: String(year),
          data: data
        }, barColor));

        // Trend line goes in the SEPARATE BOTTOM panel (no longer drawn over the bars).
        lineDatasets.push(styleLineDataset({
          label: `_Line${year}`,
          data: data
        }, barColor));
      });

      const built = makeComparePanels({
        barCanvasId: "waterCompareChart",
        lineCanvasId: "waterCompareLineChart",
        labels: labels,
        barDatasets: barDatasets,
        lineDatasets: lineDatasets,
        metric: "water",
        yTitle: "Water (m³)",
        tickLabels: buildingKeys
      });
      waterCompareChart = built.barChart;
      waterCompareLineChart = built.lineChart;
      reapplyYearVisibility("water");
      buildInlineColorControls();
      refreshEnterpriseAnalytics();

      if (!is_auto_mode) { stopProgressBarAnimation(); return; }
      runProgressForPage(4, getPageDuration(4), true);
    }

