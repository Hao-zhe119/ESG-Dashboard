/* Compare pages (Electricity / Water by building): bars on top, trend line below */
.three-chart-wrap.compare-split {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.three-chart-wrap.compare-split .compare-bars {
  flex: 1 1 56%;
  min-height: 0;
  position: relative;
  transition: opacity .28s var(--chartEase), transform .28s var(--chartEase), flex-basis .28s var(--chartEase);
}
.three-chart-wrap.compare-split .compare-line {
  flex: 1 1 44%;
  min-height: 0;
  position: relative;
  transition: opacity .28s var(--chartEase), transform .28s var(--chartEase), flex-basis .28s var(--chartEase);
}

.three-chart-wrap.compare-split.analytics-view-mode-combined .compare-bars,
.three-chart-wrap.compare-split.analytics-view-mode-combined .compare-line {
  position: absolute;
  inset: 16px 18px 18px;
  flex: none;
  min-height: 0;
}

.three-chart-wrap.compare-split.analytics-view-mode-combined .compare-bars { z-index: 1; }
.three-chart-wrap.compare-split.analytics-view-mode-combined .compare-line {
  z-index: 2;
  pointer-events: none;
}

.three-chart-wrap.compare-split.analytics-view-mode-bar .compare-bars,
.three-chart-wrap.compare-split.analytics-view-mode-line .compare-line {
  flex: 1 1 100%;
}

.three-chart-wrap.compare-split.analytics-view-mode-bar .compare-line,
.three-chart-wrap.compare-split.analytics-view-mode-line .compare-bars {
  flex: 0 0 0;
  min-height: 0;
  opacity: 0;
  pointer-events: none;
  transform: translateY(8px);
  overflow: hidden;
}

