    const yearColorPalette = [
      "#ef4444", "#f97316", "#f59e0b", "#eab308", "#84cc16", "#22c55e",
      "#14b8a6", "#06b6d4", "#0ea5e9", "#3b82f6", "#6366f1", "#8b5cf6",
      "#a855f7", "#d946ef", "#ec4899", "#f43f5e"
    ];

    function getColorForYear(yearIndex, totalYears) {
      if (totalYears <= 1) return yearColorPalette[5];
      const step = Math.floor(yearColorPalette.length / Math.min(totalYears, yearColorPalette.length));
      const colorIndex = (yearIndex * step) % yearColorPalette.length;
      return yearColorPalette[colorIndex];
    }

