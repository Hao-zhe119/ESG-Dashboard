    function setChartRange(chart, start, end) {
      if (!chart || !chart.data || !chart.data.labels || !chart.data.labels.length) return;
      const labels = chart.data.labels;
      const safeStart = Math.max(0, Math.min(labels.length - 1, Math.round(start)));
      const safeEnd = Math.max(safeStart, Math.min(labels.length - 1, Math.round(end)));
      if (!chart.options.scales) chart.options.scales = {};
      if (!chart.options.scales.x) chart.options.scales.x = {};
      chart.options.scales.x.min = labels[safeStart];
      chart.options.scales.x.max = labels[safeEnd];
      chart.update("none");
    }

    function resetChartRange(chart) {
      if (!chart || !chart.options || !chart.options.scales || !chart.options.scales.x) return;
      delete chart.options.scales.x.min;
      delete chart.options.scales.x.max;
      chart.update("none");
    }

    function chartPrimarySeries(chart) {
      const primary = primaryVisibleDataset(chart);
      if (!primary) return null;
      const values = Array.isArray(primary.dataset.data)
        ? primary.dataset.data.map(value => (value == null ? NaN : Number(value)))
        : [];
      return { index: primary.index, dataset: primary.dataset, values };
    }

    function computeMovingAverage(values, windowSize) {
      const output = [];
      for (let index = 0; index < values.length; index++) {
        const start = Math.max(0, index - windowSize + 1);
        const slice = values.slice(start, index + 1).filter(Number.isFinite);
        if (!slice.length) continue;
        output.push({ index, value: slice.reduce((sum, value) => sum + value, 0) / slice.length });
      }
      return output;
    }

    function computeLinearTrend(values, start, end) {
      const points = [];
      for (let index = start; index <= end; index++) {
        const value = Number(values[index]);
        if (Number.isFinite(value)) points.push({ x: index, y: value });
      }
      if (points.length < 2) return [];
      const n = points.length;
      const sumX = points.reduce((sum, point) => sum + point.x, 0);
      const sumY = points.reduce((sum, point) => sum + point.y, 0);
      const sumXY = points.reduce((sum, point) => sum + point.x * point.y, 0);
      const sumXX = points.reduce((sum, point) => sum + point.x * point.x, 0);
      const denom = (n * sumXX) - (sumX * sumX);
      if (!denom) return [];
      const slope = ((n * sumXY) - (sumX * sumY)) / denom;
      const intercept = (sumY - slope * sumX) / n;
      return [
        { index: start, value: intercept + slope * start },
        { index: end, value: intercept + slope * end }
      ];
    }

    function updateAnalyticsOverlays(state) {
      state.charts.forEach((chart) => {
        const series = chartPrimarySeries(chart);
        const labels = chart.data && chart.data.labels ? chart.data.labels : [];
        const range = getVisibleRange(chart);
        const values = series ? series.values : [];
        const visibleValues = values.slice(range.start, range.end + 1).filter(Number.isFinite);
        const stats = summarizeValues(visibleValues);
        const overlays = {};
        if (state.toggles.movingAverage && values.length) overlays.movingAverage = computeMovingAverage(values, 3);
        if (state.toggles.trendLine && values.length) overlays.trendLine = computeLinearTrend(values, range.start, range.end);
        if (state.toggles.benchmark && stats) overlays.benchmark = stats.average;
        if (state.toggles.forecast && values.length) {
          const trend = computeLinearTrend(values, Math.max(0, range.end - 4), range.end);
          if (trend.length === 2) {
            const slope = (trend[1].value - trend[0].value) / Math.max(1, trend[1].index - trend[0].index);
            overlays.forecast = [];
            for (let index = range.end; index <= Math.min(labels.length - 1, range.end + 3); index++) {
              overlays.forecast.push({ index, value: Number(values[range.end] || 0) + slope * (index - range.end) });
            }
          }
        }
        if (state.toggles.target && stats) overlays.target = stats.average * 0.92;
        chart.$analyticsOverlays = overlays;
        chart.update("none");
      });
    }

    function updateAnalyticsStats(state) {
      const activeChart = state.mode === "line" ? state.lineChart : state.barChart || state.lineChart;
      if (!activeChart) return;
      const range = state.selection || getVisibleRange(activeChart);
      const values = [];
      activeChart.data.datasets.forEach((dataset, datasetIndex) => {
        values.push(...visibleDatasetValues(activeChart, datasetIndex, range.start, range.end));
      });
      const stats = summarizeValues(values);
      const labels = activeChart.data.labels || [];
      const timeAxis = isMonthAxis(labels);
      const rangeText = labels.length
        ? String(labels[range.start]) + " to " + String(labels[range.end])
        : "All periods";
      state.rangeValue.textContent = rangeText;
      const grid = state.statsGrid;
      if (!grid) return;

      // Growth is only meaningful along a time axis. On categorical axes
      // (building comparisons) "first vs last" is alphabetical noise, so we
      // report the high–low spread instead.
      const primary = chartPrimarySeries(activeChart);
      const windowValues = primary ? primary.values.slice(range.start, range.end + 1) : [];
      const finiteWindow = windowValues.filter(Number.isFinite);
      const growth = timeAxis && finiteWindow.length >= 2
        ? pctChange(finiteWindow[finiteWindow.length - 1], finiteWindow[0])
        : null;
      const items = stats ? [
        ["Min", formatAxisNumber(stats.min)],
        ["Max", formatAxisNumber(stats.max)],
        ["Avg", formatAxisNumber(stats.average)],
        ["Median", formatAxisNumber(stats.median)],
        ["Total", formatAxisNumber(stats.total)],
        timeAxis ? ["Growth", formatPercent(growth)] : ["Spread", formatAxisNumber(stats.max - stats.min)],
        ["Std Dev", formatAxisNumber(Math.sqrt(stats.variance))],
        ["Points", String(stats.count)]
      ] : [["Min", "n/a"], ["Max", "n/a"], ["Avg", "n/a"], ["Median", "n/a"]];
      grid.innerHTML = items.map(item =>
        '<div class="analytics-stat"><span class="analytics-stat-label">' + item[0] + '</span><span class="analytics-stat-value">' + item[1] + '</span></div>'
      ).join("");

      const insight = state.insightBody;
      if (insight && stats) {
        // Peak is looked up across every visible series, not just the primary
        // one, so it survives hidden years and series with missing readings.
        let maxValue = -Infinity;
        let maxOffset = -1;
        activeChart.data.datasets.forEach((dataset, datasetIndex) => {
          if (!dataset) return;
          if (activeChart.isDatasetVisible && !activeChart.isDatasetVisible(datasetIndex)) return;
          const dataArray = Array.isArray(dataset.data) ? dataset.data : [];
          const end = Math.min(range.end, dataArray.length - 1);
          for (let index = range.start; index <= end; index++) {
            const value = dataArray[index] == null ? NaN : Number(dataArray[index]);
            if (Number.isFinite(value) && value > maxValue) { maxValue = value; maxOffset = index - range.start; }
          }
        });
        const maxLabel = maxOffset >= 0 && labels[range.start + maxOffset] != null
          ? String(labels[range.start + maxOffset])
          : "the selected range";
        if (timeAxis) {
          const direction = Number(growth) > 2 ? "increased" : Number(growth) < -2 ? "decreased" : "remained broadly stable";
          insight.textContent = "Usage " + direction + (growth != null ? " (" + formatPercent(growth) + ")" : "") +
            " across the visible months. The peak is in " + maxLabel + ", and the average is " +
            formatAxisNumber(stats.average) + " over " + stats.count + " recorded readings.";
        } else {
          insight.textContent = "Highest usage is at " + maxLabel + ". The visible average is " +
            formatAxisNumber(stats.average) + " across " + stats.count + " readings, with a high–low gap of " +
            formatAxisNumber(stats.max - stats.min) + ".";
        }
      }
    }

    function setAnalyticsMode(state, mode) {
      state.mode = mode;
      state.wrap.classList.remove("analytics-view-mode-bar", "analytics-view-mode-line", "analytics-view-mode-combined");
      state.wrap.classList.add("analytics-view-mode-" + mode);
      state.toolbar.querySelectorAll("[data-analytics-mode]").forEach(button => {
        button.classList.toggle("active", button.dataset.analyticsMode === mode);
      });
      state.charts.forEach(chart => {
        if (!chart || !chart.options || !chart.options.scales) return;
        if (!chart.$analyticsScaleDisplay) {
          chart.$analyticsScaleDisplay = {};
          Object.keys(chart.options.scales).forEach(scaleKey => {
            chart.$analyticsScaleDisplay[scaleKey] = chart.options.scales[scaleKey].display;
          });
        }
        // In combined mode the line canvas is overlaid on the bar canvas. Its
        // axes must stay LAID OUT (same fonts, same tick text, same padding) so
        // both plot areas are pixel-identical — otherwise lines drift off the
        // bars. So instead of hiding the scales we paint them transparent.
        const isLineOverlay = mode === "combined" && chart === state.lineChart && state.lineChart !== state.barChart;
        applyGraphBackgroundToChartOptions(chart.options); // restore themed colours first
        Object.keys(chart.options.scales).forEach(scaleKey => {
          const scale = chart.options.scales[scaleKey];
          if (!scale) return;
          scale.display = chart.$analyticsScaleDisplay[scaleKey];
          if (!isLineOverlay) return;
          if (!scale.ticks) scale.ticks = {};
          if (!scale.border) scale.border = {};
          if (!scale.grid) scale.grid = {};
          scale.ticks.color = "transparent";
          scale.border.color = "transparent";
          scale.grid.color = "transparent";
          if (scale.title) scale.title.color = "transparent";
        });
        chart.$axisGhost = isLineOverlay;
        chart.update("active");
      });
      requestAnimationFrame(() => {
        state.charts.forEach(chart => {
          try { chart.resize(); chart.update("none"); } catch (error) {}
        });
      });
      updateAnalyticsStats(state);
    }

    function setStateRange(state, start, end, updateInputs) {
      const labels = state.labels || [];
      if (!labels.length) return;
      const safeStart = Math.max(0, Math.min(labels.length - 1, Math.round(start)));
      const safeEnd = Math.max(safeStart, Math.min(labels.length - 1, Math.round(end)));
      state.range = { start: safeStart, end: safeEnd };
      state.charts.forEach(chart => setChartRange(chart, safeStart, safeEnd));
      if (updateInputs !== false) {
        state.rangeStart.value = String(safeStart);
        state.rangeEnd.value = String(safeEnd);
      }
      updateAnalyticsOverlays(state);
      updateAnalyticsStats(state);
    }

    function resetAnalyticsRange(state) {
      state.selection = null;
      state.range = { start: 0, end: Math.max(0, state.labels.length - 1) };
      state.charts.forEach(resetChartRange);
      state.rangeStart.value = "0";
      state.rangeEnd.value = String(Math.max(0, state.labels.length - 1));
      updateAnalyticsOverlays(state);
      updateAnalyticsStats(state);
    }

    function addAnalyticsAnnotation(state, chart, event) {
      if (!state.annotationType || !chart || !chart.chartArea) return;
      const area = chart.chartArea;
      const rect = chart.canvas.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      if (x < area.left || x > area.right || y < area.top || y > area.bottom) return;
      const xScale = chart.scales.x;
      const yScale = chart.scales.y;
      const xIndex = Math.round(Number(xScale.getValueForPixel(x)));
      const yValue = Number(yScale.getValueForPixel(y));
      const defaultNote = state.annotationType === "event" ? "ESG event" :
        state.annotationType === "region" ? "Highlighted period" :
        state.annotationType === "trend" ? "Trend annotation" :
        state.annotationType === "arrow" ? "Consumption spike" :
        state.annotationType === "note" ? "Operational note" : "Marker";
      const note = window.prompt("Annotation label", defaultNote) || defaultNote;
      state.charts.forEach(targetChart => {
        if (!Array.isArray(targetChart.$analyticsAnnotations)) targetChart.$analyticsAnnotations = [];
        targetChart.$analyticsAnnotations.push({
          type: state.annotationType,
          xIndex,
          yValue,
          note,
          color: getComputedStyle(state.wrap).getPropertyValue("--chartAccent") || "rgba(37,99,235,0.82)"
        });
        targetChart.update("none");
      });
    }

    function bindAnalyticsCanvasInteractions(state) {
      state.wrap.querySelectorAll("canvas").forEach(canvas => {
        if (canvas.dataset.analyticsBound === "true") return;
        canvas.dataset.analyticsBound = "true";
        let dragStart = null;
        canvas.addEventListener("wheel", function (event) {
          const labels = state.labels || [];
          if (labels.length < 2) return;
          event.preventDefault();
          const current = state.range || { start: 0, end: labels.length - 1 };
          const span = Math.max(2, current.end - current.start + 1);
          const nextSpan = event.deltaY < 0 ? Math.max(2, Math.round(span * 0.82)) : Math.min(labels.length, Math.round(span * 1.18));
          const rect = canvas.getBoundingClientRect();
          const ratio = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
          const anchor = current.start + ratio * (span - 1);
          let start = Math.round(anchor - ratio * (nextSpan - 1));
          let end = start + nextSpan - 1;
          if (start < 0) { end -= start; start = 0; }
          if (end >= labels.length) { start -= end - labels.length + 1; end = labels.length - 1; }
          setStateRange(state, Math.max(0, start), Math.min(labels.length - 1, end));
        }, { passive: false });

        canvas.addEventListener("dblclick", function () { resetAnalyticsRange(state); });

        canvas.addEventListener("click", function (event) {
          if (state.annotationType) {
            const chart = Chart.getChart(canvas);
            addAnalyticsAnnotation(state, chart, event);
          }
        });

        canvas.addEventListener("mousedown", function (event) {
          if (state.annotationType) return;
          dragStart = {
            x: event.clientX,
            range: Object.assign({}, state.range || { start: 0, end: state.labels.length - 1 }),
            brush: state.brushMode || event.shiftKey
          };
        });

        window.addEventListener("mousemove", function (event) {
          if (!dragStart) return;
          const labels = state.labels || [];
          const rect = canvas.getBoundingClientRect();
          const units = (event.clientX - dragStart.x) / Math.max(1, rect.width) * Math.max(1, dragStart.range.end - dragStart.range.start + 1);
          if (dragStart.brush) {
            const startRatio = Math.max(0, Math.min(1, (dragStart.x - rect.left) / rect.width));
            const endRatio = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
            const startIndex = Math.round(startRatio * (labels.length - 1));
            const endIndex = Math.round(endRatio * (labels.length - 1));
            state.selection = { start: Math.min(startIndex, endIndex), end: Math.max(startIndex, endIndex) };
            updateAnalyticsStats(state);
          } else {
            const span = dragStart.range.end - dragStart.range.start;
            let start = Math.round(dragStart.range.start - units);
            let end = start + span;
            if (start < 0) { end -= start; start = 0; }
            if (end >= labels.length) { start -= end - labels.length + 1; end = labels.length - 1; }
            setStateRange(state, start, end);
          }
        });

        window.addEventListener("mouseup", function () {
          dragStart = null;
        });
      });
    }

    function stopAnalyticsPlayback(state) {
      if (state.playTimer) clearInterval(state.playTimer);
      state.playTimer = null;
      if (state.playButton) state.playButton.classList.remove("is-playing");
    }

    function toggleAnalyticsPlayback(state) {
      if (state.playTimer) {
        stopAnalyticsPlayback(state);
        return;
      }
      const labels = state.labels || [];
      if (labels.length < 2) return;
      state.playButton.classList.add("is-playing");
      const windowSize = Math.max(3, Math.min(labels.length, (state.range.end - state.range.start + 1) || 4));
      state.playTimer = setInterval(() => {
        const current = state.range || { start: 0, end: windowSize - 1 };
        let start = current.start + 1;
        if (start + windowSize - 1 >= labels.length) start = 0;
        setStateRange(state, start, start + windowSize - 1);
      }, 950);
    }

    function installEnterpriseAnalytics(wrap, options) {
      if (!wrap) return;
      const card = wrap.closest(".analytics-card");
      const body = wrap.closest(".analytics-card-body");
      const header = card ? card.querySelector(".analytics-card-header") : null;
      if (!body || !header) return;
      const legendElement = options && options.legendId ? document.getElementById(options.legendId) : null;
      const accent = card ? getComputedStyle(card).getPropertyValue("--chartAccent") : "";
      const toolbar = createAnalyticsToolbar(header, legendElement, accent);
      const panels = ensureAnalyticsPanels(body, wrap);
      const charts = chartsInsideWrap(wrap);
      if (!charts.length) return;
      const labels = (charts[0].data && charts[0].data.labels) || [];

      let state = analyticsModuleState.get(wrap);
      if (!state) {
        state = {
          wrap,
          toolbar,
          charts,
          barChart: charts[0] || null,
          lineChart: charts[1] || charts[0] || null,
          labels,
          range: { start: 0, end: Math.max(0, labels.length - 1) },
          mode: "combined",
          toggles: {},
          annotationType: null,
          brushMode: false,
          navigator: panels.navigator,
          rangeStart: panels.navigator.querySelector(".analytics-range-start"),
          rangeEnd: panels.navigator.querySelector(".analytics-range-end"),
          rangeValue: panels.navigator.querySelector(".analytics-range-value"),
          statsGrid: panels.intelligence.querySelector(".analytics-stats-grid"),
          insightBody: panels.intelligence.querySelector(".analytics-insights-body")
        };
        analyticsModuleState.set(wrap, state);
      } else {
        state.charts = charts;
        state.barChart = charts[0] || null;
        state.lineChart = charts[1] || charts[0] || null;
        state.labels = labels;
      }

      state.rangeStart.max = String(Math.max(0, labels.length - 1));
      state.rangeEnd.max = String(Math.max(0, labels.length - 1));
      state.rangeStart.value = String(state.range.start || 0);
      state.rangeEnd.value = String(state.range.end || Math.max(0, labels.length - 1));

      if (toolbar.dataset.analyticsBound !== "true") {
        toolbar.dataset.analyticsBound = "true";
        toolbar.addEventListener("click", function (event) {
          const button = event.target.closest("button");
          if (!button) return;
          if (button.dataset.analyticsMode) setAnalyticsMode(state, button.dataset.analyticsMode);
          if (button.dataset.analyticsToggle) {
            const key = button.dataset.analyticsToggle;
            state.toggles[key] = !state.toggles[key];
            if (key === "benchmark") state.toggles.target = false;
            button.classList.toggle("active", !!state.toggles[key]);
            updateAnalyticsOverlays(state);
          }
          if (button.dataset.analyticsAnnotation) {
            state.annotationType = state.annotationType === button.dataset.analyticsAnnotation ? null : button.dataset.analyticsAnnotation;
            toolbar.querySelectorAll("[data-analytics-annotation]").forEach(item => item.classList.toggle("active", item.dataset.analyticsAnnotation === state.annotationType));
          }
          if (button.dataset.analyticsBrush) {
            state.brushMode = !state.brushMode;
            button.classList.toggle("active", state.brushMode);
          }
          if (button.dataset.analyticsPlay) {
            state.playButton = button;
            toggleAnalyticsPlayback(state);
          }
          if (button.dataset.analyticsReset) {
            stopAnalyticsPlayback(state);
            state.annotationType = null;
            state.brushMode = false;
            state.toggles = {};
            state.charts.forEach(chart => {
              chart.$analyticsAnnotations = [];
              chart.$analyticsOverlays = {};
              chart.update("none");
            });
            toolbar.querySelectorAll(".analytics-tool-btn.active").forEach(item => item.classList.remove("active"));
            resetAnalyticsRange(state);
          }
        });
      }

      const rangeHandler = function () {
        let start = Number(state.rangeStart.value);
        let end = Number(state.rangeEnd.value);
        if (start > end) [start, end] = [end, start];
        state.selection = null;
        setStateRange(state, start, end, false);
      };
      if (state.rangeStart.dataset.analyticsBound !== "true") {
        state.rangeStart.dataset.analyticsBound = "true";
        state.rangeEnd.dataset.analyticsBound = "true";
        state.rangeStart.addEventListener("input", rangeHandler);
        state.rangeEnd.addEventListener("input", rangeHandler);
      }

      bindAnalyticsCanvasInteractions(state);
      setAnalyticsMode(state, state.mode || "combined");
      updateAnalyticsOverlays(state);
      updateAnalyticsStats(state);
    }

